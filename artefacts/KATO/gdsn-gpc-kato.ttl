###  urn:gs1:std:gdsn:cv169819
gdsn:cv169819 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Malt liquor, in North America, is beer with high alcohol content. Legally, it often includes any alcoholic beverage with 5% or more alcohol by volume made with malted barley." ;
              rdfs:label "AMERICAN_STYLE_MALT_LIQUOR" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169819" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169820
gdsn:cv169820 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "American Style Pale ale is a top fermented beer, crafted originally in America, made with predominantly pale malt. The highest proportion of pale malts results in a lighter colour." ;
              rdfs:label "AMERICAN_STYLE_PALE_ALE" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169820" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169821
gdsn:cv169821 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "American Style Pilsners are made with neutral and hard water. They tend to be golden in colour with a dry, crisp, and somewhat bitter flavour. Pilsner stands out from other lagers due to its more distinctive hop taste." ;
