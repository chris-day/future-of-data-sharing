###  urn:gs1:std:gdsn:cv169823
gdsn:cv169823 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "American Style stout is a dark, top fermented beer, crafted originally in America, with a number of variations, including dry stout, Baltic porter, milk stout, and imperial stout." ;
