                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lithium ion batteries utilizing phosphate are primary use in automotive and power tool products." ;
              rdfs:label "LITHIUM_PHOSPHATE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169657" ;
              gdsn:sourceType "codeValue" .


