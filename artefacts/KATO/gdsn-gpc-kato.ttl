###  urn:gs1:std:gdsn:cv180961
gdsn:cv180961 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Substances derived from palm oil such as fatty acids, fatty alcohols and glycerol and their fractions such as olein and stearin. It is used in pharmaceuticals, oleochemical production, fuel, paint and plastics manufacturing and food production." ;
              rdfs:label "PALM_OIL_DERIVATIVES" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "180961" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180962
