###  urn:gs1:std:gdsn:cv177110
gdsn:cv177110 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A small peg, plug or tapl, especially for insertion into the vent of a cask." ;
