                rdfs:domain gdsn:extGroup_BestBuy ;
                rdfs:range xsd:decimal ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "What is the minimum required power supply wattage from the computer system power supply required to operate the product?t" ;
                rdfs:label "requiredPowerSupplyWattage" ;
                gdsn:example "Any Valid Number (4,2)" ;
                gdsn:groupName "BestBuy" ;
