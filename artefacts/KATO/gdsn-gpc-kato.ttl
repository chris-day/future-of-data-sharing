gdsn:cv176781 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"SILVER\" award of the Great MUNDUS VINI International Wine Awards. At least 85 points must be achieved in the judging of the wines by the international jury. Only the wines achieving the highest number of points in this range will receive the gold medal. This means that the minimum number of points required for this award may be higher." ;
              rdfs:label "MUNDUSVINI_SILVER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.mundusvini.de/9777180--~de~internationaler_weinpreis~Medaillen~medaillen.html" ;
