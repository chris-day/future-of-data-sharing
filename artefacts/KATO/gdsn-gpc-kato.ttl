###  urn:gs1:std:gdsn:cv168849
gdsn:cv168849 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-sparkling wine with between 1 and 2.5 atmospheres of pressures and include German spritzig, Italian frizzante and French pétillant wines." ;
