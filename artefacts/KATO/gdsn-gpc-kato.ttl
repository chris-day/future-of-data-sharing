###  urn:gs1:std:gdsn:cv181548
gdsn:cv181548 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Climate Activator Certified standard gives you the acknowledgement that the results of your work are helping and are meaningful. The steps that have been taken are expertly tested against published criteria in a transparent process. With the logo, you can clearly communicate your commitment to your stakeholders, who are becoming more critical when it comes to socially, ecologically and economically responsible business." ;
              rdfs:label "CLIMATE_ACTIVATOR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.climateactivator.org/" ;
              gdsn:sourceId "181548" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181549
gdsn:cv181549 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "COSC-certified watches must be accurate to within -4 to +6 seconds per day when tested for accuracy over 15 days." ;
              rdfs:label "COSC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.cosc.swiss/" ;
              gdsn:sourceId "181549" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181550
gdsn:cv181550 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "EKO stars stands for organic products of Dutch origin that meet extra requirements in the field of nature, biodiversity, animal and climate as determined per sector. All these extras realised by EKO farmers in the Netherlands are indicated with the EKO 3-star quality mark, where 1 star stands for 30-60% Dutch origin." ;
              rdfs:label "EKO_1" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "EKO keurmerk - Voor pioniers in biologische voeding. (eko-keurmerk.nl)" ;
              gdsn:sourceId "181550" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181551
gdsn:cv181551 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "EKO stars stands for organic products of Dutch origin that meet extra requirements in the field of nature, biodiversity, animal and climate as determined per sector. All these extras realised by EKO farmers in the Netherlands are indicated with the EKO 3-star quality mark, where 2 stars stand for 60-90% Dutch origin." ;
              rdfs:label "EKO_2" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "EKO keurmerk - Voor pioniers in biologische voeding. (eko-keurmerk.nl)" ;
              gdsn:sourceId "181551" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181552
gdsn:cv181552 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "EKO stars stands for organic products of Dutch origin that meet extra requirements in the field of nature, biodiversity, animal and climate as determined per sector. All these extras realised by EKO farmers in the Netherlands are indicated with the EKO 3-star quality mark, where 3 stars stand for 90-100% Dutch origin." ;
              rdfs:label "EKO_3" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "EKO keurmerk - Voor pioniers in biologische voeding. (eko-keurmerk.nl)" ;
              gdsn:sourceId "181552" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181553
gdsn:cv181553 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Geneva Seal, also known as the Poinçon de Genève, indicates a watch movement was assembled, adjusted, and cased in Geneva. The Geneva Seal also includes testing for a watch's functionality, accuracy, power reserve, and water resistance." ;
              rdfs:label "GENEVA_SEAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.poincondegeneve.ch/en" ;
              gdsn:sourceId "181553" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181554
gdsn:cv181554 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "IP Suisse - Ingredient flour which is produced environmentally friendly." ;
              rdfs:label "IP_SUISSE_MEHL_FARINE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ipsuisse.ch/zertifizierungsreglement-ab-2025/" ;
              gdsn:sourceId "181554" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181555
gdsn:cv181555 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Midwest Organic Services Association (MOSA) Certified Organic is an organic certifier in the United States, primarily certifying livestock and dairy." ;
              rdfs:label "MOSA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://mosaorganic.org/certification" ;
              gdsn:sourceId "181555" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181556
gdsn:cv181556 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"NRW geprüfte Qualität\" label guarantees the quality of food products and their origin in North Rhine-Westphalia." ;
              rdfs:label "NRW_CERTIFIED_QUALITY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.nrw-isst-gut.de/gepruefte-qualitaet/" ;
              gdsn:sourceId "181556" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181557
gdsn:cv181557 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Seal of approval for condoms. The association Gütesiegel für Präservative, Lucerne, certifies condoms that meet their requirements. Such condoms may use the label, on packaging, promotional material and digitals." ;
              rdfs:label "OK_CONDOMS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ok-guetesiegel.ch/kontakt/" ;
              gdsn:sourceId "181557" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181558
gdsn:cv181558 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"Herkunftskennzeichen Deutschland\" label guarantees that food and agricultural products are produced and manufactured in Germany." ;
              rdfs:label "ORIGIN_MARK_GERMANY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://herkunft-deutschland.de/" ;
              gdsn:sourceId "181558" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181559
gdsn:cv181559 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The QM++ (Quality Management Milk) add-on module enables even more animal-friendly milk production than QM and QM+. The QM++ add-on module has been developed to further promote animal welfare on dairy farms. Cows are raised in outdoor climate conditions and can move freely." ;
              rdfs:label "QM_MILCH_PLUS_PLUS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://qm-milch.de/qm-plus-plus/" ;
              gdsn:sourceId "181559" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181560
gdsn:cv181560 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The QM+++ (Quality Management Milk) add-on module enables even more animal-friendly milk production than QM, QM+ and QM++. The QM+++ add-on module has been developed to further promote animal welfare on dairy farms. Cows are raised in pasture conditions and have additional outdoor access all year round." ;
              rdfs:label "QM_MILCH_PLUS_PLUS_PLUS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://qm-milch.de/qm-plus-plus-plus/" ;
              gdsn:sourceId "181560" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181561
gdsn:cv181561 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The QUALITE FLEURIER quality label is delivered by the Fleurier Quality Foundation (FQF), also known as Foundation Qualité Fleurier, to finished mechanical watches developed in Switzerland." ;
              rdfs:label "QUALITE_FLEURIER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fleurier-quality.com/rules-fqf-quality-seal.html" ;
              gdsn:sourceId "181561" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181562
gdsn:cv181562 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ViniPortugal has created the National Sustainability Certification Benchmark for the wine sector (RNCSSV), a unified reference for sustainability in wine production throughout the country, based on OIV-VITI Resolution 641-2020 'Guide to the Implementation of the Principles of Sustainable Winegrowing'." ;
              rdfs:label "SUSTAINABLE_WINEGROWING_PORTUGAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.viniportugal.pt/en/sustainability/" ;
              gdsn:sourceId "181562" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181563
gdsn:cv181563 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"Swiss Made\" label is a reference in the field of watchmaking, and ensures the presence of Swiss know-how in the making of the timepiece. This label reflects a quality requirement from a technical and aesthetic point of view. At present, it is a federal ordinance that sets the conditions for a timepiece to bear the Swiss Made label. While there is not a specific logo or seal, the requirements set forth the placement and styling of the words \"Swiss Made\" (or language equivalents) on the face of the timepiece." ;
              rdfs:label "SWISS_MADE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fhs.swiss/eng/strengthening.html" ;
              gdsn:sourceId "181563" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181564
gdsn:cv181564 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Viper seal is a quality certificate for mechanical chronometers delivered by the Besançon observatory." ;
              rdfs:label "VIPER_SEAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "181564" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181565
gdsn:cv181565 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certificate from Where Food Comes From, Inc., related to organic products." ;
              rdfs:label "WFCF_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.wfcforganic.com/get-certified" ;
              gdsn:sourceId "181565" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181566
gdsn:cv181566 rdf:type owl:NamedIndividual ,
                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cage container or cage pallet is a type of storage or transportation unit designed with a rigid framework of bars or mesh, resembling a cage. It is typically used to securely hold, protect, and transport goods, materials while allowing for ventilation, visibility, and containment." ;
              rdfs:label "60" ;
              gdsn:codeListName "PlatformTypeCode" ;
              gdsn:sourceId "181566" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181567
gdsn:cv181567 rdf:type owl:NamedIndividual ,
                       gdsn:c1608555517 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A mixture of raw milk and pasteurised or thermised milk, or a mixture of microfiltered skimmed milk and whole raw milk or raw cream." ;
              rdfs:label "MILK_MIXTURE" ;
              gdsn:codeListName "PreservationTechniqueTypeCode" ;
              gdsn:sourceId "181567" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181568
gdsn:cv181568 rdf:type owl:NamedIndividual ,
                       gdsn:c1608555517 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Thermisation is a heat treatment process applied at lower temperature than pasteurisation. The product is heated to a temperature of more than 40°C and less than 72°C for at least 15 seconds, e.g., for milk." ;
              rdfs:label "THERMISATION" ;
              gdsn:codeListName "PreservationTechniqueTypeCode" ;
              gdsn:sourceId "181568" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181569
gdsn:cv181569 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Measurement of the internal width of a barrel." ;
              rdfs:label "BARREL_DIAMETER" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "181569" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181570
gdsn:cv181570 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Angle formed between a bent structures parts, typically used to describe the deflection of material." ;
