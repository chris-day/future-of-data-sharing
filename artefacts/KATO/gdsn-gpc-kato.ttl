###  urn:gs1:std:gdsn:cv169847
gdsn:cv169847 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Contemporary Gose is a warm fermented beer that originated in Goslar, Germany. It is usually brewed with at least 50% of the grain bill being malted wheat. Dominant flavours in gose include a lemon sourness, an herbal characteristic, and a strong saltiness (the result of either local water sources or added salt). Gose beers typically do not have prominent hop bitterness, flavours, or aroma." ;
              rdfs:label "CONTEMPORARY_GOSE" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169847" ;
              gdsn:sourceType "codeValue" .


