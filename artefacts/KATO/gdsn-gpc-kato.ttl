gdsn:cv181587 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348048 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product can be cleaned by using a pipe carrier to brush the cavity or lumen of a hollow surgical instrument. Consult the Instructions for Use (IFU) or cleaning, disinfection and sterilisation regulations for the specifications." ;
