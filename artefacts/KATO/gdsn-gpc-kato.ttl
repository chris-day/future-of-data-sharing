gdsn:cv174091 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Butylated hydroxyanisole (BHA) is an antioxidant which retards rancidity in fats, oils, and oil-containing products." ;
              rdfs:label "BHA" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174091" ;
