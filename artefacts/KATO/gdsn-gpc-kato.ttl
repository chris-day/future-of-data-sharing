###  urn:gs1:std:gdsn:cv176409
gdsn:cv176409 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certified B Corporations voluntarily meet the highest standards of verified, overall social and environmental performance, public transparency, and legal accountability. B Corps are certified by the non-profit organisation B Lab." ;
              rdfs:label "CERTIFIED_B_CORPORATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bcorporation.net/" ;
              gdsn:sourceId "176409" ;
