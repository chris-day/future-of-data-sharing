                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The state of the product after it has been separated from any liquid within the package’’ – For example, a can of apricots in syrup would have a different nutritional composition if the apricots are consumed with the syrup rather than if the syrup is drained before consuming the apricots (because of the high sugar and energy content of the syrup)." ;
              rdfs:label "AS_DRAINED" ;
              gdsn:codeListName "PreparationTypeCode" ;
