###  urn:gs1:std:gdsn:cv172530
gdsn:cv172530 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A measurement for sound in air and other gases, relative to 20 micropascals (μPa) = 2×10−5 Pa, the quietest sound a human can hear. This is roughly the sound of a mosquito flying 3 metres away. This is often abbreviated to just \"dB\"; however the correct abbreviation is dB(SPL), indicating decibel for Sound Pressure Level." ;
              rdfs:label "2N" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172530" ;
              gdsn:sourceType "codeValue" .


