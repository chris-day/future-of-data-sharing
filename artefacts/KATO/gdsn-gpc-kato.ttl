gdsn:cv174080 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Artificial colour is defined as colour formed by chemical synthesis and is not identical to substances found in nature." ;
              rdfs:label "ARTIFICIAL_COLOUR" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174080" ;
              gdsn:sourceType "codeValue" .


