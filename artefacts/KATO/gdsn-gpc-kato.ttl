###  urn:gs1:std:gdsn:cv168810
gdsn:cv168810 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Port wine or vinho do Porto or Porto is a Portuguese fortified wine produced with distilled grape spirits exclusively in the Douro Valley in the northern provinces of Portugal." ;
              rdfs:label "FORTIFIED_WINE_PORT" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168810" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168811
gdsn:cv168811 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sherry is a fortified wine made from white grapes. Sherry is produced in a variety of styles made primarily from the Palomino grape, ranging from light versions similar to white table wines, such as Manzanilla and Fino, to darker and heavier versions that have been allowed to oxidise as they age in barrel, such as Amontillado and Oloroso." ;
              rdfs:label "FORTIFIED_WINE_SHERRY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168811" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168812
gdsn:cv168812 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vermouth is an aromatized, fortified wine flavoured with various botanicals (roots, barks, flowers, seeds, herbs, and spices) and sometimes coloured." ;
              rdfs:label "FORTIFIED_WINE_VERMOUTH" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168812" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168813
gdsn:cv168813 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vin doux naturel is a type of wine that has a natural level of sweetness. This is created through light fortification with a spirit being added to the wine before the end of the fermentation process, usually consisting of brandy. The natural sweetness of the wine is created through the process of mutage." ;
              rdfs:label "FORTIFIED_WINE_VIN_DOUX_NATURELS_VDN" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168813" ;
              gdsn:sourceType "codeValue" .


