@prefix : <urn:gs1:std:gdsn:#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix gpc: <urn:gs1:std:gpc:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gdsn: <urn:gs1:std:gdsn:> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix iso3166: <urn:iso:std:iso:3166> .
@base <urn:gs1:std:gdsn:> .

<urn:gs1:std:gdsn:> rdf:type owl:Ontology ;
                     owl:imports <urn:gs1:sample:kato:ontology> ,
                                 gpc: .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/source
dct:source rdf:type owl:AnnotationProperty ;
           rdfs:comment "Source artefact path or name." ;
           rdfs:label "Source" .


###  http://www.w3.org/2002/07/owl#maxCardinality
owl:maxCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#versionInfo
owl:versionInfo rdf:type owl:AnnotationProperty ;
                rdfs:comment "Ontology or source version information." ;
                rdfs:label "Version info" .


###  urn:gs1:std:gdsn:bmsId
gdsn:bmsId rdf:type owl:AnnotationProperty ;
           rdfs:comment "BMS identifier from GDSN instance or AVP metadata." ;
           rdfs:label "BMS ID" .


###  urn:gs1:std:gdsn:codeListName
gdsn:codeListName rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Source code-list name." ;
                  rdfs:label "Code list name" .


###  urn:gs1:std:gdsn:conversionWarning
gdsn:conversionWarning rdf:type owl:AnnotationProperty ;
                       rdfs:comment "Diagnostic note emitted during TSV generation." ;
                       rdfs:label "Conversion warning" .


###  urn:gs1:std:gdsn:example
gdsn:example rdf:type owl:AnnotationProperty ;
             rdfs:comment "Source example value." ;
             rdfs:label "Example" .


###  urn:gs1:std:gdsn:externalLink
gdsn:externalLink rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Source external reference link." ;
                  rdfs:label "External link" .


###  urn:gs1:std:gdsn:groupName
gdsn:groupName rdf:type owl:AnnotationProperty ;
               rdfs:comment "Original GDSN group name." ;
               rdfs:label "Group name" .


###  urn:gs1:std:gdsn:hierarchyLevel
gdsn:hierarchyLevel rdf:type owl:AnnotationProperty ;
                    rdfs:comment "Source hierarchy-level marker." ;
                    rdfs:label "Hierarchy level" .


###  urn:gs1:std:gdsn:originalLimit
gdsn:originalLimit rdf:type owl:AnnotationProperty ;
                   rdfs:comment "Unparsed source limit." ;
                   rdfs:label "Original limit" .


###  urn:gs1:std:gdsn:originalMultiplicity
gdsn:originalMultiplicity rdf:type owl:AnnotationProperty ;
                          rdfs:comment "Unparsed source multiplicity." ;
                          rdfs:label "Original multiplicity" .


###  urn:gs1:std:gdsn:pathId
gdsn:pathId rdf:type owl:AnnotationProperty ;
            rdfs:comment "Path identifier from gdsn_instances.json." ;
            rdfs:label "Path ID" .


###  urn:gs1:std:gdsn:semanticResourceUrn
gdsn:semanticResourceUrn rdf:type owl:AnnotationProperty ;
                         rdfs:comment "GDD semantic resource identifier." ;
                         rdfs:label "Semantic resource URN" .


###  urn:gs1:std:gdsn:sourceId
gdsn:sourceId rdf:type owl:AnnotationProperty ;
              rdfs:comment "Original UML or code-value numeric identifier." ;
              rdfs:label "Source ID" .


###  urn:gs1:std:gdsn:sourceType
gdsn:sourceType rdf:type owl:AnnotationProperty ;
                rdfs:comment "Original UML type code or source category." ;
                rdfs:label "Source type" .


###  urn:gs1:std:gdsn:targetMarket
gdsn:targetMarket rdf:type owl:AnnotationProperty ;
                  rdfs:comment "Source target-market marker." ;
                  rdfs:label "Target market" .


###  urn:gs1:std:gdsn:validationRules
gdsn:validationRules rdf:type owl:AnnotationProperty ;
                     rdfs:comment "Source validation rules text." ;
                     rdfs:label "Validation rules" .


###  urn:gs1:std:gdsn:xPath
gdsn:xPath rdf:type owl:AnnotationProperty ;
           rdfs:comment "XML XPath from gdsn_instances.json." ;
           rdfs:label "XPath" .


###  urn:gs1:std:gpc:active
gpc:active rdf:type owl:AnnotationProperty ;
           rdfs:comment "GPC active status." ;
           rdfs:label "GPC active" .


###  urn:gs1:std:gpc:contextCode
gpc:contextCode rdf:type owl:AnnotationProperty ;
                rdfs:comment "GPC context code associated with a brick." ;
                rdfs:label "GPC context code" .


###  urn:gs1:std:gpc:level
gpc:level rdf:type owl:AnnotationProperty ;
          rdfs:comment "GPC hierarchy level." ;
          rdfs:label "GPC level" .


###  urn:iso:std:iso:3166countryName
iso3166:countryName rdf:type owl:AnnotationProperty ;
                    rdfs:comment "ISO 3166 country name." ;
                    rdfs:label "ISO 3166 country name" .


###  urn:iso:std:iso:3166numericCode
iso3166:numericCode rdf:type owl:AnnotationProperty ;
                    rdfs:comment "ISO 3166 numeric country code." ;
                    rdfs:label "ISO 3166 numeric code" .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gDay
xsd:gDay rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


###  urn:gs1:std:gdsn:c-1284986072
gdsn:c-1284986072 rdf:type rdfs:Datatype ;
                  dct:source "gdsn_classes.json" ;
                  rdfs:comment "A string of no more than 500 characters in a specified language." ;
                  rdfs:label "Description500" ;
                  gdsn:sourceId "-1284986072" ;
                  gdsn:sourceType "3" ;
                  owl:equivalentClass [ rdf:type rdfs:Datatype ;
                                        owl:onDatatype xsd:string ;
                                        owl:withRestrictions ( [ xsd:maxLength 500
                                                               ]
                                                             )
                                      ] .


###  urn:gs1:std:gdsn:c-1691173723
gdsn:c-1691173723 rdf:type rdfs:Datatype ;
                  dct:source "gdsn_classes.json" ;
                  rdfs:comment "A data type that allows for temporary attributes along with associated qualifiers (e.g. unit of measure, currency code) introduced between minor versions." ;
                  rdfs:label "CompoundStringAttributeValuePair" ;
                  gdsn:sourceId "-1691173723" ;
                  gdsn:sourceType "3" ;
                  owl:equivalentClass xsd:string .


