###  urn:gs1:std:gdsn:cv179483
gdsn:cv179483 rdf:type owl:NamedIndividual ,
                       gdsn:c112158556 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Limited Production Run by the Manufacturer/Supplier. This does not mean that retailers will order only once (not a one time buy product), retailers can order until the supplier runs out of stock. Those products are typically called one shot , limited edition." ;
