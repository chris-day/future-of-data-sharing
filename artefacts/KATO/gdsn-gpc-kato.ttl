                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Trade Item image representing the image the manufacturer is supplying to the consumer to depict the content or texture of an item. The image should be designed in such a way that the texture can be experienced by the consumer similar to stationary retail, e.g. creme, lipstick." ;
              rdfs:label "CONTENT_TEXTURE_IMAGE" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
