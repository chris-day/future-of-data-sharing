                 rdfs:comment "8AHUIT CARREFOUR CHAMPION CONTACT_GB DIA DI_PER_DI DOCKS_MARKET ED GS MARCHE_PLUS NORTE OOSHOP PRODIREST PROMOCASH PROXI PUNTO_CASH SHOPI SUPER_GB" ;
