###  urn:gs1:std:gdsn:cv180666
gdsn:cv180666 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Möbelfakta is a sustainability label for furniture. The label is owned by IVL and Trä- och Möbelföretagen (TMF). Möbelfakta works to establish harmonized requirements for furniture that ensures sustainable development, both nationally and internationally. A piece of furniture that lives up to Möbelfakta's three parts meets the market's requirements for the environment, is manufactured in accordance with ethical guidelines and complies with international requirements specifications for quality." ;
              rdfs:label "MOEBELFAKTA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.mobelfakta.se" ;
              gdsn:sourceId "180666" ;
              gdsn:sourceType "codeValue" .


