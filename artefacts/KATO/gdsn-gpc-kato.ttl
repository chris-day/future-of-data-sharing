###  urn:gs1:std:gdsn:cv179590
gdsn:cv179590 rdf:type owl:NamedIndividual ,
                       gdsn:c-1164516845 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Soft-ripened cheeses begin firm and rather chalky in texture, but are aged from the exterior inwards by exposing them to mould. The mould may be a velvety bloom of penicillium candida or P. camemberti that forms a flexible white crust and contributes to the smooth, runny, or gooey textures and more intense flavours of these aged cheeses. Brie and Camembert, the most famous of these cheeses." ;
              rdfs:label "SOFT_RIPENED_MOULD_RIND" ;
              gdsn:codeListName "SurfaceOfCheeseAtEndOfRipeningCode" ;
              gdsn:sourceId "179590" ;
              gdsn:sourceType "codeValue" .


