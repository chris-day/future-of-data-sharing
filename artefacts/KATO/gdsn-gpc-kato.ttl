###  urn:gs1:std:gdsn:cv176201
gdsn:cv176201 rdf:type owl:NamedIndividual ,
                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A label is a piece of paper, polymer, cloth, metal, or other material affixed to a container or article (or printed directly upon it), which usually carries information about the article to which it has been attached." ;
              rdfs:label "LABEL" ;
              gdsn:codeListName "PackagingFeatureCode" ;
              gdsn:sourceId "176201" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176202
gdsn:cv176202 rdf:type owl:NamedIndividual ,
                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has not a physical packaging, but is directly laser marked in the product skin." ;
              rdfs:label "LBR" ;
              gdsn:codeListName "PackagingFeatureCode" ;
              gdsn:sourceId "176202" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176203
gdsn:cv176203 rdf:type owl:NamedIndividual ,
                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In packaging, the top or bottom of a container, usually the part that closes the opening; may also be known as cap, over, or top" ;
              rdfs:label "LID" ;
              gdsn:codeListName "PackagingFeatureCode" ;
              gdsn:sourceId "176203" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176204
gdsn:cv176204 rdf:type owl:NamedIndividual ,
                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An internal chamber within a container which separates the content of the container from the walls. Inner liners provide additional isolation and protection to the content of a container. Sometimes coatings of certain materials may be applied as an alternative to inner liners." ;
              rdfs:label "LINER" ;
              gdsn:codeListName "PackagingFeatureCode" ;
              gdsn:sourceId "176204" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176205
gdsn:cv176205 rdf:type owl:NamedIndividual ,
                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A metal lid closure scored and has a tab when pulled, opens the container without dislodging the closure. The most common seal of aluminium can." ;
              rdfs:label "LOE" ;
              gdsn:codeListName "PackagingFeatureCode" ;
              gdsn:sourceId "176205" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176206
gdsn:cv176206 rdf:type owl:NamedIndividual ,
                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The LSST is a pin with a spring and a toggle lever principle, usually made of porcelain or plastic, with a sealing ring, mainly for closing bottles. Opening and closing can be done by hand as often as desired and does not require any aid such as a bottle opener. Also known as a flip-top." ;
              rdfs:label "LSST" ;
              gdsn:codeListName "PackagingFeatureCode" ;
              gdsn:sourceId "176206" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176207
gdsn:cv176207 rdf:type owl:NamedIndividual ,
                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A small indentation or raised portion on the surface of a bottle, provided as an indexing means for operations such as multi-pass decoration or labeling." ;
              rdfs:label "LUG" ;
              gdsn:codeListName "PackagingFeatureCode" ;
              gdsn:sourceId "176207" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176208
gdsn:cv176208 rdf:type owl:NamedIndividual ,
                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Product packaging suitable for its use in a microwave oven." ;
              rdfs:label "MICROWAVE_SUITABLE" ;
              gdsn:codeListName "PackagingFeatureCode" ;
              gdsn:sourceId "176208" ;
              gdsn:sourceType "codeValue" .


