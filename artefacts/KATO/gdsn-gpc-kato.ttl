###  urn:gs1:std:gdsn:a2010763404
gdsn:a2010763404 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:c897307252 ;
                 rdfs:range gdsn:c1490 ;
                 dct:source "gdsn_classAttributes.json" ;
                 rdfs:comment "The maximum diameter of the light bulb, either in 1/8 of an inch, or in millimetres, depending on the shape and the region. For example, 63 mm reflectors are designated R63, but in the US, they are known as R20 (2.5 in). However, in both regions, a PAR38 reflector is known as PAR38." ;
                 rdfs:label "lightBulbDiameterValue" ;
                 gdsn:bmsId 5464 ;
                 gdsn:originalMultiplicity "0..*" ;
                 gdsn:pathId "c71783870/c897307252/a2010763404" ;
                 gdsn:semanticResourceUrn "urn:gs1:gdd:bie:LightBulbInformation.lightBulbDiameterValue" ;
                 gdsn:sourceId "2010763404" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:lighting_device:xsd:3' and local-name()='lightingDeviceModule']/lightBulbInformation/lightBulbDiameterValue" .


###  urn:gs1:std:gdsn:a2011723467
gdsn:a2011723467 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:c1830797766 ;
                 rdfs:range gdsn:c1446 ;
                 dct:source "gdsn_classAttributes.json" ;
                 rdfs:comment "A description of any properties related to the ability of a substance to catch fire for example auto-ignition temperature, flashpoint, LEL, UEL in relation to any hazardous materials for example those regulated by ADR (European Agreement concerning the International Carriage of Dangerous Goods by Road)." ;
                 rdfs:label "flammablePropertiesDescription" ;
                 gdsn:bmsId 3234 ;
                 gdsn:originalMultiplicity "0..*" ;
                 gdsn:pathId "c230502910/c-2007711992/c1830797766/a2011723467" ;
                 gdsn:semanticResourceUrn "urn:gs1:gdd:bie:FireFightingInstructions.flammablePropertiesDescription" ;
                 gdsn:sourceId "2011723467" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:safety_data_sheet:xsd:3' and local-name()='safetyDataSheetModule']/safetyDataSheetInformation/fireFightingInstructions/flammablePropertiesDescription" .


###  urn:gs1:std:gdsn:a2023196774
gdsn:a2023196774 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:c-739610563 ;
                 rdfs:range gdsn:dt_string_MinLength1_MaxLength70 ;
                 dct:source "gdsn_classAttributes.json" ;
                 rdfs:comment "Either the Sub-Species, Variety, Sub-Variety, Form, and/or Sub-Form of an organism. All are taxonomic rank below that of species. A Sub-Species is a taxonomic rank subordinate to species. A Variety will have an appearance distinct from other varieties, but will hybridize freely with other varieties of the same species (if brought into contact). Usually varieties will be geographically separate from each other. A Sub-Variety is a subordinate variety, or a division of a variety. A Form usually designates a group with a noticeable but minor deviation. For instance, white-flowered forms of species that usually have coloured flowers can be named a \"“f. alba\"”. It is recommended to place an Abbreviation at the beginning of the text to clarify to what type the text belongs. The recommended abbreviations are: subspecies (Abbreviation not required for Animals) -– subsp or ssp varietas (variety) -– var subvarietas (subvariety) -– subvar forma (form) -– form or f subforma (subforma) -– subf" ;
                 rdfs:label "rankBelowSpecies" ;
                 gdsn:bmsId 2146 ;
                 gdsn:originalLimit "{1..70}" ;
                 gdsn:originalMultiplicity "0..1" ;
                 gdsn:pathId "c812820895/c-739610563/a2023196774" ;
                 gdsn:semanticResourceUrn "urn:gs1:gdd:bie:OrganismClassification.rankBelowSpecies" ;
                 gdsn:sourceId "2023196774" ;
                 gdsn:sourceType "attribute" ;
