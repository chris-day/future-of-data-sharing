gdsn:cv177006 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Tierschutzbund with 2 stars guarantees compliance with even higher requirements than Tierschutzbund 1 star in terms of husbandry and processing." ;
