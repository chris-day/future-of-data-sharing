###  urn:gs1:std:gdsn:cv178195
gdsn:cv178195 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the number of wires e.g. of a power cable / sheathed cable. To populate use productCharacteristicValueInteger." ;
              rdfs:label "numberOfWires" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178195" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178196
gdsn:cv178196 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Does the game provide an online multiplayer option? TRUE, FALSE, NOT_APPLICABLE, UNSPECIFIED. Use productCharacteristicValueCode to populate value." ;
              rdfs:label "onlineMultiplayerCapability" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178196" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178197
gdsn:cv178197 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Technology of the optical disk drive if one be present. Examples: CD ROM. CD RW; BD ROM. Use productCharacteristicValueString to populate value." ;
              rdfs:label "opticalDiskDriveType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178197" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178198
gdsn:cv178198 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the tint of optical lens. Examples blue, yellow, etc. Uses productCharacteristicsValueDescription." ;
              rdfs:label "opticalLensTint" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178198" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178199
gdsn:cv178199 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of optical lens in eyeglasses, sunglasses, contact lens. Examples include adaptive, polarized, etc. Uses productCharacteristicValueDescription." ;
              rdfs:label "opticalLensType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178199" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178200
gdsn:cv178200 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The maximum number of oscillations the trade item can move or swing back and forth per minute. Populate using productCharacteristicValueNumeric." ;
              rdfs:label "oscillationsPerMinuteMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178200" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178201
gdsn:cv178201 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The minimum number of oscillations the trade item can move or swing back and forth per minute. Populate using productCharacteristicValueNumeric." ;
              rdfs:label "oscillationsPerMinuteMin" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178201" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178202
gdsn:cv178202 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of heating mechanism. Example Radiant heat, Gas Burner. Uses productCharacteristicValueDescription." ;
              rdfs:label "outdoorHeatingType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178202" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178203
gdsn:cv178203 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximal payload. Payload is the carrying capacity of an aircraft or launch vehicle, usually measured in terms of weight. Depending on the nature of the flight or mission, the payload of a vehicle may include cargo, passengers, flight crew, munitions, scientific instruments or experiments, or other equipment. Extra fuel, when optionally carried, is also considered part of the payload. In a commercial context (i.e., an airline or air freight carrier), payload may refer only to revenue-generating cargo or paying passengers. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "payloadMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178203" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178204
gdsn:cv178204 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The fragrance or scent of a perfume, cologne, eau de toilette, etc., such as FLORAL, ORIENTAL, SPICY, WOODY, etc., see Local Code List website under GS1 Global Office section for Perfume Fragrance Code." ;
              rdfs:label "perfumeFragranceCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178204" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178205
gdsn:cv178205 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Type of health prevention or conditions that the item is intended to address concerning the health and well being of a pet. Uses productCharacteristicValueDescription." ;
              rdfs:label "petFoodHealthPrevention" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178205" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178206
gdsn:cv178206 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Air compressors come in various types such as pancake, Hot dog, Twin Tank. Allows the ability to explain the air compressor type. Use productCharacteristicValueDescription." ;
              rdfs:label "portableAirCompressorType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178206" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178207
gdsn:cv178207 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Powertrain in a vehicle is composed of everything that makes the vehicle move. This includes everything from the engine to the transmission to all the parts that allow the power from the engine to get to the wheels. Example 4 Stroke Diesel Engine; Gasoline Hybrid; Electric. Use productCharacteristicValueDescription to populate." ;
              rdfs:label "powertrainType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178207" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178208
gdsn:cv178208 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A set amount of time paid beforehand for usage of the trade item. Examples cell phones and games come with pre paid time to use/play a certain amount of time. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "prepaidTime" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178208" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178209
gdsn:cv178209 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Commonly used retail name for the central processing unit. Examples: Celeron; Intel Core i7; Snapdragon; ARM Cortex A7. Use productCharacteristicValueString to populate value." ;
              rdfs:label "processorBrandType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178209" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178210
gdsn:cv178210 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Operational frequency of the central processing unit. Use productCharacteristicValueIMeasurement to populate value." ;
              rdfs:label "processorSpeed" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178210" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178211
gdsn:cv178211 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the amount of seeds for fresh fruits and vegetables e.g. for water melons, citrus fruits. Use productCharacteristicValueCode to populate. Values are available in GS1 code list: ProduceSeedPresenceCode." ;
              rdfs:label "produceSeedPresenceTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178211" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178212
gdsn:cv178212 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Taxon that has been selected for a particular attribute or combination of attributes, and is clearly distinct, uniform, and stable in its characteristics and when propagated by appropriate means, retains those characteristics. In some particular cases, the term “cultivar” is equivalent to “variety” which is a single botanic taxon of the lowest known rank. Varieties are recognised for their unique characteristics by authorities for variety protection. They may have been derived by mutation or hybridization" ;
              rdfs:label "produceVarietyType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178212" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178213
gdsn:cv178213 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A machine that produces thrust to push an object forward. On airplanes, thrust is usually generated through some application of Newton's third law of action and reaction. Examples: T-V-Drive Cummins QSB 425 Diesels; 160mm jet pump, axial-flow, single stage. Populate using productCharacteristicValueString." ;
              rdfs:label "propulsionSystemType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178213" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178214
gdsn:cv178214 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The distinction addresses whether a text discusses the world of the imagination FICTION or the real world NON_FICTION. Use productCharateristicCode to populate with values from PublicationContentTypeCode." ;
              rdfs:label "publicationTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178214" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178215
gdsn:cv178215 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of brakes that recommended. For the rear of vehicle. example:11.3\" discs with single piston callipers; Single Brembo 220mm disc & Brembo 2 piston calliper. Brembo rear brake master cylinder. Populate using productCharacteristicValueDescription." ;
              rdfs:label "rearBrakesType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178215" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178216
gdsn:cv178216 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of suspension that recommended. For the rear of vehicle. example: Independent short-and-long arm (SLA) with one upper and two lower control arms; double wishbone with pillow ball lateral link bushing, stabilizer bar; Ohlin's twin shocks with remote reservoir - adjustable ride height, preload and compression. Populate using productCharacteristicValueDescription." ;
              rdfs:label "rearSuspensionType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178216" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178217
gdsn:cv178217 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The recording technologies compatible with the item. Examples: DVD-R; DVD-RW; motion JPEG; Blu-Ray; MPEG-1. Use productCharacteristicValueString to populate value." ;
              rdfs:label "recordableMediaFormat" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178217" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178218
gdsn:cv178218 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum Revolutions per minute (rpm). Revolutions per minute (abbreviated rps, RPM, rev/min, r/min) is a measure of the frequency of rotation, specifically the number of rotations around a fixed axis in one minute. It is used as a measure of rotational speed of a mechanical component. Populate using productCharacteristicValueInteger." ;
              rdfs:label "revolutionsPerMinuteMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178218" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178219
gdsn:cv178219 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the minimum Revolutions per minute (rpm). Revolutions per minute (abbreviated rps, RPM, rev/min, r/min) is a measure of the frequency of rotation, specifically the number of rotations around a fixed axis in one minute. It is used as a measure of rotational speed of a mechanical component. Populate using productCharacteristicValueInteger." ;
              rdfs:label "revolutionsPerMinuteMin" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178219" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178220
gdsn:cv178220 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Run flat tires are tires on which you can continue driving after a puncture so you can take time get to an auto shop or find a safe, level area to change your tire. TRUE, FALSE, UNSPECIFIED, NOT_APPLICABLE. Populate using productCharacteristicValueCode." ;
              rdfs:label "runFlatTyre" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178220" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178221
gdsn:cv178221 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The number of people that can be accommodated by the available seats of an item. Use productCharacteristicValueNumeric to populate value." ;
              rdfs:label "seatingCapacity" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178221" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178222
gdsn:cv178222 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A camera’s sensor is a highly sophisticated piece of component that captures light through small pixels (also called photosites) and turns them into a digital signal. Examples include: 1/2.3 inch; 35.8 millimetre x 23.9 millimetre; 0.43 inch; 1.69 inch. Use productCharacteristicValueString to populate." ;
              rdfs:label "sensorResolution" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178222" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178223
gdsn:cv178223 rdf:type owl:NamedIndividual ,
