              rdfs:comment "PALPA Standas for Suomen Palautuspakkaus Oy. PALPA administers the recycling of beverage containes and promotes recycling in Finland. EKO-pullo is one of the recycling systems PALPA is administer. This is a recycling system used in Finland." ;
              rdfs:label "EKO_PULLO" ;
              gdsn:codeListName "PackagingRecyclingSchemeCode" ;
              gdsn:sourceId "177261" ;
              gdsn:sourceType "codeValue" .


