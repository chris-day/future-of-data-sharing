###  urn:gs1:std:gdsn:cv172251
gdsn:cv172251 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product out of its packaging (i.e., the product as it first arrives “out of packaging” not how it appears after it has been processed or prepared)." ;
              rdfs:label "0" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172251" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172252
gdsn:cv172252 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product in its packaging." ;
              rdfs:label "1" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172252" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172253
gdsn:cv172253 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product in its case as it would appear to the operator upon delivery." ;
              rdfs:label "A" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172253" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172254
gdsn:cv172254 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product as it would appear inside its packaging inside the case." ;
              rdfs:label "B" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172254" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172255
gdsn:cv172255 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which has not been cooked or processed or that needs to be cooked or further prepared." ;
              rdfs:label "C" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172255" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172256
gdsn:cv172256 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which has been taken from a raw or uncooked state to a cooked state according to the appropriate method of preparation (e.g., baked, fried, grilled or boiled)." ;
              rdfs:label "D" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172256" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172257
gdsn:cv172257 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which is prepared food arranged simply on a serving plate, dish or bowl for better visibility. May include an additional step, such as garnishing, icing, seasoning or other enhancement." ;
              rdfs:label "E" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172257" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172258
gdsn:cv172258 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which is carefully and artfully arranged for an attractive visual presentation, and designed to suggest the taste, aroma and appeal of the actual dish. May include complementary items (e.g., an entrée and sides) to present the impression of a complete meal. May also include an additional step, such as garnishing, icing, seasoning or other enhancement. May be presented with different backgrounds and at different angles." ;
              rdfs:label "F" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172258" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172259
gdsn:cv172259 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which has been arranged for display in such a way as to provide clear visibility. The product may be propped up if necessary for optimum viewing, but it should not be held or used in any way by a person." ;
              rdfs:label "G" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172259" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172260
gdsn:cv172260 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which has been held out for display by one hand or a pair of hands. When relevant, proper grip should be demonstrated. Apart from the hands and forearms, no part of the person holding the item should be visible." ;
              rdfs:label "H" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172260" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172261
gdsn:cv172261 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product, such as a protective item or article of clothing, which is worn by a person. The complete product should be visible inside the frame, but the individual wearing it should be cropped out as much as possible." ;
              rdfs:label "J" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172261" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172262
gdsn:cv172262 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product as it is meant to be used in its appropriate environment. Small utensils may be held in a hand or hands and used for their intended purpose." ;
              rdfs:label "K" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172262" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172263
gdsn:cv172263 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which is a number of related products (e.g., matched sets, place settings) arranged together in a single picture." ;
              rdfs:label "L" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172263" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172264
gdsn:cv172264 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which is a case, flaps open, that shows how the product(s) would look when an operator receives the product and opens the case." ;
              rdfs:label "M" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172264" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172265
gdsn:cv172265 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image state is not applicable for this image." ;
              rdfs:label "NA" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172265" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172266
gdsn:cv172266 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which is a pallet/display." ;
              rdfs:label "P" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "172266" ;
              gdsn:sourceType "codeValue" .


