           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:TradeItemDisposalInformation.isTradeItemConsumerUpgradeableOrMaintainable" ;
           gdsn:sourceId "6928" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:trade_item_disposal_information:xsd:3' and local-name()='tradeItemDisposalInformationModule']/tradeItemDisposalInformation/isTradeItemConsumerUpgradeableOrMaintainable" .


