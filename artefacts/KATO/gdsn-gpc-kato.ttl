###  urn:gs1:std:gdsn:cv172880
gdsn:cv172880 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A count of attenuation steps or dilution levels representing the homeopathic potency of a substance using the Hahnemannian (CH) method of attenuation; commonly denoted as CH1, CH2, CH3, etc. Each centesimal attenuation step represents one part source material combined with 99 parts dilution medium; commonly denoted as C1, C2, C3, etc." ;
              rdfs:label "X_CHD" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172880" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172881
