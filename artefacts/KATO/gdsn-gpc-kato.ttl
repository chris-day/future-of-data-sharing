###  urn:gs1:std:gdsn:cv169932
gdsn:cv169932 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Stout is a dark, top-fermented beer with a number of variations, including dry stout, Baltic porter, milk stout, and imperial stout. Milk stout (also called sweet stout or cream stout) is a stout containing lactose, a sugar derived from milk. Because lactose cannot be fermented by beer yeast, it adds sweetness and body to the finished beer." ;
              rdfs:label "SWEET_STOUT_OR_CREAM_STOUT" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169932" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169933
gdsn:cv169933 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Stout is a dark, top-fermented beer with a number of variations, including dry stout, Baltic porter, milk stout, and imperial stout. Tropical stout is a stout containing tropical flavouruings." ;
              rdfs:label "TROPICAL_STOUT" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169933" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169934
gdsn:cv169934 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Distinctly amber coloured Vienna lager is a reddish-brown or copper-coloured beer with medium body and slight malt sweetness. The malt aroma and flavour may have a toasted character." ;
              rdfs:label "VIENNA_LAGER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169934" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169935
gdsn:cv169935 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vienna Style Lager is a type of beer, originally crafted in Vienna, conditioned at low temperatures. Lagers can be pale, amber, or dark. Pale lager is the most widely consumed and commercially available style of beer." ;
              rdfs:label "VIENNA_STYLE_LAGER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169935" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169936
gdsn:cv169936 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Wee Heavy is a version of Scotch Ale. Scotch ale tends toward sweetness from residual sugars, malty notes, and a full body." ;
              rdfs:label "WEE_HEAVY" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169936" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169937
gdsn:cv169937 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Weizenbier or Hefeweizen or Weißbier is a beer, traditionally from Bavaria, in which a significant proportion of malted barley is replaced with malted wheat." ;
              rdfs:label "WEISSBIER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
