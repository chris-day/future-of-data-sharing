              rdfs:comment "The catalogue item that was never manufactured has been removed from the Global Registry." ;
              rdfs:label "CANCELED" ;
              gdsn:codeListName "RegistryCatalogueItemStateEnumeration" ;
              gdsn:sourceId "178626" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178627
gdsn:cv178627 rdf:type owl:NamedIndividual ,
                       gdsn:c1826432850 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The catalogue item that has been in the supply chain has been removed from the supply chain." ;
