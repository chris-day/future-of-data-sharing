gdsn:cv168841 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Champagne is a French sparkling wine. Many people use the term Champagne as a generic term for sparkling wine but in the EU and some other countries it is illegal to label any product Champagne unless it comes from the region Champagne and is produced under the rules of the appellation." ;
              rdfs:label "SPARKLING_WINE_CHAMPAGNE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168841" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168842
gdsn:cv168842 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Clairette de Die AOC is a natural sparkling white wine from the Rhône Valley region in France. It is made from the Muscat Blanc à Petits Grains (75% minimum) and Clairette (25% maximum) grape varieties." ;
              rdfs:label "SPARKLING_WINE_CLAIRETTE_DE_DIE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168842" ;
              gdsn:sourceType "codeValue" .


