                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A symbol to indicate the product is safe to teeth - non-cariogenic and non-erosive by the Institutes licensed by Toothfriendly International." ;
