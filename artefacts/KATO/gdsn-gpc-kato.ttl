###  urn:gs1:std:gdsn:cv172273
gdsn:cv172273 rdf:type owl:NamedIndividual ,
                       gdsn:c2034116970 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A system for collecting information and producing statistics on the trade in goods between countries of the European Union (EU)." ;
              rdfs:label "INTRASTAT" ;
