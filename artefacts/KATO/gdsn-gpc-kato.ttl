###  urn:gs1:std:gdsn:cv174065
gdsn:cv174065 rdf:type owl:NamedIndividual ,
                       gdsn:c459407133 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Food and Nutrition Service (FNS) is an agency of USDA’s Food, Nutrition, and Consumer Services. FNS works to end hunger and obesity through the administration of 15 federal nutrition assistance programs including WIC, Supplemental Nutrition Assistance Program (SNAP), and school meals. In partnership with State and Tribal governments, FNS programs serve one in four Americans during the course of a year. Working with public, private and non-profit partners, the mission is to increase food security and reduce hunger by providing children and low-income people access to food, a healthful diet and nutrition education in a way that supports American agriculture and inspires public confidence. No American should have to go hungry. http://www.fns.usda.gov/" ;
              rdfs:label "1" ;
              gdsn:codeListName "NutritionAgencyCode" ;
              gdsn:sourceId "174065" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174066
gdsn:cv174066 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Acetone is the trivial name for the organic chemical compound propanone or dimethyl ketone." ;
              rdfs:label "ACETONE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174066" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174067
gdsn:cv174067 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Substances added to foods to prevent spoilage, improve appearance, enhance flavor or texture, or increase nutritional value." ;
              rdfs:label "ADDITIVES" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174067" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174068
gdsn:cv174068 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Syrup from the Agave plant." ;
              rdfs:label "AGAVE_SYRUP" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174068" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174069
gdsn:cv174069 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Alcohol" ;
              rdfs:label "ALCOHOL" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174069" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174070
gdsn:cv174070 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The almond is a species of tree native to the Middle East and South Asia. \"Almond\" is also the name of the edible and widely cultivated seed of this tree. Within the genus Prunus, it is classified with the peach in the subgenus Amygdalus, distinguished from the other subgenera by the corrugated shell (endocarp) surrounding the seed. The fruit of the almond is a drupe, consisting of an outer hull and a hard shell with the seed (which is not a true nut) inside." ;
              rdfs:label "ALMONDS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174070" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174071
gdsn:cv174071 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Aluminium-based compounds are the active ingredients in antiperspirants. They block the sweat glands to keep sweat from getting to the skin's surface." ;
              rdfs:label "ALUMINIUM" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174071" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174072
gdsn:cv174072 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A group of organic molecules that consist of a basic amino group, an acidic carboxyl group, and a unique organic side chain. Building blocks of protein." ;
              rdfs:label "AMINO_ACIDS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174072" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174073
gdsn:cv174073 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Compound of nitrogen and hydrogen with the formula NH₃. A stable binary hydride, and the simplest pnictogen hydride, ammonia is a colourless gas with a characteristic pungent smell." ;
              rdfs:label "AMMONIA" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174073" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174074
gdsn:cv174074 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ancient grains are considered to be uncommon grains cultivated before modern times. They are high in protein, calcium and magnesium. Some ancient grains include polenta, farro, spelt, millet, barley, oats, sorghum and quinoa." ;
              rdfs:label "ANCIENT_GRAINS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174074" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174075
gdsn:cv174075 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
