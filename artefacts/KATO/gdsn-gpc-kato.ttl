###  urn:gs1:std:gdsn:cv178562
gdsn:cv178562 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The file link is to a drug fact panel of the trade item. A drug fact label usually contains such items as active ingredients, uses, warnings, purpose, directions, etc." ;
              rdfs:label "DRUG_FACT_LABEL" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178562" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178563
gdsn:cv178563 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Link to a file containing the details of a product with its environmental impact and performance. E.g. Beelong.ch Eco-Score Fact Sheet." ;
              rdfs:label "ECOLOGICAL_FACT_SHEET" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178563" ;
