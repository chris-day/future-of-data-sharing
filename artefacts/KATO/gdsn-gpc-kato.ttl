              gdsn:codeListName "SustainabilityFeatureCode" ;
              gdsn:sourceId "179606" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179607
gdsn:cv179607 rdf:type owl:NamedIndividual ,
                       gdsn:c-839280846 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The trade item is supporting circular economy, a system of production and consumption that tackles global challenges like climate change, biodiversity loss, waste, and pollution by involving reuse, repair, refurbish and recycle of existing materials and products for as long as possible." ;
              rdfs:label "CIRCULAR_ECONOMY" ;
              gdsn:codeListName "SustainabilityFeatureCode" ;
              gdsn:sourceId "179607" ;
              gdsn:sourceType "codeValue" .


