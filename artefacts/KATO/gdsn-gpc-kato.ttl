                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{1..255}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "360" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator." .


