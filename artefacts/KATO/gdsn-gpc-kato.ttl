###  urn:gs1:std:gdsn:cv180723
gdsn:cv180723 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Demain la Terre is an association under the law of 1901 of producers of fresh or processed fruits and vegetables, gathered around a common project of sustainable development." ;
              rdfs:label "DEMAIN_LA_TERRE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://demainlaterre.org" ;
