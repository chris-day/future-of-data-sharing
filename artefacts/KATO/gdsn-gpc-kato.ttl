###  urn:gs1:std:gdsn:cv174890
gdsn:cv174890 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The claim \"Canadian\" is considered to be the same as a \"Product of Canada\" claim. As such, all or virtually all major ingredients, processing, and labour used to make the food product must be Canadian. For example, the claim \"Canadian\" on a container of frozen lasagna would mean that the food meets the \"Product of Canada\" criteria" ;
              rdfs:label "CA_MUSTARD_SEEDS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "174890" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174891
gdsn:cv174891 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "When the claim \"100% Canadian\" is used on a label, the food or ingredient to which the claim applies must be entirely Canadian rather than \"all or virtually all\" Canadian" ;
              rdfs:label "CA_OATS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "174891" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174892
gdsn:cv174892 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "To describe a food which has been intirely prepared in Canada" ;
              rdfs:label "CA_PREPARED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "174892" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174893
gdsn:cv174893 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "To describe a food which has been entirely processed in Canada" ;
              rdfs:label "CA_PROCESSED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "174893" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174894
gdsn:cv174894 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A food product may use the claim \"Product of Canada\" when all or virtually all major ingredients, processing, and labour used to make the food product are Canadian. This means that all the significant ingredients in a food product are Canadian in origin and that non-Canadian material is negligible." ;
              rdfs:label "CA_PRODUCT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5" ;
              gdsn:sourceId "174894" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174895
gdsn:cv174895 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim such as \"Proudly Made in Canada\" would need a qualifying statement if the product contains imported ingredients as this claim includes the phrase \"Made in Canada" ;
              rdfs:label "CA_PROUD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5" ;
              gdsn:sourceId "174895" ;
              gdsn:sourceType "codeValue" .


