###  urn:gs1:std:gdsn:cv178233
gdsn:cv178233 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Type of gemstone cut, as distinct from shape. Examples: brilliant cut; hearts and arrows; round brilliant; ideal brilliant cut; ideal cut; American standard; practical fine cut; Scandinavian standard; fancy cut; asscher cut; baguette cut; cushion cut; emerald cut; heart cut; marquis cut; oval cut; pear cut; princess cut; radiant cut. Use ProductCharacteristicValueDescription to populate." ;
              rdfs:label "stoneCut" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178233" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178234
gdsn:cv178234 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Type of setting for the stone. Use productCharacteristicValueNumeric to populate value." ;
              rdfs:label "stoneSetting" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178234" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178235
gdsn:cv178235 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
