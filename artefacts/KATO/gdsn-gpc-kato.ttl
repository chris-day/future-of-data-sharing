                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Marine Conservation Society is a UK-based not for profit organisation, it consists of a community of ocean lovers all working together towards the vision of a sea full of life, where nature flourishes and people thrive." ;
