###  urn:gs1:std:gdsn:cv181603
gdsn:cv181603 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Organotin substances (organotins) are tin compounds having 1, 2, 3 or 4 organic groups attached and are designated as mono-, di-, tri- or tetra-organotin depending on the number of tin-carbon bonds in the molecule. E.g., tributyltin, dibutyltin." ;
              rdfs:label "ORGANOTIN" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "181603" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181604
gdsn:cv181604 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An organic compound that has a high vapor pressure at room temperature and low water solubility." ;
              rdfs:label "VOC" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "181604" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181605
gdsn:cv181605 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Zeolite is a group of porous minerals composed of aluminum silicates. Zeolites are used in industry for applications such as filtration, odour removal, molecular sieves, and water softening." ;
              rdfs:label "ZEOLITE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "181605" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181606
gdsn:cv181606 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348061 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a product does not contain (verifiably) the substance in the ClaimElementCode. Note the amount that determines containment or lack of containment is based on target market regulations." ;
              rdfs:label "NO" ;
              gdsn:codeListName "ClaimTypeCode" ;
              gdsn:sourceId "181606" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181607
gdsn:cv181607 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348105 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The EBC colour scale is a system used to measure and describe the colour of beer and wort. It is standardized by the European Brewery Convention and is widely used in Europe and internationally. The EBC value represents the depth of colour, with lower values indicating paler beers (like lagers) and higher values indicating darker beers (like stouts or porters)." ;
              rdfs:label "14" ;
              gdsn:codeListName "ColourCodeListCode" ;
              gdsn:sourceId "181607" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181608
gdsn:cv181608 rdf:type owl:NamedIndividual ,
                       gdsn:c831288 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Active Matrix Organic Light Emitting Diode (AMOLED) is an advanced display technology where each pixel emits its own light without the need for backlighting." ;
              rdfs:label "AMOLED" ;
              gdsn:codeListName "DisplayScreenTypeCode" ;
              gdsn:sourceId "181608" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181609
gdsn:cv181609 rdf:type owl:NamedIndividual ,
                       gdsn:c831288 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Display method where an image is projected onto a screen from the front, typically using a projector placed in front of the viewing surface. It is commonly used in home theaters, classrooms, and cinemas." ;
              rdfs:label "FRONT_PROJECTION" ;
              gdsn:codeListName "DisplayScreenTypeCode" ;
              gdsn:sourceId "181609" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181610
gdsn:cv181610 rdf:type owl:NamedIndividual ,
                       gdsn:c831288 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Quantum dot is a display technology that uses quantum dots to enhance colour and brightness. Unlike OLED, quantum dot screens still require a backlight (usually LED), but they offer high brightness, vibrant colours, and long lifespan. Also known as Quantum Dot Light Emitting Diode (QLED), Triluminos, Quantum Color, or Quantum Nano-Emitting Diode (QNED)." ;
              rdfs:label "QUANTUM_DOT" ;
              gdsn:codeListName "DisplayScreenTypeCode" ;
              gdsn:sourceId "181610" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181611
gdsn:cv181611 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348233 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product is designed to contribute to hygiene or odour reduction by inhibiting the growth of bacteria on its surface or on the applied surface." ;
              rdfs:label "ANTIBACTERIAL" ;
              gdsn:codeListName "FeatureCode" ;
              gdsn:sourceId "181611" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181612
gdsn:cv181612 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348333 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Permanent dyeing that does not wash out. Penetrates deep into the hair structure and changes the natural pigments through chemical reactions. This often uses ammonia or a similar alkalizing agent that opens the cuticle and hydrogen peroxide to lighten or prepare the hair. Does not wash out, needs to grow out or be refreshed by re-dyeing. E.g., classic hair dyes for a permanent change." ;
              rdfs:label "PERMANENT" ;
              gdsn:codeListName "HairColourPermanenceLevelCode" ;
              gdsn:sourceId "181612" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181613
gdsn:cv181613 rdf:type owl:NamedIndividual ,
                       gdsn:c1120209087 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A husbandry system where animals have access to different climate zones." ;
              rdfs:label "FRESH_AIR_BARN" ;
              gdsn:codeListName "GrowingMethodCode" ;
              gdsn:sourceId "181613" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181614
gdsn:cv181614 rdf:type owl:NamedIndividual ,
                       gdsn:c1120209087 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A husbandry system where animals are housed in a barn (indoor) with more space per animal than the minimum legal requirements. The determination of this is made by the supplier and may be subject to target market regulations or trade organization guidelines." ;
              rdfs:label "INDOOR_MORE_PLACE" ;
              gdsn:codeListName "GrowingMethodCode" ;
              gdsn:sourceId "181614" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181615
gdsn:cv181615 rdf:type owl:NamedIndividual ,
                       gdsn:c1120209087 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A specific husbandry system is not indicated for the ingredients of animal origin contained in the product." ;
              rdfs:label "NON_LABELLED_PORTION" ;
              gdsn:codeListName "GrowingMethodCode" ;
              gdsn:sourceId "181615" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181616
gdsn:cv181616 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348053 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The image is of the product which has the supporting shape/form (for example a model, mannequin, hanger) removed to give the product a 3-D look." ;
              rdfs:label "Q" ;
              gdsn:codeListName "ImageStateCode" ;
              gdsn:sourceId "181616" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181617
gdsn:cv181617 rdf:type owl:NamedIndividual ,
                       gdsn:c-1992297661 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The code applicable for standard devices that are neither systems nor procedure packs (in accordance with the Art. 22 MDR), nor kits (only applicable in case of IVDR Art. 2)." ;
