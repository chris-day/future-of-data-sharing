              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Molybdenum" ;
              rdfs:label "MOLYBDENUM" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174195" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174196
gdsn:cv174196 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Mono-protein is particularly effective for treating allergies and intolerances. Most of the allergens are generated by proteins, so the single source protein foods can help limit the exposure to potential allergens. A single source protein food can be used as a diagnostic method or as a long-term treatment." ;
              rdfs:label "MONO_PROTEIN" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174196" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174197
gdsn:cv174197 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
