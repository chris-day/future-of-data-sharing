                       gdsn:c223477456 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A business message used to register basic Catalogue Item information from the Data Source to the GS1 Global Registry via the Source Data Pool within the GDSN (Global Data Synchronisation Network)." ;
              rdfs:label "51" ;
              gdsn:codeListName "MessageCapabilityCode" ;
              gdsn:sourceId "172926" ;
