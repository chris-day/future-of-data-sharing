###  urn:gs1:std:gdsn:cv180434
gdsn:cv180434 rdf:type owl:NamedIndividual ,
                       gdsn:c715725203 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The packaging which is designed and intended to be secure against the entry of microorganisms and to maintain the safety and quality of its contents after processing." ;
              rdfs:label "HERMETICALLY_SEALED" ;
              gdsn:codeListName "PackagingFunctionCode" ;
              gdsn:sourceId "180434" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180435
gdsn:cv180435 rdf:type owl:NamedIndividual ,
                       gdsn:c715725203 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An unopened package which cannot be opened without breaking or damaging such package or any seal, adhesive label or other part of or attachment to such package. Most commonly a sealed package is not air tight." ;
              rdfs:label "SEALED" ;
              gdsn:codeListName "PackagingFunctionCode" ;
              gdsn:sourceId "180435" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180436
gdsn:cv180436 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Allergy UK Seal of Approval is a globally recognised product endorsement. This Seal of Approval is an endorsement of products which have been independently scientifically tested and proven to reduce or remove allergens from the indoor environment." ;
              rdfs:label "ALLERGY_UK_SEAL_APPROVAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.allergyresearch.co.uk/seal-of-approval/" ;
              gdsn:sourceId "180436" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180437
gdsn:cv180437 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "National BIO mark of the Slovak Republic (Naturalis SK). The main subjects of business are control and certification in organic agricultural production (EPV)." ;
              rdfs:label "BIO_SLOVAK_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.naturalis.sk" ;
              gdsn:sourceId "180437" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180438
gdsn:cv180438 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The national environmental labelling scheme, the Ministry of the Environment of the Slovak Republic awards the national environmental label \"Environmentally suitable product\" (EVP) to products and services that have met strict environmental criteria." ;
              rdfs:label "ECO_SLOVAK_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:sourceId "180438" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180439
gdsn:cv180439 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ECOSMETICA QUALITY certifications protect consumers concernes about safety and efficacy of cosmetics products. The Standard sets criteria for companies to ensure the use of vegetable substances and natural processes to create “natural” cosmetics. The certification confirms adherence to these criteria and and that the cosmetic is compliant following control from Ecogruppo Italia." ;
              rdfs:label "ECOSMETICA_NATURAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ecogruppoitalia.it/ecosmetica" ;
              gdsn:sourceId "180439" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180440
gdsn:cv180440 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ECOSMETICA QUALITY certifications protect consumers concernes about safety and efficacy of cosmetics products. The Standard sets criteria for companies to ensure the use of vegetable substances and natural processes to create “organic” cosmetics. The certification confirms adherence to these criteria and and that the cosmetic is compliant following control from Ecogruppo Italia." ;
              rdfs:label "ECOSMETICA_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ecogruppoitalia.it/ecosmetica" ;
              gdsn:sourceId "180440" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180441
gdsn:cv180441 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Based on a sense of environmental responsibility, scientific discipline and sensitivity to consumer wishes, BASF has introduced a methodology to assess the environmental impact of sunscreen formulations. The environmental impact of the selected combination of UV-filters (ultra-violet filters) is calculated by EcoSun Pass’ evaluation parameters. No UV-filters known to harm coral reefs or on EU’s priority list for potential endocrine disrupters are allowed." ;
              rdfs:label "ECOSUN_PASS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.personal-care.basf.com/ecosunpass" ;
              gdsn:sourceId "180441" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180442
gdsn:cv180442 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The vegan V-Label with the additional statement “von Natur aus” (naturally vegan / vegan by nature) is a recognised, registered label which can be applied to vegan products that are not or only minimally processed and are vegan due to their natural properties." ;
              rdfs:label "EUROPEAN_V_LABEL_NATURALLY_VEGAN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.v-label.eu/de/das-v-label" ;
              gdsn:sourceId "180442" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180443
gdsn:cv180443 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The GlobalG.A.P. Number (GGN) can only be used on consumer labels for GlobalG.A.P. certified products under the Integrated Farm Assurance (IFA) Standards for: aquaculture; flowers and ornamental plants (floriculture); fruit and vegetables." ;
              rdfs:label "GGN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.ggn.org" ;
              gdsn:sourceId "180443" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180444
gdsn:cv180444 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Green Experience is a Coldiretti Cuneo project, aimed at creating a network of Piedmontese producers who practice green, rethought and sustainable viticulture. It is presented to consumers with two specifications and two respective alternative brands (blue butterfly, for integrated production, and gold butterfly, for organic), 10 rules to follow and a unique future-oriented collaboration project." ;
              rdfs:label "GREEN_EXPERIENCE_ITALY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.thegreenexperience.it" ;
              gdsn:sourceId "180444" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180445
gdsn:cv180445 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Halal certification of Islamic Cultural Center of Scandinavia." ;
              rdfs:label "HALAL_ISLAMIC_CULTURAL_CENTER_OF_SCANDINAVIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.islamiccc.net/" ;
              gdsn:sourceId "180445" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180446
gdsn:cv180446 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ISA (Islamic Services of America) is a recognized global leader in Halal Certification and Auditing Services with a team of regional offices, professionals, and industry leaders throughout the United States, Canada, and Mexico. ISA confidently provides any organization from multinationals, SME’s, and even startups, a level of integrity and service in Halal certification ensuring a comprehensive approach and plan for all your Halal needs." ;
              rdfs:label "ISA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.isahalal.com" ;
              gdsn:sourceId "180446" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180447
gdsn:cv180447 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "KVH (Kashrus Vaad Harabonim) Kosher, a premier authority on Kashrus, brings together consumers, retailers and manufacturers, to make Kosher accessible in the Greater Boston area, the New England region and across the globe." ;
              rdfs:label "KVH_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.https://kvhkosher.org" ;
              gdsn:sourceId "180447" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180448
gdsn:cv180448 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"Made in Slovakia\" logo can only be used by companies that carry out production activities on the territory of the Slovak Republic, are registered in the GS1 Slovakia association and have an application for the use of the logo on specific products approved by the association. The \"Made in Slovakia\" logo is protected by copyright law." ;
              rdfs:label "MADE_IN_SLOVAKIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.vns.sk/" ;
              gdsn:sourceId "180448" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180449
gdsn:cv180449 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Based in the North West of England, the MK (Manchester Kosher) has dedicated teams travelling the world, certifying manufacturers of raw material, ingredients and finished retail goods to the highest standards of Kosher. The MK Kosher certification services is a division of the Manchester beis din, otherwise known as Badatz Manchester, the largest Jewish court of law in the North West of England." ;
              rdfs:label "MANCHESTER_BEIS_DIN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.mbd.org.uk/" ;
              gdsn:sourceId "180449" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180450
gdsn:cv180450 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The quality mark is the property of the Ministry of Agriculture and Rural Development of the Slovak Republic. The priority of the program was to make domestic quality food products and agricultural products visible and thus their competitiveness on the domestic market. The quality mark is awarded level 1." ;
              rdfs:label "QUALITY_LABEL_SLOVAK_1" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:sourceId "180450" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180451
gdsn:cv180451 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The quality mark is the property of the Ministry of Agriculture and Rural Development of the Slovak Republic. The priority of the program was to make domestic quality food products and agricultural products visible and thus their competitiveness on the domestic market. The quality mark is awarded level 2." ;
              rdfs:label "QUALITY_LABEL_SLOVAK_2" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:sourceId "180451" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180452
gdsn:cv180452 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The SRP-Verified (Sustainable Rice Platform) label represents the integrity of claims to sustainable best practices according to the SRP Standard, as verified through the SRP Assurance Scheme. Sustainable Rice Platform is a global alliance aiming to transform the rice sector through improving smallholder livelihoods, reducing environmental impact, and providing a sustainable supply of rice." ;
              rdfs:label "SRP_VERIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://sustainablerice.org/ https://sustainablerice.org/wp-content/uploads/2022/12/601-SRP-Brand-Manual_update-Apr-2022.pdf" ;
              gdsn:sourceId "180452" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180453
gdsn:cv180453 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "YCOA (Yolo County Agricultural) Commissioner's office is one of the few counties in California to offer an organic certification program to qualified agricultural producers and handlers. The certification standards used by YCOA are the USDA's National Organic Program (NOP). YCOA is a USDA accredited certification agency." ;
              rdfs:label "YCOA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.yolocounty.org/government/general-government-departments/agriculture-cooperative-extension/agriculture-and-weights-measures/yolo-certified-organic-agriculture" ;
              gdsn:sourceId "180453" ;
              gdsn:sourceType "codeValue" .


