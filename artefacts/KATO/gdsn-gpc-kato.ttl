gdsn:cv176665 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Only fruits from high stem fruit trees" ;
              rdfs:label "HOCHSTAMM_SUISSE" ;
