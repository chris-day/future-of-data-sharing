###  urn:gs1:std:gdsn:cv172275
gdsn:cv172275 rdf:type owl:NamedIndividual ,
                       gdsn:c2034116970 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A regional trade agreement created in 1991, and it is integrated by Brazil, Argentina, Uruguay, Paraguay and Venezuela." ;
              rdfs:label "MERCOSUR" ;
