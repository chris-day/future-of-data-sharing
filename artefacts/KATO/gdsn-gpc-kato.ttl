gdsn:cv168921 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Quality Wine Produced in a Specific Region (QWPSR) or VQPRD - Vinho de Qualidade. These are the most protected wine and indicates a specific vineyard, such as Port Wine, Vinhos Verdes, and Alentejo Wines. These wines are labeled D.O.C. (Denominação de Origem Controlada) which secures a superior quality." ;
              rdfs:label "STILL_WINE_VINHO_DE_QUALIDADE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168921" ;
              gdsn:sourceType "codeValue" .


