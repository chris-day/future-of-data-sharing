                 gdsn:groupName "GS1 Canada" ;
                 gdsn:hierarchyLevel 2 ;
                 gdsn:originalLimit "{1..255}" ;
                 gdsn:originalMultiplicity "0..*" ;
                 gdsn:sourceId "1121" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:validationRules "This is a compound AVP, consisting of several parts, separated by a colon. This AVP must start with Active Ingredient Name, then a colon, then strenght, then a colon, then the associated unit of measure, then a colon, and then the strength basis for the" .


