              gdsn:externalLink "https://www.agrocert.sk/" ;
              gdsn:sourceId "180946" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180947
gdsn:cv180947 rdf:type owl:NamedIndividual ,
                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A product is placed in a cooking appliance that consists of two hinged concave, round or square, cast iron or aluminium plates on long handles which press the sandwich heating/toasting it for consumption. Some presses also seal the sandwich. A sandwich press is also known as a pie iron, pudgy pie iron, sandwich toaster, snackwicher, toastie maker, or panini press." ;
              rdfs:label "SANDWICH_PRESS" ;
              gdsn:codeListName "PreparationTypeCode" ;
              gdsn:sourceId "180947" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180948
gdsn:cv180948 rdf:type owl:NamedIndividual ,
                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A product is cooked between two hinged metal plates. Both plates have gridded indentations to shape the waffle from the batter or dough placed between them. The plates are heated and the iron is closed while the waffle bakes." ;
              rdfs:label "WAFFLE_IRON" ;
              gdsn:codeListName "PreparationTypeCode" ;
              gdsn:sourceId "180948" ;
              gdsn:sourceType "codeValue" .


