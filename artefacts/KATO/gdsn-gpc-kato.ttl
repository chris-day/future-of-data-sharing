###  urn:gs1:std:gdsn:a5419
gdsn:a5419 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c824 ;
           rdfs:range gdsn:dt_string_MinLength1_MaxLength4 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "The dangerous goods classification of the trade item. Dangerous classes explain in general terms the hazardous nature and properties of the goods and serves to classify them together in terms of their most significant risk." ;
           rdfs:label "classOfDangerousGoods" ;
           gdsn:bmsId 3879 ;
           gdsn:originalLimit "{1..4}" ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/a5419" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:HazardousInformationDetail.classOfDangerousGoods" ;
           gdsn:sourceId "5419" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/classOfDangerousGoods" .


###  urn:gs1:std:gdsn:a5421
gdsn:a5421 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c824 ;
           rdfs:range gdsn:dt_string_MinLength1_MaxLength70 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "A classification code of the trade item (dangerous goods) for transport by road and rail for example ADR/RID. It indicates the dangerous characteristics respectively the subsections of the trade item within a given classification." ;
           rdfs:label "dangerousGoodsClassificationCode" ;
           gdsn:bmsId 3880 ;
           gdsn:originalLimit "{1..70}" ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/a5421" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:HazardousInformationDetail.dangerousGoodsClassificationCode" ;
           gdsn:sourceId "5421" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/dangerousGoodsClassificationCode" .


###  urn:gs1:std:gdsn:a5422
gdsn:a5422 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c824 ;
           rdfs:range gdsn:dt_string_MinLength1_MaxLength35 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Dangerous goods hazard ID number, which must be applied to the vehicle, when transporting this trade item (dangerous good) by road or rail, to inform the police, the fire brigade and others in case of an accident about the kind of danger caused by the cargo." ;
           rdfs:label "dangerousGoodsHazardousCode" ;
           gdsn:bmsId 3881 ;
           gdsn:originalLimit "{1..35}" ;
           gdsn:originalMultiplicity "0..*" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/a5422" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:HazardousInformationDetail.dangerousGoodsHazardousCode" ;
           gdsn:sourceId "5422" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/dangerousGoodsHazardousCode" .


###  urn:gs1:std:gdsn:a5423
gdsn:a5423 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c824 ;
           rdfs:range gdsn:c1419 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Identifies the degree of risk these dangerous goods present during transport according to IATA/IMDG/ADR/RID regulations." ;
           rdfs:label "dangerousGoodsPackingGroup" ;
           gdsn:bmsId 3882 ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/a5423" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:HazardousInformationDetail.dangerousGoodsPackingGroup" ;
           gdsn:sourceId "5423" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/dangerousGoodsPackingGroup" .


###  urn:gs1:std:gdsn:a5424
gdsn:a5424 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c824 ;
           rdfs:range gdsn:c-450194305 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Shipping name of the trade item (dangerous goods). The recognized agencies (see dangerousGoodsRegulationsCodes), in their regulations, provide a list of all acceptable proper shipping names." ;
           rdfs:label "dangerousGoodsShippingName" ;
           gdsn:bmsId 3883 ;
           gdsn:originalMultiplicity "0..*" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/a5424" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:HazardousInformationDetail.dangerousGoodsShippingName" ;
           gdsn:sourceId "5424" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/dangerousGoodsShippingName" .


###  urn:gs1:std:gdsn:a5425
gdsn:a5425 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c824 ;
           rdfs:range gdsn:dt_string_MinLength1_MaxLength70 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "A numeric code of special regulations to be met regarding a Dangerous Goods Classification Regulation. For example ADR 2005 provides additional information for identifying the substances or items (s. 3.2.1 ADR 2005). Special provisions can include transport restrictions, exemptions from regulation, explanations on the classifying of certain forms of the dangerous goods in question as well as additional marking and labelling requirements." ;
           rdfs:label "dangerousGoodsSpecialProvisions" ;
           gdsn:bmsId 3884 ;
           gdsn:originalLimit "{1..70}" ;
           gdsn:originalMultiplicity "0..*" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/a5425" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:HazardousInformationDetail.dangerousGoodsSpecialProvisions" ;
           gdsn:sourceId "5425" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/dangerousGoodsSpecialProvisions" .


###  urn:gs1:std:gdsn:a5426
gdsn:a5426 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c824 ;
           rdfs:range gdsn:c1490 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "The measurement of the net explosive mass of the trade item (dangerous goods) for transport by road and rail according to a dangerous goods classification regulation." ;
           rdfs:label "netMassOfExplosives" ;
           gdsn:bmsId 3892 ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/a5426" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:HazardousInformationDetail.netMassOfExplosives" ;
           gdsn:sourceId "5426" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/netMassOfExplosives" .


###  urn:gs1:std:gdsn:a5427
gdsn:a5427 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c824 ;
           rdfs:range gdsn:dt_string_Patternac6dac427d10 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "The four-digit number assigned by the United Nations Committee of Experts on the Transport of Dangerous Goods to classify a substance or a particular groups of substances. Abbreviation: UNDG Number. Recommend to use codes listed in the latest edition of the UN Recommendations on the Transport of Dangerous Goods." ;
           rdfs:label "unitedNationsDangerousGoodsNumber" ;
           gdsn:bmsId 3894 ;
           gdsn:originalLimit "{\\\\d{4}}" ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/a5427" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:HazardousInformationDetail.unitedNationsDangerousGoodsNumber" ;
           gdsn:sourceId "5427" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/unitedNationsDangerousGoodsNumber" .


###  urn:gs1:std:gdsn:a5428
gdsn:a5428 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c825 ;
           rdfs:range gdsn:dt_string_MinLength1_MaxLength35 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "A visible number indicating the specific risk and thus the required precautions associated with a dangerous or hazardous good for example, the indication of the hazardous label number according to chapter 3.2, table A of the ADR." ;
           rdfs:label "dangerousHazardousLabelNumber" ;
           gdsn:bmsId 3896 ,
                      986 ;
           gdsn:originalLimit "{1..35}" ;
           gdsn:originalMultiplicity "1..1" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/c825/a5428" ,
                       "c572222879/c1394600054/c1390/c825/a5428" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:DangerousHazardousLabel.dangerousHazardousLabelNumber" ;
           gdsn:sourceId "5428" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:dangerous_substance_information:xsd:3' and local-name()='dangerousSubstanceInformationModule']/dangerousSubstanceInformation/dangerousSubstanceProperties/dangerousHazardousLabel/dangerousHazardousLabelNumber" ,
                      "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/dangerousHazardousLabel/dangerousHazardousLabelNumber" .


###  urn:gs1:std:gdsn:a5429
gdsn:a5429 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c825 ;
           rdfs:range xsd:nonNegativeInteger ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "A sequence number indicating the primacy of one dangerous/hazardous label number over another. For example, a value of 1 would indicate that the associated hazard label number is the primary, 2 = secondary, etc." ;
           rdfs:label "dangerousHazardousLabelSequenceNumber" ;
           gdsn:bmsId 3897 ,
                      987 ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c-1638339737/c-219947759/c1995455310/c822/c824/c825/a5429" ,
                       "c572222879/c1394600054/c1390/c825/a5429" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:DangerousHazardousLabel.dangerousHazardousLabelSequenceNumber" ;
           gdsn:sourceId "5429" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:dangerous_substance_information:xsd:3' and local-name()='dangerousSubstanceInformationModule']/dangerousSubstanceInformation/dangerousSubstanceProperties/dangerousHazardousLabel/dangerousHazardousLabelSequenceNumber" ,
                      "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:transportation_hazardous_classification:xsd:3' and local-name()='transportationHazardousClassificationModule']/transportationClassification/regulatedTransportationMode/hazardousInformationHeader/hazardousInformationDetail/dangerousHazardousLabel/dangerousHazardousLabelSequenceNumber" .


###  urn:gs1:std:gdsn:a5432
gdsn:a5432 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c826 ;
           rdfs:range xsd:float ;
           dct:source "gdsn_classAttributes.json" ;
