###  urn:gs1:std:gdsn:a6925
gdsn:a6925 rdf:type owl:ObjectProperty ;
           rdfs:domain gdsn:c1385 ;
           rdfs:range gdsn:c143459158 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Indicates that a product is or is contained in a Rigid Plastic Packaging Container (RPPC) as defined by laws in the target market. A Rigid Plastic Packaging Container is a container that is made entirely of plastic, with a capacity between 8 fluid ounces and 5 gallons or the equivalent solid volume, maintains its shape while holding the product, and is capable of multiple re-closures." ;
           rdfs:label "isTradeItemRigidPlasticPackagingContainer" ;
           gdsn:bmsId 2517 ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c-2081284020/c1385/a6925" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:SustainabilityInformation.isTradeItemRigidPlasticPackagingContainer" ;
           gdsn:sourceId "6925" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:sustainability_module:xsd:3' and local-name()='sustainabilityModule']/sustainabilityInformation/isTradeItemRigidPlasticPackagingContainer" .


###  urn:gs1:std:gdsn:a6926
gdsn:a6926 rdf:type owl:ObjectProperty ;
           rdfs:domain gdsn:c1385 ;
           rdfs:range gdsn:c143459158 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Indicates if the product is compliant with the European Union RoHS Directive (the restriction of the use of certain hazardous substances in electrical and electronic equipment), a government regulated agency that sets guidelines for product not to contain certain hazardous substances. The RoHS (restriction of the use of certain hazardous substances) bans the placing on the EU market of new electrical and electronic equipment containing more than agreed levels of lead, cadmium, mercury, hexavalent chromium, polybrominated biphenyl (PBB) and polybrominated diphenyl ether (PBDE) flame retardants." ;
           rdfs:label "isTradeItemROHSCompliant" ;
           gdsn:bmsId 2518 ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c-2081284020/c1385/a6926" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:SustainabilityInformation.isTradeItemROHSCompliant" ;
           gdsn:sourceId "6926" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:sustainability_module:xsd:3' and local-name()='sustainabilityModule']/sustainabilityInformation/isTradeItemROHSCompliant" .


###  urn:gs1:std:gdsn:a6927
gdsn:a6927 rdf:type owl:ObjectProperty ;
           rdfs:domain gdsn:c-1696240591 ;
           rdfs:range gdsn:c143459158 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Indicates if a product can be considered universal waste. Universal waste is defined as “wastes that do meet the regulatory definition of hazardous waste, but are managed under special, tailored regulations." ;
           rdfs:label "isTradeItemUniversalWaste" ;
           gdsn:bmsId 3570 ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c1426620759/c-1696240591/a6927" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:TradeItemDisposalInformation.isTradeItemUniversalWaste" ;
           gdsn:sourceId "6927" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:trade_item_disposal_information:xsd:3' and local-name()='tradeItemDisposalInformationModule']/tradeItemDisposalInformation/isTradeItemUniversalWaste" .


