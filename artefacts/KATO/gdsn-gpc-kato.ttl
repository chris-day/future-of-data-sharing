###  urn:gs1:std:gdsn:cv172250
gdsn:cv172250 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348054 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The camera plunge angle is the right. This plunge shows the listed face plus an angled view of the face to the right." ;
              rdfs:label "R" ;
              gdsn:codeListName "ImageOrientationTypeCode" ;
              gdsn:sourceId "172250" ;
