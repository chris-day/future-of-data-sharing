              rdfs:label "INTERLOCKING" ;
              gdsn:codeListName "StackingPatternTypeCode" ;
              gdsn:sourceId "179557" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179558
gdsn:cv179558 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Autoclave (Steam) is a method of sterilisation that utilizes pressure and heat to achieve a sterile environment." ;
              rdfs:label "AUTOCLAVE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179558" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179559
gdsn:cv179559 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Beta particles are able to penetrate living matter to a certain extent (radiation intensity from a small source of radioactive material decreases as one over the distance squared) and can change the structure of struck molecules." ;
              rdfs:label "BETA_RADIATION" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179559" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179560
gdsn:cv179560 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Gaseous chlorine dioxide systems for sterilization of healthcare products are not mutagenic or carcinogenic in humans. As the chlorine dioxide concentration increases, the time required to achieve sterilization becomes progressively shorter." ;
              rdfs:label "CHLORINE_DIOXIDE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179560" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179561
gdsn:cv179561 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This method should be used only for materials that might be damaged by moist heat or that are impenetrable to moist heat (e.g., powders, petroleum products, sharp instruments). There are two types of dry-heat sterilizers: the static-air type and the forced-air type." ;
              rdfs:label "DRY_HEAT" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179561" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179562
gdsn:cv179562 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A commercially successful technology for sterilizing a variety of disposable medical devices with a wide range of densities. The e-beam inactivates micro-organisms either by causing microbial death as a direct effect of the destruction of a vital molecule or by an indirect chemical reaction. This is the same mechanism as in gamma irradiation, and the dose required is the same." ;
              rdfs:label "ELECTRON_BEAM_IRRADIATION" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179562" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179563
gdsn:cv179563 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A chemical sterilisation method that utilizes ethanol as the sterilisation method." ;
              rdfs:label "ETHANOL" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179563" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179564
gdsn:cv179564 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A gas that is commonly used to sterilize objects sensitive to temperatures greater than 60 °C such as plastics, optics and electrics. Ethylene oxide treatment is generally carried out between 30 °C and 60 °C with relative humidity above 30% and a gas concentration between 200 and 800 mg/L for at least three hours. Ethylene oxide penetrates well, moving through paper, cloth, and some plastic films and is highly effective." ;
              rdfs:label "ETO_ETHYLENE_OXIDE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179564" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179565
gdsn:cv179565 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A chemical sterilisation agent used to provide sterilisation. Items being sterilized are usually immersed in the formaldehyde for a pre determined time period." ;
              rdfs:label "FORMALDEHYDE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179565" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179566
gdsn:cv179566 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Gamma rays are very penetrating and are commonly used for sterilisation of disposable medical equipment, such as syringes, needles, cannulas and IV sets. Gamma radiation requires bulky shielding for the safety of the operators; they also require storage of a radioisotope (usually Cobalt- 60), which continuously emits gamma rays (it cannot be turned off, and therefore always presents a hazard in the area of the facility)." ;
              rdfs:label "GAMMA_RADIATION" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179566" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179567
gdsn:cv179567 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A colourless liquid with a pungent odour used to sterilize medical and dental equipment. It is also used for industrial water treatment and as a chemical preservative. Glutaraldehyde is an oily liquid at room temperature (density 1.06 g/mL), and miscible with water, alcohol, and benzene." ;
              rdfs:label "GLUTARALDEHYDE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179567" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179568
gdsn:cv179568 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pulsed light is a non-thermal sterilization method that uses brief intense pulses or flashes of white light to kill micro-organisms." ;
              rdfs:label "HIGH_INTENSITY_OR_PULSE_LIGHT" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179568" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179569
gdsn:cv179569 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A germicide that inactivates all microbial pathogens, except small numbers of bacterial endospores." ;
              rdfs:label "HIGH_LEVEL_DISINFECTANT" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179569" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179570
gdsn:cv179570 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Another chemical sterilizing agent. It is relatively non-toxic once diluted to low concentrations (although a dangerous oxidizer at high concentrations), and leaves no residue." ;
              rdfs:label "HYDROGEN_PEROXIDE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179570" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179571
gdsn:cv179571 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A sterilization process that uses liquid chemical as its sterilant to kill microorganisms." ;
              rdfs:label "LIQUID_CHEMICAL" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179571" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179572
gdsn:cv179572 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Microwaves are used in medicine for disinfection of soft contact lenses, dental instruments, dentures, milk, and urinary catheters for intermittent self-catheterization. However, microwaves must only be used with products that are compatible (e.g., do not melt). Microwaves are radio-frequency waves, which are usually used at a frequency of 2450 MHz." ;
              rdfs:label "MICROWAVE_RADIATION" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179572" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179573
gdsn:cv179573 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A sterilization process that uses nitrogen dioxide radicals that are formed from dinitrogen tetroxide dimers to kill microorganisms." ;
              rdfs:label "NITROGEN_DIOXIDE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179573" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179574
gdsn:cv179574 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Is a method often times used in industrial settings to sterilize water and air, as well as a disinfectant for surfaces. It has the benefit of being able to oxidize most organic matter. It is a toxic and unstable gas that must be produced on-site, so it is not practical to use in many settings." ;
              rdfs:label "OZONE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179574" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179575
gdsn:cv179575 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A chemical in the organic peroxide family. It is a bright, colorless liquid with a characteristic acrid acetic acid type odor. It has a strong oxidizing potential, is highly corrosive, and can explode at temperatures exceeding 110 °C." ;
              rdfs:label "PERACETIC_ACID" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179575" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179576
gdsn:cv179576 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A method of sterilisation that utilizes hydrogen peroxide vapour to sterilize heat sensitive equipment." ;
              rdfs:label "PLASMA" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179576" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179577
gdsn:cv179577 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sound waves of frequency >20,000 cycle/second kills bacteria and some viruses on exposing for one hour. High frequency sound waves disrupt cells. They are used to clean and disinfect instruments as well as to reduce microbial load." ;
              rdfs:label "SOUND_WAVES" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179577" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179578
gdsn:cv179578 rdf:type owl:NamedIndividual ,
                       gdsn:c-510936499 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A sterilization process that uses supercritical carbon dioxide in combination with a small percentage of additive to kill microorganisms." ;
              rdfs:label "SUPERCRITICAL_CARBON_DIOXIDE" ;
              gdsn:codeListName "SterilisationTypeCode" ;
              gdsn:sourceId "179578" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179579
