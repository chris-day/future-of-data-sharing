###  urn:gs1:std:gdsn:cv176744
gdsn:cv176744 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Label Rouge products guarantee that the poultry and eggs you purchase are superior to standard products because they are produced using traditional, free-range farming methods that ensure the poultry’s welfare and protect the environment." ;
