###  urn:gs1:std:gdsn:cv170975
gdsn:cv170975 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes a product that can be safely consumed by a person with coeliac disease. Coeliac disease is caused by a reaction to gladin (a gluten protein found in wheat) and similar proteins found in other crops." ;
              rdfs:label "COELIAC" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170975" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170976
gdsn:cv170976 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes a product that intends to decrease the need for insulin or oral diabetic agents by adjusting caloric and carbohydrate intake." ;
              rdfs:label "DIABETIC" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170976" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170977
gdsn:cv170977 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes a product that is specially prepared or processed for people on restrictive diets." ;
              rdfs:label "DIETETIC" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170977" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170978
gdsn:cv170978 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes a product that can be used in a gluten free diet, as specified by the appropriate authority within a target market." ;
              rdfs:label "FREE_FROM_GLUTEN" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170978" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170979
gdsn:cv170979 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that the product is suitable for a grain-free diet that eliminates all grains, including wheat, spelt, barley, rye, dried corn, millet, rice, and oats, as well as foods — and sometimes even ingredients — derived from them." ;
              rdfs:label "GRAIN_FREE" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170979" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170980
gdsn:cv170980 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes selling or serving food ritually fit according to Islamic dietary laws." ;
              rdfs:label "HALAL" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170980" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170981
gdsn:cv170981 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "High Carb is not a fast diet but much more a complete diet. \"High Carb\" means that most of the calories in your daily diet come from carbohydrates. At the same time, it is also a low fat diet because the fat content in the diet is relatively low." ;
              rdfs:label "HIGH_CARB" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170981" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170982
gdsn:cv170982 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that the product is suitable for a protein-defined diet in which protein foods are dominant, calories are low, carbohydrates are largely avoided and fat is avoided to a limited extent." ;
              rdfs:label "HIGH_PROTEIN" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170982" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170983
gdsn:cv170983 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Infant formulas come in powder, liquid concentrate, and ready-to-feed forms. Infant formulas come in a variety of types: Cow's milk formula is the most commonly used type. The milk has been altered to resemble breast milk. Soy protein based formulas are frequently used for infants allergic to cow's milk or lactose." ;
              rdfs:label "INFANT_FORMULA" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170983" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170984
gdsn:cv170984 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A ketogenic diet is a form of low carb diet. It is characterized by an extremely low carbohydrate and very high-fat diet. Due to the lack of carbohydrates, the metabolism changes and gets into the so-called \"ketosis\"." ;
              rdfs:label "KETO" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170984" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170985
gdsn:cv170985 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes selling or serving food ritually fit according to Jewish dietary laws." ;
              rdfs:label "KOSHER" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170985" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170986
gdsn:cv170986 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This product is an enzyme supplement used to help people who have trouble digesting milk and other dairy products (lactose intolerance). Lactase enzyme is normally produced by the body to help break down (digest) lactose." ;
              rdfs:label "LACTASE_ENZYME" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170986" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170987
gdsn:cv170987 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that the product is suitable for a those with an intolerance to lactose as the product does not contain the lactose sugar that is normally found in a dairy product." ;
              rdfs:label "LACTOSE_FREE" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170987" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170988
gdsn:cv170988 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that the product is suitable for a calorie-defined diet in which the calorie intake is restricted." ;
              rdfs:label "LOW_CALORIE" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170988" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170989
gdsn:cv170989 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Low-carb diets is a diet that restrict carbohydrate consumption. Foods high in carbohydrates (e.g., sugar, bread, pasta) are limited or replaced with foods containing a higher percentage of fats and moderate protein (e.g., meat, poultry, fish, shellfish, eggs, cheese, nuts, and seeds) and other foods low in carbohydrates (e.g., most salad vegetables such as spinach, kale, chard and collards), although other vegetables and fruits (especially berries) are often allowed." ;
              rdfs:label "LOW_CARB" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170989" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170990
gdsn:cv170990 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A low-fat diet is one that restricts fat and often saturated fat and cholesterol as well. Low-fat diets are intended to reduce the occurrence of conditions such as heart disease and obesity." ;
              rdfs:label "LOW_FAT" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170990" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170991
gdsn:cv170991 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that the product is suitable for a protein-defined diet in which the protein intake with food is restricted." ;
              rdfs:label "LOW_PROTEIN" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170991" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170992
gdsn:cv170992 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that the product is suitable for a salt-defined diet in which the salt intake with food is restricted." ;
              rdfs:label "LOW_SALT" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170992" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170993
gdsn:cv170993 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A calorie-controlled, pre-packaged product in the form of a bar or a beverage (ready-to-drink or powder) that is used to replace a meal." ;
              rdfs:label "MEAL_REPLACEMENT" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170993" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170994
gdsn:cv170994 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is approved as substitute mother's milk the appropriate authority of the target market." ;
              rdfs:label "MOTHERS_MILK_SUBSTITUTE" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170994" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170995
gdsn:cv170995 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Nutritional supplements are any dietary supplement that is intended to provide nutrients that may otherwise not be consumed in sufficient quantities; for example, vitamins, minerals, proteins, amino acids or other nutritional substances." ;
              rdfs:label "NUTRITION_SUPPLEMENT" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170995" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170996
gdsn:cv170996 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes a food product that was produced with the use of feed or fertiliser of plant or animal origin, without employment of chemically formulated fertilisers, growth stimulants, antibiotics or pesticides." ;
              rdfs:label "ORGANIC" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170996" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170997
gdsn:cv170997 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Paleo diet, is a fad diet type requiring the sole or predominant eating of foods presumed to have been available to humans during the Paleolithic era." ;
              rdfs:label "PALEO" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170997" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170998
gdsn:cv170998 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A pescatarian diet excludes meat and poultry but includes fish or seafood (and may include dairy products and eggs)." ;
              rdfs:label "PESCATARIAN" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170998" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170999
gdsn:cv170999 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A plant-based diet is a way of eating that focuses on vegetables fruits, whole grains, legumes (beans, peas, and lentils), nuts and seeds. (i.e. foods that come from plants. It is not a vegan/vegetarian diet that avoids animal products, but it de-emphasizes animal products and its contribution to our meals)." ;
              rdfs:label "PLANT_BASED" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "170999" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171000
gdsn:cv171000 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Probiotics are live bacteria and yeasts that are good for you, especially your digestive system." ;
              rdfs:label "PROBIOTICS" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "171000" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171001
gdsn:cv171001 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A dietary practice of eating food that is uncooked and unprocessed. Also known as Raw foodism, rawism." ;
              rdfs:label "RAW" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "171001" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171002
gdsn:cv171002 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Dietary supplements include vitamins, minerals, herbs, botanicals, enzymes, amino acids, or other dietary ingredients. You take these products by mouth in pill, capsule, tablet, or liquid form to replace your diet." ;
              rdfs:label "TOTAL_DIET_REPLACEMENT" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "171002" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171003
gdsn:cv171003 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products that are not of animal origin and at no stage of production and processing has use been made of, or the product been supplemented with ingredients or processing aids or substances that are of animal origin. The product has not been tested on animals. Local regulations, where they exist, prevail since the term may be a combination or all of the above statements." ;
              rdfs:label "VEGAN" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "171003" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171004
gdsn:cv171004 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes a product that contains no meat or other animal products but depending upon the local market regulations may also contain milk, eggs, products from bees (and in some markets also fish), and their components. Please refer to local regulations." ;
              rdfs:label "VEGETARIAN" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "171004" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171005
gdsn:cv171005 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes a product that contains no beef or beef-products. Beef is considered to be a taboo food product by some religions most notable Hinduism, Buddhism and Jainism." ;
              rdfs:label "WITHOUT_BEEF" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "171005" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171006
gdsn:cv171006 rdf:type owl:NamedIndividual ,
                       gdsn:c-683161172 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes a product that contains no pork meat." ;
              rdfs:label "WITHOUT_PORK" ;
              gdsn:codeListName "DietTypeCode" ;
              gdsn:sourceId "171006" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171007
gdsn:cv171007 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348220 ;
