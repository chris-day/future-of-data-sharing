                       gdsn:c1329411021 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Consignment is a form of trade where a product is offered for sale by the retailer, but owned by the supplier, whereby the retailer doesn’t buy the product from the supplier until it is sold to the consumer." ;
              rdfs:label "CONSIGNMENT" ;
              gdsn:codeListName "TradeChannelCode" ;
              gdsn:sourceId "180021" ;
              gdsn:sourceType "codeValue" .


