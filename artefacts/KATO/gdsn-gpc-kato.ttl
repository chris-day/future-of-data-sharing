###  urn:gs1:std:gdsn:a6746
gdsn:a6746 rdf:type owl:ObjectProperty ;
           rdfs:domain gdsn:c1343 ;
           rdfs:range gdsn:c143459158 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "An indication that the products sterile status must be maintained from the point in time of sterilisation until point of administration." ;
           rdfs:label "isTradeItemRequiredToRemainSterile" ;
           gdsn:bmsId 1595 ;
