###  urn:gs1:std:gdsn:cv168707
gdsn:cv168707 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "NATO Stock Number or National Stock Number is a 13-digit numeric code identifying all the standardized material items of supply as they have been recognized by all NATO countries . The complete structure of this identifier can be found at this link. https://www.nato.int/structur/AC/135/ncs_guide/english/e_1-6-5.htm" ;
              rdfs:label "NSN" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168707" ;
              gdsn:sourceType "codeValue" .


