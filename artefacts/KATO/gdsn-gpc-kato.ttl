###  urn:gs1:std:gdsn:cv178629
gdsn:cv178629 rdf:type owl:NamedIndividual ,
                       gdsn:c1826432850 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Catalogue Item has been registered at the Global Registry." ;
              rdfs:label "REGISTERED" ;
              gdsn:codeListName "RegistryCatalogueItemStateEnumeration" ;
              gdsn:sourceId "178629" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178630
gdsn:cv178630 rdf:type owl:NamedIndividual ,
                       gdsn:c-94684537 ;
