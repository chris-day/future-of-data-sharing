###  urn:gs1:std:gdsn:extAttr1188
gdsn:extAttr1188 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:extGroup_US_NABCA ;
                 rdfs:range xsd:string ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "The year or vintage of the beverage. For spirits, value should be provided ##Y or ##M. For wine, value should be provided ####." ;
