###  urn:gs1:std:gdsn:cv177099
gdsn:cv177099 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A right-angle piece placed over the outermost perimeter edges of a container to distribute pressure and prevent collapse or cutting from banding, strapping, or handling." ;
              rdfs:label "EDGE_PROTECTION" ;
              gdsn:codeListName "PackagingMaterialElementCode" ;
              gdsn:sourceId "177099" ;
