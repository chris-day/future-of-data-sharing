###  urn:gs1:std:gdsn:cv176899
gdsn:cv176899 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: HVE level 3. Qualenvi is a certification system for independent winemakers in France who run the whole process from growing to producing and bottling." ;
              rdfs:label "QUALENVI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.preignes.com/en/qualenvi-2/" ;
              gdsn:sourceId "176899" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176900
gdsn:cv176900 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Seal of quality for high-quality products from regional and small-scale farming and is awarded by the Agrarmarketing Tirol (AM Tirol). Products bearing this seal of approval are produced exclusively from Tyrolean raw materials and processed in the Tyrol.www.qualitaet.tirol.at," ;
              rdfs:label "QUALITAET_TIROL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.qualitaet.tirol.at,https://www.bewusstkaufen.at/guetezeichen/188/qualitaet-tirol.html" ;
