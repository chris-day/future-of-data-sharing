###  urn:gs1:std:gdsn:cv181476
gdsn:cv181476 rdf:type owl:NamedIndividual ,
                       gdsn:c-778930468 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Classification system of medical devices managed by the General Health Insurance Company of the Czech Republic. It is used to calculate payments between insurance companies and healthcare providers in the Czech Republic. The code consists of seven digits." ;
              rdfs:label "91" ;
              gdsn:codeListName "AdditionalTradeItemClassificationCodeListCode" ;
              gdsn:sourceId "181476" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181477
gdsn:cv181477 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Cosmetic Products Notification Portal (CPNP) is an online database created by the European Union for the implementation of Regulation (EC) No 1223/2009, in which cosmetics are registered and documented. Each product is assigned a unique CPNP reference when it is registered." ;
              rdfs:label "CPNP" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "181477" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181478
gdsn:cv181478 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The SÚKL code is a unique identifier used by the State Institute for Drug Control (SÚKL) in the Czech Republic. It uniquely identifies a specific medicinal product or medical device in the SÚKL database." ;
              rdfs:label "CZ_SUKL" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "181478" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181479
gdsn:cv181479 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "National Allowance Pricing Agreement Local Stock Number is a specific identification code used within a national pricing agreement framework to track and manage inventory at a local level." ;
              rdfs:label "NAPALSN" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "181479" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181480
gdsn:cv181480 rdf:type owl:NamedIndividual ,
                       gdsn:c-1513720680 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Definition (includes Common Name): Refers to the presence of bee pollen and its derivatives in the product. - Family/Genus/Species: Pollen - Also known as: Bee bread, ambrosia or perga - Disclaimer: Refers to the presence of the allergen in the product, as listed in the regulations specified by an agency and specification or any local market regulations." ;
              rdfs:label "BPN" ;
              gdsn:codeListName "AllergenTypeCode" ;
              gdsn:sourceId "181480" ;
              gdsn:sourceType "codeValue" .


