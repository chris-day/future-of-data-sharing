###  urn:gs1:std:gdsn:cv178192
gdsn:cv178192 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the number of window elements e.g. window systems or double window. To populate use productCharacteristicValueInteger." ;
              rdfs:label "numberOfWindowElements" ;
