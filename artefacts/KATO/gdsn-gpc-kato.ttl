###  urn:gs1:std:gdsn:cv178634
gdsn:cv178634 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348026 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A nation with its own government, occupying a particular territory." ;
              rdfs:label "COUNTRY" ;
              gdsn:codeListName "RegulationCommunityLevelCode" ;
              gdsn:sourceId "178634" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178635
gdsn:cv178635 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348026 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A city, town, or other district possessing corporate existence and usually its own local government." ;
              rdfs:label "MUNICIPALITY" ;
              gdsn:codeListName "RegulationCommunityLevelCode" ;
              gdsn:sourceId "178635" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178636
gdsn:cv178636 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348026 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "One of the constituent units of a nation having a federal government." ;
              rdfs:label "PROVENCE_OR_STATE" ;
              gdsn:codeListName "RegulationCommunityLevelCode" ;
              gdsn:sourceId "178636" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178637
gdsn:cv178637 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348026 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A group of states or nations united into one political body." ;
              rdfs:label "UNION" ;
              gdsn:codeListName "RegulationCommunityLevelCode" ;
              gdsn:sourceId "178637" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178638
gdsn:cv178638 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products complying with all the requirements of the Aerosol Directive are marked with the \"reverse epsilon\" symbol" ;
              rdfs:label "AEROSOL_REVERSE_EPSILON" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178638" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178639
gdsn:cv178639 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products complying with EU Council Directive 91/414/EEC. This directive concerning the placing of plant protection products on the market lays down rules and procedures for approval of the active substances at EU-level and for the authorisation at Member State level of plant protection products (PPPs) containing these substances. This Directive states that substances cannot be used in plant protection products unless they are included in a positive EU list. Once a substance is included in the positive list Member States may authorise the use of products containing them." ;
              rdfs:label "AGRICULTURE_PROTECTION_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178639" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178640
gdsn:cv178640 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Food business operators, in accordance with Regulation (EC) No 853/2004, should ensure that all products of animal origin that they place on the market, bear either a health mark or an identification mark." ;
              rdfs:label "ANIMAL_ID_HEALTH_MARK" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178640" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178641
gdsn:cv178641 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Directive describing the legal requirements on batteries intended to made available on the market provided that such products are labelled, marked or accompanied with commercial documents. Essentially safety and environmental aspects are defined (e.g. obligation of the seller to take batteries back, proscription to throw batteries into the household garbage) for different type of batteries (e.g. batteries used by the end consumer, batteries used in cars). In Germany the law on batteries (BattG) details these rules." ;
              rdfs:label "BATTERY_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178641" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178642
gdsn:cv178642 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation (e.g., EU Reg 528/2012) harmonising the rules on making available on the market and using biocidal products whilst ensuring a high level of protection of both human and animal health and the environment. It should not be used for trade items treated with biocidal products ('treated articles')." ;
              rdfs:label "BIOCIDE_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178642" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178643
gdsn:cv178643 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the product has a regulatory requirement to show to the consumer that it may or may not contain Bisphenol A (BPA)." ;
              rdfs:label "BPA_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178643" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178644
gdsn:cv178644 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Buy American Act - requires the United States government to prefer U.S.-made products in its purchases. This includes the Berry Amendment to the Act in the provisioning of products for the US Government and federal programs like National School Lunch. https://en.wikipedia.org/wiki/Buy_American_Act" ;
              rdfs:label "BUY_AMERICAN_ACT" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178644" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178645
gdsn:cv178645 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Buy American Provision in accordance with the USDA is Section 104(d) of the William F. Goodling Child Nutrition Reauthorization Act of 1998 (Public Law 105-336) added a provision, Section 12(n) to the National School Lunch Act (NSLA) (42 USC 1760(n)), requiring school food authorities (SFAs) to purchase, to the maximum extent practicable, domestic commodities or products. This Buy American provision supports the mission of the Child Nutrition Programs, which is to serve children nutritious meals and support American agriculture. https://www.fns.usda.gov/school-meals/compliance-enforcement-buy-american" ;
              rdfs:label "BUY_AMERICAN_PROVISION_USDA" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178645" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178646
gdsn:cv178646 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The CE marking is the manufacturer's, distributor's or EU authorised representative's declaration that the product meets EU standards for health, safety, protection of consumers and environmental protection in accordance with the regulation. The CE mark indicates that the product may be sold freely in any part of the European Economic Area, regardless of its country of origin. The mark consists of the CE logo and, if applicable, the four-digit identification number of the notified body involved in the conformity assessment procedure." ;
              rdfs:label "CE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178646" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178647
gdsn:cv178647 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The FLSA established a national minimum wage guaranteed 'time-and-a-half' for overtime in certain jobs, and prohibited most employment of minors in \"oppressive child labor,\" a term that is defined in the statute. It applies to employees engaged in interstate commerce or employed by an enterprise engaged in commerce or in the production of goods for commerce, unless the employer can claim an exemption from coverage." ;
              rdfs:label "COMPLIANT_WITH_FAIR_LABOR_STANDARDS_ACT" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178647" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178648
gdsn:cv178648 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Compliant With Flammability Act" ;
              rdfs:label "COMPLIANT_WITH_FLAMMABILITY_ACT" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178648" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178649
gdsn:cv178649 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Requires the country of origin of imported furs to be disclosed on all labels and in all advertising" ;
              rdfs:label "COMPLIANT_WITH_FUR_PRODUCT_LABELING_ACT" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178649" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178650
gdsn:cv178650 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "NOT AVAILABLE" ;
              rdfs:label "COMPLIANT_WITH_STATE_ENVIRONMENT_REQUIREMENTS" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178650" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178651
gdsn:cv178651 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A US regulation regarding the advertising and labelling of textile fibre products." ;
              rdfs:label "COMPLIANT_WITH_TEXTILE_FIBER_PRODUCT_IDENTIFICATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178651" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178652
gdsn:cv178652 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A US regulation that requires anyone who manufacturers or sells products containing wool to accurately label each item with the fibre content and origin" ;
              rdfs:label "COMPLIANT_WITH_WOOL_PRODUCTS_LABELING_ACT" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178652" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178653
gdsn:cv178653 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation ensuring that products placed on the market are safe for consumer use, enhancing market surveillance and traceability, and introducing clear obligations for economic operators to prevent and manage product risks. E.g., EU Regulation 2023/988, or regulations from the Consumer Product Safety Commission in the US." ;
              rdfs:label "CONSUMER_PRODUCT_SAFETY" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178653" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178654
gdsn:cv178654 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes that the trade item or packaging contains composite wood that falls under regulatory menas due to chemicals used in process to create the wood, such as Formaldehyde has both cancer and noncancer-causing effects on human health. For example: California Air Resources Board is a department of the California Environmental Protection Agency. CARB’s mission, US EPA. https://www.epa.gov/formaldehyde ." ;
              rdfs:label "CONTAINS_COMPOSITE_WOOD" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178654" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178655
gdsn:cv178655 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation (EU Reg 1223/2009) establishing rules to be complied with any cosmetic product made available on the market, a high level of protection of human health and a high degree of protection of the environment. These rules include the necessity to indicate allergens and the displaying of the ingredients used in the product." ;
              rdfs:label "COSMETIC_INFORMATION_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178655" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178656
gdsn:cv178656 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Declaration Of Performance (DOP) is legally required. See target market regulations for applicability." ;
              rdfs:label "DECLARATION_OF_PERFORMANCE_REQUIRED" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178656" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178657
gdsn:cv178657 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation establishing rules designed to achieve the free movement of detergents and surfactants for detergents in the market while, at the same time, ensuring a high degree of protection of the environment and human health. For example (EU Reg 648/2004)" ;
              rdfs:label "DETERGENTS_SAFETY_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178657" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178658
gdsn:cv178658 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Estimated Sign (℮) (also referred to as \"e-mark\") is a mark that sometimes can be found on pre-packed goods in Europe. The e-mark indicates that the packaging is filled according to the European Directive 76/211/EEC." ;
              rdfs:label "E_MARK" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178658" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178659
gdsn:cv178659 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A directive defining the energy labeling of electrical lamps and luminaires (e.g. EU Reg 874/2012). This directive deals with environmental aspects as the electricity used by electrical lamps accounts for a significant share of total electricity demand." ;
              rdfs:label "EFFICIENCY_OF_LAMPS_LUMINARIES" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178659" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178660
gdsn:cv178660 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The main objective of the Directive 2004/108/EC of the European Council, of 15 December 2004, is to regulate the compatibility of equipment regarding EMC (Electromagnetic Compatibility)." ;
              rdfs:label "EMC_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178660" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178661
gdsn:cv178661 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the product contains enclosed or attached information available for regulatory compliance where applicable." ;
              rdfs:label "ENCLOSED_ATTACHED_INFORMATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178661" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178662
gdsn:cv178662 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A code that indicates that a trade item is in compliance with energy efficiency guide and is labelled as such." ;
              rdfs:label "ENERGY_GUIDE_LABEL_REQUIRED" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178662" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178663
gdsn:cv178663 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation (EC) No 178/2002 of the European Parliament and of the Council of 28 January 2002 laying down the general principles and requirements of food law, establishing the European Food Safety Authority and laying down procedures in matters of food safety. For the purposes of this Regulation, \"food\" (or \"foodstuff\") means any substance or product, whether processed, partially processed or unprocessed, intended to be, or reasonably expected to be ingested by humans. \"Food\" includes: drink, chewing gum and any substance, including water, intentionally incorporated into the food during its manufacture, preparation or treatment. It includes water after the point of compliance." ;
              rdfs:label "EU_REGULATION_FOR_FOODSTUFF" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178663" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178664
gdsn:cv178664 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product is concerned with the marketing and use of explosives precursors and must be registered by the economic operator. Explosives precursors are chemical substances that can be used for legitimate purposes, but that can also be misused to manufacture homemade explosives. For example restricted explosive precursors listed in Annex I of the Regulation (EU) No 2019/1148." ;
              rdfs:label "EXPLOSIVES_PRECURSORS_REGISTRATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178664" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178665
gdsn:cv178665 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product is concerned with the marketing and use of explosives precursors and must be reported by the economic operator. Explosives precursors are chemical substances that can be used for legitimate purposes, but that can also be misused to manufacture homemade explosives. For example reportable explosive precursors listed in Annex II of the Regulation (EU) No 2019/1148." ;
              rdfs:label "EXPLOSIVES_PRECURSORS_REPORTING" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178665" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178666
gdsn:cv178666 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation (EU Reg 767/2009) to harmonise the conditions for the placing on the market and the use of feed, in order to ensure a high level of feed safety and thus a high level of protection of public health, as well as to provide adequate information for users and consumers." ;
              rdfs:label "FEED_SAFETY_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178666" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178667
gdsn:cv178667 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation providing the basis for the assurance of a high level of consumer protection in relation to specialized food like food for infants and young children, food for special medical purposes, and total diet replacement for weight control (e.g. EU Reg 609/2013)." ;
              rdfs:label "FOOD_FOR_SPECIAL_PURPOSES" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178667" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178668
gdsn:cv178668 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation providing the basis for the assurance of a high level of consumer protection in relation to food information, taking into account the differences in the perception of consumers and their information needs whilst ensuring the smooth functioning of the market. General principles, requirements and responsibilities governing food information, and in particular food labelling rules are established (e.g. EU regulation 1169 / 2011). These rules include the necessity to indicate allergens, the responsible food business operator, the name of the food, the displaying of the ingredients used additives." ;
              rdfs:label "FOOD_INFORMATION_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178668" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178669
gdsn:cv178669 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods, other than infant formula, represented or purported to be specifically for infants and children less than 2 years of age shall bear nutrition labelling." ;
              rdfs:label "FOOD_LABELLING_UNDER_2_YEARS_OF_AGE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178669" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178670
gdsn:cv178670 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods, other than infant formula, represented or purported to be specifically for infants and children less than 4 years of age shall bear nutrition labelling." ;
              rdfs:label "FOOD_LABELLING_UNDER_4_YEARS_OF_AGE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178670" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178671
gdsn:cv178671 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Food supplements (EU directive 2002/46/EC) marketed as foodstuffs and presented as such. These products shall be delivered to the ultimate consumer only in a pre-packaged form. Consumer health and safety aspects are in focus as well as to provide adequate information on how to use the product properly." ;
              rdfs:label "FOOD_SUPPLEMENT_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178671" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178672
gdsn:cv178672 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Directive describing the legal requirements on pharmaceutical products which are commercially available and intended to made available on the market provided that such products are labelled, marked or accompanied with commercial documents. General Consumer safety aspects are in focus like the dosage form linked with an application instruction (e.g. Do not use with alcohol). In Germany the law on medical products (AMG) details these rules." ;
              rdfs:label "FREE_PHARMACEUTICAL_PRODUCTS_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178672" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178673
gdsn:cv178673 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Decree No. 2014-1482 of 9 December 2014 on the information and supply obligations concerning spare parts indispensable for the use of a good" ;
              rdfs:label "FRENCH_SPARE_PARTS_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178673" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178674
gdsn:cv178674 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation providing the basis to ensure that workers and consumers are clearly informed of the hazards associated with chemicals by means of a system of classification and labelling. The aim is to ensure that the same hazards are described and labelled in the same way in all concerned countries (e.g. Regulation (EC) No 1272/2008 of the European Parliament and of the Council of 16 December 2008 on Classification, Labelling and Packaging (CLP) of substances and mixtures)." ;
              rdfs:label "HAZARDS_CLASSIFICATION_LABELLING_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178674" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178675
gdsn:cv178675 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is a substance used to control unwanted plants that are subject to regulation." ;
              rdfs:label "HERBICIDE_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178675" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178676
gdsn:cv178676 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Infant formula except foods, shall be labelled in compliance with regulations." ;
              rdfs:label "INFANT_FORMULA_LABELLING" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178676" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178677
gdsn:cv178677 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Requires that food contact materials a re safe; Must not transfer their components into food in quantities that could endanger human health, change food composition in an unacceptable way or deteriorate its taste and odour. Are manufactured according to good manufacturing practice." ;
              rdfs:label "INTENDED_TO_COME_INTO_CONTACT_WITH_FOOD" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178677" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178678
gdsn:cv178678 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Low Voltage Directive (LVD) 2006/95/EC provides common broad objectives for safety regulations, so that electrical equipment approved by any EU member country will be acceptable for use in all other EU countries. The Low Voltage Directive does not supply any specific technical standards that must be met, instead relying on IEC technical standards to guide designers to produce safe products. Products that conform to the general principles of the Low Voltage Directive and the relevant particular safety standards are marked with the CE marking to indicate compliance and acceptance throughout the EU. Conformance is asserted by the manufacturer based on its conformity assessment." ;
              rdfs:label "LVD_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178678" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178679
gdsn:cv178679 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The trade item has been authorised to be sold by a regulatory agency to be distributed in a market." ;
              rdfs:label "MARKET_AUTHORISATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178679" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178680
gdsn:cv178680 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A directive establishing common rules on the safety, health protection and performance characteristics of medical devices in order to provide the safety and health protection of patients, users and, where appropriate, other persons, with regard to the use of medical devices ((e.g. Medical Device Regulation (EU) 2017/745) and in-vitro diagnostic devices (e.g. In vitro Diagnostic Device Regulation (EU) 2017/746))." ;
              rdfs:label "MEDICAL_DEVICE_SAFETY" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178680" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178681
gdsn:cv178681 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the product has a regulatory requirement to show to the consumer the best to use before period so they obtain the full functionality of the product." ;
              rdfs:label "MINIMUM_DURABILITY" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178681" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178682
gdsn:cv178682 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the presence of nano materials by the levels acceptable by the appropriate regulation. Note: in Europe, use code NANOPARTICLE in attribute claimElementCode instead." ;
              rdfs:label "NANO_MATERIALS_PRESENCE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178682" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178683
gdsn:cv178683 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Not Applicable." ;
              rdfs:label "NOT_APPLICABLE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178683" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178684
gdsn:cv178684 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product represented in its packaging and/or marketing as appropriate for use by persons as defined by regulatory agency? Includes packaging, display, photography, licensed characters, promotion or advertising (in-store or ad) as appropriate for use by persons. An example is the Consumer Product Safety Commission regulation: https://www.cpsc.gov/Regulations-Laws--Standards/Statutes/Poison-Prevention-Packaging-Act/Child-Resistant-and-Senior-Friendly-Packages-packaging-guide/." ;
              rdfs:label "PACKAGING_SAFETY_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178684" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178685
gdsn:cv178685 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the product has a regulatory requirement to show to the consumer that product is denoted to have a period of time after opening before it becomes harmful to the consumer." ;
              rdfs:label "PERIOD_SAFE_TO_USE_AFTER_OPENING" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178685" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178686
gdsn:cv178686 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is a substance used to control unwanted pests that are subject to regulation." ;
              rdfs:label "PESTICIDE_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178686" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178687
gdsn:cv178687 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In contrast to the free pharmaceutical directive this directive describing the legal requirements on pharmaceutical products available only in pharmacies. These products have stronger regulations and restrictions to consumer safety aspects. For example the dosage recommendation needs to be explained in detail by the sales staff as well as possible interaction with other pharmaceutical products." ;
              rdfs:label "PHARMACEUTICAL_PRODUCT_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178687" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178688
gdsn:cv178688 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A code indicating the trade item is compliant with the food labelling regulation." ;
              rdfs:label "PRODUCT_LABELING_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178688" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178689
gdsn:cv178689 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Directive describing the legal requirements on the products of daily use focusing on consumer safety (e.g. do not use with …, not used by children). An example is the German directive BedGgstV." ;
              rdfs:label "PRODUCT_OF_DAILY_USE_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178689" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178690
gdsn:cv178690 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Containing specific toxicants for a product which contains carcinogens and/or reproductive toxicants established in California’s Proposition 65 (Prop 65), The Safe Drinking Water and Toxic Enforcement Act, enacted in 1986. This Act requires the state to publish a list of chemicals known to cause cancer or reproductive harm. Prop 65 applies to suppliers who sell products in the state if their products exceed safe harbour levels established in Prop 65. Safe harbour levels establish thresholds for no significant risk levels (NSRLs) for carcinogens and maximum allowable dose levels (MADLs) for chemicals that cause reproductive toxicity." ;
              rdfs:label "PROP_65" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178690" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178691
gdsn:cv178691 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The trade item is regulated by the agency stated in the regulatoryAgency attribute." ;
              rdfs:label "REGULATED_BY_AGENCY" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178691" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178692
gdsn:cv178692 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Directive of the returning of electronic products ensuring a high degree of protection of the environment. This directive defines returning quotes of returning electronical products needs to be fulfilled by the industry and by retailers (e.g. ElektroG in Germany)." ;
              rdfs:label "RETURNING_OF_ELECTRONICAL_PRODUCT_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178692" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178693
gdsn:cv178693 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Is not a quality mark but a European directive 2002/95/EC (stands for Restriction of Hazardous Substances). This directive restricts (with exceptions) the use of six hazardous materials like lead, cadmium and mercury in the manufacture of various types of electronic and electrical equipment." ;
              rdfs:label "ROHS_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178693" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178694
gdsn:cv178694 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Safety Data Sheet (SDS) is legally required. See target market regulations for applicability." ;
              rdfs:label "SAFETY_DATA_SHEET_REQUIRED" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178694" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178695
gdsn:cv178695 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Decree No. 2011-1650 of 25 November 2011 on the procedures for declaring and paying back the non-point pollution charge and for keeping the registers referred to in Articles L. 254-3-1 and L. 254-6 of the Rural and Maritime Fisheries Code." ;
              rdfs:label "SCATTERED_POLLUTION_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178695" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178696
gdsn:cv178696 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Directive on the safety of electronic products covering consumer health as well as environmental aspects (e.g. German law on product safety ProdSG)." ;
              rdfs:label "SECURITY_OF_ELECTRONIC_PRODUCTS_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178696" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178697
gdsn:cv178697 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A small part is any object that fits completely into a specified size by regulation that approximates the size of the fully expanded throat of a child of age specified by regulation. A small part can be a whole toy or article, a Separate part of a toy, game, or other article or a piece of a toy or article that breaks off during testing that simulates use or abuse by children. Example in US See 16 C.F.R. 1501.4." ;
              rdfs:label "SMALL_PARTS" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178697" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178698
gdsn:cv178698 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation (EU Reg 1007/2011). This Regulation lays down rules concerning the use of textile fibre names and related labelling and marking of fibre composition of textile products, rules concerning the labelling or marking of textile products containing non-textile parts of animal origin and rules concerning the determination of the fibre composition of textile products by quantitative analysis of binary and ternary textile fibre mixtures, in order to provide accurate information to consumers." ;
              rdfs:label "TEXTILE_LABELLING_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178698" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178699
gdsn:cv178699 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The directive or regulation aims to improve the functioning of tobacco products within a market while ensuring a high level of public health protection. Example: European Directive 2014/40/EU on the manufacture, presentation and sale of cigarettes, roll-your-own tobacco, pipe tobacco, cigars, cigarillos, smokeless tobacco products, electronic cigarettes and plant-smoked products." ;
              rdfs:label "TOBACCO_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178699" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178700
gdsn:cv178700 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Directive, which applies to products designed or intended, whether or not exclusively, for use in play by children under 14 years of age. Health and safety aspects of the child are in focus Amongst others security aspects of toys are defined (e.g. Warning: small components may be swallowed) as well as substances, which are not allowed to use in toys (e.g. softening agents)." ;
              rdfs:label "TOY_SAFETY_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178700" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178701
gdsn:cv178701 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that a trade item is subject to government rules and regulations regarding traceability." ;
              rdfs:label "TRACEABILITY_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
