###  urn:gs1:std:gdsn:cv176415
gdsn:cv176415 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Organic Certifiers is USDA, ISO 17065, EU Equivalent, COR (Canadian Organic Regimen) accredited, and has been certifying the organic community since 1996. Organic Certifiers was one of the first accredited by the USDA in early 2002." ;
              rdfs:label "CERTIFIED_ORGANIC_BY_ORGANIC_CERTIFIERS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://organiccertifiers.com/" ;
              gdsn:sourceId "176415" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176416
gdsn:cv176416 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "\"The Paleo Foundation was first organized for the purpose of helping Paleo Diet Adherents easily identify products that met the basic tenets of the diet. Certified Paleo certifies products that contain Paleo Diet ingredients, but have some 21st century processing methods allowing for shelf stability. https://paleofoundation.com\"" ;
              rdfs:label "CERTIFIED_PALEO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://paleofoundation.com/certified-paleo/" ;
              gdsn:sourceId "176416" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176417
gdsn:cv176417 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Paleo Foundation offers The Paleo Friendly Program allows for products that are generally regarded as gray-area products such as kombucha, dark chocolate, and even grass-fed dairy. Some restrictions apply." ;
              rdfs:label "CERTIFIED_PALEO_FRIENDLY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://paleofoundation.com/certified-paleo/" ;
              gdsn:sourceId "176417" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176418
gdsn:cv176418 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Certified Plant Based program defines plant-based food to make it easy for consumers to choose a finished product that consists of ingredients derived from plants including vegetables, fruits, whole grains, nuts, seeds and/or legumes. Additionally, fungi and algae, although not technically plants, will also be counted toward the percentage of plant-based ingredients. (https://www.nsf.org/services/by-industry/food-safety-quality/label-claims/certified-plant-based)" ;
              rdfs:label "CERTIFIED_PLANT_BASED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.nsf.org/services/by-industry/food-safety-quality/label-claims/certified-plant-based" ;
              gdsn:sourceId "176418" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176419
gdsn:cv176419 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: Certified Sustainable Wine of Chile. National - Certifies the sustainable management of the company." ;
              rdfs:label "CERTIFIED_SUSTAINABLE_WINE_CHILE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.sustainable.cl/en/" ;
              gdsn:sourceId "176419" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176420
gdsn:cv176420 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "WBENC Certification validates that the business is 51 percent owned, controlled, operated, and managed by a woman or women. WBENC Certification gives women owned businesses the ability to compete for real-time business opportunities provided by WBENC Corporate Members and government agencies." ;
              rdfs:label "CERTIFIED_WBENC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.wbenc.org/" ;
              gdsn:sourceId "176420" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176421
gdsn:cv176421 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products may be certified by WFEN if: The product contributes directly to in situ conservation of key species. Production has a positive impact on the local economy. Individuals or communities living with wildlife participate in the production, harvest, processing or manufacture of the product. The product’s conservation mission includes a clear enforcement mechanism, such that failure to follow through with required conservation actions results in immediate consequences, including forfeiture of any economic reward." ;
              rdfs:label "CERTIFIED_WILDLIFE_FRIENDLY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.wildlifefriendly.org/" ;
              gdsn:sourceId "176421" ;
              gdsn:sourceType "codeValue" .


