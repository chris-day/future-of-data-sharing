###  urn:gs1:std:gdsn:cv176931
gdsn:cv176931 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The SA8000 Standard and Certification System provide a framework for organizations of all types, in any industry, and in any country to conduct business in a way that is fair and decent for workers and to demonstrate their adherence to the highest social standards." ;
              rdfs:label "SA8000" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://sa-intl.org/programs/sa8000/" ;
              gdsn:sourceId "176931" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176932
gdsn:cv176932 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Safe Feed/Safe Food Certification Program is designed for the total feed industry. The Safe Feed/Safe Food program establishes comprehensive standards of excellence that go beyond existing regulations to maximize food and feed safety." ;
              rdfs:label "SAFE_FEED_SAFE_FOOD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://safefeedsafefood.org/main/home.cfm" ;
              gdsn:sourceId "176932" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176933
gdsn:cv176933 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Safe Quality Food (SQF) program is recognized by retailers and foodservice providers around the world as a rigorous, credible food safety management system. It is the only certification system recognized by the Global Food Safety Initiative (GFSI) that offers certificates for primary production, food manufacturing, food packaging, distribution, retail/wholesale grocers and foodservice establishments. This enables suppliers to assure their customers that food has been produced, processed, prepared and handled according to the highest possible standards, at all levels of the supply chain." ;
              rdfs:label "SAFE_QUALITY_FOOD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.sqfi.com/" ;
              gdsn:sourceId "176933" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176934
gdsn:cv176934 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The United States Environmental Protection Agency (EPA) Safer Choice label helps consumers, businesses, and purchasers identify products which perform and contain ingredients that are safer for human health and the environment. The label is for products which meet requirements for: Safer chemical ingredients, Product performance, Packaging sustainability, Ingredient disclosure, Surveillance and audits, Volatile Organic Compounds (VOCs) emissions." ;
              rdfs:label "SAFER_CHOICE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.epa.gov/saferchoice/design-environment-programs-initiatives-and-projects" ;
              gdsn:sourceId "176934" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176935
gdsn:cv176935 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Salmon-Safe offers a series of peer-reviewed certification and accreditation programs linking site development land management practices with the protection of agricultural and urban watersheds." ;
              rdfs:label "SALMON_SAFE_CERTIFICATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://salmonsafe.org/" ;
              gdsn:sourceId "176935" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176936
gdsn:cv176936 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Seal that marks products which are certified and guaranteed regional from the Austrian province Salzburg. www.garantiert-regional.at" ;
              rdfs:label "SALZBURGER_LAND_HERKUNFT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.garantiert-regional.at" ;
              gdsn:sourceId "176936" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176937
gdsn:cv176937 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A symbol used in the Netherlands Target Market intended for meat based products which guarantees that the animals has been growth without the use of antibiotics." ;
              rdfs:label "SCHARRELVLEES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.producert.nl/activiteiten/scharrelvlees/" ;
              gdsn:sourceId "176937" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176938
gdsn:cv176938 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The label of the Chamber of Agriculture Schleswig-Holstein. All foods with this award are reviewed several times during a year by independent laboratories. Since product quality is closely linked to the process quality, the laboratories are testing the overall business as well. Through these measures, the requirements are met in terms of quality and taste of the label products." ;
              rdfs:label "SCHLESWIG_HOLSTEIN_QUALITY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.gzsh.de" ;
              gdsn:sourceId "176938" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176939
gdsn:cv176939 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vaad Hakashrus of Denver (Scroll K) Certification" ;
              rdfs:label "SCROLL_K" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://scrollk.org/" ;
              gdsn:sourceId "176939" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176940
gdsn:cv176940 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SCS Recycled Content Certification (RCC) recognizes products made either in whole or part from recycled waste material in place of virgin raw materials. The percentage of post-consumer or pre-consumer recycled content is reported in compliance with Federal Trade Commission guidelines and ISO standards." ;
              rdfs:label "SCS_RECYCLED_CONTENT_CERTIFICATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.scsglobalservices.com/services/recycled-content-certification" ;
              gdsn:sourceId "176940" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176941
gdsn:cv176941 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The certification program currently requires conformance with the Sustainably Grown Standard V1.3, which provides a comprehensive framework and common set of requirements grouped into three categories – Environmental Sustainability, Social & Economic Sustainability, and Product Integrity. Agricultural crops of all types and production systems of all sizes are eligible." ;
              rdfs:label "SCS_SUSTAINABLY_GROWN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.scsglobalservices.com/" ;
              gdsn:sourceId "176941" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176942
gdsn:cv176942 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SeaChoice was created to help Canadian businesses and shoppers take an active role in supporting sustainable fisheries and aquaculture at all levels of the seafood supply chain. Based on scientific assessments, SeaChoice has created easy-to-use tools that help you make the best seafood choices. Working in collaboration with the Monterey Bay Aquarium’s acclaimed Seafood Watch program, SeaChoice undertakes science-based seafood assessments, provides informative resources for consumers, and supports businesses through collaborative partnerships." ;
              rdfs:label "SEACHOICE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.seachoice.org/" ;
              gdsn:sourceId "176942" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176943
gdsn:cv176943 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Code indicating that the product should not be disposed as unsorted municipal waste but should be discarded at a respective separate collection point." ;
              rdfs:label "SEPARATE_COLLECTION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "Different links, depending on the product group, e.g.: electrical and electronic equipment: https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32012L0019&from=EN batteries: https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32006L0066&from=EN" ;
              gdsn:sourceId "176943" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176944
gdsn:cv176944 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Sustainable Furnishings Council (SFC) Member Seal is a label representing those companies which have made a public and verifiable commitment to sustainability and to improvement. These companies are involved in the home furnishings industry. The Exemplary status is voluntary - all members make a public and verifiable commitment to sustainability, to transparency, and to continuous improvement. This seal is for basic members." ;
              rdfs:label "SFC_MEMBER_SEAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://sustainablefurnishings.org/content/sfc-membership-benefits-your-company-our-future" ;
              gdsn:sourceId "176944" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176945
gdsn:cv176945 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Sustainable Furnishings Council (SFC) Member Seal is a label representing those companies which have made a public and verifiable commitment to sustainability and to improvement. These companies are involved in the home furnishings industry. The Exemplary status is voluntary - all members make a public and verifiable commitment to sustainability, to transparency, and to continuous improvement. This seal is for gold level members." ;
              rdfs:label "SFC_MEMBER_SEAL_GOLD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://sustainablefurnishings.org/content/sfc-membership-benefits-your-company-our-future" ;
              gdsn:sourceId "176945" ;
