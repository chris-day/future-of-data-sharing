###  urn:gs1:std:gdsn:cv172281
gdsn:cv172281 rdf:type owl:NamedIndividual ,
                       gdsn:c2034116970 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Ukrainian classification of goods of foreign economic activity (UCG FEA or UKT ZED translated in Ukrainian) is built on the basis of the Harmonised Commodity Description and Coding System and the Combined Nomenclature of the European Union and is used by the customs authorities of Ukraine for the classification of goods during customs clearance." ;
              rdfs:label "UKT_ZED" ;
              gdsn:codeListName "ImportClassificationTypeCode" ;
              gdsn:sourceId "172281" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172282
gdsn:cv172282 rdf:type owl:NamedIndividual ,
                       gdsn:c-1950800345 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The risk is transferred when the goods have effectively passed the ship's rail at the port of shipment. Insurance to be covered by the buyer." ;
              rdfs:label "CFR" ;
              gdsn:codeListName "IncotermsCode" ;
              gdsn:externalLink "http://www.unece.org/cefact/recommendations/rec_index.html" ;
              gdsn:sourceId "172282" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172283
gdsn:cv172283 rdf:type owl:NamedIndividual ,
                       gdsn:c-1950800345 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The risk is transferred when the goods have effectively passed the ship's rail at the port of shipment. Insurance to be covered by the seller." ;
              rdfs:label "CIF" ;
              gdsn:codeListName "IncotermsCode" ;
              gdsn:externalLink "http://www.unece.org/cefact/recommendations/rec_index.html" ;
              gdsn:sourceId "172283" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172284
gdsn:cv172284 rdf:type owl:NamedIndividual ,
                       gdsn:c-1950800345 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The risk is transferred when the goods are taken into custody by the first carrier. Insurance to be covered by the seller." ;
              rdfs:label "CIP" ;
              gdsn:codeListName "IncotermsCode" ;
              gdsn:externalLink "http://www.unece.org/cefact/recommendations/rec_index.html" ;
              gdsn:sourceId "172284" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172285
gdsn:cv172285 rdf:type owl:NamedIndividual ,
                       gdsn:c-1950800345 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The risk is transferred when the goods are taken into custody by the first carrier who has undertaken transportation from the place of departure. Insurance to be covered by the buyer." ;
              rdfs:label "CPT" ;
              gdsn:codeListName "IncotermsCode" ;
              gdsn:externalLink "http://www.unece.org/cefact/recommendations/rec_index.html" ;
              gdsn:sourceId "172285" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172286
gdsn:cv172286 rdf:type owl:NamedIndividual ,
                       gdsn:c-1950800345 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The risk is transferred when the goods are put at the disposal of the buyer at the named place at frontier. Insurance to be covered by the seller." ;
              rdfs:label "DAF" ;
              gdsn:codeListName "IncotermsCode" ;
              gdsn:externalLink "http://www.unece.org/cefact/recommendations/rec_index.html" ;
              gdsn:sourceId "172286" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172287
gdsn:cv172287 rdf:type owl:NamedIndividual ,
                       gdsn:c-1950800345 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The risk is transferred when the goods are put at the disposal of the buyer at the named place. Duty is paid. Insurance to be covered by the seller." ;
              rdfs:label "DDP" ;
              gdsn:codeListName "IncotermsCode" ;
              gdsn:externalLink "http://www.unece.org/cefact/recommendations/rec_index.html" ;
              gdsn:sourceId "172287" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172288
gdsn:cv172288 rdf:type owl:NamedIndividual ,
                       gdsn:c-1950800345 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The risk is transferred when the goods are put at the disposal of the buyer at the named place. Duty is not paid. Insurance to be covered by the seller." ;
              rdfs:label "DDU" ;
              gdsn:codeListName "IncotermsCode" ;
              gdsn:externalLink "http://www.unece.org/cefact/recommendations/rec_index.html" ;
              gdsn:sourceId "172288" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172289
gdsn:cv172289 rdf:type owl:NamedIndividual ,
                       gdsn:c-1950800345 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The risk is transferred when the goods have been effectively put at the disposal of the buyer on the quay at the port of destination. Insurance to be covered by the seller." ;
              rdfs:label "DEQ" ;
              gdsn:codeListName "IncotermsCode" ;
              gdsn:externalLink "http://www.unece.org/cefact/recommendations/rec_index.html" ;
              gdsn:sourceId "172289" ;
              gdsn:sourceType "codeValue" .


