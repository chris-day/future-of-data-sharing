gdsn:cv176992 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Swiss Allergy Label was launched in 2006 and now, thousands of certified food products pass over the counters of wholesalers and specialist shops. Various cosmetic lines, cleaning and technical products and other consumer goods bear the label." ;
              rdfs:label "SWISS_ALLERGY_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.service-allergie-suisse.ch/" ;
              gdsn:sourceId "176992" ;
              gdsn:sourceType "codeValue" .


