gdsn:cv176430 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The National Federation of Hunters (FNC) is a French fighter organization. It is chaired by Willy Schraen, who is also president of the departmental federation of hunters of the Pas-de-Calais, since August 2016. It brings together all the departmental and regional federations of hunters and represents approximately 1.1 million French hunters." ;
              rdfs:label "CHASSEURS_DE_FRANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
