gdsn:cv172268 rdf:type owl:NamedIndividual ,
                       gdsn:c2034116970 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The 11-digit code number based on the EU Combined Nomenclature (CN) coding system. It is for national use only, and is used, for example, to encode VAT rates, national bans or restrictions." ;
              rdfs:label "CUSTOMS_TARIFF_NUMBER" ;
