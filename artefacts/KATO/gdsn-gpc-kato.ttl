                       gdsn:c2147348061 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a product is naturally free from the substance specified in the ClaimElementCode. Note the amount that determines containment or lack of containment is based on target market regulations." ;
              rdfs:label "NATURALLY_FREE_FROM" ;
              gdsn:codeListName "ClaimTypeCode" ;
              gdsn:sourceId "180962" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180963
gdsn:cv180963 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348061 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a product is naturally high in the substance specified in the ClaimElementCode. Any claim likely to have the same meaning for the consumer, may only be made where the product contains the amount that determines containment or lack of containment is based on target market regulations." ;
              rdfs:label "NATURALLY_HIGH" ;
              gdsn:codeListName "ClaimTypeCode" ;
              gdsn:sourceId "180963" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180964
gdsn:cv180964 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348061 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a product is naturally low in the substance specified in the ClaimElementCode. Any claim likely to have the same meaning for the consumer, may only be made where the product contains the amount that determines containment or lack of containment is based on target market regulations." ;
