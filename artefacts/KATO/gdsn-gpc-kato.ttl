###  urn:gs1:std:gdsn:cv181052
gdsn:cv181052 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348320 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An attributional life cycle assessment (ALCA) is focusing on describing, assessing and quantifying environmentally relevant physical flows of specific life cycle(s) and its subsystems. An ALCA gives an estimate of what part of the global environmental burdens belongs to the study object. An ALCA does not include environmental benefits or other indirect consequences that arise outside the life cycle of the investigated product." ;
              rdfs:label "ATTRIBUTIONAL" ;
              gdsn:codeListName "CfpAccountingCode" ;
              gdsn:sourceId "181052" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181053
gdsn:cv181053 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348320 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A consequential life cycle assessment (CLCA) is focusing on describing, assessing and quantifying environmentally relevant flows and how they will change in response to possible decisions. A CLCA gives an estimate of how the production and use of the study object affect the global environmental burdens. For example, an increased use of a material in the studied system can lead to less material being used in other systems." ;
              rdfs:label "CONSEQUENTIAL" ;
              gdsn:codeListName "CfpAccountingCode" ;
              gdsn:sourceId "181053" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181054
gdsn:cv181054 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348317 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The emissions resulting from the distribution of the product to the retail network or to downstream stakeholders. This stage includes transport of the final product and its packaging, storage and warehousing." ;
              rdfs:label "TRANSPORT_FINAL_PRODUCT" ;
              gdsn:codeListName "CfpBoundariesCode" ;
              gdsn:sourceId "181054" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181055
gdsn:cv181055 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348317 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Total amount of CO2 emission from a life cycle assessment (LCA) model that assesses a product’s environmental footprint from raw materials extraction until it leaves the factory gate." ;
              rdfs:label "CRADLE_TO_GATE" ;
              gdsn:codeListName "CfpBoundariesCode" ;
              gdsn:sourceId "181055" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181056
gdsn:cv181056 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348317 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Total amount of CO2 emission from a life cycle assessment (LCA) model that assesses a product’s environmental footprint from raw materials extraction until its disposal, including manufacturing, transportation, product use." ;
              rdfs:label "CRADLE_TO_GRAVE" ;
              gdsn:codeListName "CfpBoundariesCode" ;
              gdsn:sourceId "181056" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181057
gdsn:cv181057 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348317 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The emissions resulting from the production/extraction, packaging, storage, warehousing and transportation of raw materials." ;
              rdfs:label "RAW_MATERIALS" ;
              gdsn:codeListName "CfpBoundariesCode" ;
              gdsn:sourceId "181057" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181058
gdsn:cv181058 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348317 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The emission of the product when it is disposed, recycled, recovered after use." ;
              rdfs:label "END_OF_LIFE" ;
              gdsn:codeListName "CfpBoundariesCode" ;
              gdsn:sourceId "181058" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181059
gdsn:cv181059 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348317 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The emissions resulting from the manufacturing/production of the product." ;
              rdfs:label "MANUFACTURING" ;
              gdsn:codeListName "CfpBoundariesCode" ;
              gdsn:sourceId "181059" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181060
gdsn:cv181060 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348317 ;
              dct:source "gdsn_codeValues.json" ;
