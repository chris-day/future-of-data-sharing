###  urn:gs1:std:gdsn:cv180321
gdsn:cv180321 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348050 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Waste from chemicals or use of chemicals. Such wastes ranges from harmless to toxic chemicals. Chemical waste is released directly or indirectly when chemicals are used. Examples are salts, acids and bases, heavy metals, cyanides, oxidants and reductants, volatile substances, ceramic, and contaminated glassware." ;
              rdfs:label "CHEMICAL_WASTE" ;
              gdsn:codeListName "TypeOfWasteCode" ;
              gdsn:sourceId "180321" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180322
gdsn:cv180322 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348050 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Hazardous waste that is released in healthcare institutions and requires special processing due to possible contamination or due to processing problems. This often concerns infectious waste, genetically modified waste and human parts, such as blood, tissue, bone, OR gauze, drainage canister and so on." ;
              rdfs:label "HAZARDOUS_MEDICAL_WASTE" ;
              gdsn:codeListName "TypeOfWasteCode" ;
              gdsn:sourceId "180322" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180323
gdsn:cv180323 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348050 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Waste that can be collected and recycled/melted into reusable raw materials, such as recycling plastic covering material into plastic granules or remelting disposable instruments into reusable steel." ;
              rdfs:label "RECYCLABLE_WASTE" ;
              gdsn:codeListName "TypeOfWasteCode" ;
              gdsn:sourceId "180323" ;
              gdsn:sourceType "codeValue" .


