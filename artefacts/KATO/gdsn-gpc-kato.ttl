                 rdfs:domain gdsn:extGroup_GS1_France_GDM_21_12 ;
                 rdfs:range xsd:string ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "New data associated with alcoholic beverages appeared with the implementation of C.I.E.L (Contributions Indirectes En Ligne) for the dematerialization of the main tax declarations in the field of indirect taxes._x000d_ _x000d_ The decree of March 26, 2018 provides for the mandatory use of online declaration and payment of duties by:_x000d_ September 1, 2019 for wine producers (harvesters-winemakers, traders-winemakers and cooperative wineries) ;_x000d_ December 31, 2019 for other operators in the indirect tax sector._x000d_ _x000d_ Official list (page 23, 24 and 25): https://www.douane.gouv.fr/sites/default/files/2020-12/21/Documentation_fonctionnelle_DTI%2B_v6.pdf" ;
                 rdfs:label "fiscalDescriptionCode" ;
                 gdsn:groupName "GS1 France GDM 21.12" ;
                 gdsn:hierarchyLevel 1 ;
                 gdsn:originalLimit "{1..255}" ;
                 gdsn:originalMultiplicity "0..1" ;
                 gdsn:sourceId "1267" ;
                 gdsn:sourceType "attribute" .


