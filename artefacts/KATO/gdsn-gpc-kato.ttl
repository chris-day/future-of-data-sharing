###  urn:gs1:std:gdsn:cv168700
gdsn:cv168700 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The NATO Item Identification Number (NIIN) (Last Nine (9) Digits of an NSN) is the fixed part of the NSN, and it remains associated with the IoS concept throughout its life cycle. However, the NSC (First Four (4) Digits) may change if there is a revision of the IoS Classification structure." ;
              rdfs:label "NIIN" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168700" ;
              gdsn:sourceType "codeValue" .


