                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A component in packaging to serve as protecting the product and/or also the packaging shape." ;
              rdfs:label "DIVIDER_PROTECTOR" ;
