###  urn:gs1:std:gdsn:cv174566
gdsn:cv174566 rdf:type owl:NamedIndividual ,
                       gdsn:c-907768995 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The highest-numbered page in a single numbered sequence of main content, usually the highest Arabic-numbered page in a book; or, for books without page numbers or (rarely) with multiple numbered sequences of main content, the total number of pages that carry the main content of the book. This is the preferred page count for most books for the general reader. For books with substantial front and/or back matter, include also Front matter and Back matter page counts, or Total numbered pages." ;
              rdfs:label "00" ;
              gdsn:codeListName "ONIXExtentTypeCode" ;
              gdsn:sourceId "174566" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174567
gdsn:cv174567 rdf:type owl:NamedIndividual ,
                       gdsn:c-907768995 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Number of words of natural language text" ;
              rdfs:label "02" ;
              gdsn:codeListName "ONIXExtentTypeCode" ;
              gdsn:sourceId "174567" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174568
gdsn:cv174568 rdf:type owl:NamedIndividual ,
                       gdsn:c-907768995 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The total number of numbered (usually Roman-numbered) pages that precede the main content of a book. This usually consists of an introduction, preface, foreword, etc." ;
              rdfs:label "03" ;
              gdsn:codeListName "ONIXExtentTypeCode" ;
              gdsn:sourceId "174568" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174569
gdsn:cv174569 rdf:type owl:NamedIndividual ,
                       gdsn:c-907768995 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The total number of numbered (usually Roman-numbered) pages that follow the main content of a book. This usually consists of an afterword, appendices, endnotes, index, etc." ;
              rdfs:label "04" ;
              gdsn:codeListName "ONIXExtentTypeCode" ;
              gdsn:sourceId "174569" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174570
gdsn:cv174570 rdf:type owl:NamedIndividual ,
                       gdsn:c-907768995 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The sum of all Roman- and Arabic-numbered pages." ;
              rdfs:label "05" ;
              gdsn:codeListName "ONIXExtentTypeCode" ;
