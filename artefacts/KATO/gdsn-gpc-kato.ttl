                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:decimal ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The height (in millimetres) of the pallet load of goods, including the pallet. Identifies the Unit of Measure for the Pallet Height field as millimetres. Supply at Level: CASE / Dispatch Unitsh" ;
