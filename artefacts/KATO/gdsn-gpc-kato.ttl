gdsn:cv176252 rdf:type owl:NamedIndividual ,
                       gdsn:c715725203 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The packaging is designed to show when there has been some interference with the original sealing or configuration of the packaging." ;
              rdfs:label "TAMPER_EVIDENT" ;
              gdsn:codeListName "PackagingFunctionCode" ;
