###  urn:gs1:std:gdsn:cv176999
gdsn:cv176999 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Swedish company that certifies products and services to provide a better environment." ;
              rdfs:label "TCO_DEVELOPMENT" ;
