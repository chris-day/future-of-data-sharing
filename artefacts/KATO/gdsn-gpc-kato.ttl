###  urn:gs1:std:gdsn:c1498
gdsn:c1498 rdf:type rdfs:Datatype ;
           dct:source "gdsn_classes.json" ;
           rdfs:comment "A value used to identify and distinguish uniquely, one instance of an object in an identification scheme from all other objects in the same scheme." ;
