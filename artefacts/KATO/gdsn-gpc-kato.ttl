              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The company responsible for the provision of the device's network service or provided service. AT&T, T-Mobile, Verizon, O2, etc.Use productCharacteristicValueString to populate value." ;
              rdfs:label "serviceProvider" ;
