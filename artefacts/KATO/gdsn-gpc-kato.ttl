###  urn:gs1:std:gdsn:cv169939
gdsn:cv169939 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Wild beer is brewed with something in addition to—or in place of—traditional brewer’s yeast, such as Brettanomyces." ;
