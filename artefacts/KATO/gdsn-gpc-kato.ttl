gdsn:cv176255 rdf:type owl:NamedIndividual ,
                       gdsn:c1456060589 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A label with the product information is attached to the packaging material." ;
              rdfs:label "LABEL_ON_PACKAGING" ;
              gdsn:codeListName "PackagingLabellingTypeCode" ;
