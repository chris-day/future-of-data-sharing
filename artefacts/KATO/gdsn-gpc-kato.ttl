                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Pale lager, aged in wood barrels, which is a very pale-to-golden-coloured lager beer with a well attenuated body and a varying degree of noble hop bitterness." ;
