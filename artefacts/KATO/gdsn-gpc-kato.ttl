###  urn:gs1:std:gdsn:cv170006
gdsn:cv170006 rdf:type owl:NamedIndividual ,
                       gdsn:c-936843132 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Broad spectrum CBD (cannabidiol) is a bit of a mix between Full Spectrum CBD and CBD Isolate. Like Full Spectrum CBD, the other compounds found within the plant are preserved in the extract; however, like CBD Isolate, THC is completely removed. Because Broad Spectrum CBD contains multiple cannabinoids, it can deliver the enhanced benefits of the “entourage effect,” without the risk of psychoactive effects of THC.Broad Spectrum contains all phytocannabinoids in the plant but does not contain any detectable amount of THC (tetrahydrocannabinol)." ;
              rdfs:label "BROAD_SPECTRUM" ;
              gdsn:codeListName "CannabisCBDTypeCode" ;
              gdsn:sourceId "170006" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170007
gdsn:cv170007 rdf:type owl:NamedIndividual ,
                       gdsn:c-936843132 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Full spectrum CBD (cannabidiol) is an extract that contains all compounds found naturally occurring in the plant, including terpenes, essential oils, and other cannabinoids.Full Spectrum refers to cannabis-derived from the whole plant that contains CBD and other phytocannabinoids such as THC (tetrahydrocannabinol) , CBN (cannabinol) , THCA (Tetrahydrocannabinolic acid), CBC (cannabichromene), and CBG (cannabigerol)." ;
              rdfs:label "FULL_SPECTRUM" ;
              gdsn:codeListName "CannabisCBDTypeCode" ;
              gdsn:sourceId "170007" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170008
gdsn:cv170008 rdf:type owl:NamedIndividual ,
                       gdsn:c-936843132 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Hemp seed oil is cold pressed from hemp seeds. It does not contain CBD (cannabidiol) or any phytocannabinoids." ;
              rdfs:label "HEMP_SEED_OIL" ;
              gdsn:codeListName "CannabisCBDTypeCode" ;
              gdsn:sourceId "170008" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170009
gdsn:cv170009 rdf:type owl:NamedIndividual ,
                       gdsn:c-936843132 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "CBD (cannabidiol) isolate is the purest form of CBD, which is produced by removing all other compounds found in the plant including terpenes, flavonoids, plant parts, and other cannabinoids. CBD isolate, which is a purified CBD molecule. CBD isolate is white and powdery in its appearance. It does not contain other phytocannabinoids like full or broad spectrum." ;
              rdfs:label "ISOLATE" ;
              gdsn:codeListName "CannabisCBDTypeCode" ;
              gdsn:sourceId "170009" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170010
gdsn:cv170010 rdf:type owl:NamedIndividual ,
                       gdsn:c-936843132 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Nano CBD (cannabidiol) is a compound where the molecules of CBD are shrunk down to extremely small sizes (less than 100nm) and turned into a water-based form. This process allows the CBD to pass through skin much more easily and quickly than any oil-based form." ;
              rdfs:label "NANO_CBD" ;
              gdsn:codeListName "CannabisCBDTypeCode" ;
              gdsn:sourceId "170010" ;
              gdsn:sourceType "codeValue" .


