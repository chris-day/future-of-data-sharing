###  urn:gs1:std:gdsn:cv177765
gdsn:cv177765 rdf:type owl:NamedIndividual ,
                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Liquid smoke is a natural by-product of burning wood. The vapor (smoke and steam), is condensed through a cooled tubing, is distilled into a concentrate, and filtered of its impurities (soot and ash). The meat product is subjected to heat in the presence of a vaporized liquid smoke solution." ;
              rdfs:label "LIQUID_SMOKE" ;
              gdsn:codeListName "PreparationTypeCode" ;
              gdsn:sourceId "177765" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177766
gdsn:cv177766 rdf:type owl:NamedIndividual ,
                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A process where an edible meat is obtained by removing most of the bone and cartilage from a comminuted meat product from which the bone and cartilage was not previously removed." ;
              rdfs:label "MECHANICALLY_SEPARATED_MEAT" ;
              gdsn:codeListName "PreparationTypeCode" ;
              gdsn:sourceId "177766" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177767
gdsn:cv177767 rdf:type owl:NamedIndividual ,
                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A process where the integrity of a solid and uncooked meat or poultry surface has been compromised by being pierced by blades, needles or other similar instruments, or the meat/poultry has been injected with a marinade or other tenderising solution." ;
              rdfs:label "MECHANICALLY_TENDERISE" ;
              gdsn:codeListName "PreparationTypeCode" ;
              gdsn:sourceId "177767" ;
              gdsn:sourceType "codeValue" .


