###  urn:gs1:std:gdsn:cv177645
gdsn:cv177645 rdf:type owl:NamedIndividual ,
                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A firm sheet of plastic, cardboard or other material which may be hooked or attached to a forklift or other transportation equipment. The slip sheet is used to pull products stacked on top of it. Use packaging dimension attributes to specify the size of the slip sheet." ;
              rdfs:label "9" ;
              gdsn:codeListName "PlatformTypeCode" ;
              gdsn:sourceId "177645" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177646
gdsn:cv177646 rdf:type owl:NamedIndividual ,
                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indication that the unit is despatched without a standardised layer (pattern) or platform type, e.g. individually packed and despatched." ;
              rdfs:label "98" ;
              gdsn:codeListName "PlatformTypeCode" ;
              gdsn:sourceId "177646" ;
