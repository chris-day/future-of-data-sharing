              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179762
gdsn:cv179762 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Concrete is an artificial stone-like material used as a building material. Modern concrete is composed of the binding agent cement and one or more aggregates such as sand, gravel or crushed stone." ;
              rdfs:label "CONCRETE" ;
