###  urn:gs1:std:gdsn:cv176948
gdsn:cv176948 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SGS Our services enable companies to operate in a more sustainable manner by improving quality and productivity, reducing risk, verifying compliance and increasing speed to market." ;
              rdfs:label "SGS_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.sgsgroup.at/" ;
