###  urn:gs1:std:gdsn:cv176435
gdsn:cv176435 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Seal for fair trade and ecologically and socially produced products from the south. Label owned by claro fair trade AG." ;
              rdfs:label "CLARO_FAIR_TRADE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.claro.ch/de/" ;
