              rdfs:comment "A product is formed or shaped into a larger geometric shape than what would be used for a serving or use. It is intended that the user would cut, slice, or otherwise separate portions of the item for individual consumption or use." ;
              rdfs:label "BLOCK_FORM" ;
              gdsn:codeListName "PreparationTypeCode" ;
