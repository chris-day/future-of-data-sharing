###  urn:gs1:std:gdsn:cv171166
gdsn:cv171166 rdf:type owl:NamedIndividual ,
                       gdsn:c-1609455609 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Stands for Music Video Interactive and is a DVD loaded with many features that plays in all standard DVD Players, computers, and game consoles with DVD drives. Digital files are compatible with all MP3 devices. Features include: * Full album audio with superior sound quality * Video content * MP3 files of every audio track for easy transfer to a computer or MP3 device * Interactive features to create user content * Digital booklets * Online access to additional artist information * May also contain digital extras including song lyrics, photo galleries, posters, wallpaper, screen savers, buddy icons, etc." ;
              rdfs:label "MVI" ;
              gdsn:codeListName "DistributionMediaTypeCode" ;
              gdsn:sourceId "171166" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171167
gdsn:cv171167 rdf:type owl:NamedIndividual ,
                       gdsn:c-1609455609 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This value represents a physical CD with 3 audio tracks (A-side, B-side & Remix) which can also include ringtones and wallpaper. This is a technology feature of the product and is used by consumers in arriving at a buying decision." ;
              rdfs:label "RINGLE" ;
              gdsn:codeListName "DistributionMediaTypeCode" ;
              gdsn:sourceId "171167" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171168
gdsn:cv171168 rdf:type owl:NamedIndividual ,
                       gdsn:c-1609455609 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Super Audio CD (SACD) is a high-resolution, read-only optical disc for audio storage" ;
              rdfs:label "SACD" ;
              gdsn:codeListName "DistributionMediaTypeCode" ;
              gdsn:sourceId "171168" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv171169
gdsn:cv171169 rdf:type owl:NamedIndividual ,
                       gdsn:c-1609455609 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This value represents Universal Media Disc. It is an optical disc medium developed by Sony for use on the PlayStation Portable. It can hold up to 1.8 gigabytes of data, which can include games, movies, music, or a combination thereof." ;
              rdfs:label "UMD" ;
              gdsn:codeListName "DistributionMediaTypeCode" ;
              gdsn:sourceId "171169" ;
              gdsn:sourceType "codeValue" .


