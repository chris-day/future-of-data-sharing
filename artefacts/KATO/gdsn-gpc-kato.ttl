###  urn:gs1:std:gdsn:cv177644
gdsn:cv177644 rdf:type owl:NamedIndividual ,
                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A portable, horizontal, perforated metal platform for storing, stacking and handling transporting goods as unit load, with dimensions 1545 x 1180 mm, suitable for lifting by a forklift, pallet jack, or other jacking device. Fits in the space of 1 EUR pallet." ;
              rdfs:label "53" ;
              gdsn:codeListName "PlatformTypeCode" ;
