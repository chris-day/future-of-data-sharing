###  urn:gs1:std:gdsn:cv179800
gdsn:cv179800 rdf:type owl:NamedIndividual ,
                       gdsn:c-569663405 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A television information retrieval services used in parts of Europe." ;
              rdfs:label "TELETEXT" ;
              gdsn:codeListName "TelevisionInformationServiceTypeCode" ;
              gdsn:sourceId "179800" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179801
gdsn:cv179801 rdf:type owl:NamedIndividual ,
                       gdsn:c-569663405 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Television information retrieval services used in Canada." ;
              rdfs:label "TELIDON" ;
              gdsn:codeListName "TelevisionInformationServiceTypeCode" ;
              gdsn:sourceId "179801" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179802
gdsn:cv179802 rdf:type owl:NamedIndividual ,
                       gdsn:c1860493606 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "(also historically known as centigrade) is a temperature scale, the freezing point of water is 0 degrees Celsius (°C) and the boiling point 100 °C (at standard atmospheric pressure), placing the boiling and freezing points of water exactly 100 degrees apart." ;
              rdfs:label "CEL" ;
              gdsn:codeListName "TemperatureMeasurementUnitCode" ;
              gdsn:sourceId "179802" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179803
gdsn:cv179803 rdf:type owl:NamedIndividual ,
                       gdsn:c1860493606 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "the freezing point of water is 32 degrees Fahrenheit (°F) and the boiling point 212 °F (at standard atmospheric pressure), placing the boiling and freezing points of water exactly 180 degrees apart." ;
              rdfs:label "FAH" ;
              gdsn:codeListName "TemperatureMeasurementUnitCode" ;
              gdsn:sourceId "179803" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179804
gdsn:cv179804 rdf:type owl:NamedIndividual ,
                       gdsn:c1860493606 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A unit of absolute temperature equal to 1/273.16 of the absolute temperature of the triple point of water. One Kelvin degree is equal to one Celsius degree." ;
              rdfs:label "KEL" ;
              gdsn:codeListName "TemperatureMeasurementUnitCode" ;
              gdsn:sourceId "179804" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179805
gdsn:cv179805 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Trade Item is in transport to the distribution center." ;
              rdfs:label "DELIVERY_TO_DISTRIBUTION_CENTRE" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179805" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179806
gdsn:cv179806 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Trade Item is in transport to market." ;
              rdfs:label "DELIVERY_TO_MARKET" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179806" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179807
gdsn:cv179807 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the temperature the product is to be maintained at for the process that eliminates many or all pathogenic microorganisms, except bacterial spores, on inanimate objects. In health-care settings, objects can be disinfected by liquid chemicals or wet pasteurisation." ;
              rdfs:label "DISINFECTION" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179807" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179808
gdsn:cv179808 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the temperature at which a gas or fluid is expected to be when entering a device, e.g., an electric pressure washer. The device may be damaged when the inlet temperature is outside the range of temperatures." ;
              rdfs:label "INLET_TEMPERATURE" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179808" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179809
gdsn:cv179809 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the temperature at which the product operates effectively. The product will operate effectively within a specified temperature range which varies based on the function and application context, and ranges from the minimum operating temperature to the maximum operating temperature (or peak operating temperature). Outside this range of safe operating temperatures the product may fail or the protective properties are no longer guaranteed." ;
              rdfs:label "OPERATING_TEMPERATURE" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179809" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179810
gdsn:cv179810 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the temperature the product should be sterilised at in accordance to supplier or local market regulations." ;
              rdfs:label "STERILISATION" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179810" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179811
gdsn:cv179811 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the temperature the product is to be maintained at after its seal has been broken and the product has been exposed to the elements." ;
              rdfs:label "STORAGE_AFTER_OPENING" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179811" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179812
gdsn:cv179812 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the temperature the product is to be maintained at after removing a product’s protective overwrap or moisture barrier." ;
              rdfs:label "STORAGE_AFTER_OVERWRAP" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179812" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179813
gdsn:cv179813 rdf:type owl:NamedIndividual ,
                       gdsn:c-903076686 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the temperature the product is to be maintained at after adding liquid to mix or dilute the product." ;
              rdfs:label "STORAGE_AFTER_RECONSTITUTION" ;
              gdsn:codeListName "TemperatureQualifierCode" ;
              gdsn:sourceId "179813" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179814
gdsn:cv179814 rdf:type owl:NamedIndividual ,
