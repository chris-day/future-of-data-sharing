###  urn:gs1:std:gdsn:cv174255
gdsn:cv174255 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pulp is the juicy, soft part inside of fruits. Many consumers would like to avoid fruit pulp in fruit juices for personal reasons." ;
              rdfs:label "PULP" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174255" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174256
gdsn:cv174256 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyvinyl Chloride (PVC) is a common, strong but lightweight plastic used in construction. It is made softer and more flexible by the addition of plasticizers." ;
              rdfs:label "PVC" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174256" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174257
gdsn:cv174257 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyvinyl Chloride (PVC) with Phthalates is a common, strong but lightweight plastic used in construction. It is made softer and more flexible by the addition of Phthalates, used to plasticise PVC." ;
              rdfs:label "PVC_WITH_PHTHALATES" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174257" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174258
gdsn:cv174258 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyvinyle Chloride (PVC) with Phthalates is a common, strong but lightweight plastic used in construction. It is made softer and more flexible by without the addition of Phthalates as plasticizers." ;
              rdfs:label "PVC_WITHOUT_PHTHALATES" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174258" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174259
gdsn:cv174259 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Raisins are dried grapes. The term \"raisins\" is both the generic term for all dried raisins and the specific term for the dried fruit of a particular grape variety." ;
              rdfs:label "RAISINS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174259" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174260
gdsn:cv174260 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The raspberry is the edible fruit of a multitude of plant species in the genus Rubus of the rose family, most of which are in the subgenus Idaeobatus." ;
              rdfs:label "RASPBERRIES" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174260" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174261
gdsn:cv174261 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Raw sugar derived from the sugar beet." ;
              rdfs:label "RAW_BEET_SUGAR" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174261" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174262
gdsn:cv174262 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Retinyl Palmitate (Vitamin A Palmitate) is an ingredient composed of palmitic acid and retinol (Vitamin A)." ;
              rdfs:label "RETINYL_PALMITATE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174262" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174263
gdsn:cv174263 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vitamin B2, corresponding to riboflavin, or lactoflavin, is a water-soluble vitamin necessary for the synthesis of flavine adenine dinucleotide and flavine mononucleotide, two essential cofactors for flavoproteins. Vitamin B2 plays an important role in converting simple foods (carbohydrates, fats and proteins) into energy. It is involved in muscle repair metabolism." ;
              rdfs:label "RIBOFLAVIN" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174263" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174264
gdsn:cv174264 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A wheat like cereal plant that tolerates poor soils and low temperatures." ;
              rdfs:label "RYE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174264" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174265
gdsn:cv174265 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a food is low in saturated fat, and any claim likely to have the same meaning for the consumer, may only be made where the product contains no more than 1.5g of saturates per 100g for solids or, 0.75g of saturates per 100ml for liquids and in either case saturated fat must not provide more than 10% of energy. In the case of foods naturally low in saturated fat, the term \"naturally\" may be used as a prefix to this claim." ;
              rdfs:label "SATURATED_FAT" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174265" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174266
gdsn:cv174266 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A liquid or semiliquid mixture that is added to a food as it cooks or that is served with it. Sauces provide flavour, moisture, and a contrast in texture and colour. They may also serve as a medium in which food is contained." ;
              rdfs:label "SAUCE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174266" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174267
gdsn:cv174267 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A seed is a plant's unit of reproduction, capable of developing into another such plant." ;
              rdfs:label "SEEDS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174267" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174268
