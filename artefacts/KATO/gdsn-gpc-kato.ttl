                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cooking food by employing microwave radiation" ;
              rdfs:label "MICROWAVE" ;
              gdsn:codeListName "PreparationTypeCode" ;
              gdsn:sourceId "177768" ;
              gdsn:sourceType "codeValue" .


