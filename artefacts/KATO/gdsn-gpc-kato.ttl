###  urn:gs1:std:gdsn:cv173069
gdsn:cv173069 rdf:type owl:NamedIndividual ,
                       gdsn:c-519231 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polystyrene (CAS 9003-53-6) is a plastic polymer from the monomer styrene. It comes in many forms: sheet, expanded or extruded foam, or as oriented polystyrene. What is commonly known as Styrofoam™ refers only to the extruded form of polystyrene." ;
              rdfs:label "PS" ;
              gdsn:codeListName "NonfoodIngredientOfConcernCode" ;
              gdsn:sourceId "173069" ;
              gdsn:sourceType "codeValue" .


