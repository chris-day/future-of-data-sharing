###  urn:gs1:std:gdsn:cv169646
gdsn:cv169646 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Battery dependent upon the reaction between zinc and manganese dioxide." ;
              rdfs:label "ALKALINE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169646" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169647
gdsn:cv169647 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The lithium–carbon monofluoride system has been among the more successful early commercial lithium miniature batteries. It has been used extensively in cameras and smaller devices, providing about 3.2 volts per cell, high power density, and long shelf life." ;
              rdfs:label "CARBON_MONOFLUORIDE_LITHIUM" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169647" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169648
gdsn:cv169648 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Zinc carbon batteries are dry cell primary batteries that deliver about 1.5 volts of direct current from the electrochemical reaction between zinc and manganese dioxide." ;
              rdfs:label "CARBON_ZINC" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169648" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169649
gdsn:cv169649 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Calcium batteries are a form of lead acid battery which are usually sealed and maintenance free. Calcium replaces antimony in the plates of the battery to give it improved resistance to corrosion, excessive gassing, less water usage and lower self discharge." ;
              rdfs:label "LEAD_CALCIUM" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169649" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169650
gdsn:cv169650 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Batteries which use sponge lead and lead peroxide for the conversion of the chemical energy into electrical power, are called lead acid batteries. They are most commonly used in power stations and substations because they have higher cell voltage and lower cost." ;
              rdfs:label "LEAD_ACID" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169650" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169651
gdsn:cv169651 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lithium air batteries are described as the \"ultimate\" batteries because they provide a high theoretical energy density of up to ten times the energy offered by regular lithium ion batteries." ;
              rdfs:label "LITHIUM_AIR" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169651" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169652
gdsn:cv169652 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lithium ion batteries utilizing cobalt are primary used in laptop computers." ;
              rdfs:label "LITHIUM_COBALT" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169652" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169653
gdsn:cv169653 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A lithium-ion battery or Li-ion battery (abbreviated as LIB) is a type of rechargeable battery. Lithium-ion batteries are commonly used for portable electronics and electric vehicles and are growing in popularity for military and aerospace applications." ;
              rdfs:label "LITHIUM_ION" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169653" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169654
gdsn:cv169654 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A type of battery in which lithium ions move from the anode to the cathode during discharge, and from the cathode to the anode when charged." ;
              rdfs:label "LITHIUM_ION_POLYMER" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169654" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169655
gdsn:cv169655 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lithium batteries are primary batteries that have metallic lithium as an anode. These types of batteries are also referred to as lithium manganese batteries. They stand apart from other batteries in their high charge density (long life) and high cost per unit. Depending on the design and chemical compounds used, lithium cells can produce voltages from 1.5 V (comparable to a zinc–carbon or alkaline battery) to about 3.7 V." ;
              rdfs:label "LITHIUM_MANGANESE_OXIDE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169655" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169656
gdsn:cv169656 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lithium ion batteries utilizing nickel and cobalt are primary used in automotive and power tool products." ;
              rdfs:label "LITHIUM_NICKEL" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169656" ;
              gdsn:sourceType "codeValue" .


