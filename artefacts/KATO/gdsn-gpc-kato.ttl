              rdfs:comment "Candela per Square Metre" ;
              rdfs:label "A24" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172544" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172545
gdsn:cv172545 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
