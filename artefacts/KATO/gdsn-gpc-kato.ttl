###  urn:gs1:std:gdsn:cv168576
gdsn:cv168576 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Australian Therapeutic Goods Administration (TGA) is a government organisation responsible for the regulation of therapeutic goods such as medicines and medical devices. Once a product is accepted for sale in Australia (via TGA approval) this item is listed on the Australian Register of Therapeutic Goods (ARTG). All goods within Australia, or to be exported from Australia, must be present on this list before they can be available. Information held in the database includes the name of the product, what it contains and manufacturer details." ;
              rdfs:label "ARTG_ID" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168576" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168577
gdsn:cv168577 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In Australia the federal government, through the Department of Health and Ageing, provide a rebate to private health hospitals or clinics to cover the cost of any prostheses that are fitted to a patient. This rebate is designed to cover the costs incurred by the provider. Every product is given a ‘billing code’ from the Department of Health and Ageing. This is used by the provider to communicate the rebate request to the government." ;
              rdfs:label "AU_PROSTHESES_REBATE_CODE" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168577" ;
              gdsn:sourceType "codeValue" .


