###  urn:gs1:std:gdsn:cv174194
gdsn:cv174194 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The mollusc is an invertebrate of a large phylum that includes snails, slugs, mussels, and octopuses. They have a soft, unsegmented body and live in aquatic or damp habitats, and most kinds have an external calcareous shell." ;
              rdfs:label "MOLLUSCS" ;
              gdsn:codeListName "ClaimElementCode" ;
