gdsn:cv180031 rdf:type owl:NamedIndividual ,
                       gdsn:c1329411021 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The distribution and use of this trade item is \"intramural\" (within the walls of a clinic or hospital). These products may not be always supplied through a hospital pharmacy and may be used directly at the clinic." ;
