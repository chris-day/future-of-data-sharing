                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a wave/dune pattern. Wave is inequality of the surface of a liquid expanse (sea, lake...) due to currents, wind; mass of water that rises and falls. And dune is mound, a hill of fine sand formed by the wind on the seaside or in the interior of deserts." ;
              rdfs:label "WAVE_DUNE" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177430" ;
              gdsn:sourceType "codeValue" .


