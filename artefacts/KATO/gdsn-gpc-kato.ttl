###  urn:gs1:std:gdsn:cv174794
gdsn:cv174794 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Demeter-Bund - The Demeter movement as an entrepreneurial network promotes the development of bio-dynamic economy, to secure the livelihoods of the world and to strengthen the positive people in his ministry. In cooperation contribute producers, processors, traders and consumers in partnership to shape the market." ;
              rdfs:label "10" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174794" ;
