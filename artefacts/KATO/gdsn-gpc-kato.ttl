###  urn:gs1:std:gdsn:cv174076
gdsn:cv174076 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cruelty to animals, also called animal abuse, animal neglect or animal cruelty, is the infliction by omission (animal neglect) or by commission by humans of suffering or harm upon any non-human. More narrowly, it can be the causing of harm or suffering for specific achievement, such as killing animals for food, for their fur or even their tusks; opinions differ about the extent of cruelty associated with a given method of slaughter." ;
              rdfs:label "ANIMAL_CRUELTY" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174076" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174077
gdsn:cv174077 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any scientific experiment or test in which a live animal is forced to undergo something that is likely to cause them pain, suffering, distress or lasting harm." ;
              rdfs:label "ANIMAL_TESTING" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174077" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174078
gdsn:cv174078 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Antibiotics are used in the care of livestock." ;
