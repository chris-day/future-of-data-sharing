###  urn:gs1:std:gdsn:cv177428
gdsn:cv177428 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a turbulence pattern that is a formation of vortices in a fluid. Many natural patterns are shaped by this complexity, including vortex streets, other effects of turbulent flow such as meanders in rivers. Or nonlinear interaction of the system." ;
              rdfs:label "TURBULENCE" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177428" ;
              gdsn:sourceType "codeValue" .


