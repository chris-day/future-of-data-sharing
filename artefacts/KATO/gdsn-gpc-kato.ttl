              rdfs:comment "Monounsaturated Fat" ;
              rdfs:label "MONO_UNSATURATED_FAT" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174197" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174198
gdsn:cv174198 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Monosodium glutamate (MSG, also known as sodium glutamate) is the sodium salt of glutamic acid, one of the most abundant naturally occurring non-essential amino acids. Monosodium glutamate is found naturally in tomatoes, cheese and other foods. MSG is used in the food industry as a flavour enhancer with an umami taste that intensifies the meaty, savoury flavour of food, as naturally occurring glutamate does in foods such as stews and meat soups." ;
              rdfs:label "MSG" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174198" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174199
gdsn:cv174199 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "More than one type of grain. Could be several whole grains, several refined grains or a combination of both." ;
              rdfs:label "MULTIGRAIN" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174199" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174200
gdsn:cv174200 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Mustard is a pungent-tasting yellow or brown paste made from the crushed seeds of certain plants, typically eaten with meat or used as a cooking ingredient. The yellow-flowered Eurasian plant of the cabbage family whose seeds are used to make this paste." ;
              rdfs:label "MUSTARD" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174200" ;
              gdsn:sourceType "codeValue" .


