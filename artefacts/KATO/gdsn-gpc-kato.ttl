###  urn:gs1:std:gdsn:cv176256
gdsn:cv176256 rdf:type owl:NamedIndividual ,
                       gdsn:c1456060589 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Physically printed on and a label attached to the packaging material containing the product information." ;
              rdfs:label "PRINTED_AND_LABEL_ON_PACKAGING" ;
              gdsn:codeListName "PackagingLabellingTypeCode" ;
              gdsn:sourceId "176256" ;
