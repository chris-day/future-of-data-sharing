gdsn:cv176756 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: Certified Green. Regional, California. First American sustainability program. Certifies the GRAPES NOT THE WINERY/WINEMAKING. Wines must contain 85% certified grapes. www.lodigrowers.com" ;
              rdfs:label "LODI_RULES_CODE" ;
