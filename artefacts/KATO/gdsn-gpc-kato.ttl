              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Packaging is designed to prevent leaking of the content specially when it is on powdered or liquid state." ;
              rdfs:label "SIFT_PROOF" ;
              gdsn:codeListName "PackagingFunctionCode" ;
              gdsn:sourceId "176251" ;
