###  urn:gs1:std:gdsn:extAttr1201
gdsn:extAttr1201 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:extGroup_US_NABCA ;
                 rdfs:range xsd:string ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "Products are either State Stock (SS), Bailment (BO), or Special Purchase Order Plan (SP). State Stock items are stocked by the state. Bailment items are when a state rents space in a warehouse and the supplier pays a fee to store the items there. Special Purchase Order Plan indicates whether the item is a special listing. This attribute identifes which of these three order types is appropriate." ;
                 rdfs:label "nABCAOrderType" ;
                 gdsn:example "BO; SS; SP" ;
                 gdsn:groupName "US NABCA" ;
                 gdsn:hierarchyLevel 2 ;
                 gdsn:originalLimit "{2..2}" ;
                 gdsn:originalMultiplicity "0..1" ;
                 gdsn:sourceId "1201" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:validationRules "Can only be populated with one of the three options: BO, SS, SP. Required." .


###  urn:gs1:std:gdsn:extAttr1202
gdsn:extAttr1202 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:extGroup_US_NABCA ;
                 rdfs:range xsd:string ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "Any remarks associated with the case price and/or the difference in the current price compared to the previous price.s" ;
                 rdfs:label "nABCAPriceRemarks" ;
                 gdsn:example "This is an increase due to increase in production costs." ;
                 gdsn:groupName "US NABCA" ;
                 gdsn:hierarchyLevel 12 ;
                 gdsn:originalLimit "{1..225}" ;
                 gdsn:originalMultiplicity "0..1" ;
                 gdsn:sourceId "1202" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:validationRules "Provide if applicable." .


