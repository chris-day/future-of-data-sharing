gdsn:cv176875 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "All packaging is carefully evaluated by A Plastic Planet’s Plastic Free Panel of world experts in all packaging materials." ;
