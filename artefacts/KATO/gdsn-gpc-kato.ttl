              rdfs:comment "A lithium battery that used metallic lithium as anode." ;
              rdfs:label "METAL_LITHIUM" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169661" ;
              gdsn:sourceType "codeValue" .


