###  urn:gs1:std:gdsn:cv176398
gdsn:cv176398 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Gluten Free Certification Program is available to those manufacturers & brand owners who produce gluten-free products. Manufacturers must comply with regulations governing gluten-free claims as set out by the Canadian Government." ;
              rdfs:label "CCA_GLUTEN_FREE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.glutenfreecert.com/certification/" ;
              gdsn:sourceId "176398" ;
