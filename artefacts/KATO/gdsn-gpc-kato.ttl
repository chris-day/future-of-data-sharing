###  urn:gs1:std:gdsn:cv174211
gdsn:cv174211 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Octyl methoxycinnamate or ethylhexyl methoxycinnamate or octinoxate is an organic compound that is an ingredient in some sunscreens and lip balms. It is an ester formed from methoxycinnamic acid and 2-ethylhexanol." ;
              rdfs:label "OCTINOXATE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174211" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174212
gdsn:cv174212 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Octocrylene is an organic compound used as an ingredient in sunscreens and cosmetics. It is an ester formed by the reaction of 3,3-diphenylcyanoacrylate with 2-ethylhexanol." ;
              rdfs:label "OCTOCRYLENE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174212" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174213
gdsn:cv174213 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Oil is a viscous liquid derived from petroleum, plant, animal fat or synthetic fat." ;
              rdfs:label "OIL" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174213" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174214
gdsn:cv174214 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Olive oil is a liquid fat obtained from olives, a traditional tree crop of the Mediterranean Basin, produced by pressing whole olives and extracting the oil. It is commonly used in cooking or as a salad dressing." ;
              rdfs:label "OLIVE_OIL" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174214" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174215
