###  urn:gs1:std:gdsn:cv171978
gdsn:cv171978 rdf:type owl:NamedIndividual ,
                       gdsn:c-367792059 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Zero-Suppressed identifier, also called a \"Zero Suppressed UPC\", is a compressed GTIN-12 (6-digits plus a check digit). The compression utilizes a GTIN-12, where the UPC Company Prefix begins with a zero, and contains a sequence of 4 or 5 zeroes in defined positions. These zeroes are removed during an encoding process to enable the resulting number to be placed into a UPC-E barcode." ;
              rdfs:label "ZERO_SUPPRESSED_GTIN" ;
              gdsn:codeListName "GS1TradeItemIdentificationKeyTypeCode" ;
              gdsn:sourceId "171978" ;
              gdsn:sourceType "codeValue" .


