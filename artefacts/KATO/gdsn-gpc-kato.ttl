###  urn:gs1:std:gdsn:cv176656
gdsn:cv176656 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ISNA® Canada has been providing Halal Certification service to the Muslim communities not only in Canada and the United States but throughout the Muslim world. ISNA® Canada developed its Halal Logo (see below) to be put on the packages certified by it to assure the Muslims that package contains the Halal food." ;
              rdfs:label "HALAL_ISLAMIC_SOCIETY_OF_NORTH_AMERICA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.isnahalal.ca/index.html" ;
