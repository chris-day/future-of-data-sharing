gdsn:cv177642 rdf:type owl:NamedIndividual ,
                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pallet 1000 x 1100 mm (100cms X 110cms). Standard sized pallet of dimensions 100 centimetres by 110 centimetres (cms). EDIFACT X9. This is contained in Recommendation 21 as AH https://www.unece.org/uncefact/codelistrecs.html" ;
              rdfs:label "51" ;
