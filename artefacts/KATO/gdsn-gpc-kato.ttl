###  urn:gs1:std:gdsn:cv168739
gdsn:cv168739 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This derivative of the National Drug Code (NDC) was created and is utilized by the Centers for Medicare and Medicaid Services (CMS). The Health Insurance Portability and Accountability Act (HIPAA) standard code set expects the NDC to be expressed in a 5-4-2 configuration. When necessary, a zero (“0”) will pad the labeler, product, or package code segments of the FDA NDC to ensure a fixed length in the 5-4-2 configuration. The CMS NDC, of uniform code length, is referenced in lists and databases of additional US government agencies (such as the UMLS) in place of the FDA NDC." ;
              rdfs:label "US_CMS_NDC" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168739" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168740
gdsn:cv168740 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The National Drug Code (NDC) of the United States of America is a unique 3-segment number, including dashes, assigned to each medication listed under Section 510 of the U.S. Federal, Food, Drug, and Cosmetics Act. This combination of numeric segments representing the labeler or vendor, product, and trade package size is the principal identifier for medications in the eyes of the U.S. Food and Drug Administration (FDA)." ;
              rdfs:label "US_FDA_NDC" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168740" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168741
gdsn:cv168741 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The identification code assigned from the WAND (Web Assisted Notification of Devices) database." ;
              rdfs:label "WAND_NUMBER" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168741" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168742
gdsn:cv168742 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The World Health Organization’s Prequalification ensures active pharmaceutical ingredients (APIs) and finished pharmaceutical products (FPPs) are safe, appropriate and meet stringent quality standards. In addition to medicines, WHO prequalification also covers in vitro diagnostics, vaccines and vector control products. https://extranet.who.int/prequal/content/what-we-do" ;
              rdfs:label "WHOPQN" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168742" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168743
gdsn:cv168743 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An additional identification number used to identify all medical supplies and drugs in the Netherlands when managing reimbursements for the items. The Z-Index number is assigned to every product by Z-Index, which is a regulatory body in the Netherlands for the healthcare industry." ;
              rdfs:label "Z_INDEX" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168743" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168744
