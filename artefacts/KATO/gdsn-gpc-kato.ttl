                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "English Style Pale ale is a top fermented beer, crafted originally in England, made with predominantly pale malt. The highest proportion of pale malts results in a lighter colour." ;
