###  urn:gs1:std:gdsn:cv180660
gdsn:cv180660 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This label confirms that products are plastic-free, but have to be packed in plastic due to sanitary reasons, such as medical appliances, children toys or similar." ;
              rdfs:label "FLUSTIX_PLASTIC_FREE_PRODUCT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://flustix.com/en/our-certification-marks/" ;
              gdsn:sourceId "180660" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180661
gdsn:cv180661 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The label confirms that products, especially liquid product contents, are microplastic-free. Flustix tests and certifies with its accredited partners on the basis of the only internationally respected and followed microplastic definition by European Chemicals Agency (ECHA) ." ;
              rdfs:label "FLUSTIX_PRODUCTS_FREE_FROM_MICROPLASTICS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://flustix.com/en/our-certification-marks/" ;
              gdsn:sourceId "180661" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180662
gdsn:cv180662 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The label confirms that products are fully or partly made from recycled plastics. The percentage of recycled plastics is determined by an audit analyzing the manufacturing process and products, including packaging. The certification is awarded for goods of any kind." ;
              rdfs:label "FLUSTIX_PRODUCTS_FROM_RECYCLED_PLASTICS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://flustix.com/en/our-certification-marks/" ;
              gdsn:sourceId "180662" ;
              gdsn:sourceType "codeValue" .


