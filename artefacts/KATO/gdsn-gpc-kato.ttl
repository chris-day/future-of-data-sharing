###  urn:gs1:std:gdsn:cv168624
gdsn:cv168624 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Most Owners or operators of places of business (also called establishments or facilities) that are involved in the production and distribution of medical devices intended for use in the United States (U.S.) are required to list the devices that are made at their facility and the activities that are performed on those devices. Registration and listing provides FDA with the location of medical device establishments and the devices manufactured at those establishments. Knowing where devices are made increases the nation’s ability to prepare for and respond to public health emergencies." ;
              rdfs:label "FDA_MEDICAL_DEVICE_LISTING" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168624" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168625
gdsn:cv168625 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
