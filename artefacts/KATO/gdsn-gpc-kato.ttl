###  urn:gs1:std:gdsn:cv181590
gdsn:cv181590 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348048 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product can be cleaned using sound waves sent through a cleaning fluid. Consult the Instructions for Use (IFU) or cleaning, disinfection and sterilisation regulations for the specifications of the frequency of the sound waves." ;
