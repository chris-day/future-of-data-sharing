###  urn:gs1:std:gdsn:cv176876
gdsn:cv176876 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Labelled on packaging \"Plastic in Filter\" of tobacco products with filters, and packaging for filters marketed for use in combination with tobacco products . Regulatory requirement of single-use plastic products have to be marked: EU regulation 2020/2151. Note: The language(s) on the label may vary by country." ;
              rdfs:label "PLASTIC_IN_FILTER_TOBACCO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32020R2151&from=EN" ;
              gdsn:sourceId "176876" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176877
gdsn:cv176877 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Labelled on beverage cups containing plastic. Regulatory requirement of single-use plastic products have to be marked: EU regulation 2020/2151. Note: The language(s) on the label may vary by country." ;
              rdfs:label "PLASTIC_IN_PRODUCT_BEVERAGE_CUPS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32020R2151&from=EN" ;
              gdsn:sourceId "176877" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176878
gdsn:cv176878 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Labelled on packaging of tampons and tampon applicators containing plastic. Regulatory requirement of single-use plastic in products have to be marked: EU regulation 2020/2151. Note: The language(s) on the label may vary by country." ;
              rdfs:label "PLASTIC_IN_PRODUCT_TAMPONS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32020R2151&from=EN" ;
              gdsn:sourceId "176878" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176879
gdsn:cv176879 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Labelled on packaging of personal wipes and sanitary towels (pads) containing plastic. Regulatory requirement of single-use plastic products have to be marked: EU regulation 2020/2151. Note: The language(s) on the label may vary by country." ;
              rdfs:label "PLASTIC_IN_PRODUCT_WIPES_SANITARY_PADS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://eur-lex.europa.eu/legal-content/EN/TXT/PDF/?uri=CELEX:32020R2151&from=EN" ;
              gdsn:sourceId "176879" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176880
gdsn:cv176880 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that partners ensure to compensate an equivalent amount of plastic brought to the market in cooperation with Plastic Bank. Plastic Bank neutralize the product’s plastic footprint and helps to improve lives by cleaning the environment." ;
              rdfs:label "PLASTIC_NEUTRAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://plasticbank.com/" ;
              gdsn:sourceId "176880" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176881
gdsn:cv176881 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The French agricultural organizations have created a common visual identity in order to highlight the French origin of agricultural products in this case potatoes: the signatures \"Agricultural Products of France\". Remarkable to their elegant silhouette in a tricolor pentagon that is available for each family of products, these signatures reflect the commitment of the professionals of the sectors to value the know-how, the territories and the French jobs. Covering a variety of productions, these signatures all have a common basis, which consists of four criteria: Origin France of the products concerned, The existence of specifications or regulations governing the use of the logo, A formal commitment from the operators of the sectors concerned wishing to use these logos, Controls performed by a third party." ;
              rdfs:label "POMMES_DE_TERRES_DE_FRANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.produitsagricolesdefrance.fr" ;
              gdsn:sourceId "176881" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176882
gdsn:cv176882 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Note: This code is being deprecated and will be removed in a future release. Please follow the migration for correct population. The purpose of the pregnancy icon is making clear to pregnant women that they should not drink alcoholic beverages. Legislation or self-regulation is country dependent." ;
              rdfs:label "PREGNANCY_WARNING" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:sourceId "176882" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176883
gdsn:cv176883 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Pro Nature Certified label is awarded to companies that meet the criteria of the Standard for all natural products and stands for the protection of nature. The principle of the standard is the certification of different products such as cosmetics, detergents, food supplements and other areas." ;
              rdfs:label "PRO_NATURE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.pro-nature.org" ;
              gdsn:sourceId "176883" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176884
gdsn:cv176884 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Swiss Foundation for cultural, historical and genetical diversity of plants and animals." ;
              rdfs:label "PRO_SPECIE_RARA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.prospecierara.ch/" ;
              gdsn:sourceId "176884" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176885
gdsn:cv176885 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pro-Terra Non-GMO Certification attribute includes all products that present a Pro-Terra Non-GMO logo." ;
              rdfs:label "PRO_TERRA_NON_GMO_CERTIFICATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.proterrafoundation.org/" ;
              gdsn:sourceId "176885" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176886
gdsn:cv176886 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pro-Cert provides professional organic certification services to the following Standards/Regulations: 1.The Canadian Organic Standard (CAN/CGSB - 32.310 and 32.311) and Organic Products Regulation (OPR) 2.Equivalency to the European Organic Program 3.The USDA National Organic Program (NOP) 4.The Quebec Organic Program (CARTV) 5.Japanese Agricultural Standard (JAS via CERES) 6.BIOSUISSE (Switzerland) - Data collection only 7.Brazil Organic Program (via IBD) The above programs provide global access for Pro-Cert clients. Unregulated countries accept these programs and arrangements for organic status." ;
              rdfs:label "PROCERT_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.pro-cert.org/en/certification/certification-programs" ;
              gdsn:sourceId "176886" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176887
gdsn:cv176887 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "proDERM address manufacturers of high quality products who do not fear an intense test.To meet qualification a the formula must meet current dermatological and toxicological standards. And the product must have been tested in two independent studies. These would usually be a consumer orientated study (i. e. a Use-test in which the products are self-applied at home) and a tolerability study (a patch test appropriate for the product)" ;
              rdfs:label "PRODERM" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.proderm.de/qualitaetssiegel/" ;
              gdsn:sourceId "176887" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176888
gdsn:cv176888 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Product of the Year™ is the world’s largest consumer-voted award for product innovation. Product of the Year is a champion of innovation, is voted on by consumers and is recognized globally. Product of the Year currently operates in 40 countries with the same goal: to guide consumers to the most innovative products in their market and reward the entrants for quality and innovation. In Canada, the Product of the Year seal is backed by the votes of thousands of Canadian consumers, serving as a shortcut for shoppers to save time and money. For entrants of the winning products, the award is a powerful marketing message proven to increase product awareness, trial and quality." ;
              rdfs:label "PRODUCT_OF_THE_YEAR_CONSUMER_SURVEY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://productoftheyear.ca/about/about-poy/" ;
              gdsn:sourceId "176888" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176889
gdsn:cv176889 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Originally designed to indicate the Breton origin of the product, the logo displays it in letters. It is during a family meal in Savoy that one of the Breton entrepreneurs hears from his brother, which for him, Savoyard, was representative of our region: a lighthouse, a map of Brittany, a light beam. This is how the current logo was born, on a corner of paper tablecloth. This sketch was brought back to Brittany and acclaimed by the members of the time. After two years of tests in stores, and a very favourable reception from Scarmor stores (E. Leclerc stores), the logo is adopted and the statutes are fixed in 1995." ;
              rdfs:label "PRODUIT_EN_BRETAGNE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.produitenbretagne.bzh/" ;
              gdsn:sourceId "176889" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176890
gdsn:cv176890 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Protected designation of origin is the name of an area, a specific place or, in exceptional cases, the name of a country, used as a designation for an agricultural product or a foodstuff, the entire product must be traditionally and ENTIRELY manufactured (prepared, processed AND produced) within the specific region and thus acquire unique properties. Protected Geographical Status (PGS) is a legal framework defined in European Union law to protect the names of regional foods." ;
              rdfs:label "PROTECTED_DESIGNATION_OF_ORIGIN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://ec.europa.eu/agriculture/quality/schemes" ;
              gdsn:sourceId "176890" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176891
gdsn:cv176891 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Protected geographical indication is the name of an area, a specific place or, in exceptional cases, the name of a country, used as a description of an agricultural product or a foodstuff, the entire product must be traditionally and at least PARTIALLY manufactured (prepared, processed OR produced) within the specific region and thus acquire unique properties. Protected Geographical Status (PGS) is a legal framework[1] defined in European Union law to protect the names of regional foods." ;
              rdfs:label "PROTECTED_GEOGRAPHICAL_INDICATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://ec.europa.eu/agriculture/quality/schemes" ;
              gdsn:sourceId "176891" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176892
gdsn:cv176892 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is physically marked with the Protected Harvest Certified symbol." ;
              rdfs:label "PROTECTED_HARVEST_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.protectedharvest.org/" ;
              gdsn:sourceId "176892" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176893
gdsn:cv176893 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The quality label \"Geprüfte Qualität Bayern\" is featuring agriculture and food industry of Bavaria. Support of the sign by the State of Bavaria, represented by the Bavarian State Ministry for Food, Agriculture and Forestry. The Ministry decides on the granting of licenses. The aim of the quality label is agricultural produce economic and nutritional products of high quality." ;
              rdfs:label "PROVEN_QUALITY_BAVARIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.gq-bayern.de" ;
              gdsn:sourceId "176893" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176894
gdsn:cv176894 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Seed leaf flag indicates vegetables, berries and flowers of Finnish origin. Its license is granted and monitored by the Finnish Horticultural Products Society. Products will be first-class quality and from environmentally friendly farming. Product quality is also monitored in stores. Vegetable products in connection with any vegetable raw material must be Finnish. www.sirkkalehti.fi ." ;
              rdfs:label "PUHTAASTI_KOTIMAINEN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.sirkkalehti.fi" ;
              gdsn:sourceId "176894" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176895
gdsn:cv176895 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Quality Assurance International (QAI) is a leading USDA-accredited organic product certifying agency. QAI is an active leader in the organic industry, advocating for high integrity organic. QAI is committed to ensuring organic integrity at every link in the organic production chain and providing excellent customer service, domestically and internationally. QAI is a member of the NSF International family of companies. NSF is a global leader in public health and safety. QAI's certification programs are designed to provide certification services throughout the supply chain. QAI certification assures compliance with organic standards for: agricultural producers, food processing facilities, integrated manufacturing operations, contract packing operations, traders, distributors, retailers, and ultimately consumers." ;
              rdfs:label "QAI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.qai-inc.com/about/" ;
              gdsn:sourceId "176895" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176896
gdsn:cv176896 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "QCS Offers Certification Internationally in All Areas of the Organic Supply Chain, as well as Several Food Safety and Ethical Certification Schemes." ;
              rdfs:label "QCS_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.qcsinfo.org/certifications/" ;
              gdsn:sourceId "176896" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176897
gdsn:cv176897 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "QS is a quality assurance scheme for fresh foodstuffs that involves all participants in the food industry – from farm to shop. By inspecting and integrating the entire supply chain, the QS certification mark creates the basis for increased food safety and well-founded trust from the consumers." ;
              rdfs:label "QS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.q-s.de/home_gb.html" ;
              gdsn:sourceId "176897" ;
              gdsn:sourceType "codeValue" .


