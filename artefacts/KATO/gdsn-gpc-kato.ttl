gdsn:cv169942 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A dark beer which has been aged in wood barrels. They range in colour from amber to dark reddish brown. They are characterized by their smooth malty flavour." ;
