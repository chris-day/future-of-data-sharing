###  urn:gs1:std:gdsn:cv180019
gdsn:cv180019 rdf:type owl:NamedIndividual ,
                       gdsn:c1329411021 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cash and carry is a form of trade in which goods are sold from a wholesale warehouse operated either on a self-service basis, or on the basis of samples or a combination of the two. This is sometimes referred to as club in some markets." ;
