                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Decibar" ;
              rdfs:label "X_DBA" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172881" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172882
gdsn:cv172882 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A pennyweight (abbreviated dwt or denarius weight) is a unit of mass that is equal to 24 grains, 1⁄20 of a troy ounce, 1⁄240 of a troy pound, and exactly 1.55517384 grams. (Usage- The pennyweight is the common weight used in the valuation and measurement of precious metals. Jewellers use the pennyweight in calculating the amount and cost of precious metals used in fabricating or casting jewellery. Similarly, dentists and dental labs still use the pennyweight as the measure of precious metals in dental crowns and inlays.)" ;
              rdfs:label "X_DWT" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172882" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172883
gdsn:cv172883 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "One Hundredth of an inch or 0.01. (Usage- Measurements of Papers, Films, Circuit boards and the like)" ;
              rdfs:label "X_HIN" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172883" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172884
gdsn:cv172884 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "International Units per Kilogram (IU/kg) a unit of activity or potency for vitamins, hormones, or other substances, defined individually for each substance in terms of the activity of a standard quantity or preparation." ;
              rdfs:label "X_IUK" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172884" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172885
gdsn:cv172885 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A count of attenuation steps or dilution levels representing the homeopathic potency of a substance using the Korsakovian (K) method of attenuation; commonly denoted as CK1, CK2, CK3, etc.Each centesimal attenuation step represents one part source material combined with 99 parts dilution medium; commonly denoted as C1, C2, C3, etc." ;
              rdfs:label "X_KVN" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172885" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172886
