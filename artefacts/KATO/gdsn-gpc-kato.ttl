###  urn:gs1:std:gdsn:cv169826
gdsn:cv169826 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Baltic Style Porter is a dark style of beer made from brown malt, crafted originally around the Baltic Sea." ;
