                 rdfs:range xsd:float ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "The approximate number of servings contained in the package. This is an integer denoting the servings, however according to FDA/USDA labeling regulations, the value can contain provide half servings between 1 and 6 servings. For example the value can be 2.5, but can not be 10.5." ;
                 rdfs:label "servingsPerPackage" ;
                 gdsn:example "2.5" ;
                 gdsn:groupName "US FoodService" ;
                 gdsn:hierarchyLevel 1 ;
                 gdsn:originalLimit "{1..3}" ;
                 gdsn:originalMultiplicity "0..1" ;
                 gdsn:sourceId "1216" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:validationRules "Value must be a whole number if the value is greater than or equal to 6. Values less than 6, must be any of these values 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, or 5.5." .


