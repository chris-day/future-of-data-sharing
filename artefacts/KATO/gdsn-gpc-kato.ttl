###  urn:gs1:std:gdsn:extAttr1172
gdsn:extAttr1172 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:extGroup_GS1_US_Healthcare ;
                 rdfs:range xsd:float ;
                 dct:source "gdsn_extendedAttributes.json" ;
