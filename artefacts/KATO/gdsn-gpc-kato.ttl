                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Love Irish Food - a promotional label printed on the product packaging to indicate to the consumer that the food is manufactured in Ireland using Irish ingredients. http://www.loveirishfood.ie/" ;
