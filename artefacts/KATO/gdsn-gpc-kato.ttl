###  urn:gs1:std:gdsn:cv176257
gdsn:cv176257 rdf:type owl:NamedIndividual ,
                       gdsn:c1456060589 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product information is physically printed on the packaging material." ;
              rdfs:label "PRINTED_ON_PACKAGING" ;
              gdsn:codeListName "PackagingLabellingTypeCode" ;
              gdsn:sourceId "176257" ;
