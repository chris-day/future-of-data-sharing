                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A portable, horizontal, rigid platform used as a base for assembling, storing, stacking, handling and transporting goods as a unit load, suitable for lifting by a forklift, pallet jack, or other jacking device." ;
