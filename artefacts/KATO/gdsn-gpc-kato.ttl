                       gdsn:c2147348105 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "(Waren Wirtschafts System): A colour code system used in Germany for the standardisation of colours within the fashion/apparel sector." ;
              rdfs:label "8" ;
              gdsn:codeListName "ColourCodeListCode" ;
              gdsn:sourceId "170481" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170482
gdsn:cv170482 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348105 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "RAL: Farbsystem RAL colour system is an international colour standard for professional users of colours in industry, trade, architecture and design since 1927. RAL is an independent and neutral partner for industry and trade. http://www.ral.de." ;
              rdfs:label "9" ;
              gdsn:codeListName "ColourCodeListCode" ;
              gdsn:sourceId "170482" ;
              gdsn:sourceType "codeValue" .


