              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Zambia Medicines Regulatory Authority (ZAMRA) manages the market authorisation of healthcare products in Zambia - ZM" ;
              rdfs:label "ZAMRA" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168744" ;
