###  urn:gs1:std:gdsn:cv177629
gdsn:cv177629 rdf:type owl:NamedIndividual ,
                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A rigid platform with integrated restraints to prevent horizontally orientated cylindrical containers from slipping. Horizontal Drum Pallets are used for assembling, storing, stacking, handling and transporting cylindrical containers, e.g. drums, barrels, or kegs, as a unit load, suitable for lifting by a forklift, pallet jack, or other jacking device." ;
              rdfs:label "38" ;
              gdsn:codeListName "PlatformTypeCode" ;
