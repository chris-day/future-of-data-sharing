                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Austria Ministry of Agriculture Organic Label, AMA Marketing licenses the AMA organic logo. Red, white and black indicates the majority of ingredients are of Austrian origin." ;
              rdfs:label "AMA_ORGANIC_SEAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
