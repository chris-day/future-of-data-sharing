###  urn:gs1:std:gdsn:cv170508
gdsn:cv170508 rdf:type owl:NamedIndividual ,
                       gdsn:c-613156730 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A comb filter that averages the signal from the line before and after it to obtain a more accurate cancellation." ;
              rdfs:label "3_LINE_DIGITAL" ;
              gdsn:codeListName "CombFilterTechnologyTypeCode" ;
              gdsn:sourceId "170508" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170509
gdsn:cv170509 rdf:type owl:NamedIndividual ,
                       gdsn:c-613156730 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The 3 dimensional illusion is created using glasses that block the images to each eye in rapid succession. The glasses shutter open and closed faster than you can see. The end result is that each eye sees a different image, producing a 3D effect." ;
              rdfs:label "3D_ACTIVE" ;
              gdsn:codeListName "CombFilterTechnologyTypeCode" ;
              gdsn:sourceId "170509" ;
              gdsn:sourceType "codeValue" .


