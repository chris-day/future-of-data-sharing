                 rdfs:domain gdsn:extGroup_GS1_France_GDM_21_12 ;
                 rdfs:range xsd:string ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "The CLP class corresponds to the nature of the physical, health or environmental hazard. The CLP hazard category is the division of the criteria within each hazard class specifying the severity of the hazard._x000d_ This information appears to be the minimum data for the ecommerce." ;
