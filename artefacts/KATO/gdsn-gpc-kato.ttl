###  urn:gs1:std:gdsn:cv179681
gdsn:cv179681 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of a genus (Anolis) of arboreal American lizards that have a brightly colored dewlap and some with the ability to change colour." ;
              rdfs:label "ANOLES" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179681" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179682
gdsn:cv179682 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as invertebrates having jointed limbs and a segmented body with an exoskeleton made of chitin. These animals are mainly predatory. Includes animals such as spiders and scorpions." ;
              rdfs:label "ARACHNID" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179682" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179683
gdsn:cv179683 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of various Australian agamid lizards (genus Pogona synonym Amphibolurus) having spiny scales and an expandable pouch below the throat." ;
              rdfs:label "BEARDED_DRAGONS" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179683" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179684
gdsn:cv179684 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as vertebrate animals characterized primarily by feathers and forelimbs modified as wings. Includes animals such as chicken, geese and emus." ;
              rdfs:label "BIRD" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179684" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179685
gdsn:cv179685 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as dull and slow-moving, stolid mammals. These animals are usually raised as livestock for meat, dairy and leather purposes." ;
              rdfs:label "BOVINE" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179685" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179686
gdsn:cv179686 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as an animal of the feline species which are small to medium sized cats compared to the big cats or genus Panthera, which refers to Tigers, Lions, Jaguars and Leopards. Cats are carnivorous animals. These animals have evolved into hundreds of different breeds and are a very common domesticated pet around the world. Includes felines such as the Domestic cat and Manx cat." ;
              rdfs:label "CAT" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179686" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179687
gdsn:cv179687 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as any of various aquatic, chiefly marine mammals of the order Cetacea, characterized by a nearly hairless body, anterior limbs modified into broad flippers, vestigial posterior limbs, and a flat notched tail. Includes whales, dolphins and porpoises." ;
              rdfs:label "CETACEAN" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179687" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179688
gdsn:cv179688 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A small slow-moving Old World lizard with a prehensile tail, long extensible tongue, protruding eyes that rotate independently, and a highly developed ability to change color." ;
              rdfs:label "CHAMELEONS" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179688" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179689
gdsn:cv179689 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Either of two small South American rodents (Chinchilla laniger and C. brevicaudata of the family Chinchillidae) of the high Andes that are the size of large squirrels and have very soft pearly-gray fur." ;
              rdfs:label "CHINCHILLA" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179689" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179690
gdsn:cv179690 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as invertebrates that have a segmented body, a hard external skeleton (exoskeleton), two sets of antennae and one pair of legs per body segment. These animas live in marine coastal environment. Includes animals such as shrimp, lobster and crabs." ;
              rdfs:label "CRUSTACEAN" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179690" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179691
gdsn:cv179691 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as any of various fissiped mammals with nonretractile claws and typically long muzzles. These animals have evolved into hundreds of different breeds and are a very common domesticated pet around the world. Includes animals such as the Alsatian as well as the Pitbull Terrier." ;
              rdfs:label "DOG" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179691" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179692
gdsn:cv179692 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as hoofed mammals having slender legs and a flat coat with a narrow mane along the back of the neck. Includes such animals as zebras, stallions and mules." ;
              rdfs:label "EQUINE" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179692" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179693
gdsn:cv179693 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as gill breathing aquatic vertebrate, generally with fins, which are apt for locomotion and sustentation in the water. Includes animals such as the blue shark as well as all colourful tropical fish." ;
              rdfs:label "FISH" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179693" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179694
gdsn:cv179694 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of numerous small chiefly tropical and nocturnal lizard that has adhesive pads on the feet to assist in climbing on smooth surfaces." ;
              rdfs:label "GECKOS" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179694" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179695
gdsn:cv179695 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of numerous Old World burrowing desert rodents (Gerbillus and related genera) with long hind legs adapted for leaping." ;
              rdfs:label "GERBIL" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179695" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179696
gdsn:cv179696 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as being or pertaining to or resembling a goat or goats. These can include any of numerous agile ruminants related to sheep but having a beard and straight horns. Includes mountain goats." ;
              rdfs:label "GOAT" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179696" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179697
gdsn:cv179697 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A small stout-bodied short-eared tailless domesticated rodent (Cavia porcellus) of South American origin often kept as a pet and widely used in biological research." ;
              rdfs:label "GUINEA_PIG" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179697" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179698
gdsn:cv179698 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of a subfamily (Cricetinae) of small Old World rodents having very large cheek pouches." ;
              rdfs:label "HAMSTER" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179698" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179699
gdsn:cv179699 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as large-brained, with three-dimensional colour vision and grasping hands. Humans are distinguished from other primates by their bipedal locomotion, and especially by their relatively larger brain with its particularly well developed neocortex, prefrontal cortex and temporal lobes, which enable high levels of abstract reasoning, language, problem solving, and culture through social learning." ;
              rdfs:label "HUMAN" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179699" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179700
gdsn:cv179700 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of various large chiefly herbivorous usually green or brownish tropical American lizards (family Iguanidae, the iguana family) that have a serrated dorsal crest and large dewlap." ;
              rdfs:label "IGUANAS" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179700" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179701
gdsn:cv179701 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as small air-breathing arthropods with three pairs of legs and jaws. These animals have an exoskeleton and thrive in all environments. Includes animals such as ants, beetles and the butterfly." ;
              rdfs:label "INSECT" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179701" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179702
gdsn:cv179702 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of numerous small rodents (as of the genus Mus) with pointed snout, rather small ears, elongated body, and slender tail." ;
              rdfs:label "MOUSE" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179702" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179703
gdsn:cv179703 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as any of omnivorous, even-toed animals the family Suidae, which typically have a stout body, thick skin, a short neck, and a movable snout. Includes such animals as pigs, hogs and boars." ;
              rdfs:label "PIG" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179703" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179704
gdsn:cv179704 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as large-brained, mostly tree-dwelling mammals with three-dimensional colour vision and grasping hands. Includes animals such as monkeys and lemurs. Excludes humans." ;
              rdfs:label "PRIMATE" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179704" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179705
gdsn:cv179705 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as any of various herbivorous mammals having fully furred feet and two pairs of upper incisors and belonging to the order Lagomorpha. Includes rabbits, hares, and pikas." ;
              rdfs:label "RABBIT" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179705" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179706
gdsn:cv179706 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of numerous rodents (Rattus and related genera) differing from the related mice especially by considerably larger size." ;
              rdfs:label "RAT" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179706" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179707
gdsn:cv179707 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as any of various cold-blooded, usually egg-laying vertebrates of the class Reptilia, having an external covering of scales or horny plates and breathing by means of lungs. Includes snakes, lizards, crocodiles and turtles." ;
              rdfs:label "REPTILE" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179707" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179708
gdsn:cv179708 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as warm-blooded animals that have two incisors in the upper and lower jaw that grow continuously and must be kept worn down by gnawing. Includes animals such as rats, mice, squirrels and beavers." ;
              rdfs:label "RODENT" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179708" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179709
gdsn:cv179709 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes any animals that may be described/observed as any of usually horned ruminant animals of the genus Ovis in the family Bovidae. Includes both wild and domesticated species." ;
              rdfs:label "SHEEP" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179709" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179710
gdsn:cv179710 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A common name that is applied most often to land snails, terrestrial pulmonate gastropod molluscs. However, the common name \"snail\" is also applied to most of the members of the molluscan class Gastropoda that have a coiled shell that is large enough for the animal to retract completely into. When the word \"snail\" is used in this most general sense, it includes not just land snails but also thousands of species of sea snails and freshwater snails." ;
              rdfs:label "SNAIL" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179710" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179711
gdsn:cv179711 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any reptile of the order Testudines, comprising aquatic and terrestrial species having the trunk enclosed in a shell consisting of a dorsal carapace and a ventral plastron." ;
              rdfs:label "TURTLES" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179711" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179712
gdsn:cv179712 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This term is used to describe those animal attributes that are unable to be classified within their specific market" ;
              rdfs:label "UNCLASSIFIED" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179712" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179713
gdsn:cv179713 rdf:type owl:NamedIndividual ,
                       gdsn:c-2082306421 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product is intended to be used on all types of hair." ;
              rdfs:label "ALL_TYPES" ;
              gdsn:codeListName "TargetHairTypeCode" ;
              gdsn:sourceId "179713" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179714
gdsn:cv179714 rdf:type owl:NamedIndividual ,
                       gdsn:c-2082306421 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Hair that has been chemically treated, often during the process of perming, straightening or curling." ;
              rdfs:label "CHEMICALLY_TREATED" ;
              gdsn:codeListName "TargetHairTypeCode" ;
              gdsn:sourceId "179714" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179715
gdsn:cv179715 rdf:type owl:NamedIndividual ,
                       gdsn:c-2082306421 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Naturally coarse hair has strands that are thicker and wider in circumference than other hair types." ;
              rdfs:label "COARSE" ;
              gdsn:codeListName "TargetHairTypeCode" ;
              gdsn:sourceId "179715" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179716
gdsn:cv179716 rdf:type owl:NamedIndividual ,
                       gdsn:c-2082306421 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The practice of changing the hair colour." ;
              rdfs:label "COLOURED_DYED" ;
              gdsn:codeListName "TargetHairTypeCode" ;
              gdsn:sourceId "179716" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179717
gdsn:cv179717 rdf:type owl:NamedIndividual ,
                       gdsn:c-2082306421 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Curly is wavy, coiled, or spiral-shaped." ;
              rdfs:label "CURLY" ;
              gdsn:codeListName "TargetHairTypeCode" ;
              gdsn:sourceId "179717" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179718
gdsn:cv179718 rdf:type owl:NamedIndividual ,
                       gdsn:c-2082306421 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Hair damage occurs when parts of the hair structure are altered, which weakens hair and sets off a domino effect of noticeable results that look and feel like unhealthy hair." ;
              rdfs:label "DAMAGED" ;
