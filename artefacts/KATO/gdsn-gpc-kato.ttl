###  urn:gs1:std:gdsn:cv169866
gdsn:cv169866 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Field beer is made with vegetables and herbs which are added during any portion of the brewing process, providing obvious yet harmonious qualities." ;
              rdfs:label "FIELD_BEER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169866" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169867
gdsn:cv169867 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Flanders Red ale or Flemish red brown, is a style of sour ale. Flanders red ale is fermented with organisms other than Saccharomyces cerevisiae, especially Lactobacillus, which produces a sour character attributable to lactic acid." ;
              rdfs:label "FLANDERS_RED_ALE" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169867" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169868
gdsn:cv169868 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foreign Extra Stout is brewed with generous hops and roasted barley for a bittersweet balance and full-flavoured, natural bite. Developed for export, the addition of extra hops ensured this Stout would arrive in perfect condition." ;
              rdfs:label "FOREIGN_EXTRA_STOUT" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169868" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169869
gdsn:cv169869 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "French & Belgian Style Saison is a pale ale, crafted originally in France and Belgium, that is highly carbonated, fruity, spicy, and often bottle conditioned." ;
              rdfs:label "FRENCH_AND_BELGIAN_STYLE_SAISON" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169869" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169870
gdsn:cv169870 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bière de Garde, or \"keeping beer\", is a pale ale usually brewed by farmhouses in the winter and spring, to avoid unpredictable problems with the yeast during the summertime." ;
              rdfs:label "FRENCH_STYLE_BIèRE_DE_GARDE" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169870" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169871
gdsn:cv169871 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fruit Lambic beers include gueuze and kriek Lambic and infused with fruit flavours. Lambic differs from most other beers in that it is fermented through exposure to wild yeasts and bacteria, as opposed to exposure to carefully cultivated strains of brewer's yeast. This process gives the beer its distinctive flavour: dry, vinous, and cidery, usually with a sour aftertaste." ;
              rdfs:label "FRUIT_LAMBIC" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169871" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169872
gdsn:cv169872 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Wheat beer which has added fruit flavourings." ;
              rdfs:label "FRUIT_WHEAT_BEER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169872" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169873
gdsn:cv169873 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Altbier is a style of beer which is top-fermented, an older method than the bottom fermentation of other lager beers." ;
              rdfs:label "GERMAN_STYLE_ALTBIER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169873" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169874
gdsn:cv169874 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bock is a strong lager of German origin. Several substyles exist, including maibock (helles bock, heller bock), a paler, more hopped version generally made for consumption at spring festivals; doppelbock (double bock), a stronger and maltier version; and eisbock, a much stronger version made by partially freezing the beer and removing the ice that forms." ;
              rdfs:label "GERMAN_STYLE_BOCK" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169874" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169875
gdsn:cv169875 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "German Style Doppelbock is a stronger version of traditional bock, crafted originally in Germany. Historically, Doppelbock was high in alcohol and sweet, thus serving as \"liquid bread\" for the Friars during times of fasting, when solid food was not permitted. Today, Doppelbock is still strong—ranging from 7%–12% or more by volume." ;
              rdfs:label "GERMAN_STYLE_DOPPELBOCK" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169875" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169876
gdsn:cv169876 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "German Style Eisbock is a traditional specialty beer, originally crafted in Germany, made by partially freezing a Doppelbock and removing the water ice to concentrate the flavour and alcohol content, which ranges from 9% to 13% by volume." ;
              rdfs:label "GERMAN_STYLE_EISBOCK" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169876" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169877
gdsn:cv169877 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The maibock style, also known as helles bock or heller bock, is a helles lager brewed to bock strength; therefore, still as strong as traditional bock, but lighter in colour and with more hop presence." ;
              rdfs:label "GERMAN_STYLE_HELLER_BOCK_MAIBOCK" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169877" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169878
gdsn:cv169878 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Dortmunder Export or Dortmunder is a pale lager. It is a soft-textured beer influenced by the Pilsner lager brewed in Pilsen." ;
              rdfs:label "GERMAN_STYLE_HELLES_EXPORTBIER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169878" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169879
gdsn:cv169879 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Kölsch is a style of beer originating in Cologne, Germany. It has an original gravity between 11 and 16 degrees Plato (specific gravity of 1.044 to 1.065). In appearance, it is bright and clear with a straw-yellow hue. \"Kölsch\" has had a protected geographical indication (PGI) within the European Union, indicating a beer that is made within 50 km/30 miles of the city of Köln and brewed according to the Kölsch Konvention as defined by the members of the Köln Brewery Association (Kölner Brauerei-Verband)." ;
              rdfs:label "GERMAN_STYLE_KOELSCH" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169879" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169880
gdsn:cv169880 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This German wheat beer has a lighter mouthfeel than a traditional hefeweizen. Leichtes weizen is bright and refreshing with notes of banana, clove and sweet bread highlighted in its aroma and flavour." ;
              rdfs:label "GERMAN_STYLE_LEICHTES_WEIZEN" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169880" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169881
gdsn:cv169881 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "German Style Märzen or Märzenbier is a lager, crafted originally in Germany, with a medium to full body and may vary in colour from pale through amber to dark brown." ;
              rdfs:label "GERMAN_STYLE_MAERZEN" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169881" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169882
gdsn:cv169882 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lager which is brewed to celebrate Oktoberfest." ;
              rdfs:label "GERMAN_STYLE_OKTOBERFEST_WIESN" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169882" ;
              gdsn:sourceType "codeValue" .


