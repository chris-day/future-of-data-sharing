###  urn:gs1:std:gdsn:cv174906
gdsn:cv174906 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Bureau de normalisation du Québec (BNQ) is accredited by the Standards Council of Canada (SCC) as a certification organization. This accreditation guarantees the BNQ’s impartiality in the process, and the BNQ’s compliance with SCC requirements, as well as those of the International Organization for Standardization (ISO) in terms of competence and ethical practices." ;
              rdfs:label "CAN_BNQ_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bnq.qc.ca/en/certification.html" ;
