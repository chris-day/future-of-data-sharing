gdsn:cv174553 rdf:type owl:NamedIndividual ,
                       gdsn:c468201027 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Special edition: Use for anniversary, collectors', de luxe, gift, limited, numbered, autographed edition. Use to describe the exact nature of the special edition." ;
              rdfs:label "SPE" ;
              gdsn:codeListName "ONIXEditionTypeCode" ;
              gdsn:sourceId "174553" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174554
gdsn:cv174554 rdf:type owl:NamedIndividual ,
                       gdsn:c468201027 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Student edition: Where a text is available in both student and teacher's editions." ;
              rdfs:label "STU" ;
              gdsn:codeListName "ONIXEditionTypeCode" ;
              gdsn:sourceId "174554" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174555
gdsn:cv174555 rdf:type owl:NamedIndividual ,
                       gdsn:c468201027 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Teacher's edition: Where a text is available in both student and teacher's editions; use also for instructor's or leader's editions." ;
              rdfs:label "TCH" ;
              gdsn:codeListName "ONIXEditionTypeCode" ;
              gdsn:sourceId "174555" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174556
gdsn:cv174556 rdf:type owl:NamedIndividual ,
                       gdsn:c468201027 ;
              dct:source "gdsn_codeValues.json" ;
