###  urn:gs1:std:gdsn:extAttr1214
gdsn:extAttr1214 rdf:type owl:ObjectProperty ;
                 rdfs:domain gdsn:extGroup_US_FoodService ;
                 rdfs:range gdsn:extCode_nutrientValueDerivation ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "The derivation of the values, percent of intake and quantity contained, provided in the nutrient class." ;
                 rdfs:label "nutrientValueDerivation" ;
                 gdsn:example "ANALYTICAL_&_CALCULATED" ;
                 gdsn:groupName "US FoodService" ;
                 gdsn:hierarchyLevel 3 ;
                 gdsn:originalLimit "{1..100}" ;
                 gdsn:originalMultiplicity "0..1" ;
                 gdsn:sourceId "1214" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:validationRules "Valid values are:• Analytical- The item’s nutrient values have been determined through direct scientific analysis by a lab. • Calculated- The item’s nutrient values have been determined through a calculation of nutrient values provided for its ingredien" .


###  urn:gs1:std:gdsn:extAttr1251
