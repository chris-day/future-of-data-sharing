              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176290
gdsn:cv176290 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The AMA quality label ensures independent controls and stands for conventionally produced foods that meet exceptional quality criteria and whose origin is traceable." ;
              rdfs:label "AMA_SEAL_OF_APPROVAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ama-marketing.at/" ;
              gdsn:sourceId "176290" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176291
gdsn:cv176291 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The American Dental Association's (ADA) Seal of Acceptance is a trusted symbol of a dental product's safety and effectiveness. In order to earn the Seal, manufacturers must supply objective data from clinical and/or laboratory studies that support the product's safety, effectiveness, and promotional claims." ;
              rdfs:label "AMERICAN_DENTAL_ASSOCIATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.ada.org/science-research/ada-seal-of-acceptance" ;
              gdsn:sourceId "176291" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176292
gdsn:cv176292 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The American Heart Association Certified attribute includes all products that have published the symbol by Heart-Check Food Certification Program on their packaging." ;
              rdfs:label "AMERICAN_HEART_ASSOCIATION_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.heart.org/" ;
              gdsn:sourceId "176292" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176293
gdsn:cv176293 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Guarantees the meat comes from an animal raised entirely outdoors on pasture, and fed a 100-per-cent grass and forage diet." ;
              rdfs:label "ANIMAL_WELFARE_APPROVED_GRASSFED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://animalwelfareapproved.org/" ;
              gdsn:sourceId "176293" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176294
gdsn:cv176294 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "For products with an AOP (Appellation d’Origine Protégée), everything from the raw material for processing to the end product comes from a clearly defined region of origin. AOP is a quality mark protected by Swiss law, e.g. Emmentaler AOP. After registration by the Swiss Federal Office for Agriculture, the protected designation may only be used for products that meets the origin, process and quality requirements of the specifications. Independent certification bodies monitor their compliance." ;
              rdfs:label "AOP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.aop-igp.ch" ;
              gdsn:sourceId "176294" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176295
gdsn:cv176295 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The registered designation of origin (AOC) is a label allowing to identify a product whose manufacturing stages (production and processing) are carried out in the same geographical area and according to recognized know-how. It is the combination of a physical and biological environment with a traditional human community which bases the specificity of an AOC product, with definition in a specification. The French AOC is an official French label that meets the criteria of the European Protected Designation of Origin (PDO). In France, since 2012, for products other than wine, the term AOC is replaced by AOP as soon as the product is registered at the European level." ;
              rdfs:label "APPELLATION_ORIGINE_CONTROLEE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.inao.gouv.fr/" ;
              gdsn:sourceId "176295" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176296
gdsn:cv176296 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Association's recommendation of products should be seen as a guide for the consumer in the search for products that are good from an allergy point of view. Asthma Allergy Nordic is a product label developed by the Nordic asthma and allergy organisations in Denmark, Norway and Sweden." ;
              rdfs:label "APPROVED_BY_ASTHMA_AND_ALLERGY_ASSOC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.asthmaallergynordic.com/" ;
              gdsn:sourceId "176296" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176297
gdsn:cv176297 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification programme for sustainable aquaculture." ;
              rdfs:label "AQUA_GAP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.aquagap.net/" ;
              gdsn:sourceId "176297" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176298
gdsn:cv176298 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Aquaculture Stewardship Council ASC certification and labelling programme for responsibly farmed seafood. A global organisation working with aquaculture producers, seafood processors, retail and foodservice companies, scientists, conservation groups and the public to promote the best environmental and social choice in seafood. The ASC's aquaculture certification programme and seafood label will recognise and reward responsible aquaculture." ;
              rdfs:label "AQUACULTURE_STEWARDSHIP_COUNCIL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.asc-aqua.org/index.cfm?act=tekst.item&iid=252&lng=1" ;
              gdsn:sourceId "176298" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176299
gdsn:cv176299 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ARGE logo stands for the production of food without genetically modified additives." ;
              rdfs:label "ARGE_GENTECHNIK_FREI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.gentechnikfrei.at/" ;
              gdsn:sourceId "176299" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176300
gdsn:cv176300 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Argencert guarantees the organic quality of a product from its origin to the final result, certifying both raw and processed products and the compatibility assessment of inputs." ;
              rdfs:label "ARGENCERT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://argencert.com.ar/sitio/?lang=en" ;
              gdsn:sourceId "176300" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176301
gdsn:cv176301 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The FARMER OWNED marque has been develop to use on pack on all Arla branded products. FARMER OWNED represents the fact that Arla Foods is 100% owned by farmers. The FARMER OWNED marque is implemented on Arla branded assortment across all markets. The Farmer Owned marque is owned and administered by Arla Foods." ;
              rdfs:label "ARLA_FARMER_OWNED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.arla.com/company/farmer-owned/" ;
              gdsn:sourceId "176301" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176302
gdsn:cv176302 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Agricultural Services Certified Organic, LLC provides quality, express and economical organic certification services as established by the National Organic Program that meets the individualized needs of our clients in the global market place" ;
              rdfs:label "ASCO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ascorganic.com/" ;
              gdsn:sourceId "176302" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176303
gdsn:cv176303 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ASMI The Alaska Seafood Marketing Institute is a marketing organization with the mission of increasing the economic value of the Alaska seafood resource through: • Increasing the positive awareness of the Alaska Seafood brand; • Quality assurance, technical industry analysis, education, advocacy and research; http://www.alaskaseafood.org/." ;
              rdfs:label "ASMI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.alaskaseafood.org/" ;
              gdsn:sourceId "176303" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176304
gdsn:cv176304 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Asthma and Allergy Foundation of America (AAFA), a not-for-profit organization founded in 1953, is the leading patient organization for people with asthma and allergies, and the oldest asthma and allergy patient group in the world. https://www.aafa.org/certified-asthma-allergy-friendly/" ;
              rdfs:label "ASTHMA_AND_ALLERGY_FOUNDATION_OF_AMERICA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.aafa.org/certified-asthma-allergy-friendly/" ;
              gdsn:sourceId "176304" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176305
gdsn:cv176305 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "If there is no BENOR-mark for a specific material, then the manufacturers can ask for a technical approval by BUtgb (Belgian Union for technical approval in the construction). This technical approval (ATG) provides a technical advice, including a description and the technical characteristics. An ATG is a favourable review of one particular building product of one manufacturer for a particular application. It's all about systems, innovative products and products that contain multiple components." ;
              rdfs:label "ATG" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.wtcb.be" ;
              gdsn:sourceId "176305" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176306
gdsn:cv176306 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Used to specify Estonia Meat in their product. Eesti Lihatöötlejate Assotsiatsioon www.ela.ee" ;
              rdfs:label "AUS_KAUP_ESTONIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.ela.ee" ;
              gdsn:sourceId "176306" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176307
gdsn:cv176307 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Australian Certified Organic (ACO) is Australia’s largest certifier for organic and biodynamic produce and has over 1500 operators within its certification system. ACO provides certification services to operators from all sectors of the organic industry. Certification ensures compliance with national production standards and allows trace back of all products to their origin." ;
              rdfs:label "AUSTRALIAN_CERTIFIED_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://aco.net.au/" ;
              gdsn:sourceId "176307" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176308
gdsn:cv176308 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Austria Bio Garantie GMBH (ABG) is Austria's leading inspection body. It conducts inspections throughout Austria at all levels of the organic production chain (farmers-processors-traders-import/export) as well as in different foreign countries." ;
              rdfs:label "AUSTRIA_BIO_GARANTIE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bio-garantie.at/" ;
              gdsn:sourceId "176308" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176309
gdsn:cv176309 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Austrian Eco Label guarantees environment-friendly products and services." ;
              rdfs:label "AUSTRIAN_ECO_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.umweltzeichen.at/" ;
              gdsn:sourceId "176309" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176310
gdsn:cv176310 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BCARA is accredited by the Canadian Food Inspection Agency (CFIA) as a certification body that certifies organic products under the Canada Organic Regime. Products certified under the Canada Organic Regime can be sold inter-provincially and internationally to countries that have equivalency agreements with Canada. The Organic Products Regulations require mandatory certification to the current National Organic Standard for agricultural products represented as organic in international and inter-provincial trade, or that bear the federal organic agricultural product legend (or federal logo)." ;
              rdfs:label "BCARA_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.certifiedorganic.bc.ca/cb/bcara.php" ;
              gdsn:sourceId "176310" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176311
gdsn:cv176311 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BDIH Germany guidelines for Certified Natural Cosmetics" ;
              rdfs:label "BDIH_LOGO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "176311" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176312
gdsn:cv176312 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BEBAT is a non-profit organization, founded in 1995 under a Belgian law on environmental taxes. BEBAT gives a new life to batteries and flashlights! We do that by sorting and recycling. The federal government and the regional authorities are working with us." ;
              rdfs:label "BEBAT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.bebat.be" ;
              gdsn:sourceId "176312" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176313
gdsn:cv176313 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The government animal-welfare label will initially be for pork, but it will later be expanded to cover meat from other animals. Examples of animal welfare for this marking include free-range sows, curly tail/undocked tail, more straw, more space, max. 8 hours’ transport." ;
              rdfs:label "BEDRE_DYREVELFAERD_1HEART" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.foedevarestyrelsen.dk/english/Animal/AnimalWelfare/Pages/New_animal_welfare_label_will_win_the_hearts_of_Danes.aspx" ;
              gdsn:sourceId "176313" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176314
gdsn:cv176314 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The government animal-welfare label will initially be for pork, but it will later be expanded to cover meat from other animals. Examples of animal welfare include free-range sows, curly tail/undocked tail, even more straw, even more space, max. 8 hours’ transport." ;
              rdfs:label "BEDRE_DYREVELFAERD_2HEART" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.foedevarestyrelsen.dk/english/Animal/AnimalWelfare/Pages/New_animal_welfare_label_will_win_the_hearts_of_Danes.aspx" ;
              gdsn:sourceId "176314" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176315
gdsn:cv176315 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The government animal-welfare label will initially be for pork, but it will later be expanded to cover meat from other animals. Examples of animal welfare for this marking include free-range sows, curly tail/undocked tail, much more straw, much more Space, max. 8 hours’ transport, outdoor space, access to open fields." ;
              rdfs:label "BEDRE_DYREVELFAERD_3HEART" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.foedevarestyrelsen.dk/english/Animal/AnimalWelfare/Pages/New_animal_welfare_label_will_win_the_hearts_of_Danes.aspx" ;
              gdsn:sourceId "176315" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176316
gdsn:cv176316 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The goal of the bee friendly label is to promote the agricultural technics which are not harmful to bee and other pollinators." ;
              rdfs:label "BEE_FRIENDLY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.unaf-apiculture.info/nos-actions/le-label-bee-friendly-r.html http://www.certifiedbeefriendly.org/wp-content/uploads/2020/03/BEEFRIENDLY_SyntheseReferentiel_2020.pdf http://www.certifiedbeefriendly.org/" ;
              gdsn:sourceId "176316" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176317
gdsn:cv176317 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Belgaqua is the Belgian Federation for the Water Sector, and verifies the conformity of devices connected to the water supply at the request of the manufacturer or the importer, and is responsible for the inspection of protections against back blends." ;
              rdfs:label "BELGAQUA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.belgaqua.be" ;
              gdsn:sourceId "176317" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176318
gdsn:cv176318 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BENOR stands for BElgian NORm and points out that a product is according to Belgian standards. Is mainly used for traditional building materials such as steel, concrete, tile, brick, floor tiles and other concrete products, indicated by the abbreviation NBN. Mainly for building materials in road construction." ;
              rdfs:label "BENOR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.wtcb.be" ;
              gdsn:sourceId "176318" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176319
gdsn:cv176319 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The regional seal \"Berchtesgadener Land\" approved regional origin and quality of organically and conventionally produced agricultural products and services in the region of Berchtesgaden. The award criteria go in terms of the origin and support of genetic engineering ban partially beyond legal requirements." ;
              rdfs:label "BERCHTESGADENER_LAND" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.solidargemeinschaft-bgl.de" ;
              gdsn:sourceId "176319" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176320
gdsn:cv176320 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Best Aquaculture Practices Certified (BAP Certified) mark on retail packaging tells consumers that seafood came from BAP certified aquaculture facilities. The Best Aquaculture Practices standards, developed by the Global Aquaculture Alliance, form the basis for BAP certification. The standards specifically protect biodiversity and worker rights within a program that addresses environmental, social, food safety and traceability issues throughout producers' operations." ;
              rdfs:label "BEST_AQUACULTURE_PRACTICES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://bapcertification.org/" ;
              gdsn:sourceId "176320" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176321
gdsn:cv176321 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "2 Star BAP accreditation. The BAP program is the world’s most comprehensive third-party certification system for aquaculture facilities, addressing every key element of responsible aquaculture, including environmental responsibility, social responsibility, food safety, animal welfare, traceability and more. BAP standards encompassing the entire aquaculture production chain, including farms, processing plants, hatcheries and feed mills." ;
              rdfs:label "BEST_AQUACULTURE_PRACTICES_2_STARS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://bapcertification.org/" ;
              gdsn:sourceId "176321" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176322
gdsn:cv176322 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "3 Star BAP accreditation. The BAP program is the world’s most comprehensive third-party certification system for aquaculture facilities, addressing every key element of responsible aquaculture, including environmental responsibility, social responsibility, food safety, animal welfare, traceability and more. BAP standards encompassing the entire aquaculture production chain, including farms, processing plants, hatcheries and feed mills." ;
              rdfs:label "BEST_AQUACULTURE_PRACTICES_3_STARS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://bapcertification.org/" ;
              gdsn:sourceId "176322" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176323
gdsn:cv176323 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "4 Star BAP accreditation. The BAP program is the world’s most comprehensive third-party certification system for aquaculture facilities, addressing every key element of responsible aquaculture, including environmental responsibility, social responsibility, food safety, animal welfare, traceability and more. BAP standards encompassing the entire aquaculture production chain, including farms, processing plants, hatcheries and feed mills." ;
              rdfs:label "BEST_AQUACULTURE_PRACTICES_4_STARS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://bapcertification.org/" ;
              gdsn:sourceId "176323" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176324
gdsn:cv176324 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The one-star Beter Leven (better life) mark indicates that the product comes from a company that cares that animals are kept according to the minimal requirements for sanitation and well-being for the cattle industry." ;
              rdfs:label "BETER_LEVEN_1_STER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://beterleven.dierenbescherming.nl/zakelijk/en/" ;
              gdsn:sourceId "176324" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176325
gdsn:cv176325 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The two-star Beter Leven (better life) mark indicates that the product comes from a company that provides for a higher well-being of animals than that established by the minimal requirements for sanitation and well-being for the cattle industry, yet the conditions are inferior to those of biological-class products." ;
              rdfs:label "BETER_LEVEN_2_STER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://beterleven.dierenbescherming.nl/zakelijk/en/" ;
              gdsn:sourceId "176325" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176326
gdsn:cv176326 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The three-star Beter Leven (better life) mark is awarded to products that come from companies that excel in keeping animals according to top guidelines for biological-class products. In some cases, this mark is accompanied by an EKO indication." ;
              rdfs:label "BETER_LEVEN_3_STER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://beterleven.dierenbescherming.nl/zakelijk/en/" ;
              gdsn:sourceId "176326" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176327
gdsn:cv176327 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "If a business has been accredited by the BBB, it means BBB has determined that the business meets accreditation standards, which include a commitment to make a good faith effort to resolve any consumer complaints. BBB accredited businesses pay a fee for accreditation review and monitoring for continued compliance and for support of BBB services to the public. BBB Code of Business Practices represents standards for business accreditation by BBB. Businesses based in the United States and Canada that meet these standards and complete all application procedures will be accredited by BBB. The Code is built on the BBB Standards for Trust, eight principles that summarize important elements of creating and maintaining trust in business." ;
              rdfs:label "BETTER_BUSINESS_BUREAU_ACCREDITED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bbb.org/" ;
              gdsn:sourceId "176327" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176328
gdsn:cv176328 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Better Cotton Initiative (BCI) is a not-for-profit organisation stewarding the global standards for Better Cotton, and bringing together cotton’s complex supply chain, from the farmers to the retailers. BCI exists to make global cotton production better for the people who produce it, better for the environment it grows in and better for the sector’s future, by developing Better Cotton as a sustainable mainstream commodity." ;
              rdfs:label "BETTER_COTTON_INITIATIVE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://bettercotton.org" ;
              gdsn:sourceId "176328" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176329
gdsn:cv176329 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BeVeg is a global vegan network that brings legal credibility to vegan claims, which inherently raises the standard of consumer transparency. BeVeg is ISO accredited and recognized by the world accreditation forum for its internationally accredited vegan standard. BeVeg is accredited under ISO 17065 as a published vegan standard for vegan conformity assessment. https://www.beveg.com/" ;
              rdfs:label "BEVEG" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.beveg.com/" ;
              gdsn:sourceId "176329" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176330
gdsn:cv176330 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bewusst Tirol is a seal of quality marking food from the Tyrol. The \"Awareness Tyrol\" project promotes the use of local food in the hotel industry and gastronomy and thus strengthens the cooperation between tourism and agriculture. The participating companies are honoured for their high use of domestic products. http://amtirol.at/projekte/bewusst-tirol" ;
              rdfs:label "BEWUSST_TIROL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://amtirol.at/projekte/bewusst-tirol" ;
              gdsn:sourceId "176330" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176331
gdsn:cv176331 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Identifies non-staple or non-essential products (e.g. soup, candy, desserts, etc.) that offer more nutritional value or less contain less of potentially harmful ingredients (such as sugar, salt, fat) in comparison to similar items according to the guidelines of the Dutch Wetenschappelijke Commissie. See: http://www.ikkiesbewust.nl/" ;
              rdfs:label "BEWUSTE_KEUZE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ikkiesbewust.nl/" ;
              gdsn:sourceId "176331" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176332
gdsn:cv176332 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BIKo TYROL covers Genetically Modified-free milk production, AMA seal, quality Tyrol and beef labelling are controlled and certified. The Biko Tyrol operates in accordance with EN 45011 and is an accredited certification body." ;
              rdfs:label "BIKO_TIROL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.biko.at/" ;
              gdsn:sourceId "176332" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176333
gdsn:cv176333 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bio Austria is the largest organic farmers' association in Austria. The guidelines followed at Bio Austria require a higher level of compliance than the EU-Organic regulations." ;
              rdfs:label "BIO_AUSTRIA_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bio-austria.at/" ;
              gdsn:sourceId "176333" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176334
gdsn:cv176334 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In cases in which the products of a certain provenance (e.g. Bavaria) made according to the higher quality criteria can be tracked along the whole path from their production, via their processing, all the way to the shop counter, they can be given a biolabel stating the corresponding indication of geographical origin. In this case the origin is presented both in the form of a corresponding logo as well as the colours of the state of origin in the inner oval. The biolabel with the certificate of origin awarded by the Free State of Bavaria stands for products and services over and beyond the statutory standards a three-tier control system a full certificate of origin" ;
              rdfs:label "BIO_BAYERN_WITH_CERTIFICATE_PROVENANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.biosiegel.bayern/de/home/" ;
              gdsn:sourceId "176334" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176335
gdsn:cv176335 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The biolabel awarded by the Free State of Bavaria offers companies in the farming and food sector in the European Union the opportunity to label goods produced in compliance with the terms of the EU-Eco Regulation in combination with higher quality criteria. The precisely defined regulations are a guarantee for the consumers of an economic system in harmony with nature and provide them with guidance when making their purchases. Both the farmers of organic products as well as the producers must fulfil the demanding inspection criteria and allow their products to be checked by state-approved and monitored inspection boards. The defined control system ensures a complete traceability of the products over the entire lifecycle. The biolabel awarded by the Free State of Bavaria stands for products and services over and beyond the statutory standards a three-tier control system" ;
              rdfs:label "BIO_BAYERN_WITHOUT_CERTIFICATE_PROVENANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.stmelf.bayern.de/bio-siegel" ;
              gdsn:sourceId "176335" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176336
gdsn:cv176336 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fully organic, with more than 10% of raw materials imported but subject to equivalent organic standards." ;
              rdfs:label "BIO_BUD_SEAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bio-suisse.ch/de/diemarke.php" ;
              gdsn:sourceId "176336" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176337
gdsn:cv176337 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fully organic, with more than 10% of raw materials imported but subject to equivalent organic standards. Produced within the 2 years period in which the producer is converting to fully organic farming." ;
              rdfs:label "BIO_BUD_SEAL_TRANSITION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bio-suisse.ch/de/diemarke.php" ;
              gdsn:sourceId "176337" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176338
gdsn:cv176338 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "National BIO mark of the Czech Republic. More information is available on the website of Czech Ministry of Agriculture." ;
              rdfs:label "BIO_CZECH_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://eagri.cz/public/web/mze/zemedelstvi/ekologicke-zemedelstvi/biopotraviny/" ;
              gdsn:sourceId "176338" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176339
gdsn:cv176339 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ARGE Biofisch stands for criteria in rearing of fish according to agreed quality standards of organic fish farming in Austria." ;
              rdfs:label "BIO_FISCH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.biofisch.at/" ;
              gdsn:sourceId "176339" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176340
gdsn:cv176340 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fully organic, produced in Switzerland. More than 90% of the raw materials come from Switzerland. Product has been awarded for taste and quality." ;
              rdfs:label "BIO_GOURMET_BUD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bio-suisse.ch/de/diemarke.php" ;
              gdsn:sourceId "176340" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176341
gdsn:cv176341 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The products marked with the Bio-Zeichen Baden-Württemberg are regional organic foods with a traceable origin. The use or labelling is based on the ecological standards of the EC Organic Regulation supplemented with the requirement that the products must be produced in fully converted farms and, in part, on the more stringent requirements of the organic farming associations. The regional origin of the products ensures an additional ecological advantage of the products. The rationality promotes short transport and marketing channels. The independent checks of food by authorized inspection bodies and the additional supervision by the sign holder ensure a high degree of credibility of the sign. The control number printed on the products makes the controls comprehensible. The seal clearly shows the consumer that the agricultural products and products come from Baden-Württemberg. This ensures not only that the processing takes place in the region, but also that the sourcing of raw materials is 100% regional. In the production and processing of food, the guidelines of the EU Organic Regulation are used as the basis. Many products that are labelled with the Baden-Württemberg organic label are also produced according to the stricter guidelines of an organic farming association. The farms participating in the Bio-Zeichen Baden-Württemberg must be 100% organic. A partial conversion is - with the exception of products from the orchard - not permitted. Neutral controls ensure compliance with the guidelines." ;
              rdfs:label "BIO_LABEL_BADEN_WURTTENBERG" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.gemeinschaftsmarketing-bw.de/bio-zeichen-bw/was-ist-das-bio-zeichen-2/" ;
              gdsn:sourceId "176341" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176342
gdsn:cv176342 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "German national organic certification label (Bio-Siegel), see www.bio-siegel.de" ;
              rdfs:label "BIO_LABEL_GERMAN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bio-siegel.de/" ;
              gdsn:sourceId "176342" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176343
gdsn:cv176343 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The organic Label - HESSEN shows the consumer that an organically produced product originates from the region. For this, the nationwide used organic seal was supplemented with a reference to the origin. Since 2006, there is this sign for Hesse. In 2010, the organic Label - HESSEN was supplemented by another appendix: the European Union logo for organically produced products. This allows companies to use only one logo on the packaging of their products instead of three different logos, because the European organic label is required. Behind the Bio-Seal - HESSEN, similar to the quality mark \"Tested Quality - HESSEN\", there are special requirements for producers, processors and marketers regarding the quality and traceable origin of their products." ;
              rdfs:label "BIO_LABEL_HESSEN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.gutes-aus-hessen.de/unsere-siegel/bio-aus-hessen/" ;
              gdsn:sourceId "176343" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176344
gdsn:cv176344 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bio Partenaire guarantees that the product meets the European requirements for organic agriculture and a fair price is paid to farmers in developing countries. Previously, the label was known under the name Bio Equitable." ;
              rdfs:label "BIO_PARTENAIRE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.biopartenaire.com/" ;
              gdsn:sourceId "176344" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176345
gdsn:cv176345 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The logo of Bio-Ring Allgäu e.V. is issued by an association of consumers and organic farmers since 1987 with the aim to strengthen the organic farming in the region of Allgäu. Their focus is on the involvement of an independent, public welfare-oriented regional development processes in connection with the marketing of high quality regional agricultural products. The association represents the interests of producers, whose production in excess of the statutory requirements and their quality criteria based on a wide range of areas basic criteria (eco-certifications) and are the life cycle (raw materials, production and processing, disposal) take into account the products." ;
              rdfs:label "BIO_RING_ALLGAEU" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.bioring-allgaeu.de" ;
              gdsn:sourceId "176345" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176346
gdsn:cv176346 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product meets both the criteria of organic farming and those of the \"Bio solidaire\" charter. This label aims to develop local partnerships between processors and (French) producers." ;
              rdfs:label "BIO_SOLIDAIRE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.association-biosolidaire.fr/" ;
              gdsn:sourceId "176346" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176347
gdsn:cv176347 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fully organic, produced in Switzerland. More than 90% of the raw materials come from Switzerland.Produced within the 2 years period in which the producer is converting to fully organic farming." ;
              rdfs:label "BIO_SUISSE_BUD_SEAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.bio-suisse.ch" ;
              gdsn:sourceId "176347" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176348
gdsn:cv176348 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fully organic, produced in Switzerland. More than 90% of the raw materials come from Switzerland.Produced within the 2 years period in which the producer is converting to fully organic farming." ;
              rdfs:label "BIO_SUISSE_BUD_SEAL_TRANSITION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bio-suisse.ch/de/diemarke.php" ;
              gdsn:sourceId "176348" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176349
gdsn:cv176349 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BioChecked™ Agrees to provide third party certification for Non Glyphosate Certified™ (Zero Tolerance*) by reviewing and holding producer’s individual copy of laboratory test results of Glyphosate testing in house in secure and confidential manner for 1 year and as renewed." ;
              rdfs:label "BIOCHECKED_NON_GLYPHOSATE_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://biochecked.com/glyphosate-free-certified/" ;
              gdsn:sourceId "176349" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176350
gdsn:cv176350 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BioChecked™ offers Non GMO Certification for single input (mono ingredient) Non GMO Certified™ and multiple input (multi-ingredient) Non GMO Verified™ foods. It is certified multiple countries;" ;
              rdfs:label "BIOCHECKED_NON_GMO_VERIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://biochecked.com/glyphosate-free-certified/" ;
              gdsn:sourceId "176350" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176351
gdsn:cv176351 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product is biodegradable. There can be different variations of the logo." ;
              rdfs:label "BIODEGRADABLE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "176351" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176352
gdsn:cv176352 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Biodegradable Products Institute (BPI) is a not-for-profit association of key individuals and groups from government, industry and academia. Through our innovative compostable label program, we educate manufacturers, legislators and consumers about the importance of scientifically based standards for compostable materials which biodegrade in large composting facilities." ;
              rdfs:label "BIODEGRADABLE_PRODUCTS_INSTITUTE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bpiworld.org/" ;
              gdsn:sourceId "176352" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176353
gdsn:cv176353 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Biodynamic Certified includes all products that have published the Demeter USA Certified Biodynamic Certification on their package." ;
              rdfs:label "BIODYNAMIC_CERTIFICATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.demeter-usa.org/" ;
              gdsn:sourceId "176353" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176354
gdsn:cv176354 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"Biodynamisch\" indicates that products contain at least 95 percent organic and 90 percent demeter ingredients. The Label is issued by the association Demeter e.V. and is used for food and cosmetic products." ;
              rdfs:label "BIODYNAMISCH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.demeter.de" ;
              gdsn:sourceId "176354" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176355
gdsn:cv176355 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Belgian Biogarantie® label, although based on the European regulations, is ahead of its time thanks to the addition of requirements in the ecological, economic and social fields. As a Biogarantie® user, you undertake to comply with the Biogarantie® specifications and the accompanying sustainability charter." ;
              rdfs:label "BIOGARANTIE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://biogarantie.be/" ;
              gdsn:sourceId "176355" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176356
gdsn:cv176356 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Biokreis Association for Organic Farming and Healthy Food e. V. forgives the label. The label promotes cooperation between organic farmers and processing companies. They should comply with environmental and social principles. It also aims to make peasant agriculture in the sense of a circular economy. The criteria presuppose compliance with the EU organic regulation for the EU organic label, but go beyond this with its own requirements." ;
              rdfs:label "BIOKREIS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.biokreis.de/" ;
              gdsn:sourceId "176356" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176357
gdsn:cv176357 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Bioland-Label (organic label) identifies products from organic farming. The production method based on a circular economy - without synthetic pesticides and synthetic chemical nitrogen fertilizer. The animals are kept humanely and the food will be processed carefully. The guidelines go beyond the EU criteria. The organic label is assigned by the Bioland association." ;
              rdfs:label "BIOLAND" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bioland.de" ;
              gdsn:sourceId "176357" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176358
gdsn:cv176358 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"organic farming Ennstal\" was founded in 1989 as a regional initiative - today one in three farmers cultivated in Styria Liezen region its operation under the strict rules of organic farming." ;
              rdfs:label "BIOLAND_ENNSTAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bioland-ennstal.at/" ;
              gdsn:sourceId "176358" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176359
gdsn:cv176359 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The biopark e. V. was founded in 1991 by farmers and scientists as an organic farming association. Biopark companies are represented throughout Germany. At the initiative of Biopark, the first GMO-free region was founded in Germany. The objective of the Biopark label, which has been awarded since 1991, is to promote organic farming. The aim is a closed loop as far as possible. It is about the protection of the environment, landscape management and animal welfare. Biopark certifies farms that have decided to convert their work to organic farming. The Biopark label can be found on meat and cereal products as well as on potatoes. The criteria presuppose compliance with the EU organic regulation for the EU organic label, but go beyond this with its own requirements." ;
              rdfs:label "BIOPARK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://biopark.de/" ;
              gdsn:sourceId "176359" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176360
gdsn:cv176360 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The BIOS label ensures organic food that is not genetically modified and produced in accordance with environmental standards. The BIOS logo may be used for the labelling of certified organic products exclusively." ;
              rdfs:label "BIOS_KONTROLLE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.bios-kontrolle.at" ;
              gdsn:sourceId "176360" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176361
gdsn:cv176361 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Smithsonian Migratory Bird Centre Bird Friendly logo guarantees that every bean is produced organically, under high-quality shade, that tropical \"agroforests\" are preserved and migratory birds find a healthy haven." ;
              rdfs:label "BIRD_FRIENDLY_COFFEE_SMITHSONIAN_CERTIFICATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://nationalzoo.si.edu/scbi/migratorybirds/coffee/" ;
              gdsn:sourceId "176361" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176362
gdsn:cv176362 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vaad HaKashrus of Buffalo Certification" ;
              rdfs:label "BK_CHECK_VAAD_HAKASHRUS_OF_BUFFALO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bvkkosher.com/" ;
              gdsn:sourceId "176362" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176363
gdsn:cv176363 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Blue-White-Heart approach was born between 1993 and 2000, from a simple observation made by a dairy farmer, Jean Pierre Pasquet to an agricultural engineer, Pierre Weill. He explained to him that he noticed that in the spring, when his cows were in pasture grass, they were in better shape, and the butter he made was softer and more spreadable than in winter. From this observation, Jean-Pierre Pasquet and Pierre Weill began their reflection on the importance of preserving the food chain and valuing plants and seeds of nutritional interest. Together, they created an agriculture committed to a sustainable and social approach with breeders eager to feed their fellow citizens." ;
              rdfs:label "BLEU_BLANC_COEUR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bleu-blanc-coeur.org/" ;
              gdsn:sourceId "176363" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176364
gdsn:cv176364 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Blue Angel is awarded to companies as kind of a reward for their commitment to environmental protection. They use it to professionally promote their eco-friendly products in the market. The Blue Angel is an ecological beacon showing the consumer the way to the ecologically superior product and promotes environmentally conscious consumption. See: http://www.blauer-engel.de/en/index.php" ;
              rdfs:label "BLUE_ANGEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.blauer-engel.de/en/index.php" ;
              gdsn:sourceId "176364" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176365
gdsn:cv176365 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Blue Ribbon Kosher Certification" ;
              rdfs:label "BLUE_RIBBON_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "176365" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176366
gdsn:cv176366 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The quality label bluesign® approved fabrics certifies that at least 90 per cent of the used fabrics comply with the strict safety and environmental requirements of the bluesign® criteria. Their suppliers and manufacturers have been verified as bluesign® system partners." ;
              rdfs:label "BLUESIGN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bluesign.com/consumer" ;
              gdsn:sourceId "176366" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176367
gdsn:cv176367 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: a third party audit. National - A sustainability protocol created after a 4-year study at Catena Wine Institute. For certification, a third party audit must take place, with a minimum score in each category. http://discoversustainablewine.com/argentina/" ;
              rdfs:label "BODEGAS_ARGENTINA_SUSTAINABILITY_PROTOCOL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://discoversustainablewine.com/argentina/" ;
              gdsn:sourceId "176367" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176368
gdsn:cv176368 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Bonsucro certification standard is available to any sugarcane producer, sugar and ethanol mill, or any downstream processor of sugar, biofuels and other derivative products such as bioplastics. Integrated mills can target both sugar and biofuel markets, meeting sustainability requirements of both supply chains." ;
              rdfs:label "BONSUCRO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bonsucro.com/" ;
              gdsn:sourceId "176368" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176369
gdsn:cv176369 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Bord Bia Approved logo is awarded to a company which has been audited by Bord Bia to verify that processes, from farm to fork, comply with the highest Quality Assurance Standards. These standards include: animal welfare, traceability, environment, safety, feed, water, testing, inspection, hygiene and good manufacturing practice. \"Bord Bia Approved\" is awarded to a company where all the ingredients including meat content satisfy the Bord Bia requirements. www.bordbia.ie" ;
              rdfs:label "BORD_BIA_APPROVED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.bordbia.ie" ;
              gdsn:sourceId "176369" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176370
gdsn:cv176370 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bord Bia Approved - Meat Content Only applies to companies where only the meat content satisfies certain conditions detailed in the Bord Bia requirements document. see http://www.bordbia.ie/industryservices/quality/Documents/Quality-Assurance-Scheme-Logo-GuidelinesV7.pdf for more details." ;
              rdfs:label "BORD_BIA_APPROVED_MEAT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.bordbia.ie" ;
              gdsn:sourceId "176370" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176371
gdsn:cv176371 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bra Miljöval is the ecolabel of SSNC. It is referred to as \"Good Environmental Choice\" in English. SSNC started ecolabelling." ;
              rdfs:label "BRA_MILJOVAL_LABEL_SWEDISH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.naturskyddsforeningen.se/in-english" ;
              gdsn:sourceId "176371" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176372
gdsn:cv176372 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BRC Global Standards is a leading safety and quality certification programme, used by over 22,000 certificated suppliers in 123 countries, with certification issued through a worldwide network of accredited certification bodies." ;
              rdfs:label "BRC_GLOBAL_STANDARDS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.brcglobalstandards.com" ;
              gdsn:sourceId "176372" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176373
gdsn:cv176373 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BreatheWay® membranes are designed to naturally extend the shelf life of virtually any fresh product that would benefit from reduced oxygen levels and managed carbon dioxide levels. A unique membrane solution manages all gas transfer requirements for the package, leaving more flexibility for the balance of the package to meet shipping or merchandising requirements." ;
              rdfs:label "BREATHEWAY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.breatheway.com/overview/" ;
              gdsn:sourceId "176373" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176374
gdsn:cv176374 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A symbol used in the UK to indicate the dental health claims are clinically proven by the British Dental Health Foundation." ;
              rdfs:label "BRITISH_DENTAL_HEALTH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.dentalhealth.org/" ;
              gdsn:sourceId "176374" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176375
gdsn:cv176375 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BRC Global Standards is a leading safety and quality certification. The Standards guarantee the quality, safety and operational criteria and ensures that manufacturers fulfil their legal obligations and provide protection for the end consumer." ;
              rdfs:label "BRITISH_RETAIL_CONSORTIUM_CERTIFICATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.brcglobalstandards.com/" ;
              gdsn:sourceId "176375" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176376
gdsn:cv176376 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Stands for Business Social Compliance Initiative, and aims to improve the working conditions in the supply chain around the world. It shows consumers that an article is produced according to ethical practices as regards working conditions." ;
              rdfs:label "BSCI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.bsci-intl.org" ;
              gdsn:sourceId "176376" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176377
gdsn:cv176377 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bündnerfleisch also known as Grisons Meat or Viande des Grisons is an air-dried raw cured product made from beef rump meat. The term \"Bündnerfleisch\" is a protected geographical indication (PGI) and is a registered trademark of the canton of Graubünden of Switzerland. The ProCert AG certification guarantees the authenticity of Bündnerfleisch. Only meat that is dried and processed in the Graubünden air are allowed to be labelled with the name." ;
              rdfs:label "BUENDNERFLEISCH_GGA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.procert.ch" ;
              gdsn:sourceId "176377" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176378
gdsn:cv176378 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bullfrog Power emerged on the energy scene with a visionary goal: to transform the electricity landscape in Canada. BullfrogPower offered homes and businesses a green choice where previously there wasn’t one: energy." ;
              rdfs:label "BULLFROG" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.bullfrogpower.com/" ;
              gdsn:sourceId "176378" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176379
gdsn:cv176379 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "\"Product of Canada\" claims can be applied to meat from Canadian animals that are slaughtered in Canada. Animals are considered Canadian if they are born or hatched, raised and slaughtered in Canada or, in the case of feeder cattle, if they have spent a period of at least 60 days in Canada prior to slaughter in Canada." ;
              rdfs:label "CA_BEEF" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5" ;
              gdsn:sourceId "176379" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176380
gdsn:cv176380 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "When a food contains both domestic and imported ingredients, the label would state \"Made in Canada from domestic and imported ingredients\". This claim may be used on a product that contains a mixture of imported and domestic ingredients, regardless of the level of Canadian content in the product." ;
              rdfs:label "CA_BOTH_DOM_IMPORT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5" ;
              gdsn:sourceId "176380" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176381
gdsn:cv176381 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "To describe a food which is imported in bulk and packaged in Canada" ;
              rdfs:label "CA_BULK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5" ;
              gdsn:sourceId "176381" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176382
gdsn:cv176382 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "To describe green beans that were canned in Canada" ;
              rdfs:label "CA_CANNED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-ndustry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "176382" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176383
gdsn:cv176383 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "To describe bottled water that was distilled in Canada" ;
              rdfs:label "CA_DISTILLED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "176383" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176384
gdsn:cv176384 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "When a food is made with ingredients that are all sourced from outside of Canada, the label would state \"Made in Canada from imported ingredients" ;
              rdfs:label "CA_IMPORT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "176384" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176385
gdsn:cv176385 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The claim \"Canadian\" is considered to be the same as a \"Product of Canada\" claim. As such, all or virtually all major ingredients, processing, and labour used to make the food product must be Canadian. For example, the claim \"Canadian\" on a container of frozen lasagna would mean that the food meets the \"Product of Canada\" criteria." ;
              rdfs:label "CA_INGREDIENT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "176385" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176386
gdsn:cv176386 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A \"Made in Canada\" claim with a qualifying statement can be used on a food product when the last substantial transformation of the product occurred in Canada, even if some ingredients are from other countries." ;
              rdfs:label "CA_MADE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/food/labelling/food-labelling-for-industry/origin/eng/1393622222140/1393622515592?chap=5#s1c5" ;
              gdsn:sourceId "176386" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176387
gdsn:cv176387 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "CanadaGAP™ is a food safety program for companies that produce, pack and store fruits and vegetables. It is designed to help implement effective food safety procedures within fresh produce operations" ;
              rdfs:label "CANADA_GAP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.canadagap.ca/canadagap-program/program-participants/" ;
              gdsn:sourceId "176387" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176388
gdsn:cv176388 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products which are identified by the Canadian Agricultural Products (CAP) Act, e.g. dairy, eggs, fruits, vegetables, honey, maple, meat, poultry, fish. http://laws-lois.justice.gc.ca/eng/acts/c-0.4/page-6.html#h-8" ;
              rdfs:label "CANADIAN_AGRICULTURAL_PRODUCTS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://laws-lois.justice.gc.ca/eng/acts/c-0.4/page-6.html#h-8" ;
              gdsn:sourceId "176388" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176389
gdsn:cv176389 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Canadian Association of Fire Chiefs (CAFC) is an independent, non-profit organization with a voluntary membership representing approximately 3,500 fire departments across Canada. CAFC promotes the highest standard of public safety in an ever changing and increasingly complex world to ensure the protection of the public through leadership, advocacy and active collaboration with key stakeholders" ;
              rdfs:label "CANADIAN_ASSOCIATION_FIRE_CHIEFS_APPROVED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.cafc.ca/" ;
              gdsn:sourceId "176389" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176390
gdsn:cv176390 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The right to use the mark of conformity \"COMPOSTABLE\" on compostable plastic bags and on compostable products is granted only to those manufacturer/distributors that demonstrate that their product conforms with specific performance attributes and adheres to the parameters for \"compostability\" as set out in the BNQ documents, Compostable Plastic Bags - Certification Program" ;
              rdfs:label "CANADIAN_CERTIFIED_COMPOSTABLE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.compostable.info/compostable.htm" ;
              gdsn:sourceId "176390" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176391
gdsn:cv176391 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Skin Health Program’s framework is based, in large part, on the CDA’s longstanding and successful Sun Protection Program (SPP). However, the scope of the Skin Health Program is much broader. The SHP was created to effectively fill a need expressed to us by consumers and industry for the development of an effective evidence-based program that reflects the most recent available dermatological science. The SHP will help people navigate the variety of products on the market designed to enhance and maintain skin health." ;
              rdfs:label "CANADIAN_DERMATOLOGY_ASSOCIATION_SKIN_HEALTH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.dermatology.ca/programs-resources/programs/shp/" ;
              gdsn:sourceId "176391" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176392
gdsn:cv176392 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Canadian Dermatology Association, founded in 1925, represents Canadian dermatologists. The association exists to advance the science and art of medicine and surgery related to the care of the skin, hair and nails; provide continuing professional development for its members; support and advance patient care; provide public education on sun protection and other aspects of skin health; and promote a lifetime of healthier skin, hair and nails." ;
              rdfs:label "CANADIAN_DERMATOLOGY_ASSOCIATION_SUN_PROTECTION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://dermatology.ca/industry/industry-recognition-programs/spp/" ;
