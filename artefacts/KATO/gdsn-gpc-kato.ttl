                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Surface consisting of glass, a substance mainly consisting of sand, lime and soda, fused at high temperatures and cooled quickly so that it solidifies to a vitreous or non-crystalline condition." ;
              rdfs:label "GLASS" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179765" ;
