              rdfs:comment "Three Line K Kosher Certification (Rabbi Kelemer & Associates) Certification" ;
              rdfs:label "THREE_LINE_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "n/a" ;
              gdsn:sourceId "177005" ;
