###  urn:gs1:std:gdsn:cv171757
gdsn:cv171757 rdf:type owl:NamedIndividual ,
                       gdsn:c-1012663220 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Troy ounce or apothecary ounce: The troy ounce is a unit of imperial measure. In the present day it is most commonly used to gauge the weight and therefore the price of precious metals. One troy ounce equals 480 grains or 31.1035 grams." ;
              rdfs:label "APZ" ;
