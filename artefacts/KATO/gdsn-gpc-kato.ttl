gdsn:cv169816 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "American Style Imperial stout is a strong dark beer, originally crafted in America. Imperial stouts have a high alcohol content, usually over 9% abv, and are among the darkest available beer styles." ;
