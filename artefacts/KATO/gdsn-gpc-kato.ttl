###  urn:gs1:std:gdsn:cv177837
gdsn:cv177837 rdf:type owl:NamedIndividual ,
                       gdsn:c1608555517 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Microfiltration (MF) is mainly used for the reduction of bacteria in skim milk, whey and brine. It is also used for defatting whey intended for whey protein concentrate (WPC) and for protein fractionation. MF membranes have a pore size of 10-1 to 101 µm. The resulting permeate of MF separation is water, minerals, lactose and some proteins." ;
              rdfs:label "FINE_MICRO_FILTERED" ;
              gdsn:codeListName "PreservationTechniqueTypeCode" ;
              gdsn:sourceId "177837" ;
              gdsn:sourceType "codeValue" .


