                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr269
gdsn:extAttr269 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "Number used in conjunction with the Customs_Tariff_Number. Different products relating to one Customs_Tariff_Number may be classified under different statistical codes. Example 1: For wine '71' denotes 'Red' Supply at Level: All Applicableht" ;
                rdfs:label "customsStatisticalCode" ;
                gdsn:example "71" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{1..15}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "269" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "If populated, Customs Tariff Number is not NULL" .


###  urn:gs1:std:gdsn:extAttr27
gdsn:extAttr27 rdf:type owl:DatatypeProperty ;
               rdfs:domain gdsn:extGroup_Australasian_Supermarkets_PIF ;
               rdfs:range xsd:string ;
               dct:source "gdsn_extendedAttributes.json" ;
               rdfs:comment "This flag is used to indicate if there has been or it was possible that GM cross contamination occurred during the manufacturing / storage of with GM products. Valid values are Y (Yes), N (No) or blank (Not supplied)" ;
