              gdsn:codeListName "BristleHardnessCode" ;
              gdsn:sourceId "181049" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181050
gdsn:cv181050 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348312 ;
