###  urn:gs1:std:gdsn:extAttr139
gdsn:extAttr139 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Healthcare ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The National Health Act 1953 provides that listed drugs be assigned to formularies identified as F1 or F2. Generally F1 is intended for single brand drugs and F2 for drugs that have multiple brands, or are in a therapeutic group with other drugs with multiple brands. Drugs on F2 are subject to the provisions of the Act relating to statutory price reductions, price disclosure and guarantee of supply. Allocation to F1 or F2 is determined by legislative instrument. Single brand combination drugs are not included in either the F1 or F2 formulary." ;
                rdfs:label "pBSFormularyAllocationCode" ;
                gdsn:example "F1 - Formulary 1" ;
                gdsn:groupName "Australasian Healthcare" ;
                gdsn:hierarchyLevel 7 ;
                gdsn:originalLimit "{1..35}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "139" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr14
