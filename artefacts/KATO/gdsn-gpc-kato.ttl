                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A small cylinder that is pushed into the packaging to close it." ;
              rdfs:label "CORK" ;
              gdsn:codeListName "PackagingMaterialElementCode" ;
              gdsn:sourceId "177096" ;
