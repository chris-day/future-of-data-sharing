###  urn:gs1:std:gdsn:cv179606
gdsn:cv179606 rdf:type owl:NamedIndividual ,
                       gdsn:c-839280846 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Carbon neutral (or carbon-free) is removing the same amount of carbon dioxide as it's emitting into the atmosphere to achieve a net-zero carbon emission." ;
