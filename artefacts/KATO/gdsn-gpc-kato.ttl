###  urn:gs1:std:gdsn:cv169863
gdsn:cv169863 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Dunkel, or Dunkles, is a word used for several types of dark German lager. Dunkel is the German word meaning dark, and Dunkel beers typically range in colour from amber to dark reddish brown. They are characterized by their smooth malty flavour." ;
              rdfs:label "EUROPEAN_STYLE_DARK_LAGER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169863" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169864
gdsn:cv169864 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Extra Special Bitters are essentially more aggressive and more balanced Bitters, both in alcohol and hop character. The colour range will be similar, though ESBs lean toward the darker end of the scale; dark golds to copper. Low in carbonation." ;
              rdfs:label "EXTRA_SPECIAL_BITTER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169864" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169865
gdsn:cv169865 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Festbier is brewed with imported specialty malts to create a medium bodied, malty, amber lager with a smooth finish." ;
              rdfs:label "FESTBIER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169865" ;
