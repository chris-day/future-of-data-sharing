###  urn:gs1:std:gdsn:a-930082660
gdsn:a-930082660 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:c-1443794077 ;
                 rdfs:range gdsn:c1490 ;
                 dct:source "gdsn_classAttributes.json" ;
                 rdfs:comment "The amount of the trade item contained by a package, usually as claimed on the label. For example, Water 750ml - net content = \"750 MLT\" ; 20 count pack of diapers, net content = \"20 ea.\". In case of multi-pack, indicates the net content of the total trade item. For fixed value trade items use the value claimed on the package, to avoid variable fill rate issue that arises with some trade item which are sold by volume or weight, and whose actual content may vary slightly from batch to batch. In case of variable quantity trade items, indicates the average quantity." ;
                 rdfs:label "netContent" ;
                 gdsn:bmsId 3733 ;
                 gdsn:originalMultiplicity "0..*" ;
                 gdsn:pathId "c-1559145472/c-1443794077/a-930082660" ;
                 gdsn:semanticResourceUrn "urn:gs1:gdd:bie:TradeItemMeasurements.netContent" ;
                 gdsn:sourceId "-930082660" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:trade_item_measurements:xsd:3' and local-name()='tradeItemMeasurementsModule']/tradeItemMeasurements/netContent" .


