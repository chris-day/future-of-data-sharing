                       gdsn:c2147348205 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Contains images or storylines that may be disturbing or incomprehensible to minors. The film may contain portrayals of domestic violence, racism, religious matters, death, or controversial social issues." ;
