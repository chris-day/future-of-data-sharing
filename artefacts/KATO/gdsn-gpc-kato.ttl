###  urn:gs1:std:gdsn:cv171009
gdsn:cv171009 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348220 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A hot product, while pareve in its essence, has been manufactured using equipment that was also used to manufacture hot dairy products where no kosherization occurred in between. It is important to note that a thorough cleaning of the equipment still occurs between production runs and there is absolutely no dairy products contained in an item labeled DE. Link: https://cor.ca/view/183/what_does_dairy_equipment_mean.html" ;
              rdfs:label "DE" ;
