###  urn:gs1:std:gdsn:cv178553
gdsn:cv178553 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A clinician focused product information document that is written by the pharmaceutical company responsible for the medicine. This document is intended to assist doctors, pharmacists and other health professionals in prescribing and dispensing medicines. In addition, this information can be used by health professionals in their consultations with patients, so that the patient can be better informed about their medicines." ;
              rdfs:label "CLINICIAN_MEDICINE_INFORMATION" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178553" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178554
gdsn:cv178554 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Link to a website, file, or image containing the manufacturer's recommendations for how the consumer or end user should store and handle the product." ;
