###  urn:gs1:std:gdsn:cv181602
gdsn:cv181602 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Flavours are defined as flavours found without any specific chemical synthesis, but not specified as natural flavours." ;
              rdfs:label "FLAVOUR" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "181602" ;
