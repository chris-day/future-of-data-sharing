###  urn:gs1:std:gdsn:cv176625
gdsn:cv176625 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Good Manufacturing Practices (GMP) introduces a management systems approach to documenting and regulating the production, control, storage, and shipment of products. For example in 2011, the World Health Organization updated GMP requirements in the good manufacturing practices standard (WHO TRS 961, 2011 for certification of Pharmaceuticals). WHO has also created GMP processes for other product types. Also FDA and other organisations." ;
              rdfs:label "GMP_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "176625" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176626
gdsn:cv176626 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Good Manufacturing Practices (GMP) introduces a management systems approach to documenting and regulating the production, control, storage, and shipment of products. ISO standard 22716 is for cosmetic products that are manufactured according to Good Manufacturing Practices (GMP)." ;
              rdfs:label "GMP_ISO_22716" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "176626" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176627
gdsn:cv176627 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Global Organic Alliance (GOA) provides services to various organic certification or compliance verification programs." ;
              rdfs:label "GOA_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.goa-online.org/" ;
              gdsn:sourceId "176627" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176628
gdsn:cv176628 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "KRAV's label for production aids, the so-called arrow label with the text “Godkänd för ekologisk odling”, states that the product on which the label is attached is approved for use in organic farming. The products are inspected annually by independent certification bodies - so-called third-party certification. Manufacturers of production aids may, if they comply with KRAV's regulations and have been approved by a certification body, use the arrow mark." ;
              rdfs:label "GODKAND_FOR_EKOLOGISK_ODLING_KRAV" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.krav.se/en/" ;
              gdsn:sourceId "176628" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176629
gdsn:cv176629 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Good Housekeeping maintains good taste and exercises strict editorial judgment as to products that are eligible for Good Housekeeping's limited warranty to consumers. Good Housekeeping bestows its limited warranty Seal on those products that have been evaluated by the Good Housekeeping Institute and been assessed to perform as intended. These judgments are the basis of the Good Housekeeping Consumers' Refund Policy." ;
              rdfs:label "GOOD_HOUSEKEEPING" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.goodhousekeeping.com/" ;
              gdsn:sourceId "176629" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176630
gdsn:cv176630 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "http://www.finfood.fi/ Finfood Suomen Ruokatieto Ry" ;
              rdfs:label "GOODS_FROM_FINLAND_BLUE_SWAN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.finfood.fi/" ;
              gdsn:sourceId "176630" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176631
gdsn:cv176631 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "GoodWeave aims to stop child labour in the carpet industry and to replicate its market-based approach in other sectors." ;
              rdfs:label "GOODWEAVE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.goodweave.org" ;
              gdsn:sourceId "176631" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176632
gdsn:cv176632 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This label is awarded by the Stichting Gras Keurmerk to manufacturers of both vegetable and animal products who comply with the Dutch guidelines for pasturing and agriculture (Normering Grasdier Landbouw). These guidelines establish that cattle/animals are to be kept at stables with enough space and are allowed to go outside daily. Under these guidelines, crops are to be grown using animal fertilizer and with very limited use of other substances." ;
              rdfs:label "GRASKEURMERK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://graskeurmerk.nl/" ;
              gdsn:sourceId "176632" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176633
gdsn:cv176633 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "GRASP stands for GLOBAL G.A.P. Risk Assessment on Social Practice. GRASP is a voluntary ready-to-use module designed to assess social practices on the farm. The requirements catalogue consists of 11 standardized requirements and one additional QMS requirement that address specific aspects of workers’ health, safety and welfare. GRASP is designed to extend the social standards of your GLOBALG.A.P. Certification." ;
              rdfs:label "GRASP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.globalgap.org/uk_en/for-producers/globalg.a.p.-add-on/grasp/" ;
              gdsn:sourceId "176633" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176634
gdsn:cv176634 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Green America Certified Business certification attribute includes all products that have published the Green America Certified Business Gold, Silver, or Bronze seal on their packaging. Businesses earn this seal after staff at Green America's Green Business Network reviews and approves their application." ;
              rdfs:label "GREEN_AMERICA_CERTIFIED_BUSINESS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.greenamerica.org/greenbusiness/certification.cfm" ;
              gdsn:sourceId "176634" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176635
gdsn:cv176635 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Green Dot" ;
              rdfs:label "GREEN_DOT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.pro-e.org/Green-Dot-General-Remarks.html" ;
              gdsn:sourceId "176635" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176636
gdsn:cv176636 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Green-e Energy certifies renewable energy that meets the highest standards in North America: it must be generated from new facilities, marketed with complete transparency and accuracy, and delivered to the purchaser, who has sole title. Green-e verifies the entire chain of custody of certified renewable energy from generation to retirement to ensure individuals and businesses are getting exactly what they paid for." ;
              rdfs:label "GREEN_E_ENERGY_CERT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.green-e.org/" ;
              gdsn:sourceId "176636" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176637
gdsn:cv176637 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Green-e Energy is the nation's leading voluntary certification program for renewable energy. For two decades, Green-e Energy has been certifying renewable energy that meets environmental and consumer protection standards that it developed in conjunction with leading environmental, energy and policy organizations. Green-e Energy also requires that sellers of certified renewable energy disclose clear and useful information to potential customers, allowing consumers to make informed choices." ;
              rdfs:label "GREEN_E_ORG" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.green-e.org/" ;
              gdsn:sourceId "176637" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176638
gdsn:cv176638 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is physically marked with the Green Restaurant Association Endorsed symbol." ;
              rdfs:label "GREEN_RESTAURANT_ASSOCIATION_ENDORSED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.dinegreen.com" ;
              gdsn:sourceId "176638" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176639
gdsn:cv176639 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An independent, non-profit organization that strives to achieve a healthier and cleaner environment by identifying and promoting products." ;
              rdfs:label "GREEN_SEAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.greenseal.org/AboutGreenSeal.aspx" ;
              gdsn:sourceId "176639" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176640
gdsn:cv176640 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is physically marked with the Green Seal Certified symbol." ;
              rdfs:label "GREEN_SEAL_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.greenseal.org/AboutGreenSeal.aspx" ;
              gdsn:sourceId "176640" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176641
gdsn:cv176641 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Green Shield Certified is an independent, non-profit certification program that promotes practitioners of effective, prevention-based pest control while minimizing the need to use pesticides." ;
              rdfs:label "GREEN_SHIELD_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.greenshieldcertified.org/" ;
              gdsn:sourceId "176641" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176642
gdsn:cv176642 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Green Star Certified- \"GMO FREE CERTIFIED™ brand program certifies producers have provided laboratory results that their produce or products are GMO Free. The United States does not mandate GMO Free labelling or even recommend labelling, however producers want to provide peace of mind their produce and products are GMO free with the trusted GMO FREE CERTIFIED™ seal. Green Star Certified allows these same producers and manufactures to participate in the \"GMO FREE CERTIFIED™\" program by having there produce, seeds, feed and processed food tested by leading independent genetic testing laboratories. Once their products meet and maintain the Green Star Certified standards/threshold these producers can place the GMO FREE CERTIFED™ brand on their marketing and product labels." ;
              rdfs:label "GREEN_STAR_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.gmofreecertified.com/" ;
              gdsn:sourceId "176642" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176643
gdsn:cv176643 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "GreenChoice 100™ is superior paperboard and the only one that is Eco-Logo, FSC, and Rainforest Alliance certified all at the same time. All energy used for GreenChoice 100™ is 100% offset by renewable wind energy producers. It’s 100% carbon-neutral, as all carbon emitted is fully offset by new plantings. GreenChoice 100™ is also 100% recyclable, as 100% of fibres used come from recycled sources. Approximately 35% is post-consumer material and 65% is pre-consumer (fibres returned from the supply chain)." ;
              rdfs:label "GREENCHOICE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.strathconapaper.com/products/greenchoice.htm" ;
              gdsn:sourceId "176643" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176644
gdsn:cv176644 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This label is awarded to companies which use environment-friendly greenhouses. These greenhouses are to be set up according to strict regulations which aim to ensure the impact of the environment remains at a minimal level (less water and energy waste, no chemical waste)." ;
              rdfs:label "GROEN_LABEL_KAS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.groenlabelkas.nl/29/home.html" ;
              gdsn:sourceId "176644" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176645
gdsn:cv176645 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Gruyère de France comes from the meadows of Savoie and Franche-Comté (Haute-Saône and Doubs). It is a tasty cooked pressed cheese with raw milk, guaranteeing precious nutritional qualities." ;
              rdfs:label "GRUYERE_FRANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.gruyere-france.fr/ https://ec.europa.eu/agriculture/quality/door/registeredName.html?denominationId=10123" ;
              gdsn:sourceId "176645" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176646
gdsn:cv176646 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ireland: The Guaranteed Irish symbol makes shopping for Irish products and services a lot easier. Shoppers know that when they buy a product or service featuring the guaranteed Irish logo they are supporting Irish companies and safeguarding Irish jobs. http://www.guaranteedirish.ie/" ;
              rdfs:label "GUARANTEED_IRISH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.guaranteedirish.ie/" ;
              gdsn:sourceId "176646" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176647
gdsn:cv176647 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "For all exports, only recognised Islamic organisations such as Halal Australia can certify halal meat and meat products in Australia. The Halal Australia certification is back by Australian government assurance that the product has been produced in accordance with Islamic Shari'aa standards." ;
              rdfs:label "HALAL_AUSTRALIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://australiahalal.com/en/halal-mark.html" ;
              gdsn:sourceId "176647" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176648
gdsn:cv176648 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Halal Certification Services (HCS) is a Swiss-based inspection and certification body established in 1987, recognized and respected worldwide for its Halal services. Halal Certification Services has acquired official recognitions from JAKIM Malaysia, MUI Indonesia and MUIS Singapore enabling HCS to meet the exporting demand of food, pharmaceutical and cosmetic industry. HCS’s objectives are to raise the availability of Halal certified raw materials and products enabling the manufacturers to produce authentic Halal products." ;
              rdfs:label "HALAL_CERTIFICATION_SERVICES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://halalcs.org/en/" ;
              gdsn:sourceId "176648" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176649
gdsn:cv176649 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Halal Certification Services (HCS) is a Swiss-based inspection and certification body established in 1987, recognized and respected worldwide for its Halal services. Halal Certification Services has acquired official recognitions from JAKIM Malaysia, MUI Indonesia and MUIS Singapore enabling HCS to meet the exporting demand of food, pharmaceutical and cosmetic industry. HCS’s objectives are to raise the availability of Halal certified raw materials and products enabling the manufacturers to produce authentic Halal products. This label can only be used for products produced in Switzerland." ;
              rdfs:label "HALAL_CERTIFICATION_SERVICES_CH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://halalcs.org/en/" ;
              gdsn:sourceId "176649" ;
              gdsn:sourceType "codeValue" .


