###  urn:gs1:std:gdsn:cv170507
gdsn:cv170507 rdf:type owl:NamedIndividual ,
                       gdsn:c-613156730 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A technology used to turn standard 2D content into a 3D viewing experience." ;
              rdfs:label "2D_TO_3D" ;
              gdsn:codeListName "CombFilterTechnologyTypeCode" ;
              gdsn:sourceId "170507" ;
