              rdfs:comment "The length of the product blade for example of a hedge shears or knife." ;
              rdfs:label "BLADE_LENGTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179125" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179126
