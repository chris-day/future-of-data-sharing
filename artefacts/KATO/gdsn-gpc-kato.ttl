###  urn:gs1:std:gdsn:cv179755
gdsn:cv179755 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Irritated skin is skin that has been sensitized by the environment and characterized by redness and skin discomfort." ;
              rdfs:label "REDDENED_IRRITATED" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179755" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179756
gdsn:cv179756 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sensitive skin is a common issue but not a medical diagnosis in itself. The term generally refers to skin that is more prone to inflammation or adverse reactions." ;
              rdfs:label "SENSITIVE" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179756" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179757
gdsn:cv179757 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Skin fatigue is caused by a combination of lifestyle- and stress-related factors, lack of sleep and exercise, smoking, unhealthy diet." ;
              rdfs:label "TIRED" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179757" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179758
gdsn:cv179758 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Very dry skin is a deterioration of already dry skin. It can be caused by improper care of dry skin over prolonged time or by a medical condition. Similar to dry skin it is marked by scaling, itching, and cracking." ;
              rdfs:label "VERY_DRY" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179758" ;
              gdsn:sourceType "codeValue" .


