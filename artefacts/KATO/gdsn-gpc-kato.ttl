###  urn:gs1:std:gdsn:cv176394
gdsn:cv176394 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "CarbonNeutral® certification, from The CarbonNeutral Company, is the global standard for businesses, products or services that have measured, reduced and offset their carbon emissions to net zero, set out in accordance with the rules and regulations of the CarbonNeutral Protocol." ;
              rdfs:label "CARBON_NEUTRAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.carbonneutral.com/" ;
              gdsn:sourceId "176394" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176395
gdsn:cv176395 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Carbon Neutral Certified by NCOS certification attribute includes all products that have published the Carbon Neutral Certified seal by NCOS (National Carbon Offset Standard) on their packaging." ;
