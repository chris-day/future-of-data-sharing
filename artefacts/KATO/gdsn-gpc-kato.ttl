###  urn:gs1:std:gdsn:cv174090
gdsn:cv174090 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Translucent, colourless, brittle (when dry), flavourless substance derived from collagen obtained from various beef animal materials (connective tissues (skin) and bones). It is commonly used as a gelling agent in food, pharmaceutical drugs, photography, and cosmetic manufacturing." ;
              rdfs:label "BEEF_GELATINE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174090" ;
