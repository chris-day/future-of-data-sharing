###  urn:gs1:std:gdsn:cv181638
gdsn:cv181638 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Pharmacy Product Number (PPN) is a globally unique identifier for pharmaceutical products, used to ensure traceability within the supply chain. It is typically encoded in a 2D data matrix on packaging and issued under the authority of the IFA (Informationsstelle für Arzneispezialitäten) as the official issuing agency." ;
              rdfs:label "PPN" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "181638" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181639
gdsn:cv181639 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ŠÚKL code is a unique identifier used by the State Institute for Drug Control (ŠÚKL) in Slovakia. It uniquely identifies a specific medicinal product or medical device in the ŠÚKL database." ;
              rdfs:label "SK_SUKL" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "181639" ;
              gdsn:sourceType "codeValue" .


