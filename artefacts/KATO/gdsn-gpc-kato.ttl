                 rdfs:domain gdsn:extGroup_GS1_Germany_GDM_Local_Layer_20_09_4 ;
                 rdfs:range gdsn:extCode_MilkProductsCode ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "Characterisation (specification, differentiation) of the product on milk basis (for the German target market according to § 2 no. 7 Milk Act)." ;
                 rdfs:label "milkProducts" ;
                 gdsn:groupName "GS1 Germany GDM Local Layer 20.09-4" ;
                 gdsn:hierarchyLevel 3 ;
