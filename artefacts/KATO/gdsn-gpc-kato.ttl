###  urn:gs1:std:gdsn:cv172280
gdsn:cv172280 rdf:type owl:NamedIndividual ,
                       gdsn:c2034116970 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A commodity nomenclature of foreign-economic activity in Commonwealth of Independent States." ;
              rdfs:label "TN_VED" ;
              gdsn:codeListName "ImportClassificationTypeCode" ;
              gdsn:sourceId "172280" ;
