###  urn:gs1:std:gdsn:cv176401
gdsn:cv176401 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "California Certified Organic Farmers (CCOF) is a full-service organic certification agency and trade association passionate about being the leading voice for organic, and certifying, educating, advocating, and promoting organic." ;
