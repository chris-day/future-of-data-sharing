###  urn:gs1:std:gdsn:cv169940
gdsn:cv169940 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Witbier, white beer, bière blanche, or simply witte is a barley/wheat, top fermented beer. It gets its name from the suspended yeast and wheat proteins which cause the beer to look hazy, or white, when cold. It is a descendant from those medieval beers which were flavoured and preserved with a blend of spices and other plants such as coriander, orange, and bitter orange referred to as \"gruit\" instead of using hops." ;
              rdfs:label "WITBIER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169940" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169941
