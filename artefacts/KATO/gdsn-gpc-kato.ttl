                rdfs:domain gdsn:extGroup_BestBuy ;
                rdfs:range xsd:integer ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "How many watts does the product operate efficiently at? Measured in Watts.co" ;
                rdfs:label "applianceWattage" ;
                gdsn:example "1600; 50; 600; 700; 800; 900; 1000; 1100; 1200; 1250; 1300; 1350" ;
                gdsn:groupName "BestBuy" ;
                gdsn:hierarchyLevel 4 ;
                gdsn:originalLimit "{1..4}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "435" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "See code list in examples Column" .


