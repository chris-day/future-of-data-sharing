              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178230" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178231
gdsn:cv178231 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Term to identify the colour of the stone. Use productCharacteristicValueDescription to populate value." ;
