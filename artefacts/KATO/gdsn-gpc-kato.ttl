                       gdsn:c468201027 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Revised: Content has been revised from that of a previous edition." ;
              rdfs:label "REV" ;
              gdsn:codeListName "ONIXEditionTypeCode" ;
              gdsn:sourceId "174550" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174551
gdsn:cv174551 rdf:type owl:NamedIndividual ,
                       gdsn:c468201027 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "School edition: An edition intended specifically for use in schools." ;
              rdfs:label "SCH" ;
              gdsn:codeListName "ONIXEditionTypeCode" ;
              gdsn:sourceId "174551" ;
