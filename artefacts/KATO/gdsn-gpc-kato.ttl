              gdsn:codeListName "CheeseMilkAcquisitionTypeCode" ;
              gdsn:sourceId "170179" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170180
gdsn:cv170180 rdf:type owl:NamedIndividual ,
                       gdsn:c-512160160 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"farmer\" cheese is produced with milk from a single farm, typical of its region. It is almost always made from raw milk." ;
              rdfs:label "FARM" ;
              gdsn:codeListName "CheeseMilkAcquisitionTypeCode" ;
              gdsn:sourceId "170180" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170181
gdsn:cv170181 rdf:type owl:NamedIndividual ,
                       gdsn:c-512160160 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"fruitier or fruit\" cheese is made in a common place where milks of the same origin are gathered. Producers respect traditional regional customs and are grouped into cooperatives. The use of raw milk is essential." ;
              rdfs:label "FRUITIER" ;
              gdsn:codeListName "CheeseMilkAcquisitionTypeCode" ;
              gdsn:sourceId "170181" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170182
gdsn:cv170182 rdf:type owl:NamedIndividual ,
                       gdsn:c-688413220 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ripening process develops within the whole body of the cheese." ;
              rdfs:label "RIPENED" ;
              gdsn:codeListName "CheeseRipeningProcessCode" ;
              gdsn:sourceId "170182" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170183
gdsn:cv170183 rdf:type owl:NamedIndividual ,
                       gdsn:c-688413220 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ripening process starts from the surface and moves into the body of the cheese. These cheeses are often one colour on the exterior and another on the interior; the interior is usually soft and buttery. The outer \"rind\" can be consumed and may be washed prior to packaging." ;
              rdfs:label "SURFACE_RIPENED" ;
              gdsn:codeListName "CheeseRipeningProcessCode" ;
              gdsn:sourceId "170183" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170184
gdsn:cv170184 rdf:type owl:NamedIndividual ,
                       gdsn:c-688413220 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The cheese that is exposed to mould is ripened and the veins of mould appears within the body of the cheese." ;
              rdfs:label "BLUE_VEINED" ;
              gdsn:codeListName "CheeseRipeningProcessCode" ;
              gdsn:sourceId "170184" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170185
gdsn:cv170185 rdf:type owl:NamedIndividual ,
                       gdsn:c-688413220 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The cheese has not undergone any ripening. They are \"fresh\" and often spreadable." ;
              rdfs:label "UNRIPENED_OR_FRESH" ;
              gdsn:codeListName "CheeseRipeningProcessCode" ;
              gdsn:sourceId "170185" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170186
gdsn:cv170186 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A type of processed cheese that is smooth hard white or yellow cheese similar to a mild Cheddar." ;
              rdfs:label "AMERICAN_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170186" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170187
gdsn:cv170187 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft, blue-veined cheese produced with the pasteurized cow’s milk. The cheese is injected with the Penicillium roqueforti during its maturation period and the fungus develops inside the cheese." ;
              rdfs:label "BAVARIAN_BLUE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170187" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170188
gdsn:cv170188 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A firm, raw cow's milk cheese with pale yellow colour. It has a smooth and creamy texture and lacks holes like other Gruyère-style cheeses, Comté, Vacherin Fribourgeois or Emmental." ;
              rdfs:label "BEAUFORT" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170188" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170189
gdsn:cv170189 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cheese spread usually consists of a processed cheese base with a sharp cheddar flavor. To this, enough beer is added to provide flavour and texture, as well as garlic, and a variety of spices including dry mustard, horseradish and cayenne pepper." ;
              rdfs:label "BEER_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170189" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170190
gdsn:cv170190 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A dense and crumbly cheese that has blue veins like Stilton or Shropshire Blue but is less creamy than Stilton and is not coloured orange as Shropshire Blue." ;
              rdfs:label "BLUE_CHESHIRE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170190" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170191
gdsn:cv170191 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A blue cheese that is made from pasteurised cows' milk and uses vegetable rennet. The orange colour comes from the addition of annatto, a natural food colouring. Penicillium roqueforti produces the veining." ;
              rdfs:label "BLUE_SHROPSHIRE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170191" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170192
gdsn:cv170192 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A blue cheese that is made from pasteurized milk. Penicillium roqueforti is added to generate a characteristic smell and taste." ;
              rdfs:label "BLUE_STILTON" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170192" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170193
gdsn:cv170193 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semisoft, sweet-tasting cheese, made from the whole milk of cows and produced in brick form." ;
              rdfs:label "BRICK_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170193" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170194
gdsn:cv170194 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft cow's-milk cheese that is pale in color with a slight grayish tinge under a rind of white mould. The rind is typically eaten, with its flavour depending largely upon the ingredients used and its manufacturing environment." ;
              rdfs:label "BRIE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170194" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170195
gdsn:cv170195 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A farmhouse and creamery semi-hard cheese which is made with whey, milk, and/or cream. Also known as Geitost, Mysost, Brown cheese." ;
              rdfs:label "BRUNOST_GJETOST" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170195" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170196
gdsn:cv170196 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-soft, cow's milk cheese (Butterkäse) that has a buttery flavour and appearance. It is often described as mild, partly due to its brief aging time." ;
              rdfs:label "BUTTERCHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170196" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170197
gdsn:cv170197 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cream cheese made with double cream or cream-enriched milk. This rennet-free cheese is smooth, slightly thicker and grainier than clotted cream, while the colour is a pale primrose yellow." ;
              rdfs:label "CABOC" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170197" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170198
gdsn:cv170198 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A blue cheese that can be made from pure, unpasteurized cow’s milk or blended in the traditional manner with goat and/or sheep milk, which lends the cheese a stronger, spicier flavor." ;
              rdfs:label "CABRALES" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170198" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170199
gdsn:cv170199 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A type of stretched-curd cheese made out of sheep's or cow's milk. Shaped like a teardrop, it is similar in taste to the aged Southern Italian Provolone cheese, with a hard edible rind." ;
              rdfs:label "CACIOCAVALLO" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170199" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170200
gdsn:cv170200 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A hard, crumbly white cheese that is made from cow's milk, and generally has a fat content of between 45% and 55%. It has a mild taste, with a tang of lemon." ;
              rdfs:label "CAERPHILLY" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170200" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170201
gdsn:cv170201 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A moist, soft, creamy, surface-ripened cow's milk cheese. It is sometimes compared in look and taste to brie cheese." ;
              rdfs:label "CAMEMBERT" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170201" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170202
gdsn:cv170202 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An uncooked firm cheese with a strong, tangy butter taste that grows with age. A well ripened Cantal has a vigorous nutty and tangy taste, while a young cheese has a hint of sweet and buttery taste of raw milk." ;
              rdfs:label "CANTAL" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170202" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170203
gdsn:cv170203 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cow's milk cheese with cylindrical in shape. It has a soft-ripened, creamy and a little bit crumbly, non-elastic texture and is surrounded by a white Penicillium candidum rind." ;
              rdfs:label "CHAOURCE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170203" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170204
gdsn:cv170204 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A relatively hard, off-white (or orange if colourings such as annatto are added), sometimes sharp-tasting, natural cheese. The style and quality of cheeses labelled as cheddar may vary greatly, with some processed cheeses being packaged as \"cheddar\" while bearing little resemblance." ;
              rdfs:label "CHEDDAR" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170204" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170205
gdsn:cv170205 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cheese that is matured in brine in an airtight or semi-permeable container. This process gives the cheese good stability, inhibiting bacterial growth even in warmer climates. Brined cheeses may be soft or hard, varying in moisture content and in colour and flavour according to the type of milk used." ;
              rdfs:label "CHEESE_IN_BRINE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170205" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170206
gdsn:cv170206 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-hard cow's milk cheese with a Hazel-nutty flavour and an orange colour. It is often found blended with Manchego cheese. It is similar to cheddar cheese but does not undergo the cheddaring process. Considered a semi-hard cheese, Colby is softer, moister, and milder than cheddar because it is produced through a washed-curd process" ;
              rdfs:label "COLBY" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170206" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170207
gdsn:cv170207 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cheese that is made from Colby and Monterey Jack. It is classified as semi-hard in texture and is mild due to its two-week aging process." ;
              rdfs:label "COLBY_JACK" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170207" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170208
gdsn:cv170208 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A fresh cheese that is soft, curdy similar to cream cheese in texture but slightly more sour in flavour. The cheese is produced in such a way that it has a distinctive bowl shape and traditionally locals would fill the bowl with different fillings, both sweet and savoury." ;
              rdfs:label "COLWICK" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170208" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170209
gdsn:cv170209 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A simple fresh cheese curd product with a mild flavor and a creamy, non-homogenous, soupy texture. It is also known as curds and whey. It is made from cow's milk by draining the cheese, as opposed to pressing it to make cheese curd—retaining some of the whey and keeping the curds loose." ;
              rdfs:label "COTTAGE_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170209" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170210
gdsn:cv170210 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft ripened cheese that is made from cow's milk and is usually in the shape of a disc with white, bloomy, edible Penicillium candidum rind." ;
              rdfs:label "COULOMMIERS" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170210" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170211
gdsn:cv170211 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft, usually mild-tasting fresh cheese made from milk and cream. Stabilizers such as carob bean gum and carrageenan are often added in industrial production." ;
              rdfs:label "CREAM_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170211" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170212
gdsn:cv170212 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Curd cheese is the moist pieces of curdled milk that are made from fresh pasteurized milk in the process of creating cheese. After the milk clots, it is then cut into cubes; the result is a mixture of whey and curd. This mixture is then cooked and pressed to release the whey from the curd, creating the final product of cheese curd." ;
              rdfs:label "CURD_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170212" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170213
gdsn:cv170213 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Danbo is a ripened firm/semi-hard cheese. The body has a near white or ivory through to light yellow or yellow colour and a firm-textured (when pressed by thumb) texture, suitable for cutting, with few to plentiful, evenly distributed, smooth and round pea sized gas holes, but a few openings and splits are acceptable. The shape is flat squared or parallelepiped. The cheese is manufactured and sold with or without hard or slightly moist smear ripened rind, which may be coated." ;
              rdfs:label "DANBO" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170213" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170214
gdsn:cv170214 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A strong, blue-veined cheese (Danablu). It is a semi-soft creamery cheese typically drum- or block-shaped and has a yellowish, slightly moist, edible rind. Made from full fat cow's milk and homogenized cream. Danablu often marketed under the trademark Danish Blue Cheese within North America." ;
              rdfs:label "DANISH_BLUE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170214" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170215
gdsn:cv170215 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A blue veined soft cheese that is made from cow's milk and has a sweet taste." ;
              rdfs:label "DOLCELATTE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170215" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170216
gdsn:cv170216 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A traditional, full fat, hard cheese made from pasteurised or unpasteurised cow's milk." ;
              rdfs:label "DOUBLE_GLOUCESTER" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170216" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170217
gdsn:cv170217 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A sweet-milk cheese made from pasteurized cow's milk. When young, the cheese develops a nutty flavour and smooth, close texture. As it matures, the texture becomes firm and builds up sharp flavours." ;
              rdfs:label "DUNLOP" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170217" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170218
gdsn:cv170218 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-hard cheese that is traditionally sold in flat-ended spheres with a pale-yellow interior and a coat, or rind, of red paraffin wax." ;
              rdfs:label "EDAM" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170218" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170219
gdsn:cv170219 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A yellow, medium-hard cheese with savory but mild taste that is classified as a Swiss-type or Alpine cheese. Also know as Emmental or Emmentaler." ;
              rdfs:label "EMMENTHAL" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170219" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170220
gdsn:cv170220 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Époisses is a pungent soft-paste cow's milk cheese with distinctive soft red-orange colour." ;
              rdfs:label "EPOISSES" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170220" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170221
gdsn:cv170221 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Trappist-style pale yellow semi-soft cow's milk cheese which has a pungent aroma and a full, sweet flavour. Esrom is a porous cheese, with many small holes throughout, and is slightly elastic and buttery in texture. It is also known as Danish Port Salut." ;
              rdfs:label "ESROM" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170221" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170222
gdsn:cv170222 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A pressed cottage cheese that is made by adding rennet and bacterial starter to coagulate and acidify milk. Farmer cheese may be made from the milk of cows, sheep or goats, with each giving its own texture and flavour." ;
              rdfs:label "FARMER_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170222" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170223
gdsn:cv170223 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A brined curd white cheese that is soft, with small or no holes, a compact touch, few cuts, and no skin. It is formed into large blocks and aged in brine. Its flavour is tangy and salty, ranging from mild to sharp." ;
              rdfs:label "FETA" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170223" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170224
gdsn:cv170224 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-soft to hard cheese that is mild to medium-sharp in flavour from cow's milk. The characteristic flavour of Fontina is mild but distinctively nutty and savoury." ;
              rdfs:label "FONTINA" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170224" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170225
gdsn:cv170225 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-hard blue cheese that is made from raw cow's milk with a distinct and narrow cylindrical shape. It is inoculated with Penicillium roqueforti spores and aged for at least 28 days." ;
              rdfs:label "FOURME_DAMBERT" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170225" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170226
gdsn:cv170226 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A creamy soft cheese made with whole or skimmed milk and cream." ;
              rdfs:label "FROMAGE_BLANC" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170226" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170227
gdsn:cv170227 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cheese made from goat's milk (Goat cheese). It is made in a wide variety of styles, from soft fresh cheese to hard aged cheese." ;
              rdfs:label "FROMAGE_DE_CHEVRE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170227" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170228
gdsn:cv170228 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A type of a white cheese, usually made with skim milk, with a variety of textures depending upon how it has been produced. It is often used in combination with other ingredients such as savory spices or sweet berries." ;
              rdfs:label "FROMAGE_FRAIS" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170228" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170229
gdsn:cv170229 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A pasteurised cow's milk cheese that has a light-yellow colour with small holes and a mild, aromatic flavour. It has a waxed rind, which is usually red." ;
              rdfs:label "GEHEIMRATSKAESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170229" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170230
gdsn:cv170230 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A veined blue cheese made from unskimmed cow's milk. It can be buttery or firm, crumbly and quite salty, with a \"bite\" from its blue veining." ;
              rdfs:label "GORGONZOLA" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170230" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170231
gdsn:cv170231 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A sweet, creamy, yellow semi-hard to hard cow's milk cheese." ;
              rdfs:label "GOUDA" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170231" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170232
gdsn:cv170232 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A hard yellow cheese that is classified as a Swiss-type or Alpine cheese, and is sweet but slightly salty, with a flavour that varies widely with age." ;
              rdfs:label "GRUYERE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170232" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170233
gdsn:cv170233 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-hard, unripened cheese made from a mixture of goat's and sheep's milk, and sometimes also cow's milk." ;
              rdfs:label "HALLOUMI" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170233" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170234
gdsn:cv170234 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-soft cow's milk cheese. Havarti is a washed-curd cheese, which contributes to the subtle flavour of the cheese. It is an interior-ripened cheese that is rindless, smooth, and slightly bright-surfaced with a cream to yellow colour depending on type." ;
              rdfs:label "HAVARTI" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170234" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170235
gdsn:cv170235 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A mild cheese made from cow's-milk, with large, regular eyes. It has a yellow wax rind and a semi-firm yellow interior. It is a mild, buttery cheese and the flavour has been described as \"clean and rich, with a slightly sweet and nutty flavour\"." ;
              rdfs:label "JARLSBERG" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170235" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170236
gdsn:cv170236 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A spreadable, creamy sour milk cheese (cooked cheese)." ;
              rdfs:label "KOCHKAESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170236" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170237
gdsn:cv170237 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cow's milk cheese with a crumbly texture and a mild flavour when the cheese is young, but as it becomes older, the taste matures and becomes sharper." ;
              rdfs:label "LANCASHIRE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170237" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170238
gdsn:cv170238 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-hard, cumin and caraway seed flavoured cheese made from cow's milk." ;
              rdfs:label "LEYDEN" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170238" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170239
gdsn:cv170239 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A firm and compact sheep's milk cheese with a buttery texture, often containing small, unevenly distributed air pockets. The colour of the cheese varies from white to ivory-yellow, and the inedible rind from yellow to brownish-beige." ;
              rdfs:label "MANCHEGO" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170239" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170240
gdsn:cv170240 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A name given to cheeses with marbled patterns. It is usually hard, processed cow's milk cheese produced by combining either two different coloured curds, cheese curds or processed cheeses." ;
              rdfs:label "MARBLED_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170240" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170241
gdsn:cv170241 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A white, semi-hard cheese made using cow's milk. It is noted for its mild flavour and slight sweetness." ;
              rdfs:label "MONTEREY_JACK" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170241" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170242
gdsn:cv170242 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-soft fresh cheese made by the pasta filata (stretched-curd) method. Fresh mozzarella is generally white but when seasoned, it turns to a light yellow depending on the animal's diet." ;
              rdfs:label "MOZZARELLA" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170242" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170243
gdsn:cv170243 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-soft cheese that is pale in colour and smooth in texture with an orange rind. The cheese is made from pasteurized cow's milk. Also known as Munster." ;
              rdfs:label "MUENSTER" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170243" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170244
gdsn:cv170244 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft, artisan, blue-veined cow's milk. It is moist and creamy, little salty but not bitter and belongs to blue cheese family. It comes with a blue-green mold and mild aromatic taste. Also know as Danish Gorgonzola." ;
              rdfs:label "MYCELLA" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170244" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170245
gdsn:cv170245 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft, slightly crumbly, mold-ripened cow's milk cheese." ;
              rdfs:label "NEUFCHATEL" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170245" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170246
gdsn:cv170246 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A medium firm sheep's milk. Ossau-Iraty cheese crust is yellow-orange to gray, and the body color ranges from white to cream depending on how it has been matured. It is smooth, creamy and firm, and may have some small eyes." ;
              rdfs:label "OSSAU_IRATY" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170246" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170247
gdsn:cv170247 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A hard, granular cheese produced from unpasteurised cow's milk." ;
              rdfs:label "PARMESAN" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170247" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170248
gdsn:cv170248 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A hard cheese made from sheep's milk. Pecorinos are traditional, creamery, hard, drum-shaped cheese. They come in a variety of flavours depending on ageing period." ;
              rdfs:label "PECORINO" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170248" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170249
gdsn:cv170249 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-soft, wash-rind cheese that has a strong aroma and slightly sticky outer surface." ;
              rdfs:label "PETIT_MUNSTER" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170249" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170250
gdsn:cv170250 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In the cuisine of the Southern United States, pimento (or pimiento) cheese is a spread or relish made with cheese, mayonnaise and pimentos. Elsewhere, different ingredients may be used. It is served on bread, crackers and vegetables, or in sandwiches. The basic recipe has few ingredients: sharp cheddar cheese or processed cheese (such as Velveeta or American cheese), mayonnaise or salad dressing, and pimentos, blended to either a smooth or chunky paste." ;
              rdfs:label "PIMENTO_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170250" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170251
gdsn:cv170251 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft to semisoft blue cheese made with cow's milk. It has a smooth, creamy, ivory paste with blue veining and a thin white penicillin rind." ;
              rdfs:label "PIPO_CREM" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170251" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170252
gdsn:cv170252 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A food product made from cheese and other unfermented dairy ingredients mixed with emulsifiers. Additional ingredients, such as vegetable oils, salt, food coloring, or sugar may be included. As a result, many flavours, colours, and textures of processed cheese exist." ;
              rdfs:label "PROCESSED_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170252" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170253
gdsn:cv170253 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An aged pasta filata (stretched-crud) cheese." ;
              rdfs:label "PROVOLONE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170253" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170254
gdsn:cv170254 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-soft, white, string-type, Hispanic-style cheese made from cow's milk. Belonging to the pasta filata (stretched-crud) family, similar to a Mozzarella, Queso Quesillo is a stretched curd cheese, kneaded and sold in long ropes gently wound in balls. Also known as Queso Oaxaca, Asadero or Quesillo." ;
              rdfs:label "QUESO_QUESADILLA" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170254" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170255
gdsn:cv170255 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A raw, semi-hard, mildly flavoured cheese made from cow's milk which is used for melting and grilling." ;
              rdfs:label "RACLETTE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170255" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170256
gdsn:cv170256 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft washed-rind and smear-ripened cheese made from raw cow's milk." ;
              rdfs:label "REBLOCHON" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170256" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170257
gdsn:cv170257 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A dense and crumbly cheese that is coloured with annatto to a shade of deep orange." ;
              rdfs:label "RED_CHESHIRE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170257" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170258
gdsn:cv170258 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cheese made in a similar manner to Cheddar cheese, although it is crumbly in texture, and typically sold at 6 to 12 months of age. The rind is reddish-orange, with a powdery mould on it. Also know as Leicester or Leicestershire cheese." ;
              rdfs:label "RED_LEICESTER" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170258" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170259
gdsn:cv170259 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A whey cheese made from sheep, cow, goat, or water buffalo milk whey left over from the production of other cheeses. Like other whey cheeses, it is made by coagulating the proteins that remain after the casein has been used to make cheese, notably albumin and globulin." ;
              rdfs:label "RICOTTA" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170259" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170260
gdsn:cv170260 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A term used in the United States and Canada for a class of hard, salty cheese suitable primarily for grating similar to Pecorino Romano, from which the name is derived. Romano cheese can be made from cow, goat, and/or sheep's milk." ;
              rdfs:label "ROMANO" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170260" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170261
gdsn:cv170261 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi-hard sheep's milk cheese that is white, tangy, crumbly and slightly moist, with distinctive veins of blue mold." ;
              rdfs:label "ROQUEFORT" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170261" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170262
gdsn:cv170262 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cheese with a soft and creamy texture, that is usually flavoured with herbs and garlic." ;
              rdfs:label "ROULE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170262" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170263
gdsn:cv170263 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft, mold ripened cheese made from unpasteurized cow's milk." ;
              rdfs:label "SAINT_MARCELLIN" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170263" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170264
gdsn:cv170264 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A creamy, mild, semi-soft cheese made from pasteurized cow's milk. Saint-Paulin is a buttery cheese, but firm enough for slicing." ;
              rdfs:label "SAINT_PAULIN" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170264" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170265
gdsn:cv170265 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Samsø is a ripened hard cheese. The body has a near white or ivory through to light yellow or yellow colour and a firm-textured (when pressed by thumb) texture suitable for cutting, with few to plentiful, evenly distributed, smooth and round pea to cherry sized gas holes, but few openings and splits are acceptable. The shape is a flat cylindrical, flat square or rectangular. The cheese is sold with or without a hard, dry rind, which may be coated." ;
              rdfs:label "SAMSO" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170265" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170266
gdsn:cv170266 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A traditional hard cheese that is made out of the skimmed cow milk and a special kind of herb, blue fenugreek. Also know as Schabziger." ;
              rdfs:label "SAPSAGO" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170266" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170267
gdsn:cv170267 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A very hard cheese made from cow's milk. It is often used instead of Parmesan cheese in Swiss cuisine." ;
              rdfs:label "SBRINZ" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170267" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170268
gdsn:cv170268 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A generic name for several varieties of cheese. It is an American version of the Swiss Emmental and is known for being a shiny, pale yellow colour. While it has a firmer texture than baby Swiss, its flavour is mild, sweet, and nut-like. It has a savoury, but not very sharp taste." ;
              rdfs:label "SWISS_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170268" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170269
gdsn:cv170269 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semisoft, washed-rind, smear-ripened that has a thin crust and a strong aroma, but its flavour is comparatively mild with an unusual fruity tang." ;
              rdfs:label "TALEGGIO" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170269" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170270
gdsn:cv170270 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Tilsiter is a ripened firm/semi-hard cheese. The body has a near white or ivory through to light yellow or yellow colour and a firm-textured (when pressed by thumb) texture suitable for cutting, with irregularly shaped, shiny and evenly distributed gas holes. The cheese is manufactured and sold with or without a well-dried smear-developed rind, which may be coated." ;
              rdfs:label "TILSITER" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170270" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170271
gdsn:cv170271 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A variety of Tommee cheese that is pressed, uncooked. Fruity and mellow with a very slight sharpness. The cheese is aged under a thick blanket of grape marc, the residue that's left after pressing the fruit to make wine. The taste of the marc permeates through to the heart of the cheese." ;
              rdfs:label "TOMME_AU_RAISIN" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170271" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170272
gdsn:cv170272 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Weisskaese or Weichkaese is a soft cheese. It is a generic term for all soft cheeses with a relatively high-water content. Weichkaese white cheese has a velvety white coating of a mould." ;
              rdfs:label "WEISSKAESE_WHITE_CHEESE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170272" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170273
gdsn:cv170273 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A historic mild cheese that is made from pasteurised cow's milk. Wensleydale is a medium cheese that is supple and crumbly and has a slight honey aroma." ;
              rdfs:label "WENSLEYDALE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170273" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170274
gdsn:cv170274 rdf:type owl:NamedIndividual ,
                       gdsn:c213470074 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A dense and crumbly cheese that is dense and semi-hard, and is defined by its moist, crumbly texture and mild, salty taste." ;
              rdfs:label "WHITE_CHESHIRE" ;
              gdsn:codeListName "CheeseTypeCode" ;
              gdsn:sourceId "170274" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170275
gdsn:cv170275 rdf:type owl:NamedIndividual ,
                       gdsn:c1173281864 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A material, which has a vapor pressure greater than 300 kPa (43.5 psia) at 50°C (122°F) or is completely gaseous at 20°C (68°F) at a standard pressure of 101.3 kPa (14.7 psia). Including: · Aerosol: Any non-refillable receptacle containing a gas compressed, liquefied or dissolved under pressure, the sole purpose of which is to expel a nonpoisonous (other than a Division 6.1 Package Group III Material) liquid, paste, or powder and fitted with a self-closing release device allowing the contents to be ejected by the gas. · Asphyxiant Gas: A gas, which dilutes or replaces the oxygen normally in the atmosphere. · Compressed Gas in Solution: A non-liquefied compressed gas, which is dissolved in a solvent. · Liquefied Compressed Gas: A gas, which when packaged under pressure for transportation is partially liquid at temperatures above -50° C (-58° F). A liquefied compressed gas is further categorized as follows: o High Pressure Liquefied Gas: A gas with a critical temperature between -50 °C (-58° F) and + 65° C (149° F). o Low Pressure Liquefied Gas: A gas with a critical temperature above + 65° C (149° F). · Non-Liquefied Compressed Gas: A gas, which when packaged under pressure for transportation is entirely gaseous at -50° C (-58° F) with a critical temperature less than or equal to -50° C (-58° F). Oxidizing Gas: A gas, which may, generally by providing oxygen, cause or contribute to the combustion of other material more than air does." ;
              rdfs:label "GAS" ;
              gdsn:codeListName "ChemicalPhysicalStateCode" ;
              gdsn:sourceId "170275" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170276
gdsn:cv170276 rdf:type owl:NamedIndividual ,
                       gdsn:c1173281864 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A material, other than an elevated temperature material, with a melting point or initial melting point of 20°C (68°F) or lower at a standard pressure of 101.3 kPa (14.7 psia). A viscous material for which a specific melting point cannot be determined must be subjected to the procedures specified in ASTM D 4359 \"Standard Test Method for Determining Whether a Material is Liquid or Solid”." ;
              rdfs:label "LIQUID" ;
              gdsn:codeListName "ChemicalPhysicalStateCode" ;
              gdsn:sourceId "170276" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170277
gdsn:cv170277 rdf:type owl:NamedIndividual ,
                       gdsn:c1173281864 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any combination of the other states." ;
              rdfs:label "MIXED" ;
              gdsn:codeListName "ChemicalPhysicalStateCode" ;
              gdsn:sourceId "170277" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170278
gdsn:cv170278 rdf:type owl:NamedIndividual ,
                       gdsn:c1173281864 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "All non-toxic refrigerant gases, dispersant gases (fluorocarbons) and mixtures thereof, or any other compressed gas having a vapor pressure not exceeding 260 psia at 54°C (130°F), used only as a refrigerant, dispersant or blowing agent." ;
              rdfs:label "REFRIGERANT_OR_DISPERSANT_GAS" ;
              gdsn:codeListName "ChemicalPhysicalStateCode" ;
              gdsn:sourceId "170278" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170279
gdsn:cv170279 rdf:type owl:NamedIndividual ,
                       gdsn:c1173281864 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cryogenic Liquid . A refrigerated liquefied gas having a boiling point colder than -90°C (-130°F) at 101.3 kPa (14.7 psia)." ;
              rdfs:label "REFRIGERATED_LIQUID" ;
              gdsn:codeListName "ChemicalPhysicalStateCode" ;
              gdsn:sourceId "170279" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170280
gdsn:cv170280 rdf:type owl:NamedIndividual ,
                       gdsn:c1173281864 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A material that does not meet the definition of a liquid or gas (i.e., powder, pellet, flake)." ;
              rdfs:label "SOLID" ;
              gdsn:codeListName "ChemicalPhysicalStateCode" ;
              gdsn:sourceId "170280" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170281
gdsn:cv170281 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Agents that inhibit or prevent the development, maturation, and proliferation of malignant cells." ;
              rdfs:label "ANTINEOPLASTIC" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170281" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170282
gdsn:cv170282 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Biohazard substances pose a threat to the health of living organisms, primarily that of humans. Biohazards normally come from biological sources or substances used in the diagnosis, prevention, or treatment of diseases. Having the knowledge of whether a trade item contains biomedical hazards will allow for the item to be handled and administered safely." ;
              rdfs:label "BIOHAZARD" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170282" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170283
gdsn:cv170283 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A preparation, such as a drug, a vaccine, or an antitoxin, that is synthesized from living organisms or their products and used as a diagnostic, preventive, or therapeutic agent." ;
              rdfs:label "BIOLOGIC" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170283" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170284
gdsn:cv170284 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Carcinogen is a substance capable of causing cancer in living tissue." ;
              rdfs:label "CARCINOGEN" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170284" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170285
gdsn:cv170285 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Cytotoxic is a compound that is toxic to cells." ;
              rdfs:label "CYTOTOXIC" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170285" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170286
gdsn:cv170286 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Confirms the product has no biohazardous substance" ;
              rdfs:label "NOT_BIOHAZARD" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170286" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170287
gdsn:cv170287 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any other chemical property not include in this list." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170287" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170288
gdsn:cv170288 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The hazards from radiation of radioactive materials taken into the body. The effects depend on the dose, the duration of exposure, and the organs exposed." ;
              rdfs:label "RADIOACTIVE" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170288" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170289
gdsn:cv170289 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The tendency of a substance to undergo chemical reaction, either by itself or with other materials, and to release energy." ;
              rdfs:label "REACTIVITY" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170289" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170290
gdsn:cv170290 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A hazard associated with some chemical substances that they will interfere in some way with normal reproduction. Such substances are called reprotoxic. It includes adverse effects on sexual function and fertility in adult males and females, as well as developmental toxicity in the offspring." ;
              rdfs:label "REPRODUCTIVE_TOXICITY" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170290" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170291
gdsn:cv170291 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The thermodynamic stability of a chemical system." ;
              rdfs:label "STABILITY" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170291" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170292
gdsn:cv170292 rdf:type owl:NamedIndividual ,
                       gdsn:c1030685439 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Degree to which a substance can damage an organism" ;
              rdfs:label "TOXICITY" ;
              gdsn:codeListName "ChemicalPropertyTypeCode" ;
              gdsn:sourceId "170292" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170293
gdsn:cv170293 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Vegetable Section of the Food Buying Guide. Vegetables that are fresh, frozen, or canned vegetables and full-strength vegetable juice may contribute toward the vegetable requirement. The minimum creditable amount is 1/8 cup. The vegetable component is credited on a volume measure. The unit of measure is “cup”. Beans and legume vegetables may be counted towards the meats/meat alternates or vegetable component, but not as both simultaneously. Vegetable crediting for beans/peas (legumes) is expressed by rounding down to the nearest 1/8 cup. Examples of bean/peas (legumes) include:black beans, black-eyed peas (mature, dry), garbanzo beans (chickpeas), kidney beans, lentils, navy beans, pinto beans, soy beans, split peas, and white beans." ;
              rdfs:label "BEANS_PEAS_LEGUMES" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170293" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170294
gdsn:cv170294 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Grains Section of the Food Buying Guide and/or Exhibit A: School Lunch and Breakfast Whole Grain-Rich Ounce Equivalency for School Meal Programs. *Regulations on APP are fond in 7 CFR Parts 210, 220, 225, 226 Appendix A. The minimum creditable amount is 0.25 ounce equivalents. Crediting is expressed by rounding down to the nearest 0.25 ounce equivalent increment. Foods that qualify as grains/bread in the Child Nutrition Program are enriched or whole-grain or are made from enriched or whole-grain meal and or flour. All grains must meet the whole grain-rich criteria: a blend of whole-grain meal and/or flour and enriched meal and/or flour of which at least 50 percent is whole grain, with the remaining grains, if any, being enriched." ;
              rdfs:label "BREAD_OR_BREAD_ALTERNATIVE" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170294" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170295
gdsn:cv170295 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Vegetable Section of the Food Buying Guide. Vegetables that are fresh, frozen, or canned vegetables and full-strength vegetable juice may contribute toward the vegetable requirement. The minimum creditable amount is 1/8 cup. The vegetable component is credited on a volume measure. The unit of measure is “cup”. Crediting for dark green vegetable is expressed by rounding down to the nearest 1/8 cup. Examples of dark green vegetables include: bok choy, broccoli, collard greens, dark green leafy lettuce, kale, mesclun, mustard greens, romaine lettuce, spinach, turnip greens, and watercress." ;
              rdfs:label "DARK_GREEN_VEGETABLE" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170295" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170296
gdsn:cv170296 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fluid milk means pasteurized unflavored or flavored low fat (1%), lactose free milk, lactose reduced milk, buttermilk, and acidified milk, all of which meet State and local standards for such milk. The milk must contain vitamins A and D at levels specified by the U.S. Food and Drug Administration, and must be consistent with State and local standards. School food authorities must offer at least two different options of fluid milk. Milk (flavored or unflavored) must be fat-free or low fat (1% fat or less). The fluid milk component is credited on a volume measure. The unit of measure is “cup”. Minimum credit is 1/2 cup. Crediting for fluid milk is expressed by rounding down to the nearest 1/4 cup. Non-dairy beverages offered as fluid milk substitutes may also be offered in the NSLP, SBP, and CACFP. However, they must be nutritionally equivalent to milk and provide specific levels of calcium, protein, vitamins A and D, magnesium, phosphorus, potassium, riboflavin, and vitamin B-12." ;
              rdfs:label "FLUID_MILK" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170296" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170297
gdsn:cv170297 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Fruit Section of the Food Buying Guide. Fresh, frozen, dried, canned (packed in water, full-strength juice, or light syrup) and full-strength fruit juice may contribute toward the fruit requirement. The minimum creditable amount for fruit is 1/8 cup. The Fruit component is credited on a volume measure. The unit of measure is “cup”. Crediting for fruit is expressed by rounding down to the nearest 1/8 cup." ;
              rdfs:label "FRUIT" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170297" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170298
gdsn:cv170298 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Fruit Section of the Food Buying Guide. Fresh, frozen, dried, canned (packed in water, full-strength juice, or light syrup) and full-strength fruit juice may contribute toward the fruit requirement. The minimum creditable amount for fruit is 1/8 cup. The Fruit component is credited on a volume measure. The unit of measure is “cup”. Crediting for fruit is expressed by rounding down to the nearest 1/8 cup." ;
              rdfs:label "FRUIT_VEGETABLE_OR_FRUIT_VEGETABLE_ALTERNATIVE" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170298" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170299
gdsn:cv170299 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Grains Section of the Food Buying Guide and/or Exhibit A: School Lunch and Breakfast Whole Grain-Rich Ounce Equivalency for School Meal Programs. *Regulations on APP are fond in 7 CFR Parts 210, 220, 225, 226 Appendix A. The minimum creditable amount is 0.25 ounce equivalents. Crediting is expressed by rounding down to the nearest 0.25 ounce equivalent increment. Foods that qualify as grains/bread in the Child Nutrition Program are enriched or whole-grain or are made from enriched or whole-grain meal and or flour. All grains must meet the whole grain-rich criteria: a blend of whole-grain meal and/or flour and enriched meal and/or flour of which at least 50 percent is whole grain, with the remaining grains, if any, being enriched." ;
              rdfs:label "GRAINS" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170299" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170300
gdsn:cv170300 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Meat/Meat Alternates Section of the Food Buying Guide. The M/MA must be served in the main dish or in the main dish and one other menu item. In order for a food to contribute to the M/MA component, it must contain a minimum of 0.25 oz. Crediting for M/MA is expressed by rounding down to the nearest 0.25 oz. Examples Include: meat, poultry, fish, cheese, yogurt, dry beans and peas, whole eggs, alternate protein products (APP)*, soy yogurt, tofu, peanut butter or other nut or seed butters, and nuts and seeds. may also be counted as meeting part of the M/MA requirement. Enriched macaroni-type products with fortified protein as defined in 7 CFR Part 210 Appendix A." ;
              rdfs:label "MEAT_OR_MEAT_ALTERNATIVE" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170300" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170301
gdsn:cv170301 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Vegetable Section of the Food Buying Guide. Vegetables that are fresh, frozen, or canned vegetables and full-strength vegetable juice may contribute toward the vegetable requirement. The minimum creditable amount is 1/8 cup. The vegetable component is credited on a volume measure. The unit of measure is “cup”. Crediting for other vegetable is expressed by rounding down to the nearest 1/8 cup. Examples of other vegetables include: artichokes, asparagus, avocado, bean sprouts, beets, Brussels sprouts, cabbage, cauliflower, celery, cucumbers, eggplant, green beans, green peppers, iceberg lettuce, mushrooms, okra, onions, parsnips, turnips, wax beans, and zucchini." ;
              rdfs:label "OTHER_VEGETABLE" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170301" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170302
gdsn:cv170302 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Vegetable Section of the Food Buying Guide. Vegetables that are fresh, frozen, or canned vegetables and full-strength vegetable juice may contribute toward the vegetable requirement. The minimum creditable amount is 1/8 cup. The vegetable component is credited on a volume measure. The unit of measure is “cup”. Crediting for red/orange vegetable is expressed by rounding down to the nearest 1/8 cup. Examples of red/orange vegetables include: sweet potatoes, acorn squash, butternut squash, carrots, hubbard squash, pumpkin, red peppers, tomatoes, tomato products and tomato juice." ;
              rdfs:label "RED_ORANGE_VEGETABLE" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170302" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170303
gdsn:cv170303 rdf:type owl:NamedIndividual ,
                       gdsn:c-1651017938 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods can be found in the Vegetable Section of the Food Buying Guide. Vegetables that are fresh, frozen, or canned vegetables and full-strength vegetable juice may contribute toward the vegetable requirement. The minimum creditable amount is 1/8 cup. The vegetable component is credited on a volume measure. The unit of measure is “cup”. Crediting for starchy vegetable is expressed by rounding down to the nearest 1/8 cup. Examples of starchy vegetables include:potatoes, corn, cassava, green bananas, green peas, green lima beans, plantains, taro, water chestnuts, and fresh cowpeas, field peas, or black-eyed peas (not dry)." ;
              rdfs:label "STARCHY_VEGETABLE" ;
              gdsn:codeListName "ChildNutritionQualifierCode" ;
              gdsn:sourceId "170303" ;
              gdsn:sourceType "codeValue" .


