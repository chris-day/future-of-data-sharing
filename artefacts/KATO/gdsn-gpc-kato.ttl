###  urn:gs1:std:gdsn:cv176949
gdsn:cv176949 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Shopper Army is the proprietary name of a platform created by Toronto-based BrandSpark International to aggregate and deliver to the brand self-selecting but demographically appropriate groups of consumers who are willing to serve as sounding boards and guinea pigs for CPG product launches" ;
              rdfs:label "SHOPPER_ARMY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://shopperarmy.com/" ;
              gdsn:sourceId "176949" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176950
gdsn:cv176950 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: SIP Certified. Regional, Central Coast California. Economic viability, environmental stewardship, social equity with a points system. A winery or vineyard needs 75% of the total possible sustainability points which includes the pesticides on the Prohibited Materials List. http://www.sipcertified.org" ;
              rdfs:label "SIP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.sipcertified.org/" ;
              gdsn:sourceId "176950" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176951
gdsn:cv176951 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SKG is the independent institute in the Netherlands for testing and certification for the building industry. Note: Do not use this code. Use SKG_CERTIFICATE_1_STAR, SKG_CERTIFICATE_2_STAR, or SKG_CERTIFICATE_3_STAR." ;
              rdfs:label "SKG_CERTIFICATE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.skgikob.nl/en/skg-ikob-logos/class-indication-certificates.html" ;
              gdsn:sourceId "176951" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176952
gdsn:cv176952 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SKG is an independent organisation that monitors the quality of products in the construction industry. On the basis of an inspection SKG determines how much resistance a lock or latch provides against burglary. This resistance is in 3 classes. 1 Star - 3 minutes (standard burglar proof) Building hardware with this label means that it provides at least 3 minutes resistance to burglary with simple tools like a crowbar or screwdriver." ;
              rdfs:label "SKG_CERTIFICATE_1_STAR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.skgikob.nl/en/skg-ikob-logos/class-indication-certificates.html" ;
              gdsn:sourceId "176952" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176953
gdsn:cv176953 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SKG is an independent organisation that monitors the quality of products in the construction industry. On the basis of an inspection SKG determines how much resistance a lock or latch provides against burglary. This resistance is in 3 classes. 2 Stars - 3 minutes (heavily burglar-proof): With security locks and latches this label must provide for at least 3 minutes resistance to burglary with a comprehensive tool kit." ;
              rdfs:label "SKG_CERTIFICATE_2_STAR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.skgikob.nl/en/skg-ikob-logos/class-indication-certificates.html" ;
              gdsn:sourceId "176953" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176954
gdsn:cv176954 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SKG is an independent organisation that monitors the quality of products in the construction industry. On the basis of an inspection SKG determines how much resistance a lock or latch provides against burglary. This resistance is in 3 classes. 3 Stars - 5 minutes (extra heavy anti-burglary): Building hardware with this label have to provide resistance to a burglar with heavy tools for at least 5 minutes for your property. It is not only the lock, the hinges and the cylinder that has to be of this heavy quality, but also the door and the frame must provide sufficient resistance." ;
              rdfs:label "SKG_CERTIFICATE_3_STAR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.skgikob.nl/en/skg-ikob-logos/class-indication-certificates.html" ;
              gdsn:sourceId "176954" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176955
gdsn:cv176955 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SLG Sächsische Landesgewerbeförderungsgesellschaft mbH Distinguishes products that protect children from danger or indicates that no danger for the children comes from the product ." ;
              rdfs:label "SLG_CHILD_SAFETY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.slg.de.com/slg_daten/downloads/formularcenter/zeichensatzung/SLG_ZS.pdf" ;
              gdsn:sourceId "176955" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176956
gdsn:cv176956 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The SLG (Sächsische Landesgewerbeförderungsgesellschaft mbH) Testing and Certification GmbH is a family-owned company. Industrial enterprises, commercial, private and public clients appreciate our neutral and independent services. We offer our customers a comprehensive range of testing and inspection services." ;
              rdfs:label "SLG_TYPE_TESTED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.slg.de.com/slg_daten/downloads/formularcenter/zeichensatzung/en/SLG_ZS_e.pdf" ;
              gdsn:sourceId "176956" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176957
gdsn:cv176957 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SLK GmbH The aim of organic agriculture is to fullfil standards which emphasise careful processing methods, limited refining, energy saving technologies, minimal use of additives and processing aids etc." ;
              rdfs:label "SLK_BIO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.slk.at/" ;
              gdsn:sourceId "176957" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176958
gdsn:cv176958 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Svensk Potatis works to ensure that the production of SMAK-labelled potatoes takes place on certified farms where growers work to ensure high food quality and good environmental considerations. They are also responsible for quality analysis of potatoes, which is performed by inspectors from Svensk Potatis. The Potatisbranschen Foundation has developed the national quality rules for edible potatoes, which guarantee that you get a certified and food-safe product." ;
              rdfs:label "SMAK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://svenskpotatis.se/" ;
              gdsn:sourceId "176958" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176959
gdsn:cv176959 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Many plastic and packaging products display a symbol that looks like the Möbius loop, but has a different purpose and meaning. This symbol is part of a resin coding system produced by the Society of the Plastics Industry (SPI) that identifies the different resins found in plastic bottles and rigid containers. Recycling firms have varying standards for the plastics they accept and the presence of an SPI code does not mean the product is recyclable or recycled in your community." ;
              rdfs:label "SOCIETY_PLASTICS_INDUSTRY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ic.gc.ca/eic/site/oca-bc.nsf/eng/ca02523.html" ;
              gdsn:sourceId "176959" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176960
gdsn:cv176960 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Soil Association Organic Symbol is a symbol used in the UK to show that products meet a strict set of organic standards that protect health, sustainability and the environment." ;
              rdfs:label "SOIL_ASSOCIATION_ORGANIC_SYMBOL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.soilassociation.org/" ;
              gdsn:sourceId "176960" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176961
gdsn:cv176961 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "All products with the Soil Association COSMOS logo guarantee: - NO Animal testing - NO GM ingredients - NO Controversial chemicals - NO Parabens and Phthalates - NO Synthetic colours, dyes or fragrances" ;
              rdfs:label "SOIL_COSMOS_NATURAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.soilassociation.org/" ;
              gdsn:sourceId "176961" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176962
gdsn:cv176962 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "For a product to be labelled organic e.g 'Organic facial oil' 95% of ALL ingredients must be organic. For leave on products, 95% of all physically processed agro-ingredients* must be organic and at least 20% of the total ingredients must be organic. For rinse off products, 95% of all physically processed agro-ingredients must be organic and at least 10% of the total ingredients must be organic." ;
              rdfs:label "SOIL_ORGANIC_COSMOS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.soilassociation.org/" ;
              gdsn:sourceId "176962" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176963
gdsn:cv176963 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: , Private, regional, Sicily, Italy. One of the smaller Italian programs, this one only on Sicily. Best practice sharing. Includes organic/biodynamic/natural and conventional producers. http://sostain.it" ;
              rdfs:label "SOSTAIN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://sostain.it/" ;
              gdsn:sourceId "176963" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176964
gdsn:cv176964 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SPCA Certified is an innovative farm certification and food-labelling program dedicated to improving farm animal welfare standards in Canada." ;
              rdfs:label "SPCA_BC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.spca.bc.ca/animal-issues/farm-animal-welfare/spca-certified/" ;
              gdsn:sourceId "176964" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176965
gdsn:cv176965 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "National Integrated Production Quality System (SQNPI) is a certification scheme that focuses on the objective of enhancing the production of agricultural produce obtained in accordance with regional integrated production regulations. SQNPI certification is recognised at a community level according to Reg. (EC) 1974/2006." ;
              rdfs:label "SQNPI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://opisolaverde.it/en/certificazione/sqnpi-certification/" ;
              gdsn:sourceId "176965" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176966
gdsn:cv176966 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Star D Kosher Certification" ;
              rdfs:label "STAR_D_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.star-k.org/star-d" ;
              gdsn:sourceId "176966" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176967
gdsn:cv176967 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "STAR-K Kosher Certification has provided kosher supervision for over fifty years. As a leader in the international world of kosher certification, the STAR-K is most proud of its reputation for providing prompt, friendly and professional service to both the kosher consumer and members of the food industry." ;
              rdfs:label "STAR_K_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.star-k.org/" ;
              gdsn:sourceId "176967" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176968
gdsn:cv176968 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Steel Recycling Institute (SRI) was established in late 1988 as the Steel Can Recycling Institute, a not-for-profit trade association with the mission of promoting and sustaining steel can recycling. With headquarters in Pittsburgh, PA, it was formed by eight North American steel companies and the American Iron and Steel Institute (AISI). The Institute's focus was a grassroots effort to implement steel can recycling in communities across North America" ;
              rdfs:label "STEEL_RECYCLING" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.recycle-steel.org/about-sri.aspx" ;
              gdsn:sourceId "176968" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176969
gdsn:cv176969 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Founded in 2002 and one of the oldest organic certifiers in the nation, Stellar Certification Services provides individualized attention and deep agricultural expertise to our members nationwide. When the USDA implemented the National Organic Program (NOP) to provide and enforce a uniform marketplace definition for the term “organic,” Stellar was originally formed to provide organic certification for our Biodynamic farmers and processors. While the NOP standard forms the base to the Demeter Biodynamic standard, in order for a Biodynamic member to receive organic certification they must be certified organic through the NOP program." ;
              rdfs:label "STELLAR_CERTIFICATION_SERVICES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.demeter-usa.org/stellar-certification/" ;
              gdsn:sourceId "176969" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176970
gdsn:cv176970 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A consumer test organization was founded in 1964 by decision of the German Bundestag to the consumer through the comparative testing of goods and services to provide independent and objective assistance." ;
              rdfs:label "STIFTUNG_WARENTEST" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.test.de/" ;
              gdsn:sourceId "176970" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176971
gdsn:cv176971 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "AGRA-teg agricultural and Umwelttechnick GmbH is a spin-off undertaking of the University of Goettingen and criteria according to strict scientific carries out the survey of emissions from a product line or from a company as a whole." ;
              rdfs:label "STOP_CLIMATE_CHANGE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://old.stop-climate-change.de/en/" ;
              gdsn:sourceId "176971" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176972
gdsn:cv176972 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This label was created to make Flemish traditional regional products recognizable and recognizable. Consumers can easily recognize traditional regional products and also get well informed. The producer is rewarded with a recognition and can thus put his traditional product in the spotlight. All these products meet the 5 criteria of the definition for traditional regional product." ;
              rdfs:label "STREEKPRODUCT_BE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.streekproduct.be/" ;
              gdsn:sourceId "176972" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176973
gdsn:cv176973 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In Norway, the Rabbi of the Jewish Community of Oslo certifies production facilities on behalf of the Orthodox Union (OU). In addition, the community also performs its own certification making it possible to obtain an internationally recongised kosher certificate." ;
              rdfs:label "STRICTLY_KOSHER_NORWAY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.dmt.oslo.no/en/kosher-certification/" ;
              gdsn:sourceId "176973" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176974
gdsn:cv176974 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Food, produced in Switzerland, environmentally friendly, in line with the animal needs and not gene-modified." ;
              rdfs:label "SUISSE_GARANTIE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.suissegarantie.ch/de" ;
              gdsn:sourceId "176974" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176975
gdsn:cv176975 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sunshine State Kosher. Sunshine State Kosher provides Torah-centered, transparently managed industrial and foodservice kashruth supervision and education to Florida's Jewish community." ;
              rdfs:label "SUNSHINE_STATE_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.sunshinestatekosher.org/" ;
              gdsn:sourceId "176975" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176976
gdsn:cv176976 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Finnish Dental Association recommends xylitol and requires properties of the xylitol product. In order to receive a recommendation, the applicant for the recommendation must submit a document produced by an independent laboratory as an annex to the application, confirming that the product meets the criteria. Please see the website for the criteria required. https://www.hammaslaakariliitto.fi/en/home/recommendations-finnish-dental-association#.X9IAYdgzZPY" ;
              rdfs:label "SUOMEN_HAMMASLAAKARILIITTO_SUOSITTELEE_KSYLITOLIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.hammaslaakariliitto.fi/en/home/recommendations-finnish-dental-association#.X9IAYdgzZPY" ;
              gdsn:sourceId "176976" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176977
gdsn:cv176977 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The pork-labelling system \"sus\" makes it possible for consumers to pursue the path of the product without a long investigation. Sus stands for the traceability from birth to slaughter of pork." ;
              rdfs:label "SUS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ama-marketing.at/" ;
              gdsn:sourceId "176977" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176978
gdsn:cv176978 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: Sustainable Australia Winegrowing (and Entwine if member of that). Regional, Mc Laren Vale, Australia - expanded. Vineyard sustainability assessment program for grape growing in Australia. Self-assessment tool allowing growers to categorise their practices from least to most sustainable and identify where action is needed. mclarenvale.info" ;
              rdfs:label "SUSTAINABLE_AUSTRALIA_WINEGROWING" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://mclarenvale.info/" ;
              gdsn:sourceId "176978" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176979
gdsn:cv176979 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: Certified Sustainable Austria. National - System of spider diagram where the lowest quartile lands in red (unsustainable) and the highest quartile lands in green (sustainable) with half in yellow, in order to recognise top performers. Much thought about balancing different sustainability practices." ;
              rdfs:label "SUSTAINABLE_AUSTRIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.sustainableaustria.com/" ;
              gdsn:sourceId "176979" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176980
gdsn:cv176980 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SFI Inc. is an independent, non-profit organization responsible for maintaining, overseeing and improving a sustainable forestry certification program that is internationally recognized and is the largest single forest standard in the world." ;
              rdfs:label "SUSTAINABLE_FORESTRY_INITIATIVE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.sfiprogram.org/" ;
              gdsn:sourceId "176980" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176981
gdsn:cv176981 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The 'Certified RSPO' logo needs to be displayed if one of the two supply chain models below are utilized:Identity Preserved (IP): The Identity Preserved (IP) supply chain model assures that the RSPO certified oil palm product delivered to the end user is uniquely identifiable to a single RSPO certified mill and its certified supply base. Segregated (SG): The Segregated (SG) supply chain model assures that RSPO certified oil palm products delivered to the end user come only from RSPO certified sources. https://www.rspo.org/key-documents/certification/rspo-supply-chain-certification" ;
              rdfs:label "SUSTAINABLE_PALM_OIL_RSPO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.rspo.org/" ;
              gdsn:sourceId "176981" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176982
gdsn:cv176982 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The 'Credits RSPO' logo needs to be displayed if the supply chain model below is utilized: Book and Claim (BC): Model that supports the production of RSPO-certified sustainable oil palm products through the sale of RSPO Credits. One (1) RSPO Credit represents one (1) metric tonne of RSPO certified sustainable oil palm product. https://www.rspo.org/key-documents/certification/rspo-supply-chain-certification" ;
              rdfs:label "SUSTAINABLE_PALM_OIL_RSPO_CREDITS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://rspocredits.org/" ;
              gdsn:sourceId "176982" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176983
gdsn:cv176983 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Supply chain model that allows certified claims to be transferred from one oil palm product to another either through physical blending or administratively under strictly controlled circumstances. https://www.rspo.org/key-documents/certification/rspo-supply-chain-certification" ;
              rdfs:label "SUSTAINABLE_PALM_OIL_RSPO_MIXED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://rspo.org/certification" ;
              gdsn:sourceId "176983" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176984
gdsn:cv176984 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sustainable Winegrowing Australia is Australia’s national program for grapegrowers and winemakers to demonstrate and continuously improve their sustainability in the vineyard and winery through the environmental, social and economic aspects of their businesses. The program is administered by the Australian Wine Research Institute with governance, endorsement and active support from Australian Grape & Wine and Wine Australia. The program is modelled on global best practices and aligned to the United Nations Sustainable Development Goals, with progress towards these monitored annually." ;
              rdfs:label "SUSTAINABLE_WINEGROWING_AUSTRALIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://sustainablewinegrowing.com.au/" ;
              gdsn:sourceId "176984" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176985
gdsn:cv176985 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sustainable Wines of Great Britain - To secure environmental sustainability at the heart of the UK wine production industry. Their vision is to create a strong and vibrant community within the English and Welsh wine industry that actively promotes sustainability through information sharing and a certification scheme that is inclusive, effective and well-respected by customers." ;
              rdfs:label "SUSTAINABLE_WINES_OF_GREAT_BRITAIN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.winegb.co.uk/home-visitors/sustainable-winegb/" ;
              gdsn:sourceId "176985" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176986
gdsn:cv176986 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Swan is the Nordic environmental label. It was established by the Nordic Council of Ministers in 1989 and Denmark joined in 1997. The Swan is used in all Nordic countries, i.e. Denmark, Norway, Sweden, Finland and Iceland." ;
              rdfs:label "SVANEN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.svanen.se/en/About-us/The-swan-and-the-EU-Ecolabel/" ;
              gdsn:sourceId "176986" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176987
gdsn:cv176987 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "From the year 2006 include all Swedish chicken and turkey that is part of Swedish Bird with a clear blue and yellow markings. The Swedish Poultry Meat Association represents 99 % of all broiler meat production in Sweden. They represent the total logistic chain i e from import of day-old Grand-Parent chickens to the slaughter plants. The hatcheries, growers and feed-companies are also members. The Blue and Yellow origin mark guarantees that the chicken is hatched, reared, slaughtered and processed in Sweden." ;
              rdfs:label "SVENSK_FAGEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.svenskfagel.se" ;
              gdsn:sourceId "176987" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176988
gdsn:cv176988 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The brand Swedish meat is a voluntary origin labelling. The mark indicates that the meat product derived from animals that were born and raised in Sweden. The product is also manufactured and packaged in Sweden. The mark may be used on meat and meat products derived from raw pork, beef and lamb. The trade organization Swedish meat is a brand independent organization that develops, manages and controls the voluntary origin labelling Swedish meat." ;
              rdfs:label "SVENSKT_KOTT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.svensktkott.se" ;
              gdsn:sourceId "176988" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176989
gdsn:cv176989 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "When companies climate certification the production, rules that are specifically aimed at reducing climate impact must be met. The rules are developed together with KRAV and are based on the latest research in the area. The most important rules for climate certification relate to the choice of feed, nitrogen fertilizers, animal welfare and energy efficiency. The certification focuses on reducing climate impact, but there are also other positive results, such as reduced eutrophication, increased biodiversity and sustainable energy systems." ;
              rdfs:label "SVENSKT_SIGILL_KLIMATCERTIFIERAD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://sigill.se/IP-STANDARD/CERTIFIERING-ENLIGT-IP/CERTIFIERING-ENLIGT-IP/KLIMATCERTIFIERING/" ;
              gdsn:sourceId "176989" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176990
gdsn:cv176990 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Natural Beef Meat certified according to the IP standard meets the Sigill Level's requirements for food safety, animal welfare and environmental responsibility. In addition, the optional module ensures that all the animals are fed on the Swedish natural areas - hedges, beach meadows, river lakes." ;
              rdfs:label "SVENSKT_SIGILL_NATURBETESKOTT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://sigill.se/IP-STANDARD/CERTIFIERING-ENLIGT-IP/CERTIFIERING-ENLIGT-IP/CERTIFIERAT-NATURBETESKOTT/" ;
              gdsn:sourceId "176990" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176991
gdsn:cv176991 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is physically marked with the Swedish Seal of Quality label which intends to guarantee the responsibility for the environment of the product." ;
              rdfs:label "SWEDISH_SEAL_OF_QUALITY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "n/a" ;
              gdsn:sourceId "176991" ;
