###  urn:gs1:std:gdsn:cv181601
gdsn:cv181601 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Colour is defined as colour found without any specific chemical synthesis, but not specified as natural colour." ;
