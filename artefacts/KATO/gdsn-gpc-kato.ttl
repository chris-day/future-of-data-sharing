              rdfs:comment "Shape of the stone. Use productCharacteristicValueDescription to populate value." ;
              rdfs:label "stoneShape" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178235" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178236
gdsn:cv178236 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In blended whiskey this is the percentage of straight whiskey by volume. Uses productCharacteristic ValueMeasurement." ;
              rdfs:label "straightWhiskeyPercentage" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178236" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178237
gdsn:cv178237 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of baby/child stroller Lightweight; Full-Size; Jogger, 4-wheel, etc. Use productCharacteristicValueDescription to populate value." ;
              rdfs:label "strollerType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178237" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178238
gdsn:cv178238 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Beer style is a term used to differentiate and categorize beers by various factors including appearance, flavour, ingredients, production method, history, or origin. Use productCharacteristicValueCode to populate. For Beer Style, use the GPC description for the attribute Style of Beer" ;
              rdfs:label "styleOfBeerCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178238" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178239
gdsn:cv178239 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum suction power, e.g. a vacuum cleaner, a carpet shampooer, ash vacuum with pallet stove kit. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "suctionPowerMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178239" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178240
gdsn:cv178240 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximal speed (surface feet)/orbits per minute, e.g.. belt sander. Surface feet per minute (SFPM or SFM) is an imperial and American customary unit of speed, being the number of linear feet that a location on a rotating component travels in one minute. Its most common use is in the measurement of cutting speed (surface speed) in machining. It is a unit of velocity that describes how fast the cutting edge of the cutting tool travels. It correlates directly to the machinability of the work piece material and the hardness of the cutting tool material. It relates to spindle speed via variables such as cutter diameter (for rotating cutters) or work piece diameter (for lathe work). Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "surfaceFeetMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178240" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178241
gdsn:cv178241 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The number of continuous hours that the device may be used to make phone calls before shutting down. Use productCharacteristicValueMeasurement to populate value." ;
              rdfs:label "talkTime" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178241" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178243
gdsn:cv178243 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The distance (D), measured from lens to screen, that a projector is placed from the screen, divided by the width (W) of the image that it will project (D/W). Use productCharacteristicValueString to populate value." ;
              rdfs:label "throwRatio" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178243" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178244
gdsn:cv178244 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The force applied on a surface in a direction perpendicular or normal to the surface is called thrust. Force, and thus thrust, is measured in the International System of Units (SI) as the newton (symbol: N), and represents the amount needed to accelerate 1 kilogram/pounds of mass at the rate of 1 metre/feet per second squared. productCharacteristicValueMeasurement =???" ;
              rdfs:label "thrust" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178244" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178245
gdsn:cv178245 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum torque moment measured in newton metre (Nm). Torque, moment, or moment of force is the tendency of a force to rotate an object about an axis, fulcrum, or pivot. Just as a force is a push or a pull, a torque can be thought of as a twist to an object. Mathematically, torque is defined as the cross product of the position vector of the point where the force is applied (distance vector) and the force vector, which tends to produce rotation. Populate using productCharacteristicValueInteger." ;
              rdfs:label "torqueMomentNmMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178245" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178246
gdsn:cv178246 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the minimum torque moment measured in newton metre (Nm). Torque, moment, or moment of force is the tendency of a force to rotate an object about an axis, fulcrum, or pivot. Just as a force is a push or a pull, a torque can be thought of as a twist to an object. Mathematically, torque is defined as the cross product of the position vector of the point where the force is applied (distance vector) and the force vector, which tends to produce rotation. Populate using productCharacteristicValueInteger." ;
              rdfs:label "torqueMomentNmMin" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178246" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178247
gdsn:cv178247 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A automatic transfer switch is an electrical switch that switches a load between two sources and switch when they sense one of the sources has lost or gained power. Manual is one that the user switches. Populate using productCharacteristicValueCode=AUTOMATIC, MANUAL." ;
              rdfs:label "transferSwitchTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178247" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178248
gdsn:cv178248 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the power conversions that can be done by an electric transformer for example from 230 volt to 12 volt. Use productCharacteristicValueDescription to populate value." ;
              rdfs:label "transformerConversionCapability" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178248" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178249
gdsn:cv178249 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Designation of the type of transmission Examples 6MT (6 speed manual transmission) 4WD (4 wheel drive), Automatic. Use productCharacteristicValueString to populate." ;
              rdfs:label "TransmissionType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178249" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178250
gdsn:cv178250 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of tire construction. Examples Bias, Radial, tubeless. Populate using productCharacteristicValueDescription." ;
              rdfs:label "tyreConstructionType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178250" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178251
gdsn:cv178251 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Load Index is part of the tyre codes used globally to standardize tyres. These tyre codes are generally found moulded on the sidewall of a tyre. Some of the codes are very detailed and were considered to be more informational, rather than what is used in GPC for grouping products together. The load index on a tyre is a numerical code stipulating the maximum load (mass, or weight) each tyre can carry. Load value codes range from 0 to 279. These codes correspond the maximum weight the tyre is designed for. For example, Code 60 means the tyre can carry a load of 250 kg (550 lb). The Load Index tables can be found on numerous internet sites. Use productCharacteristicValueCode to populate value." ;
              rdfs:label "tyreLoadIndex" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178251" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178252
gdsn:cv178252 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of sidewalls on the tire. Example Whitewall, black wall. Use productCharacteristicValueDescription to populate." ;
              rdfs:label "tyreSidewallStyle" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178252" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178253
gdsn:cv178253 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The temperature grade indicates the ability of your tire to dissipate the heat generated by driving. Over time, heat can cause damage to your tires. Temperature resistance is given one of the following grades, which you will find on the sidewall of your tire: A, B, C. Examples in US Tires graded A effectively dissipate heat up to a maximum speed that is greater than 115 mph. Tires graded B effectively dissipate heat at a speed range between 100 mph and 115 mph. Tires graded C effectively dissipate heat at a speed range between 85 mph and 100 mph. Populate using productCharacteristicsValueCode." ;
              rdfs:label "tyreTemperatureRating" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178253" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178254
gdsn:cv178254 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the tyre to the type to the need. Examples: Summer Passenger, All-Season Passenger, Winter / Snow Passenger Tires,Temporary/Compact Spare Tires,Track & Competition DOT Tires, Summer Light Truck/SUV Tires, All-Season Light Truck/SUV Tires. Populate using productCharacteristicValueDescription" ;
              rdfs:label "tyreType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178254" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178255
gdsn:cv178255 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the minimum weight of the umbrella stand, e.g. round tan offset umbrella. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "umbrellaBaseWeightMin" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178255" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178256
gdsn:cv178256 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of washing machine type. Example Front, top, etc. Uses productCharacteristicValueDescription." ;
              rdfs:label "washingMachineType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178256" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178257
gdsn:cv178257 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum wattage. Wattage or Electric power is the rate at which electrical energy is transferred by an electric circuit. The SI unit of power is the watt, one joule per second. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "wattageMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178257" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178258
gdsn:cv178258 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum weighing range or Scale graduation of e.g. a electronic balance. Populate usingproductCharacteristicValueMeasurement." ;
              rdfs:label "weighingRangeMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178258" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178259
gdsn:cv178259 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of window shade and how it fits the window. Example Custom Fit, Stretch to Fit, Fits all. Populate using productCharacteristicValueDescription." ;
              rdfs:label "windowShadeFitType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178259" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178260
gdsn:cv178260 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any wireless communications technology standard used within or by the item. Examples: Bluetooth; 802.11a; 5.8 GHz; 802.11g; 900 Mhz; Wi-Fi; 2.4GHz; None; 802.11b; 802.11n. Use productCharacteristicValueString to populate value." ;
              rdfs:label "wirelessCommunicationStandard" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178260" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178261
gdsn:cv178261 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum working load limit or load capacity, e.g. washing machine. Working Load Limit (WLL) is the maximum working load designed by the manufacturer. This load represents a force that is much less than that required to make the lifting equipment fail or yield, also known as the Minimum Breaking Load (MBL). Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "workingLoadLimitMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178261" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178262
gdsn:cv178262 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348160 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Games are characterized by game play with emphasis on combat." ;
              rdfs:label "ACTION" ;
              gdsn:codeListName "ProductGenreTypeCode (Electronic Game)" ;
              gdsn:sourceId "178262" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178263
gdsn:cv178263 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348160 ;
