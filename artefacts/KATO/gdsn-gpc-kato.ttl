###  urn:gs1:std:gdsn:cv179555
gdsn:cv179555 rdf:type owl:NamedIndividual ,
                       gdsn:c-1552266417 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product is stacked on a logistics unit in a pattern that has boxes inserted between the stacked layers or tiers to maximize the pallet configuration." ;
