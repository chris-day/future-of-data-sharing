              rdfs:comment "GS1 Tagname Description: Glucosamine hydrochloride is similiar to glucosamine, an amino sugar, but has a different chemical structure. - UOM for Nutrient Panel: - GS1 Notes, Keywords, and Examples: - GS1 Comment: GS1 temporary code - GS1 Synonyms:" ;
              rdfs:label "X_GLUCOSAMINE_HYDROCHLORIDE" ;
              gdsn:codeListName "NutrientTypeCode" ;
              gdsn:externalLink "http://www.fao.org/infoods/infoods/standards-guidelines/food-component-identifiers-tagnames/en/" ;
