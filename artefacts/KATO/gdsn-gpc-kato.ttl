###  urn:gs1:std:gdsn:cv177777
gdsn:cv177777 rdf:type owl:NamedIndividual ,
                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Treatment of meat or poultry products with functionally active proteins such as fibrinogen or transglutaminase to allow the proteins in the meat or poultry to encapsulate fat and hold fat and water together in the final sausage or product." ;
              rdfs:label "PROTEIN_BINDERS" ;
              gdsn:codeListName "PreparationTypeCode" ;
              gdsn:sourceId "177777" ;
