###  urn:gs1:std:gdsn:cv176436
gdsn:cv176436 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Climate Neutral Guaranteed standard gives you the acknowledgement that the results of your work are helping and are meaningful. The steps that have been taken are expertly tested against published criteria in a transparent process. With the logo, you can clearly communicate your commitment to your stakeholders, who are becoming more critical when it comes to socially, ecologically and economically responsible business. The Climate Neutral Group has offices in the Netherlands an South-Africa." ;
              rdfs:label "CLIMATE_NEUTRAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.climateneutralgroup.com/en/" ;
              gdsn:sourceId "176436" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176437
gdsn:cv176437 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Climate Neutral label Indicates that Climate Partner guarantees that all carbon emissions of the product have been calculated and offset via recognised carbon offset projects." ;
              rdfs:label "CLIMATE_NEUTRAL_PARTNER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.climatepartner.com/en" ;
              gdsn:sourceId "176437" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176438
gdsn:cv176438 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certified Naturally Grown (CNG) offers peer-review certification to farmers and beekeepers producing food for their local communities by working in harmony with nature, without relying on synthetic chemicals or GMOs" ;
              rdfs:label "CNG" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.cngfarming.org/" ;
              gdsn:sourceId "176438" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176439
gdsn:cv176439 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Arla have great focus for reducing the CO2 impact from their packaging. To make it simpler to see for the consumer, the logo indicates the packaging have been made more climate-friendly." ;
              rdfs:label "CO2_REDUCERET_EMBALLAGE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.arla.dk/artikler/nyt-logo-gor-det-let-at-valge-mere-klimavenlig-emballage" ;
              gdsn:sourceId "176439" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176440
gdsn:cv176440 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The 'CO2 Neutral' label by CO2logic is meant to provide both customers and companies with a basic understanding of the CO2 neutrality concept, based on the internationally recognised PAS2060 standard. The label comes with a QR code. When scanned, customers can learn about the organisation’s ambitions and achievements." ;
              rdfs:label "CO2LOGIC_CO2_NEUTRAL_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.co2-neutral-label.org/about-the-label/" ;
              gdsn:sourceId "176440" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176441
gdsn:cv176441 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cocoa Horizons is an impact driven program focused on cocoa farmer prosperity and helping build self-sustaining farming communities that protect nature and children. The purpose is to improve the livelihoods of cocoa farmers and their communities through the promotion of sustainable, entrepreneurial farming, improved productivity, and community development, which protects nature and children." ;
              rdfs:label "COCOA_HORIZONS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.cocoahorizons.org/" ;
              gdsn:sourceId "176441" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176442
gdsn:cv176442 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cocoa Life is farmer-centric, empowered by strong partnerships, and aligned with our sourcing. These three non-negotiable principles inform every choice we make, every goal we set, and every initiative we launch." ;
              rdfs:label "COCOA_LIFE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.cocoalife.org" ;
              gdsn:sourceId "176442" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176443
gdsn:cv176443 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Compost Manufacturing Alliance (CMA) is a global leader in providing industrial composting facilities an acceptance standard for compostables by performing field disintegration testing through several prominent processing methods to ensure products sent to industrial compost facilities adequately break down within the production cycle." ;
              rdfs:label "CMA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://compostmanufacturingalliance.com/" ;
              gdsn:sourceId "176443" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176444
gdsn:cv176444 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Seedling is a reliable label for compostability. The logo and the certificate number printed on the product assists in the decision on purchasing and disposing a product (packaging). The certification process is offered by Belgian certifier TÜV Austria Belgium and German certifier DIN CERTCO. Biodegradable and compostable products should be certified according to EN 13432 / 14995 standards." ;
              rdfs:label "COMPOSTABLE_DIN_CERTCO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.european-bioplastics.org/bioplastics/standards/labels/" ;
              gdsn:sourceId "176444" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176445
gdsn:cv176445 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Comté is a hard raw milk cheese from the French region of Franche-Comté. Its production area extends to the departments of Jura, Doubs and eastern Ain." ;
              rdfs:label "COMTE_GREEN_BELL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://ec.europa.eu/agriculture/quality/door/registeredName.html?denominationId=262" ;
              gdsn:sourceId "176445" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176446
gdsn:cv176446 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The letters ‘CE’ appear on many products traded on the extended Single Market in the European Economic Area (EEA). They signify that products sold in the EEA have been assessed to meet high safety, health, and environmental protection requirements. When you buy a new phone, a teddy bear, or a TV within the EEA, you can find the CE mark on them. CE marking also supports fair competition by holding all companies accountable to the same rules." ;
              rdfs:label "CONFORMITE_EUROPEENNE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://ec.europa.eu/growth/single-market/ce-marking/index_en.htm" ;
              gdsn:sourceId "176446" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176447
gdsn:cv176447 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Consumer Choice Award recognizes business excellence in small and medium sized businesses. They only organization in Canada to conduct statistically accurate independent market research surveys to determine brand reputation, customer satisfaction and business excellence" ;
              rdfs:label "CONSUMER_CHOICE_AWARD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ccaward.com/" ;
              gdsn:sourceId "176447" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176448
gdsn:cv176448 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Council of Orthodox Rabbis of Greater Detroit Certification" ;
              rdfs:label "COR_DETROIT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://cordetroit.com/k-cor/" ;
              gdsn:sourceId "176448" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176449
gdsn:cv176449 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Kashruth Council of Canada (COR) Kosher Certification" ;
              rdfs:label "COR_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.cor.ca/" ;
              gdsn:sourceId "176449" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176450
gdsn:cv176450 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The UK Corrugated Industry have been running a continuous campaign for some time to highlight and raise awareness of the recyclability of cardboard boxes, they have done this by creating an internationally recognised logo which is to be placed on all manufactured recyclable boxes" ;
              rdfs:label "CORRUGATED_RECYCLES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ccaward.com/" ;
              gdsn:sourceId "176450" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176451
gdsn:cv176451 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "COSMEBIO is the Professional Association for Natural, Ecological and Organic cosmetics. COSMEBIO federates the professional players in the industry and brings together over 390 members in France and abroad. Since 2002, COSMEBIO has been working to promote natural and ecological cosmetics made with ingredients from organic farming and developed using green technologies (green chemistry). http://www.cosmebio.org/en/ ." ;
              rdfs:label "COSMEBIO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.cosmebio.org/en/" ;
              gdsn:sourceId "176451" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176452
gdsn:cv176452 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Cosmebio COSMOS natural signature is available for products that comply with the COSMOS-standard in all respects but do not meet the required minimum organic percentages as specified in the COSMOS-standard." ;
              rdfs:label "COSMEBIO_COSMOS_NATURAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.cosmebio.org/fr/le-label/" ;
              gdsn:sourceId "176452" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176453
gdsn:cv176453 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Cosmebio COSMOS organic signature is available for products that comply with the COSMOS-standard in all respects and contain the required percentages of organic ingredients as specified in the COSMOS-standard." ;
              rdfs:label "COSMEBIO_COSMOS_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.cosmebio.org/fr/le-label/" ;
              gdsn:sourceId "176453" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176454
gdsn:cv176454 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Cosmetici Biologici certified label is awarded to companies that meet the criteria of their organic standard for cosmetic products. The principle behind the organic cosmetics standard is the sourcing of organically grown raw materials." ;
              rdfs:label "COSMETICI_BIOLOGICI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ccpb.it" ;
              gdsn:sourceId "176454" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176455
gdsn:cv176455 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Cosmetici Naturali certified label is awarded to companies that meet the criteria of their natural cosmetic standard. The principle of the standard for natural cosmetics is the raw materials used. The standard specifies the minimum requirements for ingredients, composition and manufacturing processes that a cosmetic product must meet in order to be certified as natural." ;
              rdfs:label "COSMETICI_NATURALI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ccpb.it" ;
              gdsn:sourceId "176455" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176456
gdsn:cv176456 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cotton made in Africa is the first, and as yet the only initiative of the Aid by Trade Foundation. It improves the conditions of life of cotton farmers and their families in Africa, and contributes to environmental protection by promoting sustainable methods of cultivation." ;
              rdfs:label "COTTON_MADE_IN_AFRICA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.cotton-made-in-africa.com" ;
              gdsn:sourceId "176456" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176457
gdsn:cv176457 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Eggs with this Dutch packaging mark are from chicken that are held according to certain quality standards." ;
              rdfs:label "CPE_SCHARREL_EIEREN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ncae.nl" ;
              gdsn:sourceId "176457" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176458
gdsn:cv176458 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Eggs with this Dutch packaging Mark are from chicken that have the possibility for free range in open air." ;
              rdfs:label "CPE_VRIJE_UITLOOP_EIEREN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ncae.nl" ;
              gdsn:sourceId "176458" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176459
gdsn:cv176459 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Cradle to Cradle Certified Product Standard guides designers and manufacturers through a continual improvement process that looks at a product through five quality categories - material health, material reutilization, renewable energy and carbon management, water stewardship, and social fairness. A product receives an achievement level in each category - Basic, Bronze, Silver, Gold, or Platinum - with the lowest achievement level representing the product's overall mark." ;
              rdfs:label "CRADLE_TO_CRADLE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.c2ccertified.org/" ;
              gdsn:sourceId "176459" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176460
gdsn:cv176460 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Crossed grain logo is a trademark owned and administered by Coeliac. It is a wolrdwide symbol for safe gluten-free foods. Each country has their own Coeliac website for example UK www.coeliac.org.uk" ;
              rdfs:label "CROSSED_GRAIN_SYMBOL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.coeliac.org.uk" ;
              gdsn:sourceId "176460" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176461
gdsn:cv176461 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bais Din of Crown Heights Vaad HaKashrus Certification" ;
              rdfs:label "CROWN_CHK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.chkosher.com/" ;
              gdsn:sourceId "176461" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176462
gdsn:cv176462 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "PETA People for the Ethical Treatment of Animals (PETA) is the largest animal rights organization in the world, with more than 6.5 million members and supporters. PETA focuses its attention on the four areas in which the largest numbers of animals suffer the most intensely for the longest periods of time: in laboratories, in the food industry, in the clothing trade, and in the entertainment industry. We also work on a variety of other issues, including the cruel killing of rodents, birds, and other animals who are often considered “pests” as well as cruelty to domesticated animals." ;
              rdfs:label "CRUELTY_FREE_PETA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://crueltyfree.peta.org/" ;
              gdsn:sourceId "176462" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176463
gdsn:cv176463 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "CSA International tests products for compliance to national and international standards, and issue certification marks for qualified products. Certification marks tell potential customers and users that a product has been evaluated by a formal process-involving examination, testing and follow-up inspection-and that it complies with applicable standards for safety and performance." ;
              rdfs:label "CSA_INTERNATIONAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.csagroup.org/services-industries/marks-labels/north-american-marks-labels/" ;
              gdsn:sourceId "176463" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176464
gdsn:cv176464 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "NCA has become the recognized education and advocacy group for people with celiac disease and other gluten-related disorders." ;
              rdfs:label "CSA_NCA_GLUTEN_FREE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.nationalceliac.org/" ;
              gdsn:sourceId "176464" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176465
gdsn:cv176465 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "As an independent, not-for-profit organization, CSI is able to offer programs and services to augment and support the work of regulatory officials, including standards development, and certification system development." ;
              rdfs:label "CSI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://csi-ics.com/organic/services/organic-certification" ;
              gdsn:sourceId "176465" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176466
gdsn:cv176466 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regional products from Eastern Switzerland" ;
              rdfs:label "CULINARIUM" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.culinarium.ch/" ;
              gdsn:sourceId "176466" ;
