###  urn:gs1:std:gdsn:cv178702
gdsn:cv178702 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The trade item is considered as unpacked by regulation, even if physical packaging may exist. (E.g. European Regulation on fresh fruit & vegetables EU 1169, EU 543, EU 852)" ;
              rdfs:label "TRADE_ITEM_CONSIDERED_UNPACKED" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178702" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178703
gdsn:cv178703 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has conformed to testing requirements to meet regulation needs. An example is the Consumer Product Safety Commission https://www.cpsc.gov/Regulations-Laws--Standards/Statutes/The-Consumer-Product-Safety-Improvement-Act/." ;
              rdfs:label "TRADE_ITEM_TESTED_DIRECTIVE" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178703" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178704
gdsn:cv178704 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Regulation (e.g., EU Reg 528/2012) harmonising the rules on making available on the market and trade items treated with biocidal products ('treated articles'), whilst ensuring a high level of protection of both human and animal health and the environment. It should not be used for biocidal products." ;
              rdfs:label "TREATED_WITH_BIOCIDE_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178704" ;
              gdsn:sourceType "codeValue" .


