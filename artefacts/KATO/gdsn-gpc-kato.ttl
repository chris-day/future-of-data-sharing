###  urn:gs1:std:gdsn:a5365
gdsn:a5365 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c-1431502821 ;
           rdfs:range xsd:dateTime ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "This is the effective start date of the price agreed to by the trading partners. This start date is mandatory and, if no end date is communicated, then implies that the price is effective until further notice. Various types of dates may be pre-aligned between buyer and seller. For example, based upon a prior agreement between trading partners this date may relate to any of the following events, first order date, first ship date, and first arrival date." ;
           rdfs:label "priceEffectiveStartDate" ;
           gdsn:bmsId 3381 ,
                      3390 ,
                      3399 ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c456339029/c142116504/c-1431502821/a5365" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:TradeItemPrice.priceEffectiveStartDate" ;
           gdsn:sourceId "5365" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:sales_information:xsd:3' and local-name()='salesInformationModule']/tradeItemPriceInformation/additionalTradeItemPrice/priceEffectiveStartDate" ,
                      "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:sales_information:xsd:3' and local-name()='salesInformationModule']/tradeItemPriceInformation/cataloguePrice/priceEffectiveStartDate" ,
                      "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:sales_information:xsd:3' and local-name()='salesInformationModule']/tradeItemPriceInformation/suggestedRetailPrice/priceEffectiveStartDate" .


###  urn:gs1:std:gdsn:a5366
gdsn:a5366 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c-1431502821 ;
           rdfs:range xsd:dateTime ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "The effective end date of the price is optional based upon the agreement by the trading partners. If an invalid end date is communicated, then it is implied that the price and its effective date are effective until further notice. Examples of invalid dates include 99/99/9999, 00/00/0000, blank, etc. These invalid end dates should not be communicated. Various types of dates may be pre-aligned between buyer and seller. For example, based upon a prior agreement between trading partners this date may relate to any of the following events, last order date, last ship date, and last arrival date." ;
           rdfs:label "priceEffectiveEndDate" ;
           gdsn:bmsId 3380 ,
                      3389 ,
                      3398 ;
           gdsn:originalMultiplicity "0..1" ;
           gdsn:pathId "c456339029/c142116504/c-1431502821/a5366" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:TradeItemPrice.priceEffectiveEndDate" ;
           gdsn:sourceId "5366" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:sales_information:xsd:3' and local-name()='salesInformationModule']/tradeItemPriceInformation/additionalTradeItemPrice/priceEffectiveEndDate" ,
                      "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:sales_information:xsd:3' and local-name()='salesInformationModule']/tradeItemPriceInformation/cataloguePrice/priceEffectiveEndDate" ,
                      "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:sales_information:xsd:3' and local-name()='salesInformationModule']/tradeItemPriceInformation/suggestedRetailPrice/priceEffectiveEndDate" .


