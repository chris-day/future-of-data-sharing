                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "mEq or milliequivalents, the measure is used in terms of milliequivalents of solute per liter of solvent (or milliNormal where mEq/L = mN). This is especially common for measurement of compounds in biological fluids; for instance, the healthy level of potassium in the blood of a human is defined between 3.5 and 5.0 mEq/L. To better be able to denote the units of measure for nutrients as used in business today." ;
              rdfs:label "MEQ" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
