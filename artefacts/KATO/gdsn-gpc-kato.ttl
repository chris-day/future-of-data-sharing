###  urn:gs1:std:gdsn:cv172605
gdsn:cv172605 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A kilogram-force per square centimeter (kgf/cm2), often just kilogram per square centimeter (kg/cm2), or kilopond per square centimeter is a unit of pressure using metric units. Its use is now deprecated; it is not a part of the International System of Units (SI), the modern metric system. The unit is similar to the English unit psi (lbf/in2)." ;
              rdfs:label "D5" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172605" ;
              gdsn:sourceType "codeValue" .


