###  urn:gs1:std:gdsn:c1450
gdsn:c1450 rdf:type rdfs:Datatype ;
           dct:source "gdsn_classes.json" ;
           rdfs:comment "The GS1 Identification Key used to identify trade items. The key comprises a GS1 Company Prefix, an Item Reference and Check Digit." ;
           rdfs:label "GTIN" ;
           gdsn:sourceId "1450" ;
           gdsn:sourceType "3" ;
           owl:equivalentClass xsd:string .


###  urn:gs1:std:gdsn:c1451
gdsn:c1451 rdf:type rdfs:Datatype ;
           dct:source "gdsn_classes.json" ;
           rdfs:comment "The GS1 Identification Key used to identify a logical grouping of logistic or transport units that are assembled to be transported under one transport document (e.g. HWB). The key comprises a GS1 Company Prefix and the Freight Forwarder's or Carrier's transport reference." ;
           rdfs:label "GINC" ;
           gdsn:sourceId "1451" ;
           gdsn:sourceType "3" ;
           owl:equivalentClass xsd:string .


###  urn:gs1:std:gdsn:c1452
gdsn:c1452 rdf:type rdfs:Datatype ;
           dct:source "gdsn_classes.json" ;
           rdfs:comment "The Global Location Number (GLN) is the GS1 Identification Key used to identify physical locations or parties. The key is comprised of a GS1 Company Prefix, Location Reference, and Check Digit." ;
           rdfs:label "GLN" ;
           gdsn:sourceId "1452" ;
           gdsn:sourceType "3" ;
           owl:equivalentClass xsd:string .


###  urn:gs1:std:gdsn:c1453
gdsn:c1453 rdf:type rdfs:Datatype ;
           dct:source "gdsn_classes.json" ;
           rdfs:comment "The GS1 Identification Key used to identify a logical grouping of logistic or transport units that are assembled by the consignor (seller) for a transport Shipment from that consignor to one consignee (buyer) referencing a despatch advice and/or BOL. The key comprises a GS1 Company Prefix, Shipper Reference and Check Digit." ;
           rdfs:label "GSIN" ;
           gdsn:sourceId "1453" ;
           gdsn:sourceType "3" ;
           owl:equivalentClass xsd:string .


