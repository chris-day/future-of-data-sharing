###  urn:gs1:std:gdsn:cv172552
gdsn:cv172552 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The troy ounce is a unit of imperial measure. In the present day it is most commonly used to gauge the weight and therefore the price of precious metals. One troy ounce equals 480 grains or 31.1035 grams." ;
              rdfs:label "APZ" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172552" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172553
gdsn:cv172553 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A unit of count defining the number of assortments (assortment: set of items grouped in a mixed collection)." ;
              rdfs:label "AS" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172553" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172554
gdsn:cv172554 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Standard Atmosphere" ;
              rdfs:label "ATM" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172554" ;
