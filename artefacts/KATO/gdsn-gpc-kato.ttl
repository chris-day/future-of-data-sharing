                       gdsn:c1105141912 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Status on a CPV to notify recipient that a CPV is no longer active and that a previous version is now the active primary version." ;
              rdfs:label "PRIMARY_VERSION" ;
              gdsn:codeListName "ReasonForCPVCode" ;
              gdsn:sourceId "178520" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178521
gdsn:cv178521 rdf:type owl:NamedIndividual ,
                       gdsn:c1105141912 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Used to identify when a country of origin must be distinguished and declared, but a new GTIN is not required (apparel), CPV allows for that sharing. Likely to impact consumer decisions in many product categories." ;
              rdfs:label "PRODUCED_IN_DIFFERENT_LOCATIONS" ;
              gdsn:codeListName "ReasonForCPVCode" ;
              gdsn:sourceId "178521" ;
              gdsn:sourceType "codeValue" .


