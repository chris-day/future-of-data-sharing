                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The standard HALAL CORRECT is a standard quality and guarantees the Halal conformity of the whole chain, from slaughtering until the packaging of the Halal products." ;
              rdfs:label "HALAL_CORRECT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.halalcorrect.com" ;
