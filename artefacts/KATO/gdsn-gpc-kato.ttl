                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The FCC is responsible for managing and licensing the electromagnetic spectrum for commercial users and for non-commercial users including: state, county and local governments. This includes public safety, commercial and non-commercial fixed and mobile wireless services, broadcast television and radio, satellite and other services. In licensing the spectrum, the Commission promotes efficient and reliable access to the spectrum for a variety of innovative uses as well as promotes public safety and emergency response." ;
              rdfs:label "FCC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fcc.gov/" ;
              gdsn:sourceId "176571" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176572
gdsn:cv176572 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Federally Registered/ Inspected in Canada" ;
              rdfs:label "FEDERALLY_REGISTERED_INSPECTED_CANADA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "176572" ;
