                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Link to a website, file, or image containing the product's image with its dimensions. This especially important for built-in products as ovens and fridges. Ex : http://www.docstoc.com/docs/125126778/GSS-GEW-Food-Savers-Food-Storage-Containers." ;
