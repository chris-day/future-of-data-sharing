                       gdsn:c2147348061 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a food is enriched with the substance in the ClaimElementCode. Enriched means adding back (to original levels) nutrients that were lost during food processing. e.g., Adding back certain B-vitamins lost in processing wheat to make white flour. Note the amount that determines enrichment is based on target market regulations." ;
              rdfs:label "ENRICHED_WITH" ;
