###  urn:gs1:std:gdsn:cv172556
gdsn:cv172556 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Gauge- A number referring to the outer diameter of hypodermic or suture needles. Smaller gauge numbers indicate larger outer diameters. Inner diameter depends on both gauge and wall thickness. An increasing needle-gauge size corresponds to a smaller diameter needle. This is contrary to French Gauge where an increasing gauge size corresponds to a larger external diameter." ;
              rdfs:label "AWG" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172556" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172557
gdsn:cv172557 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A unit of measure for blood potency. Units for the anti XA activity which is a measure to the anti coagulating effect at low molecular heparins." ;
              rdfs:label "AXU" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172557" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172558
gdsn:cv172558 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bel - level [B] (Unified code)" ;
              rdfs:label "B" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172558" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172559
gdsn:cv172559 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In telecommunications and computing, bitrate (sometimes written bit rate, data rate or as a variable R or fb) is the number of bits that are conveyed or processed per unit of time.The bit rate is quantified using the bits per second (bit/s or bps) unit." ;
              rdfs:label "B10" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172559" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172560
gdsn:cv172560 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The gravitational force of a kilogram weight or a one-kilogram mass multiplied by the acceleration of standard Earth gravity, equal to 9.8 newtons." ;
              rdfs:label "B37" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172560" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172561
gdsn:cv172561 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "1000 Newtons or amount needed to accelerate 1 kilogram of mass at the rate of 1 metre per second squared multiplied by 1000 (Used to measure force of an object where the value exceeds 1000 newtons)." ;
              rdfs:label "B47" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172561" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172562
gdsn:cv172562 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lumens per Square Meter" ;
              rdfs:label "B60" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172562" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172563
gdsn:cv172563 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The number of Lumens expressed per watt." ;
              rdfs:label "B61" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172563" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172564
gdsn:cv172564 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lumen seconds is the SI derived unit of luminous energy. It is based on the lumen, the SI unit of luminous flux, and the second, the SI base unit of time. The lumen second is sometimes called the Talbot (symbol T)." ;
              rdfs:label "B62" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172564" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172565
gdsn:cv172565 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Exposure is measured in lux seconds, and can be computed from exposure value (EV) and scene luminance in a specified region." ;
              rdfs:label "B64" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172565" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172566
gdsn:cv172566 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The bar is widely used in descriptions of pressure; 1 bar = 100 kilopascals 0.987 atmospheres." ;
              rdfs:label "BAR" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172566" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172567
gdsn:cv172567 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A unit of area of 112 sheets of tin mil products (tin plate, tin free steel or black plate) 14 by 20 inches, or 31,360 square inches." ;
              rdfs:label "BB" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172567" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172568
gdsn:cv172568 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A specialized unit of measure for the volume of rough lumber (before drying and planing with no adjustments) or planed/surfaced lumber. It is the volume of a one-foot length of a board one foot wide and one inch thick. Some countries utilize the synonym super foot or superficial foot." ;
              rdfs:label "BFT" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172568" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172569
gdsn:cv172569 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "There are varying standards for barrel for some specific commodities, including 31 gal for beer, 40 gal for whiskey or kerosene, and 42 gal for petroleum. The general standard for liquids is 31.5 gal or half a hogshead; the general standard for dry contents is 7,056 Cubic Inches." ;
              rdfs:label "BLL" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172569" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172570
gdsn:cv172570 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A unit of volume equal to one hundred board foot." ;
              rdfs:label "BP" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172570" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172571
gdsn:cv172571 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Beats Per Minute" ;
              rdfs:label "BPM" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172571" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172572
gdsn:cv172572 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The becquerel (symbol Bq) is the SI derived unit of radioactivity. One Bq is defined as the activity of a quantity of radioactive material in which one nucleus decays per second. SI uses the becquerel rather than the second for the unit of activity measure to avoid dangerous mistakes: a measurement in becquerels is proportional to activity, and thus a more dangerous source of radiation gives a higher reading. A measurement in seconds is inversely proportional." ;
              rdfs:label "BQL" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172572" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172573
gdsn:cv172573 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The British thermal unit (BTU or Btu) is a traditional unit of energy. It is approximately the amount of energy needed to heat one pound of water one degree Fahrenheit. One Btu is equal to about 1.06 kilojoules. It is used in the power, steam generation, heating and air conditioning industries." ;
              rdfs:label "BTU" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172573" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172574
gdsn:cv172574 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A bushel is an imperial and U.S. customary unit of dry volume, equivalent in each of these systems to 4 pecks or 8 gallons. It is used for volumes of dry commodities (not liquids), most often in agriculture" ;
              rdfs:label "BUA" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172574" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172575
gdsn:cv172575 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A bushel is an imperial and U.S. customary unit of dry volume, equivalent in each of these systems to 4 pecks or 8 gallons. It is used for volumes of dry commodities (not liquids), most often in agriculture" ;
              rdfs:label "BUI" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172575" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172576
gdsn:cv172576 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Coulomb - electric charge [C] (Unifed Code)" ;
              rdfs:label "C" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172576" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172577
gdsn:cv172577 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The number of millimetre per second the trade item or part of the trade item moves." ;
              rdfs:label "C16" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172577" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172578
gdsn:cv172578 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "a millimole is one thousandth of a mole." ;
              rdfs:label "C18" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172578" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172579
gdsn:cv172579 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A millisecond (from milli- and second; abbreviation: ms) is a thousandth (1/1000) of a second." ;
              rdfs:label "C26" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172579" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172580
gdsn:cv172580 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The mole (symbol mol) is the SI base unit of amount of substance; one of a few units used to measure this physical quantity.A mole will possess mass exactly equal to the substance's molecular or atomic weight in grams. That is to say, a substance's atomic or molecular mass in atomic mass units is the same as its molar mass in grams. Because of this, one can measure the number of moles in a pure substance by weighing it and comparing the result to its molecular or atomic weight" ;
              rdfs:label "C34" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172580" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172581
gdsn:cv172581 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Nanometre- a billionth of a metre (10 to the negative 9th power)" ;
              rdfs:label "C45" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172581" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172582
gdsn:cv172582 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A nano second is an SI unit of time equal to one thousand-millionth of a second (or one billionth of a second), that is, 10−9 seconds." ;
              rdfs:label "C47" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172582" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172583
gdsn:cv172583 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Picometre- a trillionth of a metre (10 to the negative 12th power)" ;
              rdfs:label "C52" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172583" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172584
gdsn:cv172584 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pascal second ( N s / m 2 ) is the unit of dynamic viscosity which is also known as the absolute viscosity of the fluid. It is the fluids internal resistance to flow . e.g.: water has dynamic viscosity of 1.787 at 273K or 0 degrees Celsius. and 1.002 Pa-second at 293K i.e. 20degrees Celsius." ;
              rdfs:label "C65" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172584" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172585
gdsn:cv172585 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Picowatt is a derived metric SI (System International) measurement unit of power. The picowatt is equal to one trillionth of a watt (10-12W)." ;
              rdfs:label "C75" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172585" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172586
gdsn:cv172586 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Candela [cd] (Unified code)" ;
              rdfs:label "cd" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172586" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172587
gdsn:cv172587 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Celsius (also historically known as centigrade) is a temperature scale, the freezing point of water is 0 degrees Celsius (°C) and the boiling point 100 °C (at standard atmospheric pressure), placing the boiling and freezing points of water exactly 100 degrees apart." ;
              rdfs:label "CEL" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172587" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172588
gdsn:cv172588 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Colony Forming Units: is a rough estimate of the number of viable bacteria or fungal cells in a sample." ;
              rdfs:label "CFU" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172588" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172589
gdsn:cv172589 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A unit of count defining the number of units of card (card: thick stiff paper or cardboard)." ;
              rdfs:label "CG" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172589" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172590
gdsn:cv172590 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A centigram is one hundredth (1/100) of a gram" ;
              rdfs:label "CGM" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172590" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172591
gdsn:cv172591 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A centilitre is one hundredth (1/100) of a litre" ;
              rdfs:label "CLT" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172591" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172592
gdsn:cv172592 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A square centimetre is an area of a square whose sides are exactly 1 centimetre in length." ;
              rdfs:label "CMK" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172592" ;
