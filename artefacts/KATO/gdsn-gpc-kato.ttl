###  urn:gs1:std:gdsn:cv176657
gdsn:cv176657 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The standard HALAL PLUS is high-quality Halal, certified by the Foundation Halal Correct and biologically certified by SKAL." ;
              rdfs:label "HALAL_PLUS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.halalcorrect.com" ;
              gdsn:sourceId "176657" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176658
gdsn:cv176658 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The National Commission for Environmental Certification (NCEC), was created on October 25, 2011 to monitor the implementation of the device. It is made up of representatives of the State, agricultural unions, approved associations for the protection of the environment, the agri-food industry, distribution and consumer organizations. The NCEC has in particular defined the control plans defining the precise framework allowing the certification of farms for each level of the system." ;
              rdfs:label "HAUTE_VALEUR_ENVIRONNEMENTALE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://agriculture.gouv.fr/une-certification-environnementale-pour-les-exploitations-agricoles http://agriculture.gouv.fr/certification-environnementale-mode-demploi-pour-les-exploitations" ;
              gdsn:sourceId "176658" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176659
gdsn:cv176659 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Hazard Analysis Critical Control Point (HACCP) is an approach to food safety that is systematic and preventive. It is recommended by the Codex Alimentarius Commission, the United Nations international standards organization for food safety. HACCP is used by most countries around the world. It has been in use since the 1960s. A HACCP system allows you to identify hazards and put in place controls to manage these throughout your supply chain during production. The HACCP scheme meets the requirements of the Codex Alimentarius Commission (CAC) – established by the World Health Organisation and the Food and Agriculture Organisation of the United Nations to bring together international food standards, guidelines and codes of practice to ensure fair trade. It can also be used to support the requirements of management standard requirements, such as ISO 22000 Food Safety Management." ;
              rdfs:label "HAZARD_ANALYSIS_CRITICAL_CONTROL_POINT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.fabwisconsin.com/page/certifications https://www.fda.gov/Food/GuidanceRegulation/HACCP/" ;
              gdsn:sourceId "176659" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176660
gdsn:cv176660 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies if product has been certified by Canadian Heart & Stroke Health Check Program." ;
              rdfs:label "HEALTH_CHECK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.healthcheck.org/" ;
              gdsn:sourceId "176660" ;
