###  urn:gs1:std:gdsn:cv177647
gdsn:cv177647 rdf:type owl:NamedIndividual ,
                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A shipping container of freight that is loaded with freight from the floor up, rather than on pallets. A full floor-loaded container can hold more freight than a palletized load." ;
              rdfs:label "99" ;
              gdsn:codeListName "PlatformTypeCode" ;
              gdsn:sourceId "177647" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177648
gdsn:cv177648 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This control is a peg or stem extending from the unit. There is no handle or lever on the end of the stem." ;
              rdfs:label "BARE_STEM_NO_OPERATOR" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177648" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177649
gdsn:cv177649 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a device, which resembles a cross or \"+\", which when attached to the stem can be turned to operate the unit." ;
              rdfs:label "CROSS_HANDWHEEL" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177649" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177650
gdsn:cv177650 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An electronic actuator converts energy (in the form of electricity) into motion. The motion can be rotary or linear, depending on the type of actuator." ;
              rdfs:label "ELECTRIC_ACTUATORS" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177650" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177651
gdsn:cv177651 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a flat piece of material made such as for one end to fit over the stem and can be turned to operate the unit. The unit is considered an extended lever as it has another piece of material into which the stem is inserted thereby causing the handle to be set away from the unit it operates" ;
              rdfs:label "EXTENDED_LEVER_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177651" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177652
gdsn:cv177652 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a flat piece of material made to fit over the stem and can be turned to operate the unit. The unit is considered an extended lever as it has another piece of material into which the stem is inserted thereby causing the handle to be set away from the unit it operates. Memory stop is a device which allows the user to set the range of motion allowable for the handle." ;
              rdfs:label "EXTENDED_LEVER_HANDLE_WITH_MEMORY_STOP" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177652" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177653
gdsn:cv177653 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a circular device which when attached to the stem can be turned to operate the unit. The unit is considered an extended lever as it has another piece of material into which the stem is inserted thereby causing the handle to be set away from the unit it operates." ;
              rdfs:label "EXTENDED_ROUND_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177653" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177654
gdsn:cv177654 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a device which contains a gear box and having a circular handle, thereby increasing the number of turns of the handle required to change the direction of the closure member, and reducing the force needed to operate the unit." ;
              rdfs:label "GEAR_OPERATOR" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177654" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177655
gdsn:cv177655 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a bar attached to a unit, designed to be mounted horizontally. A chain is attached on each end of the bar. By pulling on one chain or the other, the unit can be set into operation." ;
              rdfs:label "HORIZONTAL_CHAIN_LEVER_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177655" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177656
gdsn:cv177656 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a device comprised of non-conductive materials which can be turned to operate the unit even when thermal pipe insulation is affixed around the unit." ;
              rdfs:label "INSULATION_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177656" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177657
gdsn:cv177657 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a flat piece of material made such as for one end to fit over the stem and can be turned to operate the unit." ;
              rdfs:label "LEVER_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177657" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177658
gdsn:cv177658 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a long handle with a catch mechanism. The position lock can be used to set the valve in the full open or full closed position. This type of control may or may not have the ability to be locked with a padlock." ;
              rdfs:label "LEVER_LOCK_OPERATOR" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177658" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177659
gdsn:cv177659 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a flat piece of material made such as for one end to fit over the stem and can be turned to operate the unit. The lever has a secondary piece of material, which when engaged can hold the lever in one position. This type of control may or may not have the ability to be locked with a padlock. The control is a flat piece of material made such as for one end to fit over the stem and can be turned to operate the unit. The lever has a secondary piece of material, which when engaged can hold the lever in one position. This type of control may or may not have the ability to be locked with a padlock." ;
              rdfs:label "LOCKING_LEVER_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177659" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177660
gdsn:cv177660 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a stem with a keyed end. The control is operated by a lock shield key. The Key can be a simple as an allen key or more complex depending on the security required." ;
              rdfs:label "LOCKSHIELD_OPERATOR" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177660" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177661
gdsn:cv177661 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A pneumatic actuator converts energy (in the form of compressed air, typically) into motion. The motion can be rotary or linear, depending on the type of actuator." ;
              rdfs:label "PNEUMATIC_ACTUATORS" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177661" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177662
gdsn:cv177662 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a long handle with a catch mechanism. The position lock can be used to set the valve in any position or as a memory stop so the valve may be reopened to the previous position. This type of control may or may not have the ability to be locked with a padlock." ;
              rdfs:label "POSITION_LOCK_OPERATOR" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177662" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177663
gdsn:cv177663 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a circular device which when attached to the stem can be turned to operate the unit." ;
              rdfs:label "ROUND_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177663" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177664
gdsn:cv177664 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A groove or slot which allows for screwdrivers to be used to operate the control." ;
              rdfs:label "SLOTTED" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177664" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177665
gdsn:cv177665 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A solenoid is a transducer device which converts energy into linear motion." ;
              rdfs:label "SOLENOID" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177665" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177666
gdsn:cv177666 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a piece of material in the shape of a \"T\" in which the stem can be inserted. The Tee can then be rotated to operate the unit." ;
              rdfs:label "SOLID_TEE_OPERATOR" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177666" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177667
gdsn:cv177667 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control comprises a nut at the top of the stem. This nut is square in shape. Turning the nut turns the stem causing the unit to operate." ;
              rdfs:label "SQUARE_OPERATING_NUT" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177667" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177668
gdsn:cv177668 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a bar attached to a unit, designed to be mounted vertically. A chain is attached on each end of the bar. By pulling on one chain or the other, the unit can be set into operation." ;
              rdfs:label "VERTICAL_CHAIN_LEVER_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177668" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177669
gdsn:cv177669 rdf:type owl:NamedIndividual ,
                       gdsn:c-728354239 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The control is a flat piece of material made such that the center of the device can over the stem and can be turned to operate the unit. The section of the bar are bent allowing for an easier grip and resemble wings." ;
              rdfs:label "WING_HANDLE" ;
              gdsn:codeListName "PlumbingControlTypeCode" ;
              gdsn:sourceId "177669" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177670
gdsn:cv177670 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "American National Standards Institute (ANSI) oversees the creation, promulgation and use of thousands of norms and guidelines that directly impact businesses in nearly every sector: from acoustical devices to construction equipment, from dairy and livestock production to energy distribution, and many more. ANSI is also actively engaged in accrediting programs that assess conformance to standards.- http://www.ansi.org/" ;
              rdfs:label "ANSI" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177670" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177671
gdsn:cv177671 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The American Society of Mechanical Engineers (ASME) is a professional body, specifically an engineering society, focused on mechanical engineering. The organization's stated vision is to be the premier organization for promoting the art, science and practice of mechanical and multidisciplinary engineering and allied sciences to the diverse communities throughout the world. Its stated mission is to promote and enhance the technical competency and professional well-being of its members, and through quality programs and activities in mechanical engineering, better enable its practitioners to contribute to the well-being of humankind. Http://www.asme.org/" ;
              rdfs:label "ASME" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177671" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177672
gdsn:cv177672 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "American Society for Testing and Materials International (ASTM) specification documents, test methods, classifications, practices, and guides. These standards describe the characteristics of materials, systems, products, and services. ASTM documents are divided into nine sections, Metals, Construction, Paints, Petroleum Products, Plastics, Textiles, Rubber & Electric Insulating Materials, General Test Methods, and Miscellaneous. ASTM technical committees are made up of professionals from around the globe who develop ASTM standards. There are over 130 ASTM technical committees covering diverse industry areas ranging from metals to the environment. http://www.astm.org" ;
              rdfs:label "ASTM" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177672" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177673
gdsn:cv177673 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cast Iron Soil Pipe Institute (CISPI) The Institute is dedicated to aiding and improving the plumbing industry. Through the preparation and distribution of technical reports, we seek to advance interest in the manufacture, use and distribution of cast iron soil pipe and fittings, and through a program of research and the cooperative effort of soil pipe manufacturers, we strive to improve the industry's products, achieve standardization of cast iron soil pipe and fittings, and provide a continuous program of product testing, evaluation and development. Assurance that pipe and fittings meet the approved standards and tolerances of the Institute is provided either by Ç®; or the CI NO-HUB® trademarks which are the collective marks all member companies may place on their products. www.cispi.org" ;
              rdfs:label "CISPI" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177673" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177674
gdsn:cv177674 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Canadian Standards Association (CSA) As a membership-based association serving business, industry, government and consumers in Canada and the global marketplace. As a solutions-oriented organization, CSA works in Canada and around the world to develop standards that address real needs, such as enhancing public health and safety. Advancing the quality of life. Helping to preserve the environment. Facilitating trade. CSA helps people understand standards through education and information products and services." ;
              rdfs:label "CSA" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177674" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177675
gdsn:cv177675 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "International Association of Plumbing and Mechanical Officials (IAPMO) As a membership-based association, IAPMO is proud to utilize an open consensus process in the development of our flagship Uniform Plumbing Code® and Uniform Mechanical Code®. These codes are established through scientific research, debate, and analysis, strengthening our position at the forefront of the plumbing and mechanical industries. Www.iapmo.org" ;
              rdfs:label "IAPMO" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177675" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177676
gdsn:cv177676 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "International Organization for Standardization (ISO) ISO is a non-governmental organization that forms a bridge between the public and private sectors. On the one hand, many of its member institutes are part of the governmental structure of their countries, or are mandated by their government." ;
              rdfs:label "ISO" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177676" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177677
gdsn:cv177677 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Manufacturers Standardization Society (MSS) of the Valve and Fittings Industry is a non-profit technical association organized for development and improvement of industry, national and international codes and standards for: Valves, Valve Actuators, Pipe Fittings, Valve Modification, Flanges, Pipe Hangers, and Associated Seals. The primary function of MSS is to provide its members the means to develop engineering standard practices for the use and benefit of the industry and users of its products. The Society, the only organization dedicated solely to the technical needs of the industry, is currently comprised of 25 technical committees to write, revise and reaffirm industry standards. http://mss-hq.org/" ;
              rdfs:label "MSS" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177677" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177678
gdsn:cv177678 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "National Sanitation Foundation International (NSF) NSF Internal helps protect you by certifying products and writing standard for food, water and consumer goods. NSF International is The Public Health and Safety Company™, providing public health and safety risk management solutions to companies, governments and consumers around the world. www.nsf.org" ;
              rdfs:label "NSF" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177678" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177679
gdsn:cv177679 rdf:type owl:NamedIndividual ,
                       gdsn:c2027212447 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Other agency not defined in the list" ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "PlumbingHVACConnectionAgencyCode" ;
              gdsn:sourceId "177679" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177680
gdsn:cv177680 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An American Mechanical Joint is a rubber gasket is compressed by a ductile iron gland drawn up with low-alloy steel bolts which affords liberal deflection and allows expansion and contraction of the line without leakage and is rated for a water working pressure of up to 350 psi." ;
              rdfs:label "AMERICAN_MECHANICAL_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177680" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177681
gdsn:cv177681 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The end length of increased diameter into which a pipe end can be fitted." ;
              rdfs:label "BELLED" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177681" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177682
gdsn:cv177682 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The connection is a flat cut end designed to mate directly to the end of another product. This connection is to connect the same sized pipes or valve ends together." ;
              rdfs:label "BUTT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177682" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177683
gdsn:cv177683 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A compression joint kind of tubing or pipe connection where a nut, and then a sleeve or ferrule is placed over a copper or plastic tube and is compressed tightly around the tube as the nut is tightened, forming a positive grip and seal without soldering. Also a flexible compression fitting." ;
              rdfs:label "COMPRESSION_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177683" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177684
gdsn:cv177684 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This type of joint requires the joint be crimped once sections are fit together. Some of the necessary connection parts must be added or acquired separately." ;
              rdfs:label "CRIMPED" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177684" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177685
gdsn:cv177685 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Female threaded" ;
              rdfs:label "FEMALE_THREADED" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177685" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177686
gdsn:cv177686 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Flange generally refers to the actual raised rim or lip of a fitting which can be bolted to the flange of an opposite unit." ;
              rdfs:label "FLANGED_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177686" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177687
gdsn:cv177687 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Flare Joint is where a pipe or tube is widened to join with a larger diameter pipe, for example between a copper tube and a main water feed line." ;
              rdfs:label "FLARE_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177687" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177688
gdsn:cv177688 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Outer diameter of item has a groove which is designed to be joined together using external gaskets and couplings." ;
              rdfs:label "GROOVED_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177688" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177689
gdsn:cv177689 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The lug body has protruding lugs that provide bolt holes matching those in the flanges. An advantage of the lug body type is that piping on one side of the valve may be disassembled while the valve remains bolted in place, allowing for the remainder of the system to continue in operation." ;
              rdfs:label "LUG" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177689" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177690
gdsn:cv177690 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Male Threaded" ;
              rdfs:label "MALE_THREADED" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177690" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177691
gdsn:cv177691 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Mechanical Joint is a joint which typically consists of: (a) a flange which is integrally cast with the bell of the pipe, (b) a rubber gasket which fits into the recess in the socket, (c) a follower ring which compresses the gasket, and (d) nuts and bolts used to tighten the joint." ;
              rdfs:label "MECHANICAL_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177691" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177692
gdsn:cv177692 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A connector for no-hub iron pipe consisting of a rubber sleeve and a stainless steel band secured by hose clamps. A variation, a neoprene sleeve with two adjustable steel bands, is used for connecting dissimilar materials, as when connecting new plastic pipe to an existing cast iron drain pipe." ;
              rdfs:label "NO_HUB_IRON" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177692" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177693
gdsn:cv177693 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pack Joint" ;
              rdfs:label "PACK_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177693" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177694
gdsn:cv177694 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "SPG - Spigot, FTG- Fitting, M- Male Pipe Size- Straight end to connect or insert into the bell end or fitting to join to connecting pipe." ;
              rdfs:label "PLAIN" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177694" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177695
gdsn:cv177695 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This type of joint requires the joint be crimped once sections are fit together. All of the necessary connection parts are present." ;
              rdfs:label "PRESS" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177695" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177696
gdsn:cv177696 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A joint which can be pushed onto the opposite end manually to form a solid connection. This type of connection fits around an inserted pipe or fitting end." ;
              rdfs:label "PUSH" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177696" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177697
gdsn:cv177697 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A connection which has the ability to joined and un-joined repeatedly or at will. This type of joint does not degrade the product over time. This type of joint is not considered by the industry to be a push joint." ;
              rdfs:label "QUICK_CONNECT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177697" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177698
gdsn:cv177698 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The connection is a female socket end designed to allow for the insertion of straight pipe/tubing and joined using soldering, sweating, brazing, welding, or cementing. This connection is also called solder cup, hub, or slip joint." ;
              rdfs:label "SOCKET" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177698" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177699
gdsn:cv177699 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This type of joint uses a pressure type seal while allowing rotation of the units being joined." ;
              rdfs:label "SWIVEL_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177699" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177700
gdsn:cv177700 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This type of joint can connect and disjoint two pipes very easily without deformation to the pipe or tube." ;
              rdfs:label "UNION_JOINT" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177700" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177701
gdsn:cv177701 rdf:type owl:NamedIndividual ,
                       gdsn:c-1783282878 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A wafer is a seal using a tightly fitting seal, i.e., gasket, o-ring, precision machined, and a flat valve face on the upstream and downstream sides of the valve." ;
              rdfs:label "WAFER" ;
              gdsn:codeListName "PlumbingHVACConnectionTypeCode" ;
              gdsn:sourceId "177701" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177702
