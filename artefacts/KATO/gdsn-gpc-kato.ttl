gdsn:cv179759 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Surface consisting of bamboo. Bamboo, like wood, is a natural composite material with a high strength-to-weight ratio, that comes from a tall tropical plant with hollow stems." ;
              rdfs:label "BAMBOO" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179759" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179760
gdsn:cv179760 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
