gdsn:cv169658 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lithium metal batteries utilizing thionyl chloride are primary used in portable electronics and memory backup." ;
              rdfs:label "LITHIUM_THIONYL_CHLORIDE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169658" ;
              gdsn:sourceType "codeValue" .


