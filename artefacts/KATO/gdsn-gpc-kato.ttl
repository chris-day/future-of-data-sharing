              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ecolabelindex.com/ecolabel/oe-100-blended" ;
              gdsn:sourceId "176413" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176414
gdsn:cv176414 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Baystate Organic Certifiers is a USDA National Organic Program accredited certifying agent certifying farm and processing operations throughout the continental United States." ;
              rdfs:label "CERTIFIED_ORGANIC_BAYSTATE_ORGANIC_CERTIFIERS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.baystateorganic.org/" ;
