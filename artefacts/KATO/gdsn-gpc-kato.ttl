gdsn:cv177007 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "TNO awards the TNO label to various products in the Netherlands which meet high standards of sustainable innovation." ;
