              rdfs:comment "Lithium ion batteries utilizing titanate are primary used in automotive products." ;
              rdfs:label "LITHIUM_TITANATE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169659" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169660
gdsn:cv169660 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Mercury batteries (also called mercuric oxide battery, mercury cell, button cell, or Ruben-Mallory) are non-rechargeable electrochemical batteries, primary cells with primary uses in portable devices." ;
              rdfs:label "MERCURY_OXIDE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169660" ;
              gdsn:sourceType "codeValue" .


