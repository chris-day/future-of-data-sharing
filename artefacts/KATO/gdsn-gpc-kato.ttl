###  urn:gs1:std:gdsn:extAttr273
gdsn:extAttr273 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:date ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "This is a Date field to identify, for Discontinued Products, the last expiry date for the final run of production. Supply at Level: All Applicable" ;
                rdfs:label "finalBatchExpiryDate" ;
                gdsn:example "10/20/2008" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{10..10}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "273" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "If populated, then End Availability Date is not null. Batch expiry date is >= End-availability date'" .


###  urn:gs1:std:gdsn:extAttr274
gdsn:extAttr274 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "Used to determine the type of Flash Point applicable to the item. If Degrees Celsius selected, a Flash Point Temperature value is to be provided." ;
                rdfs:label "flashPointType" ;
                gdsn:example "DNB – Does Not Burn" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{1..3}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "274" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr275
