###  urn:gs1:std:gdsn:cv178028
gdsn:cv178028 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348137 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Item contains significantly less than normal mature seeds for this particular variety. Some mature seeds will exist in trade item. The determination of this is made by the supplier and is subject to target market regulations or trade organisation guidelines." ;
              rdfs:label "ALMOST_SEEDLESS" ;
              gdsn:codeListName "ProduceSeedPresenceCode" ;
              gdsn:sourceId "178028" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178029
gdsn:cv178029 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348137 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Item contains No mature Seeds or potentially a few errant seeds. The determination of this is made by the supplier and is subject to target market regulations or trade organisation guidelines." ;
              rdfs:label "SEEDLESS" ;
              gdsn:codeListName "ProduceSeedPresenceCode" ;
              gdsn:sourceId "178029" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178030
gdsn:cv178030 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348137 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Item contains the normal amount of mature seeds which are typical for this trade item. The determination of this is made by the supplier and is subject to target market regulations or trade organisation guidelines." ;
              rdfs:label "SEEDS" ;
              gdsn:codeListName "ProduceSeedPresenceCode" ;
              gdsn:sourceId "178030" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178031
gdsn:cv178031 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348137 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Quantity or presence of seeds not determined" ;
              rdfs:label "UNIDENTIFIED" ;
              gdsn:codeListName "ProduceSeedPresenceCode" ;
              gdsn:sourceId "178031" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178032
gdsn:cv178032 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
