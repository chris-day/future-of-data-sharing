###  urn:gs1:std:gdsn:cv174246
gdsn:cv174246 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Translucent, colourless, brittle (when dry), flavourless substance derived from collagen obtained from various pork raw materials (connective tissues (skin) and bones). It is commonly used as a gelling agent in food, pharmaceutical drugs, photography, and cosmetic manufacturing." ;
              rdfs:label "PORK_GELATINE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174246" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174247
gdsn:cv174247 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Potassium" ;
              rdfs:label "POTASSIUM" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174247" ;
              gdsn:sourceType "codeValue" .


