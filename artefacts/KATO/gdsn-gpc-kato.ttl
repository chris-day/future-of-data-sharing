###  urn:gs1:std:gdsn:cv176258
gdsn:cv176258 rdf:type owl:NamedIndividual ,
                       gdsn:c-250174104 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Constitutes the packaging designed to come into direct contact with the product." ;
              rdfs:label "PRIMARY" ;
              gdsn:codeListName "PackagingLevelTypeCode" ;
              gdsn:sourceId "176258" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176259
gdsn:cv176259 rdf:type owl:NamedIndividual ,
                       gdsn:c-250174104 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Groups a given number of primary packaging units together into a convenient unit at the point of sale. Secondary packaging typically has one of two roles: it can be a convenient means to replenish the shelves; or it can group primary packaging units into a package for purchase. It can be removed without affecting the product’s properties and generally defines the unit handled by the retailer" ;
              rdfs:label "SECONDARY" ;
              gdsn:codeListName "PackagingLevelTypeCode" ;
              gdsn:sourceId "176259" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176260
gdsn:cv176260 rdf:type owl:NamedIndividual ,
                       gdsn:c-250174104 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Is designed to ensure damage free handling and transport of a number of sales or grouped packages." ;
              rdfs:label "TERTIARY" ;
              gdsn:codeListName "PackagingLevelTypeCode" ;
              gdsn:sourceId "176260" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176261
gdsn:cv176261 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The use of a \"100% Canadian Milk\" or \"100% Canadian Dairy\" claim, with or without logos, vignettes etc., when used on dairy products, indicates all of the dairy ingredients in the product are derived from Canadian sources." ;
              rdfs:label "100_PERCENT_CANADIAN_MILK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.inspection.gc.ca/english/fssa/dailai/guidire.shtml" ;
              gdsn:sourceId "176261" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176262
gdsn:cv176262 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "100% Veganskt (Vegan) is certified by Djurens rätt (Animal rights) and shows that the product does not contain animal ingredients." ;
              rdfs:label "100_PERCENT_VEGANSKT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.djurensratt.se/" ;
              gdsn:sourceId "176262" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176263
gdsn:cv176263 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A three-peak mountain snowflake (3PMSF) symbol branded on a tire's sidewall indicates the tire meets required performance criteria in snow testing to be considered severe snow service-rated. Originally used as a designation for winter tires, the 3PMSF symbol is now featured on some all-season and all-terrain tires with snow performance that meets the testing criteria. (UNECE Regulation 117, (EC) 661/2009)" ;
              rdfs:label "3PMSF" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.astm.org/DATABASE.CART/HISTORICAL/E1136-14.htm" ;
              gdsn:sourceId "176263" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176264
gdsn:cv176264 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Art And Creative Materials Institute, Inc." ;
              rdfs:label "ACMI" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://acmiart.org/" ;
              gdsn:sourceId "176264" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176265
gdsn:cv176265 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ADCCPA is a non-profit association established in 1995, for the development of food product conformity certification. It manages the \"CQ - Certified Product\" logo, identifying the Product Conformance Certification (CCP) approach." ;
              rdfs:label "ADCCPA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.produitcertifie.fr/index.php/association-adccpa" ;
              gdsn:sourceId "176265" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176266
gdsn:cv176266 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "AFIA Pet Food Ingredient Facility Certification Program is launched by the American Feed Industry Association and administered by the Safe Quality Food Institute (SQFI). The program builds upon the domestic Safe Feed/Safe Food program, but is designed to meet the safety issues specifically related to the manufacturing of pet food." ;
              rdfs:label "AFIA_PET_FOOD_FACILITY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://safefeedsafefood.org/main/home.cfm" ;
              gdsn:sourceId "176266" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176267
gdsn:cv176267 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The BIO Agency is a public interest group whose mission is to develop and promote organic agriculture." ;
              rdfs:label "AGENCE_BIO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.agencebio.org/" ;
              gdsn:sourceId "176267" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176268
gdsn:cv176268 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Where do the food products come from? How and by whom are they produced? Are they respectful of the environment? It is to answer all these questions that Agri Confiance® was created in 1992. A collective approach of the producers organized in cooperative, engaged for a sustainable agriculture and for each one of us. A controlled engagement. An ambition. A movement. For there to be trust between us." ;
              rdfs:label "AGRI_CONFIANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.agriconfiance.coop/" ;
              gdsn:sourceId "176268" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176269
gdsn:cv176269 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification for meat out of integrated production based on principles of IP-Suisse. Label owned by Ernst Sutter AG." ;
              rdfs:label "AGRI_NATURA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.agrinatura.ch/" ;
              gdsn:sourceId "176269" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176270
gdsn:cv176270 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "France's national logo for organic products since 1985. Organic products carrying the logo must contain more than 95 percent organic components and be produced or processed within the EU, and were certified by one of the inspection bodies accredited according to EN 45011." ;
              rdfs:label "AGRICULTURE_BIOLOGIQUE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.agencebio.org" ;
              gdsn:sourceId "176270" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176271
gdsn:cv176271 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Association of Home Appliance Manufacturers (AHAM) is an organization that verifies the volume, energy and in some cases, performance, of many common household appliances. Since 1967, we've used outside laboratories to test products, and today you'll find the AHAM Verified Mark on all products included in our program – making comparing products easier for you" ;
              rdfs:label "AHAM" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://ahamverifide.org/" ;
              gdsn:sourceId "176271" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176272
gdsn:cv176272 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A.I.S.E., the international Association for Soaps, Detergents and Maintenance Products is the official representative body of this industry in Europe." ;
              rdfs:label "AISE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.aise.eu/" ;
              gdsn:sourceId "176272" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176273
gdsn:cv176273 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The International Association for Soaps, Detergents and Maintenance Products: This Charter logo on a product means that the company placing this product on the market is committed to the industry Charter for Sustainable Cleaning, and that the company has successfully complied with the Charter Sustainability Procedures. Consumers and professional users who see this logo on a product can be assured that the company making this product is voluntarily committed to delivering continual improvements in safety, environmental friendliness and other key aspects of sustainability. Only those companies that have signed up to the Charter, and meet the licensing conditions, are permitted to use it." ;
              rdfs:label "AISE_2005" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.sustainable-cleaning.com/en.publicarea_chartervisual.orb" ;
              gdsn:sourceId "176273" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176274
gdsn:cv176274 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The International Association for Soaps, Detergents and Maintenance Products This logo will certify that the company which manufactured the product is following Charter update 2010 sustainability principles." ;
              rdfs:label "AISE_2010" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.sustainable-cleaning.com/en.publicarea_chartervisual.orb" ;
              gdsn:sourceId "176274" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176275
gdsn:cv176275 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The new mark certifies that your brand meets all Charter product sustainability standards, in addition to the manufacturing requirements (ISO 14025 standard for Type III environmental labels and declarations)." ;
              rdfs:label "AISE_2020_BRAND" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.charter2020.eu/#join" ;
              gdsn:sourceId "176275" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176276
gdsn:cv176276 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This new mark certifies that your organisation meets the Charter company sustainability standards in their manufacturing facilities (ISO 14025 standard for Type III environmental labels and declarations)." ;
              rdfs:label "AISE_2020_COMPANY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.charter2020.eu/#join" ;
              gdsn:sourceId "176276" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176277
gdsn:cv176277 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Atlanta Kashrus Commission Certification" ;
              rdfs:label "AKC_PEACH_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://kosheratlanta.org/" ;
              gdsn:sourceId "176277" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176278
gdsn:cv176278 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The purpose of the WASP (Wines of Alentejo Sustainability Programme) is to align the sector's competitiveness with environmental, economic and social objectives, thus creating opportunities based on an integrated and sustainably oriented strategy. The certification of sustainable wine production is the guarantee that an independent evaluation, by a third party credentialed according to the Portuguese Quality System, confirms that good sustainability practices have been implemented. It is an important source of information to assess, guarantee and improve the environmental and socio-economic conditions of the industry." ;
              rdfs:label "ALENTEJO_SUSTAINABILITY_PROGRAMME" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://sustentabilidade.vinhosdoalentejo.pt/en/wines-of-alentejo-sustainability-programme" ;
              gdsn:sourceId "176278" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176279
gdsn:cv176279 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"childhood food\" symbol guarantees that the product complies with French and European regulatory requirements. In addition to perfectly meeting the special nutritional needs of children from birth to 3 years old, the product meets very strict safety standards. Ingredient quality, strict monitoring of contaminants and microbiological risks, packaging composition... my child's meal is combed through to make sure everything is fine." ;
              rdfs:label "ALIMENTATION_DU_TOUT_PETIT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.alimentationdutoutpetit.fr/" ;
              gdsn:sourceId "176279" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176280
gdsn:cv176280 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The presence of Quebec Bio Food prepared on a product means that it is composed of minimally 85% of Quebec organic products. The processing and packaging of these foods must also be made in Québec" ;
              rdfs:label "ALIMENTS_BIO_PREPARES_AU_QUEBEC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://lequebecbio.com/les-entreprises-bio/aliment-quebec-bio/" ;
              gdsn:sourceId "176280" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176281
gdsn:cv176281 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Aliments du Québec is an organization whose mission is to promote Quebec agri-food products. Promotional activities, brand identification at the points-of-sale and special events are all ways to inform consumers about the availability of Quebec food products" ;
              rdfs:label "ALIMENTS_DU_QUEBEC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.alimentsduquebec.com/en/" ;
              gdsn:sourceId "176281" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176282
gdsn:cv176282 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Aliments du Québec is the holder of the unique label of origin for Quebec food products, recognized by the whole agri-food industry, we manage two certifications" ;
              rdfs:label "ALIMENTS_DU_QUEBEC_BIO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://lequebecbio.com/les-entreprises-bio/aliment-quebec-bio/" ;
              gdsn:sourceId "176282" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176283
gdsn:cv176283 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any product processed and packaged entirely in Quebec can be considered an \"Aliments préparés au Québec . When the main ingredients are available in Quebec in sufficient quantities, they must be used." ;
              rdfs:label "ALIMENTS_PREPARES_AU_QUEBEC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.alimentsduquebec.com/en/" ;
              gdsn:sourceId "176283" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176284
gdsn:cv176284 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The products with AllergyCertified logo have been searched and examined every ingredient in the product. They never contain any perfume and every ingredient has been evaluated with regards to allergenic, hormone disruptive and carcinogenic substances." ;
              rdfs:label "ALLERGYCERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://allergycertified.com/" ;
              gdsn:sourceId "176284" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176285
gdsn:cv176285 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification for products with regional provenance of the Swiss regions Graubünden, Uri, Glarus and Tessin." ;
              rdfs:label "ALPINAVERA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.alpinavera.ch/" ;
              gdsn:sourceId "176285" ;
