###  urn:gs1:std:gdsn:cv180725
gdsn:cv180725 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fair Wild stands for sustainability for wild plants and protection for those who collect and trade them. Our standard protects local plant species and wildlife from the effects of overexploitation, and ensures that local collectors enjoy fair working conditions." ;
              rdfs:label "FAIR_WILD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fairwild.org/" ;
              gdsn:sourceId "180725" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180726
gdsn:cv180726 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foie gras is a culinary speciality made from fresh liver from the rearing and fattening by force-feeding of geese and ducks. This logo is a simple way of identifying French foie gras." ;
              rdfs:label "FOIE_GRAS_DE_FRANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://lefoiegras.fr/le-foie-gras/foie-gras-de-france" ;
              gdsn:sourceId "180726" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180727
gdsn:cv180727 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"Fumé en France\" salmon logo is gradually appearing in shops to make it easier to identify French production. It is subject to strict compliance with the French Smoked Salmon Charter." ;
              rdfs:label "FUME_EN_FRANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://saumonfumeinfo.fr/tout-pour-bien-choisir/etiquetage-clair-precis-2/" ;
              gdsn:sourceId "180727" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180728
gdsn:cv180728 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The magret is a lean meat fillet, native to the Gers cuisine, cut from the breast of a fattened goose or duck, fattened by force-feeding, the same ones used to produce confit and foie gras. This logo is a simple way of identifying French magret." ;
              rdfs:label "MAGRET_DE_FRANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://lefoiegras.fr/le-foie-gras/foie-gras-de-france" ;
              gdsn:sourceId "180728" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180729
gdsn:cv180729 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "PME+ (Petite et Moyenne Entreprise, Small and Medium-sized Enterprise) is the label for independent French companies on a human scale, with ethical and responsible practices. The PME+ label is awarded after an annual audit carried out by Ecocert environment, according to a reference system inspired by the ISO 26000 standard." ;
              rdfs:label "PME_PLUS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.label-pmeplus.fr/" ;
              gdsn:sourceId "180729" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180730
gdsn:cv180730 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This logo is a simple way of identifying French product." ;
              rdfs:label "PRODUIT_DE_FRANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://lefoiegras.fr/le-foie-gras/foie-gras-de-france" ;
              gdsn:sourceId "180730" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180731
gdsn:cv180731 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The reparability index is deployed on 5 categories of household appliances and electronics. This tool, provided for by the anti-waste law for a circular economy, aims to better inform consumers about the more or less repairable nature of their purchases." ;
              rdfs:label "REPAIRABILITY_INDEX" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ecologie.gouv.fr/indice-reparabilite" ;
              gdsn:sourceId "180731" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180732
gdsn:cv180732 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Eco-responsible orchards approach meets new consumer expectations. It marks the commitment of apple growers to production methods that respect the environment and biodiversity in the orchards, in order to offer a French apple of quality, healthy and rich in taste!" ;
              rdfs:label "VERGERS_ECORESPONSABLES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.lapomme.org/vergers-ecoresponsables" ;
              gdsn:sourceId "180732" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180733
gdsn:cv180733 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The association Vignerons en Développement Durable (Winegrowers in Sustainable Development) brings together winegrowers who are committed to a CSR (Corporate Social Responsibility) approach from the vine to the glass." ;
              rdfs:label "VIGNERONS_ENGAGES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://vignerons-engages.com/" ;
              gdsn:sourceId "180733" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180734
gdsn:cv180734 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"Zero Pesticide Residue\" programme guarantees consumers that products bearing the label are free of residues of active substances that are not compatible with this programme." ;
              rdfs:label "ZERO_RESIDU_DE_PESTICIDES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.nouveaux-champs.fr/cahier-des-charges/" ;
