                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The QZHE (Qualitaetszeichen Hessen) is a quality mark of the State of Hessen. Supervised by the Ministry for Rural Areas and Consumer Protection Hessen sourcing their natural ingredients with respect for people and biodiversity." ;
              rdfs:label "QZHE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.gutes-aus-hessen.de/unsere-siegel/gepruefte-qualitaet-hessen/" ;
              gdsn:sourceId "180667" ;
              gdsn:sourceType "codeValue" .


