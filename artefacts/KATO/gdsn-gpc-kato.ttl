###  urn:gs1:std:gdsn:cv176523
gdsn:cv176523 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ENERGY STAR is a voluntary government-backed program dedicated to helping individuals protect the environment through energy efficiency. The ENERGY STAR mark is the national symbol for energy efficiency, making it easy for consumers and businesses to identify high-quality, energy-efficient products, homes, and commercial and industrial buildings." ;
              rdfs:label "ENERGY_STAR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.eu-energystar.org/" ;
              gdsn:sourceId "176523" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176524
gdsn:cv176524 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: ENTWINE. No certification program, members certify through SAW, Freshcare or ISO14001. However, the Entwine logo can be used on bottle if member is certified (=also part of one of those certification programs) and 85% of grapes come from certified vineyards. National. Umbrella organisation run by the Australian Wine Research Institute. Voluntary sustainability program to support growers and winemakers that primarily supplies information for research, benchmarking and development of program. https://www.awri.com.au/industry_support/entwine/" ;
              rdfs:label "ENTWINE_AUSTRALIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.awri.com.au/industry_support/entwine/" ;
              gdsn:sourceId "176524" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176525
gdsn:cv176525 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Safer Choice label, it means that every ingredient in the product has been reviewed by EPA scientists. Only products that meet our Safer Choice Standard, which includes stringent human health and environmental criteria, are allowed to carry the label." ;
              rdfs:label "EPA_DFE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.epa.gov/saferchoice" ;
              gdsn:sourceId "176525" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176526
gdsn:cv176526 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Electronic Product Environmental Assessment Tool Bronze" ;
              rdfs:label "EPEAT_BRONZE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.epeat.net/" ;
              gdsn:sourceId "176526" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176527
gdsn:cv176527 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Electronic Product Environmental Assessment Tool Gold" ;
              rdfs:label "EPEAT_GOLD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.epeat.net/" ;
              gdsn:sourceId "176527" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176528
gdsn:cv176528 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Electronic Product Environmental Assessment Tool Silver" ;
              rdfs:label "EPEAT_SILVER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.epeat.net/" ;
              gdsn:sourceId "176528" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176529
gdsn:cv176529 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Equal Exchange's mission is to build long-term trade partnerships that are economically just and environmentally sound, to foster mutually beneficial relationships between farmers and consumers and to demonstrate, through our success, the contribution of worker co-operatives and Fair Trade to a more equitable, democratic and sustainable world." ;
              rdfs:label "EQUAL_EXCHANGE_FAIRLY_TRADED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://equalexchange.coop/fair-trade" ;
              gdsn:sourceId "176529" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176530
gdsn:cv176530 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The wine certification according to the Equalitas-Sustainable Wine standard. This standard has been designed to be applied to the wine industry supply chain. It provides for its adoption and certification by all types of players, whether grape producers, wine processors or bottlers, including wine protection associations. The standard, in fact, envisages the certification of three industry levels: the producer (Organisation standard), the finished product (Product standard) and the Terroir (Terroir standard)." ;
              rdfs:label "EQUALITAS_SUSTAINABLE_WINE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.equalitas.it/" ;
              gdsn:sourceId "176530" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176531
gdsn:cv176531 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The label of Bioberband Earth & Seed indicates organic agriculture that interacts in a constructive and life-enhancing way with natural systems and cycles." ;
              rdfs:label "ERDE_SAAT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.erde-saat.at/" ;
              gdsn:sourceId "176531" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176532
gdsn:cv176532 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Dutch mark Erkend Streekproduct indicates that the product and its ingredients come from a specific region. During production there has been attention for preservation and maintenance of characteristic values of the landscape and the environment." ;
              rdfs:label "ERKEND_STREEK_PRODUCT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.erkendstreekproduct.nl" ;
              gdsn:sourceId "176532" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176533
gdsn:cv176533 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Membership is open to any company involved in the sourcing, trading or packing of tea sold in Europe, North America, Australia and New Zealand. When you see the ETP Hand and Leaf logo on packaging it means the tea inside is from a member of Ethical Tea Partnership. Members range from large global brands and retailers to small boutique labels and specialty teas. Because we focus purely on improving the sustainability of tea production – and not herbs, the ETP logo can only be used on products that contain a minimum of 55% Camellia sinensis (tea) by weight." ;
              rdfs:label "ETP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ethicalteapartnership.org/" ;
              gdsn:sourceId "176533" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176534
gdsn:cv176534 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is physically marked with the European Union Eco label a European environmental initiative supported by the European Commission." ;
              rdfs:label "EU_ECO_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://ec.europa.eu/environment/ecolabel/eu-ecolabel-for-consumers.html" ;
              gdsn:sourceId "176534" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176535
gdsn:cv176535 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The EU adopted the Directive 2010/30/EU on energy labels. Energy labels help consumers choosing products which save energy and thus money. They also provide incentives for the industry to develop and invest in energy efficient product design." ;
              rdfs:label "EU_ENERGY_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://ec.europa.eu/energy/efficiency/labelling/labelling_en.htm" ;
              gdsn:sourceId "176535" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176536
gdsn:cv176536 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "New EU organic logo the EU introduced a new organic logo to ensure consumer protection and common standards. See www.organic-farming.europa.eu" ;
              rdfs:label "EU_ORGANIC_FARMING" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.organic-farming.europa.eu" ;
              gdsn:sourceId "176536" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176537
gdsn:cv176537 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Europe Soya programme has been established to promote and propagate the cultivation, processing and marketing of GM-free, origin-controlled quality soya from Europe. The aim is to develop and guarantee a GM-free protein supply in and from Europe." ;
              rdfs:label "EUROPE_SOYA_STANDARD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.donausoja.org/en/certification/standards/europe-soya-standard/" ;
              gdsn:sourceId "176537" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176538
gdsn:cv176538 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The vegan V-Label is an internationally recognised, registered label which can be applied to vegan products that do not use animals or parts of animals, and that do not derive from animals." ;
              rdfs:label "EUROPEAN_V_LABEL_VEGAN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.v-label.com/" ;
              gdsn:sourceId "176538" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176539
gdsn:cv176539 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The vegetarian V-Label is an internationally recognised, registered label which can be applied to vegetarian products that do not use animals or parts of animals, but that do derive from living animals." ;
              rdfs:label "EUROPEAN_V_LABEL_VEGETARIAN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.v-label.com/" ;
              gdsn:sourceId "176539" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176541
gdsn:cv176541 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The EWG VERIFIED™ mark, from Environmental Working Group (EWG), helps shoppers in stores and online to quickly and easily identify cosmetics and other personal care products which: avoid EWG's ingredients of concern, provide full transparency, and use good manufacturing practices." ;
              rdfs:label "EWG_VERIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ewg.org/ewgverified/" ;
              gdsn:sourceId "176541" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176542
gdsn:cv176542 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fair Flowers Fair Plants is a label attached to flowers and plants that originate from growers that meet the highest demands related to the environment and personnel, when it comes to issues such as working conditions, hygiene and safety." ;
              rdfs:label "FAIR_FLOWERS_FAIR_PLANTS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.fairflowersfairplants.com" ;
              gdsn:sourceId "176542" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176543
gdsn:cv176543 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Coalition of Immokalee Workers' (CIW) Fair Food Program is a unique partnership among farmers, farmworkers, and retail food companies that ensures humane wages and working conditions for the workers who pick fruits and vegetables on participating farms. It harnesses the power of consumer demand to give farmworkers a voice in the decisions that affect their lives, and to eliminate the longstanding abuses that have plagued agriculture for generations." ;
              rdfs:label "FAIR_FOOD_PROGRAM_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.fairfoodprogram.org" ;
              gdsn:sourceId "176543" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176544
gdsn:cv176544 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fair for Life Social & FairTrade Certification guarantees that human rights are guaranteed at any stage of production, that workers enjoy good and fair working conditions and that smallholder farmers receive a fair share. Fair trade improves the livelihood of thousands of smallholder farmers and workers by providing the means for social community projects and empowerment of people." ;
              rdfs:label "FAIR_FOR_LIFE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://fairforlife.net" ;
              gdsn:sourceId "176544" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176545
gdsn:cv176545 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: Fair’N Green. National - Soil compaction, toxicity analysis included, in addition to waste management, water use, CO2-footprint etc. After the initial analysis by an external consultant, the winery is ready to apply. Certification through third party examination rather than audit (NOT same company as consultant), passing score allows entry." ;
              rdfs:label "FAIR_N_GREEN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.fairandgreen.de/" ;
              gdsn:sourceId "176545" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176546
gdsn:cv176546 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The FAIR TRADE Mark certifies that products meet the social, economic and environmental International Fairtrade Standards. The FAIR TRADE Mark is usually supported by a local Fair Trade Labelling Organisation and certifies products not companies. It does not cover the companies or organizations selling the product." ;
              rdfs:label "FAIR_TRADE_MARK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fairtrade.net/about-fairtrade/the-fairtrade-marks/fairtrade-mark.html" ;
              gdsn:sourceId "176546" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176547
gdsn:cv176547 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fair Trade USA- The Fair Trade certification model is designed and audited to ensure equitable trade practices at every level of the supply chain. To earn a license from Fair Trade USA to use the Fair Trade Certified™ label on their products, companies must buy from certified farms and organizations, pay Fair Trade prices and premiums and submit to a rigorous supply chain audits. This process entails a high level of transparency and traceability in their global supply chains. Today, our partner companies range from small, mission-driven coffee roasters to some of the largest transnational corporations in the world." ;
              rdfs:label "FAIR_TRADE_USA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fairtradecertified.org/ http://fairtradeusa.org/" ;
              gdsn:sourceId "176547" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176548
gdsn:cv176548 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products bearing the Fair Trade Certified Ingredient logo are required to contain 20% or more Fair Trade Certified Ingredients by weight excluding water and salt. Additionally, any individual Fair Trade Certified ingredients used in the product are 100% Fair Trade Certified." ;
              rdfs:label "FAIR_TRADE_USA_INGREDIENTS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://fairtradeusa.org/" ;
              gdsn:sourceId "176548" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176549
gdsn:cv176549 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Fair Trade Sustainability Alliance (FairTSA) is an organization specializing in Fair Trade and social responsibility standard development, ethical supply chain management, and accountable, sustainable community development. We are the only Fair Trade standard holder with an \"open\" certification system, meaning that every certifier who is interested in working with our standard can do so, provided that they comply with our basic requirements. These can be found on the Producers and Licensees pages respectively." ;
              rdfs:label "FAIR_TSA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://fairtsa.org/" ;
              gdsn:sourceId "176549" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176550
gdsn:cv176550 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A scientifically based seal for certified sustainable wine production, from scientists of the DINE e.V. (Deutsches Institut für Nachhaltige Entwicklung e.V.) guarantee: wine, controlled sustainably." ;
              rdfs:label "FAIRCHOICE_GERMANY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fairchoice.info/" ;
              gdsn:sourceId "176550" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176551
gdsn:cv176551 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "These white Marks indicate that the ingredient named on the tab has been sourced as Fairtrade, such as Cashew Nuts used in a package of mixed nuts. (This is different from the black FAIRTRADE Mark, which signifies that all the ingredients that are available as Fairtrade are Fairtrade certified)." ;
              rdfs:label "FAIRTRADE_CASHEW_NUTS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fairtrade.net/about/fairtrade-marks#fsi" ;
              gdsn:sourceId "176551" ;
              gdsn:sourceType "codeValue" .


