###  urn:gs1:std:gdsn:extAttr290
gdsn:extAttr290 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:decimal ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The gross weight (in kilograms) of the pallet load of goods. The Gross weight of the pallet includes the goods weight plus the weight of the pallet itself. Supply at Level: CASE / Dispatch Units" ;
                rdfs:label "palletGrossWeight" ;
                gdsn:example "905" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 8 ;
                gdsn:originalLimit "{4..15}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "290" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "7 x Pallet Details Fields are conditionally required" .


###  urn:gs1:std:gdsn:extAttr291
