###  urn:gs1:std:gdsn:cv176761
gdsn:cv176761 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Seal from Interseroh for environmentally friendly packaging that has been analysed and proven to meet the company’s criteria of recyclability. This includes: recyclable materials, ease of sorting, disposal, etc. The new brand Interzero has been introduced in 2022 and replaces Interseroh. This code will be deprecated in a future release. Use MADE_FOR_RECYCLING_INTERZERO." ;
              rdfs:label "MADE_FOR_RECYCLING_INTERSEROH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.interseroh.de/en/services/consulting/packaging-optimisation/" ;
