                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The chemical formula is PO3−4." ;
              rdfs:label "PHOSPHATE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174235" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174236
