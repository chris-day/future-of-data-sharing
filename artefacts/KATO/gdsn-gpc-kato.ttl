###  urn:gs1:std:gdsn:cv177406
gdsn:cv177406 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Animal print is a clothing and fashion style in which the garment is made to resemble the pattern of the skin and fur of an animal such as a leopard, zebra, tiger, snake, giraffe, alligator, etc." ;
              rdfs:label "ANIMAL_PRINT" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177406" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177407
gdsn:cv177407 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has an architectural pattern. This is the idea of capturing architectural design ideas as archetypal and reusable descriptions." ;
              rdfs:label "ARCHITECTURAL" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177407" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177408
gdsn:cv177408 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a bubble/foam pattern. A soap bubble is an extremely thin film of soapy water enclosing air that forms a hollow sphere with an iridescent surface. Foam is an object formed by trapping pockets of gas in a liquid or solid." ;
              rdfs:label "BUBBLE_FOAM" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177408" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177409
gdsn:cv177409 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a camouflage pattern. Originally used to protect military force personnel and equipment from observation by enemy forces, today also common in fashion." ;
              rdfs:label "CAMOUFLAGE" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177409" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177410
gdsn:cv177410 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The pattern of dense cracking formed on the surface or appearance on the product." ;
              rdfs:label "CRACK" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177410" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177411
gdsn:cv177411 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Floral is a term used to describe something that is relative or related to the flower, that concerns the flower or its characteristics." ;
              rdfs:label "FLORAL" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177411" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177412
gdsn:cv177412 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a gingham pattern: Gingham is woven like Pepita body-bindingly, but with wider body ridges. This creates such wide black-and-white diagonal stripes when white warp and black weft threads collide that the blocks no longer appear clearly delimited, but merge with the adjacent blocks of the same colour into a shape." ;
              rdfs:label "GINGHAM" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177412" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177413
gdsn:cv177413 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a gradient colour. A colour gradient (sometimes called a colour ramp or colour progression) specifies a range of position-dependent colours. Example: Pink transitioning to Dark Red." ;
              rdfs:label "GRADIENT" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177413" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177414
gdsn:cv177414 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a herringbone pattern. An arrangement of rectangles, so named for a fancied resemblance to the bones of a fish such as herring. The blocks can be rectangles or parallelograms." ;
              rdfs:label "HERRINGBONE" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177414" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177415
gdsn:cv177415 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a houndstooth pattern. Created in canvas-binding fabrics, when the chain and the shot each have two thread-wide stripes. The encounter of white warp threads with black weft threads gives the impression of tiny wind turbines." ;
              rdfs:label "HOUNDSTOOTH" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177415" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177416
gdsn:cv177416 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a mottled pattern. Irregular marks, spots, streaks, blotches or patches of different shades or colours." ;
              rdfs:label "MOTTLED" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177416" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177417
gdsn:cv177417 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a pattern but has not been specified in this code list. This code will be used for any new pattern that is not specified." ;
              rdfs:label "OTHER_PATTERN" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177417" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177418
gdsn:cv177418 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a paisley pattern. An abstract, decorative fabric pattern that represents the Persian Boteh pattern. In its basic form, it represents a leaf with a pointed, curved end, in the style of a large comma and recalls the Gothic fish bubble ornament." ;
              rdfs:label "PAISLEY" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177418" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177419
gdsn:cv177419 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a pepita pattern: Created when warp and firing strips of mostly eight threads wide are woven body-bindingly, typically as 2/1 bodies. Those blocks in which white warp threads meet black weft threads appear diagonally striped." ;
              rdfs:label "PEPITA" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177419" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177420
gdsn:cv177420 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a photo printed on its material." ;
              rdfs:label "PHOTO_PRINT" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177420" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177421
gdsn:cv177421 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a pinstripe pattern. Very thin stripes of any colour running in parallel. The colour-highlighted warp threads are incorporated into a base fabric, which appear as fine longitudinal strips." ;
              rdfs:label "PINSTRIPE" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177421" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177422
gdsn:cv177422 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a plaid pattern. Squares and lines known as a sett. The plaid pattern best characterized by horizontal and vertical lines intersecting each other that together form different sizes of squares or checks all throughout the fabric is also known as Tartan or the Scottish plaid." ;
              rdfs:label "PLAID" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177422" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177423
gdsn:cv177423 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a polka dot pattern. Equally large, filled, regularly arranged circles. The dots are not woven, but printed on the fabric, sometimes embroidered." ;
              rdfs:label "POLKA_DOT" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177423" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177424
gdsn:cv177424 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product has a spiral pattern that is a flat curve that describes revolutions around a fixed point (pole) as it moves further and further away from it." ;
              rdfs:label "SPIRAL" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177424" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177425
gdsn:cv177425 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A stripe(s) pattern is a long, narrow band or strip differing in colour or texture from the surface on either side of it." ;
              rdfs:label "STRIPES" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177425" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177426
gdsn:cv177426 rdf:type owl:NamedIndividual ,
                       gdsn:c-1700637751 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "'The product has a symmetrical pattern that has a regular distribution of parts or objects on either side of an axis or around a centre point" ;
              rdfs:label "SYMMETRY" ;
              gdsn:codeListName "PatternCode" ;
              gdsn:sourceId "177426" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177427
gdsn:cv177427 rdf:type owl:NamedIndividual ,
