                       gdsn:c2147348205 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The film may be inappropriate for young children. An example might be the death of a family pet, a complicated family breakdown, or images considered frightening or disturbing for the very young. \"Young Children\" would be persons age 8 and under." ;
              rdfs:label "NRYC" ;
              gdsn:codeListName "RatingContentDescriptorCode(BC)" ;
              gdsn:sourceId "178489" ;
              gdsn:sourceType "codeValue" .


