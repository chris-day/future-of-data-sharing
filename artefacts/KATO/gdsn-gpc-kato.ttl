###  urn:gs1:std:gdsn:cv168514
gdsn:cv168514 rdf:type owl:NamedIndividual ,
                       gdsn:c-778930468 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Product Classification Database contains medical device names and associated information developed by the Center for Devices and Radiological Health (CDRH) in support of its mission. This database contains device names and their associated product codes. The name and product code identify the generic category of a device for FDA. The Product Code assigned to a device is based upon the medical device product classification designated under 21 CFR Parts 862-892." ;
              rdfs:label "43" ;
              gdsn:codeListName "AdditionalTradeItemClassificationCodeListCode" ;
              gdsn:sourceId "168514" ;
              gdsn:sourceType "codeValue" .


