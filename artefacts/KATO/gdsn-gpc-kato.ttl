              rdfs:comment "Indicates the width of a cutting thread/line for example the cutting line of string trimmer." ;
              rdfs:label "THREAD_CUTTING_WIDTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179343" ;
