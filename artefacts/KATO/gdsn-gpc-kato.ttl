gdsn:cv174166 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Propellants commonly used in pharmaceutical aerosols cover both liquefied gases (CFC, hydrocarbons, hydrochlorofluorocarbons (HCFC), and HFC) and compressed gases (nitrogen, nitrous oxide, and carbon dioxide) [1]." ;
