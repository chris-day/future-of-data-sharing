              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a food is very low in specific ingredient/nutrition/etc in the ClaimElementCode Any claim likely to have the same meaning for the consumer, may only be made where the product contains the amount that determines containment or lack of containment is based on target market regulations." ;
              rdfs:label "VERY_LOW" ;
              gdsn:codeListName "ClaimTypeCode" ;
              gdsn:sourceId "174365" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174366
gdsn:cv174366 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348061 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a product is without intentional addition of the substance in the ClaimElementCode. Note the amount that determines containment or lack of containment is based on target market regulations." ;
              rdfs:label "WITHOUT" ;
              gdsn:codeListName "ClaimTypeCode" ;
              gdsn:sourceId "174366" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174367
gdsn:cv174367 rdf:type owl:NamedIndividual ,
                       gdsn:c1339624690 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The USDA Child Nutrition (CN) Labeling Program provides food manufacturers the option to include a standardised food crediting statement on their product label. Labels must be approved by USDA, FNS prior to use and manufacturers must have quality control procedures and inspection oversight that meet the FNS requirements. Products produced in accordance with the CN Labeling Program are generally purchased by foodservice providers for FNS meal programs." ;
              rdfs:label "1" ;
              gdsn:codeListName "NutritionalLabelTypeCode" ;
              gdsn:sourceId "174367" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174368
gdsn:cv174368 rdf:type owl:NamedIndividual ,
                       gdsn:c1339624690 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Trade item packaging contains information pertaining to its nutrition information." ;
              rdfs:label "2" ;
              gdsn:codeListName "NutritionalLabelTypeCode" ;
              gdsn:sourceId "174368" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174369
gdsn:cv174369 rdf:type owl:NamedIndividual ,
                       gdsn:c1339624690 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Trade item packaging does not contains information pertaining to its nutrition information." ;
              rdfs:label "3" ;
              gdsn:codeListName "NutritionalLabelTypeCode" ;
              gdsn:sourceId "174369" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174370
gdsn:cv174370 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "5 a day. A program designed to encourage the consumption of at least five portions of fruit and vegetables per day," ;
              rdfs:label "1" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174370" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174371
gdsn:cv174371 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ChooseMyPlate.gov provides practical information to individuals, health professionals, nutrition educators, and the food industry to help consumers build healthier diets with resources and tools for dietary assessment, nutrition education, and other user-friendly nutrition information. - See more at: http://www.choosemyplate.gov." ;
              rdfs:label "2" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174371" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174372
gdsn:cv174372 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Dietary Guidelines for Americans encourages individuals to eat a healthful diet — one that focuses on foods and beverages that help achieve and maintain a healthy weight, promote health, and prevent chronic disease. The U.S. Department of Health and Human Services (HHS) and the U.S. Department of Agriculture (USDA) jointly publish the Dietary Guidelines every 5 years. www.health.gov/DietaryGuidelines/." ;
              rdfs:label "3" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174372" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174373
gdsn:cv174373 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fruits & Veggies-More Matters is a health initiative focused on helping Americans increase fruit & vegetable consumption for better health. http://www.fruitsandveggiesmorematters.org/." ;
              rdfs:label "4" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174373" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174374
gdsn:cv174374 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Consuming 3-Every-Day® of Dairy – three daily servings of milk, cheese, or yogurt – is an easy way for families to get a powerful punch of nutrients to help build stronger bones and healthy bodies and reduce the risk of osteoporosis. In addition, a growing body of research suggests that enjoying three servings of dairy foods a day as part of a nutrient-rich, balanced diet may help maintain a healthy weight. www.nationaldairycouncil.org" ;
              rdfs:label "5" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174374" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174375
gdsn:cv174375 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "If you have diabetes, it’s essential to have a road map for your diet. This road map is a meal plan, and you can either create it by yourself or enlist the help of a registered nutritionist, dietitian or certified diabetes educator. The goal of a meal plan exchange lists is to help control your blood sugar and lose weight by balancing the type and amount of food you eat. Diabetics should follow a diet low in carbohydrates, fat and calories. Exchange lists, which were created by the American Dietetic Association and the American Diabetes Association as a meal planning guide primarily for diabetics, are based on principles of good nutrition that apply to everyone. The foods within each group have similar amounts of calories, carbs, fats, and proteins, which allows for greater flexibility in choosing foods." ;
              rdfs:label "6" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174375" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174376
gdsn:cv174376 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item meets criteria set forth by Weight Watchers (https://welcome.weightwatchers.com/) and is eligible for their weight management program." ;
              rdfs:label "7" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174376" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174377
gdsn:cv174377 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Nutri-Score was created by the French Health Ministry in order to introduce an independent measure of the nutritional quality of food products. The score itself is calculated based on the nutritional data and ingredients, and is displayed as a colored logo (green to red) and letters (A to E)." ;
              rdfs:label "8" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174377" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174378
gdsn:cv174378 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Smart Snacks was established to help students get the nutrition they need to grow and learn during the school day. Any food or beverage sold to students at schools during the school day, other than those foods provided as part of the school meal program, must meet Smart Snack criteria as defined by the USDA Guide to Smart Snacks in Schools - https://fns-prod.azureedge.net/sites/default/files/resource-files/USDASmartSnacks_508_62019.pdf" ;
              rdfs:label "9" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174378" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174379
gdsn:cv174379 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Health Star Rating is a front-of-pack labelling system that rates the overall nutritional profile of packaged food and assigns it a rating from ½ a star to 5 stars. It provides a quick, easy, standard way to compare similar packaged foods. The more stars, the healthier the choice. (http://healthstarrating.gov.au)" ;
              rdfs:label "10" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174379" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174380
gdsn:cv174380 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Atkins 20 is a low carbohydrate-keto diet which is split into four phases of carbohydrate control." ;
              rdfs:label "ATKINS_20" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174380" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174381
gdsn:cv174381 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Atkins 40 is a low carb diet plan based on portion control and eating 40 grams net carbs per day." ;
              rdfs:label "ATKINS_40" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174381" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174382
gdsn:cv174382 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Atkins 100 is a low carb plan based on portion control and eating 100 grams of net carbs per day." ;
              rdfs:label "ATKINS_100" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174382" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174383
gdsn:cv174383 rdf:type owl:NamedIndividual ,
                       gdsn:c-1330075727 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The UK government program to reduce childhood obesity includes restrictions in the promotion of food and drink products classified as high in fat, sugar or salt (HFSS) under the UK Department of Health 2004 nutritional profile model. The intent is that the industry will use the nutritional profile model to calculate the score and convey the numeric result." ;
              rdfs:label "HFSS" ;
              gdsn:codeListName "NutritionalProgramCode" ;
              gdsn:sourceId "174383" ;
              gdsn:sourceType "codeValue" .


