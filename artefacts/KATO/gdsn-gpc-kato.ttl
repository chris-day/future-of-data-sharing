              rdfs:comment "Synthetic chemicals added to liquid and powder laundry detergents to make clothing appear whiter and brighter, and thus cleaner." ;
              rdfs:label "OPTICAL_BRIGHTENERS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174217" ;
