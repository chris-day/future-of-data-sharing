              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to half of an animal." ;
              rdfs:label "HALF" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181109" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181110
gdsn:cv181110 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the back half of an animal's carcass, specifically the rear portion of the body. It includes the hind legs or limbs, hip, and associated cuts of meat." ;
              rdfs:label "HINDQUARTER" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181110" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181111
gdsn:cv181111 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific type of meat cut that involves slicing the meat parallel to its natural grain or muscle fibers. This results in longer, more elongated pieces of meat." ;
              rdfs:label "LONG_LONG_CUT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181111" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181112
gdsn:cv181112 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the portion of meat from the animal's body located between the head and the shoulders." ;
              rdfs:label "NECK" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181112" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181113
gdsn:cv181113 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cut into slices." ;
              rdfs:label "SLICED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181113" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181114
gdsn:cv181114 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to poultry meat that has been removed or separated from the bone, skin, or other connective tissues. This process of removing the meat from the bones and other parts is commonly referred to as \"deboning\" or \"stripping\" the poultry." ;
              rdfs:label "STRIPPED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181114" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181115
gdsn:cv181115 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of poultry meat known for its tenderness and are located on the underside of the chicken breast. These tenderloins are thin, long strips of meat that run parallel to the breastbone. Poultry tenders are distinct from the rest of the breast meat as they are not connected to the breastbone and do not have any tough connective tissues or bones." ;
              rdfs:label "TENDERLOINS" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181115" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181116
gdsn:cv181116 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the male reproductive organs of animals. In some culinary traditions and cultures, testicles are considered a type of offal or \"variety meat\" and are consumed as food. They are often referred to by specific names based on the animal they come from." ;
              rdfs:label "TESTICLES_TESTES" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181116" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181117
gdsn:cv181117 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the lower part of the bird's leg, specifically the upper portion of the leg that is closer to the body." ;
              rdfs:label "THIGH" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181117" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181118
gdsn:cv181118 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the upper part of the wing, closest to the bird's body. It is meatier and resembles a small drumstick." ;
              rdfs:label "WING_DRUMMETTE" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181118" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181119
gdsn:cv181119 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the middle portion of the wing. It contains two bones and is flatter in shape. Also known as the mid-wing, wingette or flat." ;
              rdfs:label "WING_FLAT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181119" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181120
gdsn:cv181120 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the section located closer to the neck and is generally considered part of the poultry's breast. The upper back is often referred to as the back half of the breast." ;
              rdfs:label "BACK_UPPER" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181120" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181121
gdsn:cv181121 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the bone(s) with or without the meat." ;
              rdfs:label "BONE_OR_BONE_IN" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181121" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181122
gdsn:cv181122 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a type of poultry meat preparation where some bones have been removed, leaving only certain bone-in portions intact. In this context, \"partial\" indicates that not all bones have been taken out, and the meat still retains some of its natural bone structure. Each cut may vary in the bones removed." ;
              rdfs:label "BONELESS_PARTIAL" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181122" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181123
gdsn:cv181123 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a thin, boneless piece of meat that is sometimes breaded and/or fried. The meat used for cutlets can come from various sources." ;
              rdfs:label "CUTLET" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181123" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181124
gdsn:cv181124 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat from certain parts of the bird that is darker in colour compared to white meat. Dark meat is found in areas of the bird that are more active and used for sustained movement, such as walking or flying." ;
              rdfs:label "DARK_MEAT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181124" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181125
gdsn:cv181125 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the lower portion of the bird's leg, specifically the part between the knee joint and the ankle joint." ;
              rdfs:label "DRUMSTICK" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181125" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181126
gdsn:cv181126 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to making small cuts or slits in the flesh of the drumstick." ;
              rdfs:label "DRUMSTICK_INCISION" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181126" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181127
gdsn:cv181127 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat found along the ribs of a bird. The rib meat is located on the underside of the bird's body, where the ribs are attached to the breast meat." ;
              rdfs:label "RIB_MEAT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181127" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181128
gdsn:cv181128 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the removal of the meat found along the ribs of a bird. The rib meat is located on the underside of the bird's body, where the ribs are attached to the breast meat." ;
              rdfs:label "RIB_MEAT_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181128" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181129
gdsn:cv181129 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refer to the bones and meat found along the ribcage of a bird. While poultry ribs are smaller and more delicate compared to traditional pork or beef ribs, they still offer a flavorful and tender eating experience. The ribcage of a bird contains a combination of bones, cartilage, and intercostal muscles that contribute to the rib meat." ;
              rdfs:label "RIBS" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181129" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181130
gdsn:cv181130 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific type of meat cut that involves slicing the meat perpendicular to its grain, resulting in shorter and more compact pieces." ;
              rdfs:label "SHORT_SHORT_CUT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181130" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181131
gdsn:cv181131 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The animal with tail removed / without tail." ;
              rdfs:label "TAIL_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181131" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181132
gdsn:cv181132 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The animal with its tail on / with its tail." ;
              rdfs:label "TAIL_ON" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181132" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181133
gdsn:cv181133 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the fat deposits found in the abdominal cavity of poultry birds raised for meat production. This type of fat is distinct from subcutaneous fat, which is found directly under the skin, as it accumulates within the abdominal cavity surrounding the internal organs. Also known as abdominal fat pad or abdominal adipose tissue." ;
              rdfs:label "ABDOMINAL_FAT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181133" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181134
gdsn:cv181134 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a description of a collection or group of various different items or things that are mixed together. It is often used to refer to a selection of different types or varieties of something, typically presented as a single package or set." ;
              rdfs:label "ASSORTED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181134" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181135
gdsn:cv181135 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific preparation of poultry meat where the back portion has been removed from the bird before further processing or cooking. This process is commonly done to create specific cuts or to modify the bird's shape for various culinary purposes." ;
              rdfs:label "BACK_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181135" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181136
gdsn:cv181136 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the organ that is a part of the central nervous system found in the heads of animals. In culinary terms, \"brain\" specifically refers to the brain of certain animals, usually those that are commonly consumed for food." ;
              rdfs:label "BRAIN" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181136" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181137
gdsn:cv181137 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of poultry meat where the breast section of the bird is split into two halves, creating two separate pieces." ;
              rdfs:label "BREAST_SPLIT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181137" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181138
gdsn:cv181138 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific method of preparing poultry by removing the backbone and flattening the bird to create a more even thickness. This technique involves cutting along the backbone and then spreading the bird open like a book, resulting in a butterfly-like appearance. also known as spatchcocking or butterflying." ;
              rdfs:label "BUTTERFLY_CUT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181138" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181139
gdsn:cv181139 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a distinctive tuft or fleshy protuberance of feathers found on the top of the bird's head." ;
              rdfs:label "CREST" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181139" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181140
gdsn:cv181140 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of removing the fat from meat. Fat is adipose tissue found in and around various cuts of meat. Additionally, there is also external fat, often referred to as \"trimmable fat\" or \"fat cap,\" which is found on the surface of certain cuts of meat." ;
              rdfs:label "REMOVED_FAT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181140" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181141
gdsn:cv181141 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a set of internal organs commonly found in birds raised for meat consumption.The typical poultry giblets include liver, heart, gizzard, and/or neck." ;
              rdfs:label "GIBLET" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181141" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181142
gdsn:cv181142 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the removal of a set of internal organs commonly found in birds raised for meat consumption.The typical poultry giblets include liver, heart, gizzard, and/or neck." ;
              rdfs:label "GIBLETS_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181142" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181143
gdsn:cv181143 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the entire head of an animal. The head contains various parts, including the skull, brain, eyes, ears, snout, tongue, and sometimes the cheeks and jowls. Different cultures have varying culinary traditions and uses for the head of the animal." ;
              rdfs:label "HEAD" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181143" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181144
gdsn:cv181144 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the muscular organ that pumps blood throughout the circulatory system of an animal. The heart is a vital organ and an edible part of the animal that is used for culinary purposes in various cuisines around the world." ;
              rdfs:label "HEART" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181144" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181145
gdsn:cv181145 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the organ found in the abdominal cavity that are part of the animal's urinary system and play a crucial role in filtering waste products and excess water from the blood to produce urine. Animal kidneys are also considered a type of offal or organ meat, and they have been a part of traditional diets in many cultures for centuries." ;
              rdfs:label "KIDNEY" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181145" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181146
gdsn:cv181146 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the entire leg of a bird, which includes both the drumstick and the thigh in one piece. This cut is not separated at the joint, and the leg remains intact, preserving the natural connection between the thigh and the drumstick." ;
              rdfs:label "LEG_WHOLE" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181146" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181147
gdsn:cv181147 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a combination of different cuts of meat and pieces obtained from an animal during the butchering process." ;
              rdfs:label "MIXED_PARTS" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181147" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181148
gdsn:cv181148 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of poultry that includes half of the bird's neck. A poultry neck half is obtained by cutting the neck in half lengthwise, dividing it into two roughly equal parts. Each half of the neck includes both the bone and the meat." ;
              rdfs:label "NECK_HALF" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181148" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181149
gdsn:cv181149 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of poultry meat where the rib bones have been removed from the bird, leaving the rib meat without the bones. This is a preparation method commonly used to create boneless poultry meat cuts." ;
              rdfs:label "RIBS_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181149" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181150
gdsn:cv181150 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The animal with its skin on / with skin on." ;
              rdfs:label "SKIN_ON" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181150" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181151
gdsn:cv181151 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of cutting the meat at a between 15 to 30 degree angle." ;
              rdfs:label "SLANT_CUT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181151" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181152
gdsn:cv181152 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the removal of the tenderloins. The tenderloins are thin, long strips of meat that run parallel to the breastbone. Poultry tenders are distinct from the rest of the breast meat as they are not connected to the breastbone and do not have any tough connective tissues or bones." ;
              rdfs:label "TENDERLOINS_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181152" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181153
gdsn:cv181153 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the protruding portion of the tendon is removed." ;
              rdfs:label "TENDON_CLIPPED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181153" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181154
gdsn:cv181154 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the tough, fibrous connective tissues that connect muscles to bones in an animal's body." ;
              rdfs:label "TENDONS" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181154" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181155
gdsn:cv181155 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of removing excess fat, connective tissue, and any undesirable or inedible portions from a meat cut. When a cut of meat is \"trimmed,\" it is prepared to have a more uniform appearance, improve its presentation, and enhance its cooking qualities." ;
              rdfs:label "TRIMMED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181155" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181156
gdsn:cv181156 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the animal as a whole." ;
              rdfs:label "WHOLE" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181156" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181157
gdsn:cv181157 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of the bird's wing, which has been divided into two distinct joints. The tip is usually removed, and the wing is separated into two sections: the drumette and the wingette (mid-wing). The two joints created by this cut are the connection points between the drumette and the wingette." ;
              rdfs:label "WING_2_JOINT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181157" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181158
gdsn:cv181158 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to less common or unconventional ways of portioning the bird. These cuts are not typically found in standard culinary practices but can offer unique and creative ways to use different parts of the bird. Examples: Oyster, Cushion, Roulade, etc." ;
              rdfs:label "NON_TRADITIONAL" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181158" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181159
gdsn:cv181159 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the section of the bird's body located between the neck and the tail. This area includes the backbone, ribs, and surrounding meat." ;
              rdfs:label "BACK_PORTION" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181159" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181160
gdsn:cv181160 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the entire back portion of a bird, including the backbone, ribs, and surrounding meat, remains intact without any specific preparation or removal. This would typically include the upper back (closer to the neck) and the lower back (towards the tail)." ;
              rdfs:label "BACK_WHOLE" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181160" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181161
gdsn:cv181161 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of poultry that comes from the underside or abdominal area of an animal." ;
              rdfs:label "BELLY" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181161" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181162
gdsn:cv181162 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of slaughtering an animal, some blood can be collected for various purposes, such as further processing into blood-based products or used in specific culinary applications." ;
              rdfs:label "BLOOD" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181162" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181163
gdsn:cv181163 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the entire breast portion of a bird that includes both the left and right sides, with bones and skin intact. Also known as a full breast." ;
              rdfs:label "BREAST_WHOLE" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181163" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181164
gdsn:cv181164 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the edible flesh or muscle tissue obtained from the body of an animal after it has been slaughtered and processed for consumption. When an animal is slaughtered, the body is typically referred to as a carcass until it is broken down into different cuts of meat." ;
              rdfs:label "CARCASS" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181164" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181165
gdsn:cv181165 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refer to the edible parts of an animal's limbs, particularly the feet or hooves. The feet from various animals, can be consumed in certain cuisines and culinary traditions around the world." ;
              rdfs:label "FEET" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181165" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181166
gdsn:cv181166 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the front portion of an animal's carcass, specifically the front half of the body. It includes the front legs or limbs, shoulder, and associated cuts of meat." ;
              rdfs:label "FOREQUARTER" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181166" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181167
gdsn:cv181167 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the small intestines of birds raised for meat consumption. Like other animals, poultry have a digestive system that includes a long tube-like structure called the intestines, responsible for the absorption of nutrients from their food. also known as chitterlings or chitlins." ;
              rdfs:label "INTESTINES_CHITTERLINGS" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181167" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181168
gdsn:cv181168 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of poultry that includes both the leg and thigh portions of the bird." ;
              rdfs:label "LEG_QUARTER" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181168" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181169
gdsn:cv181169 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the large organ found in the abdominal cavity of animals, including livestock and game animals. The liver is responsible for performing essential functions such as filtering and detoxifying blood, producing bile to aid in digestion, storing certain nutrients, and metabolizing various substances in the body. the liver is considered an organ meat or offal, and it is highly valued for its nutritional richness and distinct flavour." ;
              rdfs:label "LIVER" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181169" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181170
gdsn:cv181170 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The value needed is not listed or is not defined within this list’s individual code values and definitions. Please send a work request into GS1 or your solution provider requesting the code you are searching for." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181170" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181171
gdsn:cv181171 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion or cut of poultry meat, such as a chicken breast or turkey thigh." ;
              rdfs:label "PART_PIECE" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181171" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181172
gdsn:cv181172 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific preparation method where a whole bird is cut into four quarters by dividing it into four parts. Each quarter typically consists of a combination of the leg and thigh on one side and the wing and breast on the other side of the bird." ;
              rdfs:label "QUARTERED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181172" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181173
gdsn:cv181173 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat removed from the scapula bone (shoulder blade)." ;
              rdfs:label "SCAPULA_MEAT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181173" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181174
gdsn:cv181174 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific request or custom preparation of meat made by a customer or chef to meet their specific requirements or preferences. It involves trimming or cutting the meat in a particular way that differs from the standard or conventional cuts typically offered by the butcher." ;
              rdfs:label "SPECIAL_TRIM" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181174" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181175
gdsn:cv181175 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cutting technique used to prepare meat or poultry. When a piece of meat is square cut, it means that the butcher has made straight, even cuts across the meat, resulting in a block-like or square shape." ;
              rdfs:label "SQUARE_CUT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181175" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181176
gdsn:cv181176 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the organ that forms a part of the digestive system of animals. The stomach is responsible for breaking down and digesting food through the action of digestive juices and acids. In certain culinary traditions and cultures, the stomach is considered an edible part and used in various dishes." ;
              rdfs:label "STOMACH" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181176" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181177
gdsn:cv181177 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to poultry meat from which the tendons or tough connective tissues have been removed. Tendons are fibrous tissues that connect muscles to bones, and they can be tough and chewy when not properly cooked or removed." ;
              rdfs:label "TENDON_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181177" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181178
gdsn:cv181178 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to poultry meat from which some, but not all, of the tendons or tough connective tissues have been removed. In this case, the meat may still contain some small pieces of tendon or connective tissue that have not been fully trimmed away." ;
              rdfs:label "TENDON_PARTIALLY_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181178" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181179
gdsn:cv181179 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the leftover pieces, scraps, or excess parts of poultry that are removed during the butchering and processing of the bird. These trimmings can include various parts, such as skin, fat, small bits of meat, connective tissues, bones, and other offcuts." ;
              rdfs:label "TRIMMINGS" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181179" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181180
gdsn:cv181180 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of dislocating the joint between the wingette and drumette, so that the two portions form an upright \"V\" shape." ;
              rdfs:label "V_WING" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181180" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181181
gdsn:cv181181 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the lighter-coloured meat found in birds. It is typically located in the breast and wing portions of the bird. The primary difference between white meat and dark meat in poultry is the muscle type and function in the bird. White meat comes from fast-twitch muscles, which are used for short bursts of activity and are less active." ;
              rdfs:label "WHITE_MEAT" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181181" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181182
gdsn:cv181182 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the pointed end of the wing. It is mostly skin and cartilage and has little meat. Also know as the flapper." ;
              rdfs:label "WING_TIP" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181182" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181183
gdsn:cv181183 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific part of the bird's anatomy. The wings are located on the upper part of the bird's body, and they are essential for flight in wild birds." ;
              rdfs:label "WING_WHOLE" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181183" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181184
gdsn:cv181184 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of removal of the wings. The wings are located on the upper part of the bird's body, and they are essential for flight in wild birds." ;
              rdfs:label "WINGS_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181184" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181185
gdsn:cv181185 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348331 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the standard methods of dividing a whole bird into smaller, more manageable pieces for cooking or serving." ;
              rdfs:label "TRADITIONAL" ;
              gdsn:codeListName "AnimalCutCode(Poultry)" ;
              gdsn:sourceId "181185" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181186
gdsn:cv181186 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to meat cut in 3 sections. Please refer to the animal to determine the exact parts that are cut." ;
              rdfs:label "3_WAY_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181186" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181187
gdsn:cv181187 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a description of a collection or group of various different items or things that are mixed together. It is often used to refer to a selection of different types or varieties of something, typically presented as a single package or set." ;
              rdfs:label "ASSORTED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181187" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181188
gdsn:cv181188 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a meat cut named Banjo Cut and is named due to its oval shape after removal of the scapular and ribs from the square cut shoulder." ;
              rdfs:label "BANJO_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181188" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181189
gdsn:cv181189 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the related cartilage, and overlying muscles (in their entirety) and fat shall be removed." ;
              rdfs:label "BLADE_BONE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181189" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181190
gdsn:cv181190 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of slaughtering an animal, some blood can be collected for various purposes, such as further processing into blood-based products or used in specific culinary applications." ;
              rdfs:label "BLOOD" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181190" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181191
gdsn:cv181191 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific meat cut taken from the shoulder region of a beef carcass. More specifically, it is the triangular-shaped cut located between the blade bone and the neck bone." ;
              rdfs:label "BOLAR" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181191" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181192
gdsn:cv181192 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific meat cut taken from the upper shoulder or the rear end of an animal, such as a pig (pork butt) or a cattle (beef butt). It is also known as \"pork shoulder\" or \"pork butt\" when sourced from a pig and \"beef shoulder\" or \"beef butt\" when sourced from cattle." ;
              rdfs:label "BUTT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181192" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181193
gdsn:cv181193 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat cut still has a layer of fat (the \"cap\") covering one side of the meat." ;
              rdfs:label "CAP_ON" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181193" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181194
gdsn:cv181194 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat cut has been trimmed to remove the layer of fat covering one side of the meat." ;
              rdfs:label "CAP_OFF" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181194" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181195
gdsn:cv181195 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the edible flesh or muscle tissue obtained from the body of an animal after it has been slaughtered and processed for consumption. When an animal is slaughtered, the body is typically referred to as a carcass until it is broken down into different cuts of meat." ;
              rdfs:label "CARCASS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181195" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181196
gdsn:cv181196 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific section or portion of meat that is obtained from one side of an animal's carcass after it has been divided lengthwise." ;
              rdfs:label "CARCASS_SIDE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181196" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181197
gdsn:cv181197 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the preparation from a full carcass, that the leg folded or placed into the chest cavity, a cut is made horizontally across the dorsal edge of the carcass at the junction of the 6th lumbar and 1st sacral vertebrae breaking the spine sufficiently to allow the legs to fold into the cavity of the carcass." ;
              rdfs:label "CARCASS_TELESCOPED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181197" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181198
gdsn:cv181198 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut that comes from the hindquarters of the animal, specifically the lower back and rump area. The chump is also sometimes called \"chump chop\" or \"chump end\"." ;
              rdfs:label "CHUMP" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181198" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181199
gdsn:cv181199 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the removal of the Chump by a cut at right angles across the leg at a specified measured distance from the acetabulum." ;
              rdfs:label "CHUMP_OFF" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181199" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181200
gdsn:cv181200 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a large, dome-shaped muscle that separates the chest cavity (thoracic cavity) from the abdominal cavity in mammals." ;
              rdfs:label "DIAPHRAGM" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181200" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181201
gdsn:cv181201 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a muscular tube that connects the mouth to the stomach. Its primary function is to transport food from the mouth to the stomach through rhythmic contractions known as peristalsis." ;
              rdfs:label "ESOPHAGUS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181201" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181202
gdsn:cv181202 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion of meat obtained from the round primal section. The round primal is located on the rear leg of the animal and is known for being one of the leaner and less tender parts of the carcass. The \"round eye\" specifically comes from the round roast, which is a large, boneless cut that includes the eye of round muscle. The eye of round is a small, elongated, and somewhat cylindrical muscle located within the round roast." ;
              rdfs:label "EYE_OF_ROUND" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181202" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181203
gdsn:cv181203 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion of meat obtained from the short loin section. It is also commonly known as the \"eye of the short loin.\"" ;
              rdfs:label "EYE_OF_SHORTLOIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181203" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181204
gdsn:cv181204 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refer to the edible parts of an animal's limbs, particularly the feet or hooves. The feet from various animals, can be consumed in certain cuisines and culinary traditions around the world." ;
              rdfs:label "FEET" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181204" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181205
gdsn:cv181205 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the flat iron steak which is obtained from the chuck primal section of the carcass, specifically from the top blade muscle. It is a rectangular-shaped, well-marbled cut that sits between the shoulder blade and the ribs." ;
              rdfs:label "FLAT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181205" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181206
gdsn:cv181206 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a long, flat, and somewhat V-shaped muscle that hangs between the last rib and the loin of the animal. It is located in the plate primal section of the carcass, specifically near the diaphragm. Also known as hanger steak, onglet, butcher's steak." ;
              rdfs:label "HANGING_TENDER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181206" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181207
gdsn:cv181207 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the pointed, hard, and often curved structures that grow from the heads of certain animals." ;
              rdfs:label "HORN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181207" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181208
gdsn:cv181208 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the large intestine of an animal, which is a part of the digestive system responsible for absorbing nutrients and water from the ingested food. The large intestine is also known as the colon. In certain culinary traditions, large intestines from certain animals are cleaned thoroughly and prepared as a specialty ingredient in various dishes. In culinary dishes known as chitlins, chitterlings, sausage casing, etc." ;
              rdfs:label "INTESTINE_LARGE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181208" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181209
gdsn:cv181209 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the large intestine of an animal, which is a part of the digestive system responsible for absorbing nutrients and water from the ingested food. The large intestine is also known as the colon. In certain culinary traditions, large intestines from certain animals are cleaned thoroughly and prepared as a specialty ingredient in various dishes. In culinary dishes known as tripe, sausage casing, etc." ;
              rdfs:label "INTESTINE_SMALL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181209" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181210
gdsn:cv181210 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat that comes from the joint at the end of an animal's leg, particularly in larger animals. The knuckle is located at the lower end of the leg, where it connects to the animal's hoof. It is a part of the round primal cut, which is the rear leg of the animal. Also known as the knuckle bone or round knuckle." ;
              rdfs:label "KNUCKLE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181210" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181211
gdsn:cv181211 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the soft, fleshy, and often fatty tissues that surround the mouth of certain animals, particularly livestock and game animals." ;
              rdfs:label "LIPS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181211" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181212
gdsn:cv181212 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the large organ found in the abdominal cavity of animals, including livestock and game animals. The liver is responsible for performing essential functions such as filtering and detoxifying blood, producing bile to aid in digestion, storing certain nutrients, and metabolizing various substances in the body. the liver is considered an organ meat or offal, and it is highly valued for its nutritional richness and distinct flavour." ;
              rdfs:label "LIVER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181212" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181213
gdsn:cv181213 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of beef that is also known by several other names, such as Chuck Fillet Steak, Chuck Eye Steak, or Scotch Tender. This cut comes from the chuck primal, which is located in the shoulder region of the animal." ;
              rdfs:label "MOCK_TENDER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181213" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181214
gdsn:cv181214 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the portion of meat from the animal's body located between the head and the shoulders." ;
              rdfs:label "NECK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181214" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181215
gdsn:cv181215 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion of meat found in certain animals, particularly in beef and lamb. The term \"oyster\" is commonly used for this cut due to its shape and location, which bears a resemblance to an oyster shell." ;
              rdfs:label "OYSTER_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181215" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181216
gdsn:cv181216 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The animal with tail removed / without tail." ;
              rdfs:label "TAIL_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181216" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181217
gdsn:cv181217 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific section of meat that includes a portion of the animal's rib bones. This cut is typically obtained from the rib primal or rib section of the animal." ;
              rdfs:label "RIB_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181217" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181218
gdsn:cv181218 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat that includes both ribs and meat from the lower belly of an animal. The rib plate cut is obtained from the rib section of the animal, and it typically extends downward to include some portions of the belly or \"plate\" area." ;
              rdfs:label "RIB_PLATE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181218" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181219
gdsn:cv181219 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a meat cut that is a premium and highly prized cut of meat that comes from the rib primal section of the animal, specifically the ribeye area. Also known as ribeye roll, rack eye, eye of rib, cube roll or scotch fillet." ;
              rdfs:label "RIBEYE_CUBE_ROLL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181219" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181220
gdsn:cv181220 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific section of an animal's skeletal structure that includes the bones and meat extending from the spine or backbone. Ribs are commonly obtained from various animals." ;
              rdfs:label "RIBS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181220" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181221
gdsn:cv181221 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of ribs obtained from the upper part of the animal's ribcage." ;
              rdfs:label "RIBS_BACK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181221" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181222
gdsn:cv181222 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The roundcut comes from the animal's hind legs, thigh, butt, and hams." ;
              rdfs:label "ROUND" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181222" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181223
gdsn:cv181223 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cutting technique where the shank or leg bone is removed from a cut of meat or a joint. This technique is commonly used to create boneless cuts from portions that originally included the leg bone." ;
              rdfs:label "SHANK_OFF" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181223" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181224
gdsn:cv181224 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific section of meat obtained from the back of an animal, The shortloin is located in the upper part of the animal's back, just behind the rib section and before the sirloin." ;
              rdfs:label "SHORTLOIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181224" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181225
gdsn:cv181225 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific section of the pork shoulder cut known as the \"Boston butt.\" The \"upper half\" of the Boston butt refers to a portion of the whole pork shoulder. The pork shoulder is typically divided into two parts: the upper half and the lower half. The upper half of the Boston butt contains more fat and marbling compared to the lower half." ;
              rdfs:label "SHOULDER_BOSTON_BUTT_UPPER_HALF" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181225" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181226
gdsn:cv181226 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat cut that comes from the rear of the animal, specifically from the area along the back between the short loin and the round." ;
              rdfs:label "SIRLOIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181226" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181227
gdsn:cv181227 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The animal with its skin on / with skin on." ;
              rdfs:label "SKIN_ON" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181227" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181228
gdsn:cv181228 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to meat trimmed from the ribs, rolled, and used for short steaks or for a roast." ;
              rdfs:label "SPENCER_ROLL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181228" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181229
gdsn:cv181229 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "refers to a specific cut or trimming technique used for spare ribs. St. Louis style ribs are spare ribs that have been trimmed to remove the brisket bone and rib tips. The brisket bone is removed to create a rectangular and more uniform rack of ribs." ;
              rdfs:label "ST_LOUIS_STYLE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181229" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181230
gdsn:cv181230 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the organ that forms a part of the digestive system of animals. The stomach is responsible for breaking down and digesting food through the action of digestive juices and acids. In certain culinary traditions and cultures, the stomach is considered an edible part and used in various dishes." ;
              rdfs:label "STOMACH" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181230" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181231
gdsn:cv181231 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the measurement or thinness of a meat cut. When the term refers to a cut of meat as \"thin,\" it means that the cut has been sliced or portioned to be thinner and have less depth than thicker cuts." ;
              rdfs:label "THIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181231" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181232
gdsn:cv181232 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a glandular organ found in the throat or neck region of animals. In culinary terms, the thymus is considered a type of offal or variety meat. It is also known as sweetbread in some regions." ;
              rdfs:label "THYMUS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181232" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181233
gdsn:cv181233 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to describe a specific portion or end of a meat cut. Depending on the meat cut, the tip may represent different meanings." ;
              rdfs:label "TIP" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181233" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181234
gdsn:cv181234 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific part of the brisket. The navel plate is also known as the \"navel end\" or the \"belly end\" of the brisket. The brisket navel plate is the thinner, more pointy end of the brisket that tapers down towards the belly of the animal. It is located opposite to the thicker and more rectangular flat cut of the brisket." ;
              rdfs:label "BRISKET_NAVEL_PLATE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181234" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181235
gdsn:cv181235 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a major muscle in the beef rib and loin; lamb rack and loin; and the pork loin. It is the longest and largest muscle in the back and is exposed when a carcass is ribbed. Also know as Longissimus dorsi, loineye." ;
              rdfs:label "EYE_OF_LOIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181235" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181236
gdsn:cv181236 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion of meat obtained from the rump or hindquarters of an animal, particularly from beef or lamb." ;
              rdfs:label "EYE_OF_RUMP" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181236" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181237
gdsn:cv181237 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat from the cheek and jaw region of an animal. For pigs is also known as pork jowl or jowl bacon." ;
              rdfs:label "JOWL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181237" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181238
gdsn:cv181238 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat that includes a portion of the animal's rib bones, usually from the rib section or rib primal." ;
              rdfs:label "RACK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181238" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181239
gdsn:cv181239 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat has had the aitch-bone removed. Aitch bone is a cut of meat lying over the aitchbone" ;
              rdfs:label "AITCH_BONE_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181239" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181240
gdsn:cv181240 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat that comes from the hindquarters of an animal. The rump is located at the rear part of the animal, above the hind legs and just behind the loin." ;
              rdfs:label "RUMP" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181240" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181241
gdsn:cv181241 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific and prestigious cut of meat that includes the back and loin sections of an animal." ;
              rdfs:label "SADDLE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181241" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181242
gdsn:cv181242 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cutting and preparation technique where the shank or leg bone is intentionally left attached to a cut of meat or a joint. This means that the meat portion includes the leg bone, typically from the lower leg of the animal." ;
              rdfs:label "SHANK_ON" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181242" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181243
gdsn:cv181243 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific section of meat obtained from the upper part of an animal's front legs." ;
              rdfs:label "SHOULDER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181243" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181244
gdsn:cv181244 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the edible lining of the stomach of animals. Tripe is considered a type of offal or variety meat and is consumed in various culinary traditions around the world." ;
              rdfs:label "TRIPE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181244" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181245
gdsn:cv181245 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the animal as a whole." ;
              rdfs:label "WHOLE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181245" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181246
gdsn:cv181246 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to meat cut in 5 sections. Please refer to the animal to determine the exact parts that are cut." ;
              rdfs:label "5_WAY_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181246" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181247
gdsn:cv181247 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a large piece of meat, such as a primal or subprimal cut, before further processing into individual retail cuts." ;
              rdfs:label "BLOCK_READY" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181247" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181248
gdsn:cv181248 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the bone(s) with or without the meat." ;
              rdfs:label "BONES" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181248" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181249
gdsn:cv181249 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific meat cut taken from the front chest area of an animal." ;
              rdfs:label "BREAST" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181249" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181250
gdsn:cv181250 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific part of the beef brisket. The brisket point is also known as the \"point cut\" or simply \"point.\" The brisket point is the thicker, more heavily marbled, and triangular-shaped portion of the brisket. It is located on the opposite end of the brisket from the flat cut." ;
              rdfs:label "BRISKET_POINT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181250" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181251
gdsn:cv181251 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the breastbone, which is a bone located in the center of the chest of animals." ;
              rdfs:label "STERNUM" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181251" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181252
gdsn:cv181252 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion or section of meat that is obtained from the centre or middle of a larger piece, often a roast or a larger primal cut." ;
              rdfs:label "CENTRE_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181252" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181253
gdsn:cv181253 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion or piece of meat that is cut perpendicular to the backbone of an animal and includes a rib or bone-in portion." ;
              rdfs:label "CHOP" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181253" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181254
gdsn:cv181254 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the leg prepared from a side by a straight cut through the 6th lumbar vertebrae to a point just clear of the tip of the ilium to the ventral portion of the flap. The lymph node gland (Subiliac) and gland fats situated on the flap are removed." ;
              rdfs:label "CHUMP_ON" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181254" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181255
gdsn:cv181255 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific section of the animal that comes from the shoulder or forequarter of the animal. The clod is also known as the shoulder clod or simply \"beef clod.\" It is a large, tough, and relatively inexpensive cut of meat that consists of various muscles, connective tissues, and some fat." ;
              rdfs:label "CLOD" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181255" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181256
gdsn:cv181256 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to various anatomical features appearing as a raised point or ridge, most prominently those on the head or back of an animal." ;
              rdfs:label "CREST" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181256" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181257
gdsn:cv181257 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cutaneous Trunci or cutaneous muscle is a relatively thin muscle near the skin in the live animal. It begins on the shoulder and ends in the flank where it is much thicker. The cutaneous trunci on the beef shoulder is commonly called the Shoulder Rose. The flank portion is commonly called Elephant Ears." ;
              rdfs:label "CUTANEOUS_TRUNCI_ROSE_MEAT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181257" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181258
gdsn:cv181258 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process and skill of easily (low effort) cutting portions of meat, such as roast and poultry, to obtain a maximum or satisfactory number of meat portions." ;
              rdfs:label "EASY_CARVE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181258" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181259
gdsn:cv181259 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the adipose tissue found in and around various cuts of meat. Additionally, there is also external fat, often referred to as \"trimmable fat\" or \"fat cap,\" which is found on the surface of certain cuts of meat." ;
              rdfs:label "FAT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181259" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181260
gdsn:cv181260 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a meat cut that comes from the abdominal area of an animal. It is a long, flat, and lean cut of meat that is known for its rich flavor but can be relatively tough if not prepared correctly. Also known as flank plate or flank." ;
              rdfs:label "FLANK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181260" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181261
gdsn:cv181261 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the front limbs or legs of an animal, typically referring to the front feet of larger animals. These front feet are also known as front trotters or front hooves." ;
              rdfs:label "FORE_FEET" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181261" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181262
gdsn:cv181262 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the front portion of an animal's carcass, specifically the front half of the body. It includes the front legs or limbs, shoulder, and associated cuts of meat." ;
              rdfs:label "FOREQUARTER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181262" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181263
gdsn:cv181263 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat obtained from the front leg or limb of an animal. The foreshank is located in the lower portion of the front leg, just below the shoulder and above the knee joint. Also known as front shank or shin." ;
              rdfs:label "FORESHANK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181263" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181264
gdsn:cv181264 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific trimming technique applied to meat, particularly to bone-in cuts like racks of lamb, pork, or beef. When a cut of meat is frenched, the butcher or chef removes the meat and connective tissue from the ends of the bones, exposing them to create a clean and visually appealing presentation. This technique is commonly used to enhance the aesthetics of the dish. Also known as Frenching." ;
              rdfs:label "FRENCHED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181264" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181265
gdsn:cv181265 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the entire head of an animal. The head contains various parts, including the skull, brain, eyes, ears, snout, tongue, and sometimes the cheeks and jowls. Different cultures have varying culinary traditions and uses for the head of the animal." ;
              rdfs:label "HEAD" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181265" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181266
gdsn:cv181266 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat from the cheeks of an animal's head." ;
              rdfs:label "HEAD_CHEEK_MEAT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181266" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181267
gdsn:cv181267 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the back limbs or legs of an animal. Also known as hind trotters or hind hooves." ;
              rdfs:label "HIND_FEET" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181267" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181268
gdsn:cv181268 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the internal organs and offal of an animal that are removed during the process of dressing or evisceration. These organs are also commonly referred to as variety meats, organ meats, or offal." ;
              rdfs:label "INSIDE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181268" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181269
gdsn:cv181269 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the organ found in the abdominal cavity that are part of the animal's urinary system and play a crucial role in filtering waste products and excess water from the blood to produce urine. Animal kidneys are also considered a type of offal or organ meat, and they have been a part of traditional diets in many cultures for centuries." ;
              rdfs:label "KIDNEY" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181269" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181270
gdsn:cv181270 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific primal cut of meat that comes from the hindquarters of an animal. The leg is also known as the hind leg or ham in certain animals." ;
              rdfs:label "LEG" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181270" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181271
gdsn:cv181271 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific section of meat located along the back of an animal, between the ribcage and the pelvis. The exact location of the loin can vary slightly depending on the animal being butchered." ;
              rdfs:label "LOIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181271" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181272
gdsn:cv181272 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the respiratory organs found in the chest cavity of animals, including livestock and game animals. n many regions, laws and regulations govern the handling and disposal of lung tissues to prevent any risk of contamination to the food supply." ;
              rdfs:label "LUNGS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181272" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181273
gdsn:cv181273 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the central portion of an animal's carcass, usually divided along the backbone." ;
              rdfs:label "MIDDLE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181273" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181274
gdsn:cv181274 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the outside part of an animal or meat cut." ;
              rdfs:label "OUTSIDE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181274" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181275
gdsn:cv181275 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to part of an animal or meat cut." ;
              rdfs:label "PART_PIECE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181275" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181276
gdsn:cv181276 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a piece of meat that still has a portion of bone attached to it after it has been partially deboned." ;
              rdfs:label "PARTIAL_BONE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181276" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181277
gdsn:cv181277 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a large section of an animal carcass that is separated during the initial stages of butchering. Primal cuts are the basic, major divisions of the animal's body that form the foundation for further butchering into individual retail cuts." ;
              rdfs:label "PRIMAL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181277" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181278
gdsn:cv181278 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the meat has had the blade bone removed. Blade bone is related cartilage, and overlying muscles (in their entirety) and fat shall be removed." ;
              rdfs:label "BLADE_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181278" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181279
gdsn:cv181279 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of removing the fat from meat. Fat is adipose tissue found in and around various cuts of meat. Additionally, there is also external fat, often referred to as \"trimmable fat\" or \"fat cap,\" which is found on the surface of certain cuts of meat." ;
              rdfs:label "FAT_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181279" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181280
gdsn:cv181280 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the removal of a smaller, very skinny muscle called the psoas minor, commonly referred to as the chain, runs the length of the tenderloin and is often removed before the tenderloin is sold." ;
              rdfs:label "PSOAS_MINOR_REMOVED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181280" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181281
gdsn:cv181281 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to small, narrow, and flavorful cuts of meat that come from the ribs of an animal. Riblets are obtained by cutting the rib section into smaller pieces, creating individual portions that contain a portion of the rib bones and surrounding meat." ;
              rdfs:label "RIBLETS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181281" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181282
gdsn:cv181282 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of ribs that comes from the lower portion of the animal's ribcage." ;
              rdfs:label "RIBS_SHORT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181282" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181283
gdsn:cv181283 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific type of meat cut that is intended for roasting. The term \"roast cut\" does not refer to a specific part of an animal but rather to the way the meat is prepared and cooked." ;
              rdfs:label "ROAST_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181283" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181284
gdsn:cv181284 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat that comes from the lower leg portion of an animal. The shank is located between the knee and the hoof of the animal." ;
              rdfs:label "SHANK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181284" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181285
gdsn:cv181285 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific and relatively lesser-known cut of meat that comes from the shoulder area of an animal. The shoulder cushion is sometimes referred to as shoulder tender." ;
              rdfs:label "SHOULDER_CUSHION" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181285" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181286
gdsn:cv181286 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the pectoralis muscles are usually included in larger sections of shoulder meat." ;
              rdfs:label "SHOULDER_PECTORALIS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181286" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181287
gdsn:cv181287 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion of the shoulder cut known as the picnic shoulder or picnic ham. The shoulder picnic lower half comes from the lower portion of the front leg closer to the foot or hock area." ;
              rdfs:label "SHOULDER_PICNIC_LOWER_HALF" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181287" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181288
gdsn:cv181288 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific and relatively lesser-known cut of meat that comes from the shoulder area of an animal. The teres major muscle is a small, triangular muscle located in the shoulder region, adjacent to the more well-known and larger shoulder tender or petite tender muscle." ;
              rdfs:label "SHOULDER_TERES_MAJOR" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181288" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181289
gdsn:cv181289 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to one half of a large animal carcass that has been split lengthwise along the backbone. When an animal, is processed for meat, it is usually divided into two sides. Each side contains one half of the animal's carcass." ;
              rdfs:label "SIDE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181289" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181290
gdsn:cv181290 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a separate cut of meat that comes from the diaphragm area of the animal. It is a thin, long, and grainy cut. Also known as skirt steak." ;
              rdfs:label "SKIRT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181290" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181291
gdsn:cv181291 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific request or custom preparation of meat made by a customer or chef to meet their specific requirements or preferences. It involves trimming or cutting the meat in a particular way that differs from the standard or conventional cuts typically offered by the butcher." ;
              rdfs:label "SPECIAL_TRIM" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181291" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181292
gdsn:cv181292 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A steak is a crosswise cut made perpendicular to the spine." ;
              rdfs:label "STEAK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181292" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181293
gdsn:cv181293 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific and popular cut of meat that comes from the loin primal section of the animal. The striploin is located in the loin primal section, which runs along the back of the animal, just behind the rib section and before the sirloin." ;
              rdfs:label "STRIPLOIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181293" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181294
gdsn:cv181294 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a leg cut that is the same as style 2 except that flank muscles (M. rectus abdominis, M. obliquus internus abdominis, M. obliquus externus abdominis), vertebrae, hip bone along with overlying lean and fat, lean and fat overlying the quadriceps (fore cushion), M. psoas major, and M. iliacus shall be removed." ;
              rdfs:label "LEG_LONG_CUT_STYLE_3" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181294" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181295
gdsn:cv181295 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a large cut of meat that is derived from one of the primary sections of an animal carcass. The primary sections, known as \"primal cuts,\" are large sections that are separated during the initial butchering process. Sub-primals are subsequently derived from these primal cuts and further broken down into retail cuts." ;
              rdfs:label "SUB_PRIMAL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181295" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181296
gdsn:cv181296 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The animal with its tail on / with its tail." ;
              rdfs:label "TAIL_ON" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181296" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181297
gdsn:cv181297 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the measurement or thickness of a meat cut. When the term refers to a cut of meat as \"thick,\" it means that the cut has been sliced or portioned to be wider and have more depth than thinner cuts." ;
              rdfs:label "THICK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181297" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181298
gdsn:cv181298 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the muscular organ found in the mouth of animals. The tongue is a versatile and unique type of offal or variety meat that is consumed in many cultures and cuisines around the world." ;
              rdfs:label "TONGUE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181298" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181299
gdsn:cv181299 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific and popular cut that comes from the sirloin primal section of the animal. The top sirloin is located in the sirloin primal section of the carcass. It is situated above the bottom sirloin and behind the tenderloin." ;
              rdfs:label "TOP_SIRLOIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181299" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181300
gdsn:cv181300 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat that is taken from the underside or ventral portion of an animal. The undercut comes from the area of the animal that is located beneath the loin and rib primal sections. It is situated on the ventral side, closer to the belly." ;
              rdfs:label "UNDERCUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181300" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181301
gdsn:cv181301 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the reproductive organ found in female animals. In some culinary traditions, the uterus is considered a type of offal or variety meat and is used as food. It is known by various names, such as womb or matrix." ;
              rdfs:label "UTERUS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181301" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181302
gdsn:cv181302 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to meat cut in 4 sections. Please refer to the animal to determine the exact parts that are cut." ;
              rdfs:label "4_WAY_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181302" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181303
gdsn:cv181303 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to meat cut in 6 sections. Please refer to the animal to determine the exact parts that are cut." ;
              rdfs:label "6_WAY_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181303" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181304
gdsn:cv181304 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a long, cylindrical muscle that runs along the spine on the inside of the ribs. It is located on the opposite side of the belly or brisket." ;
              rdfs:label "BACKSTRAP_BACKSTRIP" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181304" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181305
gdsn:cv181305 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat that comes from the underside or abdominal area of an animal." ;
              rdfs:label "BELLY" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181305" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181306
gdsn:cv181306 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific meat cut that has been prepared by removing the bones from the piece of meat." ;
              rdfs:label "BONELESS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181306" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181307
gdsn:cv181307 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the upper portion of the rear legs around the hip and rump area. The Bottom round comes from the Round primal." ;
              rdfs:label "BOTTOM" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181307" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181308
gdsn:cv181308 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the organ that is a part of the central nervous system found in the heads of animals. In culinary terms, \"brain\" specifically refers to the brain of certain animals, usually those that are commonly consumed for food." ;
              rdfs:label "BRAIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181308" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181309
gdsn:cv181309 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific meat cut that comes from the breast or lower chest area of an animal." ;
              rdfs:label "BRISKET" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181309" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181310
gdsn:cv181310 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific preparation of the brisket cut where the deckle (also known as the point or deckle point) has been removed." ;
              rdfs:label "BRISKET_DECKLE_OFF" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181310" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181311
gdsn:cv181311 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion of meat that is obtained from the front section of the animal's carcass, particularly from the shoulder and neck area. The chuck is a primal cut, and it contains a mix of muscles, connective tissue, and some bone." ;
              rdfs:label "CHUCK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181311" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181312
gdsn:cv181312 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific meat cut that is obtained from the chuck primal of a beef carcass. The chuck roll is a cylindrical piece of meat that runs along the front shoulder area of the animal. It is a boneless cut that consists of several muscles, connective tissue, and some fat." ;
              rdfs:label "CHUCK_ROLL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181312" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181313
gdsn:cv181313 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a unique boneless cut that comes from the inner portions of the shoulder." ;
              rdfs:label "COLLAR_BUTT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181313" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181314
gdsn:cv181314 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a thin, boneless piece of meat that is sometimes breaded and/or fried. The meat used for cutlets can come from various sources." ;
              rdfs:label "CUTLET" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181314" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181315
gdsn:cv181315 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the preparing the forequarter by removing the eye muscle portion lying along the spinous processes and transverse processes and the thoracic vertebrae. Also know as neck fillet." ;
              rdfs:label "EYE_OF_FOREQUARTER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181315" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181316
gdsn:cv181316 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cut or prepared as a fillet." ;
              rdfs:label "FILLETED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181316" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181317
gdsn:cv181317 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific meat cut that comes from the abdominal area of an animal. It is also known as flap meat or flap steak." ;
              rdfs:label "FLAP" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181317" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181318
gdsn:cv181318 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to half of an animal." ;
              rdfs:label "HALF" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181318" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181319
gdsn:cv181319 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the muscular organ that pumps blood throughout the circulatory system of an animal. The heart is a vital organ and an edible part of the animal that is used for culinary purposes in various cuisines around the world." ;
              rdfs:label "HEART" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181319" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181320
gdsn:cv181320 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the back half of an animal's carcass, specifically the rear portion of the body. It includes the hind legs or limbs, hip, and associated cuts of meat." ;
              rdfs:label "HINDQUARTER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181320" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181321
gdsn:cv181321 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of meat obtained from the lower portion of the hind leg or limb of an animal. The hindshank is located just below the knee joint, where the leg connects to the rest of the carcass." ;
              rdfs:label "HINDSHANK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181321" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181322
gdsn:cv181322 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the joint or the lower portion of the leg of an animal. In pigs, the hock is specifically known as the pork hock or ham hock." ;
              rdfs:label "HOCK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181322" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181323
gdsn:cv181323 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion of the leg primal cut from an animal. The outside eye is a particular muscle or portion within the leg that has distinct characteristics and culinary uses. In beef, the \"leg outside eye\" is commonly known as the outside round or bottom round. In pork is found in the ham primal cut. In lamb is located in the leg of lamb cut." ;
              rdfs:label "LEG_OUTSIDE_EYE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181323" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181324
gdsn:cv181324 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific type of meat cut that involves slicing the meat parallel to its natural grain or muscle fibers. This results in longer, more elongated pieces of meat." ;
              rdfs:label "LONG_LONG_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181324" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181325
gdsn:cv181325 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a collection of various edible organs and organ meats from an animal, excluding the standard cuts of muscle meat. Offal, also known as variety meats or organ meats, consists of internal organs such as the liver, heart, kidneys, sweetbreads, tongue, brain, tripe (stomach lining), and sometimes even the lungs, spleen, and other lesser-known parts." ;
              rdfs:label "MIXED_OFFAL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181325" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181326
gdsn:cv181326 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a combination of different cuts of meat and pieces obtained from an animal during the butchering process." ;
              rdfs:label "MIXED_PARTS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181326" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181327
gdsn:cv181327 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The value needed is not listed or is not defined within this list’s individual code values and definitions. Please send a work request into GS1 or your solution provider requesting the code you are searching for." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181327" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181328
gdsn:cv181328 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a pair of pieces of meat." ;
              rdfs:label "PAIR" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181328" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181329
gdsn:cv181329 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to an internal organ found in the abdominal cavity of animals, including livestock and game animals. The pancreas is a glandular organ that serves essential functions in the digestive and endocrine systems." ;
              rdfs:label "PANCREAS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181329" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181330
gdsn:cv181330 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the preparation from a hindquarter by the removal of the thin flank, lateral portion ribs and portion of the navel end brisket. A cut is made commencing at the superficial inguinal lymph node separating the M. rectus abdominus and following the contour of the hip, running parallel to the bodies of the vertebrae approximately 50mm from the M. longissimus dorsi (eye muscle) to the specified rib." ;
              rdfs:label "PISTOLA_HINDQUARTER" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181330" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181331
gdsn:cv181331 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of ribs obtained from the lower portion of the animal's ribcage, closer to the belly." ;
              rdfs:label "RIBS_SPARE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181331" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181332
gdsn:cv181332 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the full animal carcass, suitable for roasting." ;
              rdfs:label "ROASTING_FULL" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181332" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181333
gdsn:cv181333 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific method of roasting where a cut of meat is split or opened along its natural seam or bone structure before being cooked." ;
              rdfs:label "ROASTING_SPLIT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181333" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181334
gdsn:cv181334 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific type of meat cut where some of the bones have been removed from the meat, but not all of them. It is a term commonly used for cuts of meat that are intended to be easier to handle and cook while still retaining some of the benefits of bone-in meat." ;
              rdfs:label "SEMIBONELESS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181334" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181335
gdsn:cv181335 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific portion of a cut of meat or a joint that includes the shank or leg bone." ;
              rdfs:label "SHANK_END" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181335" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181336
gdsn:cv181336 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific type of meat cut that involves slicing the meat perpendicular to its grain, resulting in shorter and more compact pieces." ;
              rdfs:label "SHORT_SHORT_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181336" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181337
gdsn:cv181337 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut of beef that comes from the hindquarters of the animal. Silverside comes from the hind leg of the carcass, specifically from the outside of the upper leg, just above the knee joint." ;
              rdfs:label "SILVERSIDE" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181337" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181338
gdsn:cv181338 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cutting technique used to prepare meat or poultry. When a piece of meat is square cut, it means that the butcher has made straight, even cuts across the meat, resulting in a block-like or square shape." ;
              rdfs:label "SQUARE_CUT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181338" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181339
gdsn:cv181339 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a leg cut is separated from the split carcass side by a straight cut approximately perpendicular to a line parallel to the vertebral column between the 6th and 7th lumbar vertebrae and passing through a point immediately anterior to the hip bone (ilium) and related cartilage. The hind foot is removed at the tarsal joint." ;
              rdfs:label "LEG_LONG_CUT_STYLE_1" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181339" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181340
gdsn:cv181340 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a leg cut that is the same as style 1 except the tail (caudal) vertebrae, flank muscle (M. rectus abdominis), M. cutaneus trunci, and exposed lymph glands shall be removed." ;
              rdfs:label "LEG_LONG_CUT_STYLE_2" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181340" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181341
gdsn:cv181341 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific and highly prized cut of meat that comes from the loin primal section of an animal. The tenderloin is located along the backbone, inside the ribcage, in the loin primal section of the animal." ;
              rdfs:label "TENDERLOIN" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181341" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181342
gdsn:cv181342 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the tough, fibrous connective tissues that connect muscles to bones in an animal's body." ;
              rdfs:label "TENDONS" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181342" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181343
gdsn:cv181343 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the male reproductive organs of animals. In some culinary traditions and cultures, testicles are considered a type of offal or \"variety meat\" and are consumed as food. They are often referred to by specific names based on the animal they come from." ;
              rdfs:label "TESTICLES_TESTES" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181343" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181344
gdsn:cv181344 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to a specific cut that comes from the sirloin primal section of the animal. The top butt is also known by other names, such as top sirloin butt or \"op sirloin cap. The top butt is located in the sirloin primal section of the carcass. It is situated above the bottom sirloin and behind the tenderloin." ;
              rdfs:label "TOP_BUTT" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181344" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181345
gdsn:cv181345 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the process of removing excess fat, connective tissue, and any undesirable or inedible portions from a meat cut. When a cut of meat is \"trimmed,\" it is prepared to have a more uniform appearance, improve its presentation, and enhance its cooking qualities." ;
              rdfs:label "TRIMMED" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181345" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181346
gdsn:cv181346 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348332 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to the main body of an animal, particularly the torso or central part that contains the chest and abdominal cavities." ;
              rdfs:label "TRUNK" ;
              gdsn:codeListName "AnimalCutCode(Meat)" ;
              gdsn:sourceId "181346" ;
              gdsn:sourceType "codeValue" .


