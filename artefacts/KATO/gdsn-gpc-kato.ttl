###  urn:gs1:std:gdsn:cv180665
gdsn:cv180665 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Halal Quality Control (HQC) is the German certification body established in 1983, globally recognized and accredited for its Halal services." ;
