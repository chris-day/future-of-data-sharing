###  urn:gs1:std:gdsn:cv177778
gdsn:cv177778 rdf:type owl:NamedIndividual ,
                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A wood smoke process of fish and meat whereby the unhealthy substances found in un-purified smoke, such as polycyclic aromatic hydrocarbons (PAHs), ash and tar, have been removed." ;
              rdfs:label "PURIFY_SMOKE" ;
              gdsn:codeListName "PreparationTypeCode" ;
              gdsn:sourceId "177778" ;
              gdsn:sourceType "codeValue" .


