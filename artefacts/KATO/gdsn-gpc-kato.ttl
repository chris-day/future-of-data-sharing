                 gdsn:sourceType "attribute" ;
                 gdsn:validationRules "If the product is a spirit then age can be printed but is not required. If the product is a wine then the vintage/year can be printed, but is not required." .


###  urn:gs1:std:gdsn:extAttr1189
gdsn:extAttr1189 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:extGroup_US_NABCA ;
