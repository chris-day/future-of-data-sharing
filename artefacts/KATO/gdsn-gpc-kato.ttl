###  urn:gs1:std:gdsn:cv171159
gdsn:cv171159 rdf:type owl:NamedIndividual ,
                       gdsn:c-1609455609 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A format that contains the same kind of content delivered on CD/DVD combos but normally on a single disc. This configuration is playable in any DVD player (not CD players) and requires no other special equipment. This configuration can contain the same tracks as the CD, plus optional content that could include some or all of the following: 48khz/24 - bit stereo, high res stereo, surround, high res surround, video, behind the scenes, making of * interviews , lyrics , interactive booklet, portable MP3 audio files, ROM interactive (applications for ring-tones), online enablement for post release content updates." ;
              rdfs:label "DVD_ALBUM" ;
              gdsn:codeListName "DistributionMediaTypeCode" ;
              gdsn:sourceId "171159" ;
              gdsn:sourceType "codeValue" .


