                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "Code to indicate if the item is an imported product (C) with an assigned Customs Tariff code or a locally sourced product (E) with an assigned ATO Excise code." ;
                rdfs:label "customsOrExcisableType" ;
