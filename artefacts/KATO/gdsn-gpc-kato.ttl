gdsn:cv179347 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The number of karats of the stones in the item as related to the descriptiveSizeDimension." ;
