                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A type of rechargeable battery using nickel oxide hydroxide and metallic cadmium as electrodes." ;
              rdfs:label "NICKEL_CADMIUM" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169662" ;
              gdsn:sourceType "codeValue" .


