###  urn:gs1:std:gdsn:a7538357
gdsn:a7538357 rdf:type owl:DatatypeProperty ;
              rdfs:domain gdsn:c1883158950 ;
              rdfs:range xsd:boolean ;
              dct:source "gdsn_classAttributes.json" ;
              rdfs:comment "Indicates whether the medical device is exempt from premarket regulations. For the FDA, Premarket approval (PMA) is the process of scientific and regulatory review to evaluate the safety and effectiveness of Class III medical devices. Class III devices are those that support or sustain human life, are of substantial importance in preventing impairment of human health, or which present a potential, unreasonable risk of illness or injury. Due to the level of risk associated with Class III devices, FDA has determined that general and special controls alone are insufficient to assure the safety and effectiveness of class III devices. Therefore, these devices require a premarket approval (PMA) application under section 515 of the FD&C Act in order to obtain marketing clearance. Please note that some Class III preamendment devices may require a Class III 510(k)." ;
              rdfs:label "isExemptFromPremarketAuthorisation" ;
              gdsn:bmsId 6100 ;
              gdsn:originalMultiplicity "0..1" ;
              gdsn:pathId "c-121536678/c1883158950/a7538357" ;
              gdsn:semanticResourceUrn "urn:gs1:gdd:bie:MedicalDeviceInformation.isExemptFromPremarketAuthorisation" ;
              gdsn:sourceId "7538357" ;
              gdsn:sourceType "attribute" ;
              gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:medical_device_trade_item:xsd:3' and local-name()='medicalDeviceTradeItemModule']/medicalDeviceInformation/isExemptFromPremarketAuthorisation" .


