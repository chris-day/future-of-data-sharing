###  urn:gs1:std:gdsn:cv174778
gdsn:cv174778 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348221 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Full coverage is very opaque, and used to cover birthmarks, vitiligo, hyperpigmentation and scars. It is sometimes referred to as “corrective” or “camouflage” make-up. Products with full or high coverage contain over 15% pigment." ;
              rdfs:label "FULL" ;
              gdsn:codeListName "OpacityTypeCode(Cosmetics)" ;
              gdsn:sourceId "174778" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174779
gdsn:cv174779 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348221 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Light can cover unevenness and slight blotchiness, but is not opaque enough to cover freckles. Products with light coverage have 5-10 percent pigment." ;
              rdfs:label "LIGHT" ;
              gdsn:codeListName "OpacityTypeCode(Cosmetics)" ;
              gdsn:sourceId "174779" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174780
gdsn:cv174780 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348221 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Medium coverage can cover freckles, discolorations, blotchiness, and red marks left by pimples. Products with medium coverage have 10-15 percent pigment." ;
              rdfs:label "MEDIUM" ;
              gdsn:codeListName "OpacityTypeCode(Cosmetics)" ;
              gdsn:sourceId "174780" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174781
gdsn:cv174781 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348221 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sheer is the most transparent and contains the least amount of pigment. It will not hide discolorations on the skin but it can minimize the contrast between the discoloration and the rest of the skin tone. Products with sheer coverage have less than 5 percent pigment." ;
              rdfs:label "SHEER" ;
              gdsn:codeListName "OpacityTypeCode(Cosmetics)" ;
              gdsn:sourceId "174781" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174782
gdsn:cv174782 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348224 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Extremely opaque also known as blackout, light doesn't pass through and textile heavier than very opaque. 100+ denier" ;
              rdfs:label "EXTREMELY_OPAQUE" ;
              gdsn:codeListName "OpacityTypeCode(Textiles)" ;
              gdsn:sourceId "174782" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174783
gdsn:cv174783 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348224 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Opaque materials do not allow light to pass through or penetrate them. 41-69 denier" ;
              rdfs:label "OPAQUE" ;
              gdsn:codeListName "OpacityTypeCode(Textiles)" ;
              gdsn:sourceId "174783" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174784
gdsn:cv174784 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348224 ;
