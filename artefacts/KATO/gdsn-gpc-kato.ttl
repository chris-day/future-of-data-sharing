              rdfs:comment "The width of a blade for example a bench plain blade." ;
              rdfs:label "BLADE_WIDTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179126" ;
              gdsn:sourceType "codeValue" .


