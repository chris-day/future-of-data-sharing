###  urn:gs1:std:gdsn:cv177276
gdsn:cv177276 rdf:type owl:NamedIndividual ,
                       gdsn:c829522730 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A plane figure that is bounded by a closed path or circuit composed of a finite sequence of equally-sized straight line segments. A polygon may have a varying number of segments or ‘faces’ resulting in different configurations, for example a 5-faced polygon: pentagon, 6-faced: hexagon, 8-faced: octagon, 12-faced: dodecahedron, etc." ;
              rdfs:label "POLYGON" ;
              gdsn:codeListName "PackagingShapeCode" ;
              gdsn:sourceId "177276" ;
              gdsn:sourceType "codeValue" .


