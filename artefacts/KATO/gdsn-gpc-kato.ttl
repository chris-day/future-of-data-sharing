###  urn:gs1:std:gdsn:cv172952
gdsn:cv172952 rdf:type owl:NamedIndividual ,
                       gdsn:c-1384049456 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "To indicate the value of coliform bacteria. Coliform: Gram-negative, nonsporing, facultative rods that ferment lactose with gas formation within 48 hours at 35 °C. Examples of coliform bacteria are members in the genera Escherichia ( e.g. E. coli), Klebsiella (e.g. K. pneumoniae), Enterobacter (e.g. E. cloacai), and Citrobacter ( e.g. C. freundii). Bacteria: bacterium (plural bacteria) See prokaryote. Prokaryote: A cell or organism lacking a unit membrane-bound (true) nucleus and other organelles, usually having its DNA in a single circular molecule." ;
              rdfs:label "COLIFORM_BACTERIA_AT_35_DEGREES_C" ;
              gdsn:codeListName "MicrobiologicalOrganismCode" ;
              gdsn:sourceId "172952" ;
              gdsn:sourceType "codeValue" .


