gdsn:cv168846 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Crémant de Jura is French sparkling wine produced in the Jura département. Located between Burgundy and Switzerland" ;
