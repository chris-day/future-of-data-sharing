###  urn:gs1:std:gdsn:a6742
gdsn:a6742 rdf:type owl:ObjectProperty ;
           rdfs:domain gdsn:c1342 ;
           rdfs:range gdsn:c-1794641936 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Determines if the product is intended for single or multiple uses, including the number of validated cycles and the number of times a product can be used according to the manufacturer specifications. It is suggested that medical providers consult the device manufacturer’s Instruction For Use (IFU) for full reusability instructions." ;
