###  urn:gs1:std:gdsn:cv173062
gdsn:cv173062 rdf:type owl:NamedIndividual ,
                       gdsn:c-519231 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Acetaminophen is an analgesic drug used to treat headaches, arthritis, etc., and also to reduce fever, often as an alternative to aspirin." ;
              rdfs:label "ACETAMINOPHEN" ;
              gdsn:codeListName "NonfoodIngredientOfConcernCode" ;
