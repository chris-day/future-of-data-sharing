              rdfs:comment "A type of secondary electrochemical cell similar to nickel hydrogen cell." ;
              rdfs:label "NICKEL_METAL_HYDRIDE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169663" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169664
gdsn:cv169664 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Nickel oxide, made from iron, batteries are a rechargeable battery having nickel(III) oxide hydroxide positive and iron negative plates, with an electrolyte of potassium hydroxide." ;
              rdfs:label "NICKEL_OXIDE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169664" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169665
gdsn:cv169665 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Nickel oxyhydroxide batteries are a type of primary cell. It is not rechargeable and must be disposed after a single use. They can be used in high-drain applications such as digital cameras." ;
              rdfs:label "NICKEL_OXYHYDROXIDE" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169665" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169666
gdsn:cv169666 rdf:type owl:NamedIndividual ,
                       gdsn:c1309688889 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Nickel zinc batteries are a type of rechargeable batteries similar to nickel metal hydride batteries." ;
              rdfs:label "NICKEL_ZINC" ;
              gdsn:codeListName "BatteryTechnologyTypeCode" ;
              gdsn:sourceId "169666" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv169667
