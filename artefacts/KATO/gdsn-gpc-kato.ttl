###  urn:gs1:std:gdsn:cv172668
gdsn:cv172668 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In the metric system, the density of all types of paper, paperboard, and fabric, is expressed in terms of grams per square meter (g/m2).This quantity is commonly called grammage both in English and French (ISO 536), though many English- speaking countries still refer to the \"weight\". The term density here is used somewhat incorrectly, as density is mass by volume. More precisely, it is a measure of the area density, areal density, or surface density." ;
              rdfs:label "GM" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172668" ;
              gdsn:sourceType "codeValue" .


