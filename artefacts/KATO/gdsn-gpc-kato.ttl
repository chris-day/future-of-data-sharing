                 rdfs:domain gdsn:c-793841806 ;
                 rdfs:range gdsn:c2068269641 ;
                 dct:source "gdsn_classAttributes.json" ;
                 rdfs:comment "A code that indicates the way a record was produced. Three stages are involved in production: recording, editing/mixing and dubbing/transfer. Recording and editing/mixing stages can be analogue or digital. If digital, the stage is coded D. If analogue, the stage is coded A. “ADD” means that the recording was analogue and the editing/mixing was digital." ;
                 rdfs:label "digitalisationLevelCode" ;
                 gdsn:bmsId 569 ;
                 gdsn:originalMultiplicity "0..1" ;
                 gdsn:pathId "c-660934406/c-793841806/a1391385457" ;
                 gdsn:semanticResourceUrn "urn:gs1:gdd:bie:AudioVisualMediaProductionInformation.digitalisationLevelCode" ;
