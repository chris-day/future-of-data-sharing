###  urn:gs1:std:gdsn:cv179123
gdsn:cv179123 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The length of the bench plane blade e.g. hand plane. A hand plane is a tool for shaping wood. When powered by electricity, the tool may be called a planer. Planes are used to flatten, reduce the thickness of, and impart a smooth surface to a rough piece of lumber or timber. Planing is used to produce horizontal, vertical, or inclined flat surfaces on workpieces usually too large for shaping. Special types of planes are designed to cut joints or decorative mouldings." ;
              rdfs:label "BENCH_PLAIN_BLADE_LENGTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179123" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179124
gdsn:cv179124 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Identify the top of the seat tube, where the seat clamp holds the seat post. Identify the centre of the bottom bracket (it's the axle that holds the crank arms together). Measure the distance between the two points- this is the length of the seat tube." ;
              rdfs:label "BICYCLE_FRAME" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179124" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179125
gdsn:cv179125 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
