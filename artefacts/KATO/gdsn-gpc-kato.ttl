gdsn:cv178705 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Trade item has been treated with herbicide(s) that are subject to regulation." ;
              rdfs:label "TREATED_WITH_HERBICIDE_REGULATION" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "178705" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178706
