              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Link to a website containing product or manufacturer information." ;
              rdfs:label "WEBSITE" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178615" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178616
gdsn:cv178616 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A picture of a portion of a trade item (e.g., the wheels of a suitcase or the ingredients list of a food trade item)." ;
              rdfs:label "ZOOM_VIEW" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178616" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178617
gdsn:cv178617 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Dependent trade items are Trade Items which may be required or which may be used in conjunction with the current trade item to make the current trade item functional." ;
              rdfs:label "DEPENDENT_PROPRIETARY" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178617" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178618
gdsn:cv178618 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A product which can be substituted for the trade item based on supplier- defined functional equivalence to the trade item." ;
              rdfs:label "EQUIVALENT" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178618" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178619
gdsn:cv178619 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Another trade item of which this trade item is a variant. Used when the trade item is a variant of a previously specified trade item for example a new flavour of an existing soft drink. This reference may be used when the trade item has identical package type, physical dimensions and brand name as the itemVariantMaster trade item. This attribute only creates a logical link to a similar product. It is not used to negate the need for sending all item information about this product." ;
              rdfs:label "ITEM_VARIANT_MASTER" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178619" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178620
gdsn:cv178620 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A GTIN identification assigned by the manufacturer for the purpose of grouping multiple versions of the same title (e.g. limited edition, etc.)." ;
              rdfs:label "PREFERRED" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178620" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178621
gdsn:cv178621 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Trade Item that is similar to the current Trade Item but is not exact match. Same form fit function, e.g. same product different colour, different package size, better quality." ;
              rdfs:label "PRIMARY_ALTERNATIVE" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178621" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178622
gdsn:cv178622 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the trade item identification of an item that is being permanently replaced by this trade item." ;
              rdfs:label "REPLACED" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178622" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178623
gdsn:cv178623 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The trade item which permanently replaces the current trade item. This Trade Item is sent in the record for the original item that is being replaced." ;
              rdfs:label "REPLACED_BY" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178623" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178624
gdsn:cv178624 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The original trade item that is temporarily being replaced. This attribute is used with the replacement trade item." ;
              rdfs:label "SUBSTITUTED" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178624" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178625
gdsn:cv178625 rdf:type owl:NamedIndividual ,
                       gdsn:c-1286144735 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The trade item that is temporarily replacing the original GTIN. This attribute is used on the original trade item." ;
              rdfs:label "SUBSTITUTED_BY" ;
              gdsn:codeListName "ReferencedTradeItemTypeCode" ;
              gdsn:sourceId "178625" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178626
gdsn:cv178626 rdf:type owl:NamedIndividual ,
                       gdsn:c1826432850 ;
