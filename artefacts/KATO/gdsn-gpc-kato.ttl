###  urn:gs1:std:gdsn:cv168540
gdsn:cv168540 rdf:type owl:NamedIndividual ,
                       gdsn:c-778930468 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Medsafe Regulatory Classification The New Zealand Medicines Safety Authority" ;
              rdfs:label "67" ;
              gdsn:codeListName "AdditionalTradeItemClassificationCodeListCode" ;
              gdsn:sourceId "168540" ;
