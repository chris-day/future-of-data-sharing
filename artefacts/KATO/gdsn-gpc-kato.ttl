gdsn:cv176393 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Carbon Footprint Ltd is ISO14001 certified for environmental management and has a Quality Management System certified to ISO 9001:2008. PAS 2060 Carbon Neutrality programme meets the British Standard Institute (BSI)'s specification on carbon neutrality." ;
              rdfs:label "CARBON_FOOTPRINT_STANDARD" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
