              gdsn:sourceId "179336" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179337
gdsn:cv179337 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Is back-and-forth motion. Each cycle of reciprocation consists of two opposite motions: there is a motion in one direction, and then a motion back in the opposite direction. Each of these is called a stroke. The term is also used to mean the length of the stroke." ;
              rdfs:label "STROKE_LENGTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179337" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179338
gdsn:cv179338 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The supply line length until the first illuminant for example for length of cord until the first light on Christmas lights." ;
              rdfs:label "SUPPLY_LINE_LENGTH_TO_ILLUMINANT" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179338" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179339
gdsn:cv179339 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
