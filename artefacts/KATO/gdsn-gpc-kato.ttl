              rdfs:label "UBR" ;
              gdsn:codeListName "ONIXEditionTypeCode" ;
              gdsn:sourceId "174556" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174557
gdsn:cv174557 rdf:type owl:NamedIndividual ,
                       gdsn:c468201027 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ultra large print: For print sizes 20pt and above, and with typefaces designed for the visually impaired - see also LTE" ;
              rdfs:label "ULP" ;
              gdsn:codeListName "ONIXEditionTypeCode" ;
              gdsn:sourceId "174557" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174558
gdsn:cv174558 rdf:type owl:NamedIndividual ,
                       gdsn:c468201027 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Unexpurgated: Content previously considered 'offensive' has been restored" ;
              rdfs:label "UXP" ;
              gdsn:codeListName "ONIXEditionTypeCode" ;
              gdsn:sourceId "174558" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174559
gdsn:cv174559 rdf:type owl:NamedIndividual ,
                       gdsn:c468201027 ;
