###  urn:gs1:std:gdsn:cv172551
gdsn:cv172551 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Unit of time equal to 365,25 days." ;
              rdfs:label "ANN" ;
