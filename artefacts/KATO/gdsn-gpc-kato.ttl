gdsn:a5417 rdf:type owl:DatatypeProperty ;
           rdfs:domain gdsn:c822 ;
           rdfs:range gdsn:c1446 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Any regulatory information required that is not specifically identified by another field." ;
