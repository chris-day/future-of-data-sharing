###  urn:gs1:std:gdsn:cv179350
gdsn:cv179350 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "the capacity measurement of that the trade item was designed to be able to pull or tow." ;
              rdfs:label "TOWING_CAPACITY" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179350" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179351
gdsn:cv179351 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The measurement between the top of the tread rubber to the bottom of the tire's deepest grooves. Because it is difficult to accurately measure tread depth with a ruler, tread depth is best measured with a tire tread depth gauge." ;
              rdfs:label "TREAD_DEPTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179351" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179352
gdsn:cv179352 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The measurement between the outboard and inboard edges of a new tire's tread design. Ideally it approximates the width of the tread that comes into contact with the road." ;
              rdfs:label "TREAD_WIDTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179352" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179353
gdsn:cv179353 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum tree height that is suitable for a stand such as a Christmas tree stand." ;
              rdfs:label "TREE_STAND_HEIGHT_MAX" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179353" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179354
gdsn:cv179354 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The diameter of the product’s turntable." ;
              rdfs:label "TURNTABLE_DIAMETER" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179354" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179355
gdsn:cv179355 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The rim of a tyre carries different measures both width and depth to make a rim size. The calculation fits into a rim size that would be stated here, Examples 30c, 2.2, 3.0, 2.5" ;
              rdfs:label "TYRE_RIM_SIZE" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179355" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179356
gdsn:cv179356 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The size of the tyre there are various ways US, EU, ISO, Auto, Bicycle etc. For Example A bicycle tyre sequence: \"28-622, 700 x 28C, 28 x 1 5/8 x 1 1/8\" you at least have a useful deciphering reference. The rim diameter is 622mm and tyre outer diameter is around 700mm (the actual outer diameter will depend on the tyre's height). The tyre width is 28mm." ;
              rdfs:label "TYRE_SIZE" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179356" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179357
gdsn:cv179357 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the measurement of the usable depth of the product's inner rims when it is placed in contact with the floor, table or other surface. Example: The inner depth of a food storage container." ;
              rdfs:label "USABLE_DEPTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179357" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179358
gdsn:cv179358 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the measurement of the usable diameter of the product's inner rims when it is placed in contact with the floor, table or other surface. Example: An inner section of a bowl or inner diameter of a flower pot." ;
              rdfs:label "USABLE_DIAMETER" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179358" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179359
gdsn:cv179359 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the measurement of the usable height of the product's inner rim to the inner base when it is placed in contact with the floor, table or other surface. Example: The inner height of a food storage container." ;
              rdfs:label "USABLE_HEIGHT" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179359" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179360
gdsn:cv179360 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Total length of the product minus the length of additional elements for its usage. Example: The length of a nail file rocky surface. Note: There are specific sizeTypeCodes for specific type of product lengths." ;
              rdfs:label "USABLE_LENGTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179360" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179361
gdsn:cv179361 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the measurement of the usable width of the product's inner rims when it is placed in contact with the floor, table or other surface. Example: The inner width of a food storage container." ;
              rdfs:label "USABLE_WIDTH" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179361" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179362
gdsn:cv179362 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Is the weight of a vehicle without any consumables, passengers, or cargo." ;
              rdfs:label "VEHICLE_DRY_WEIGHT" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179362" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179363
gdsn:cv179363 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The capacity measurement that the trade item was designed to hold. Example Toilets, Plumping, storage bins all have an amount of volume capacity. 4 Cubic Metres" ;
              rdfs:label "VOLUME_CAPACITY" ;
              gdsn:codeListName "SizeTypeCode" ;
              gdsn:sourceId "179363" ;
              gdsn:sourceType "codeValue" .


