###  urn:gs1:std:gdsn:cv180629
gdsn:cv180629 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348280 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fibre obtained from the leaves of Agave sisalana." ;
              rdfs:label "FIBRE_SISAL" ;
              gdsn:codeListName "MaterialCode" ;
              gdsn:sourceId "180629" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180630
gdsn:cv180630 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348280 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fibre from the bast of Crotalaria juncea." ;
              rdfs:label "FIBRE_SUNN" ;
              gdsn:codeListName "MaterialCode" ;
              gdsn:sourceId "180630" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180631
gdsn:cv180631 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348280 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cellulose acetate fibre wherein at least 92% of the hydroxyl groups are acetylated." ;
              rdfs:label "FIBRE_TRIACETATE" ;
              gdsn:codeListName "MaterialCode" ;
              gdsn:sourceId "180631" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180632
gdsn:cv180632 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348280 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fibre formed of acrylonitrile terpolymer, a chlorinated vinyl monomer and a third vinyl monomer, none of which represents as much as 50% of the total mass." ;
              rdfs:label "FIBRE_TRIVINYL" ;
              gdsn:codeListName "MaterialCode" ;
              gdsn:sourceId "180632" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv180633
gdsn:cv180633 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348280 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fibre obtained from the bast of hemp (Cannabis sativa)." ;
              rdfs:label "FIBRE_TRUE_HEMP" ;
              gdsn:codeListName "MaterialCode" ;
              gdsn:sourceId "180633" ;
