###  urn:gs1:std:gdsn:cv168718
gdsn:cv168718 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The pharmaceutical central number (Pharmazentralnummer), or PZN for short, is an identification number for the uniform identification of pharmaceuticals and medical devices subject to pharmacies available on the German market. Their assignment is carried out by the Informationsstelle für Arzneimittelspezialitäten (IFA) after an application is submitted by the manufacturer." ;
              rdfs:label "PZN" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168718" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168719
gdsn:cv168719 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "(Register Verpakte Geneesmiddelen): An identification number provided by the Institute for Drug Evaluation (College ter Beoordeling van Geneesmiddelen – CBG) in the Netherlands. This number is used as the main identification for all drugs that have been approved by the CBG for distribution within the Netherlands." ;
              rdfs:label "RVG" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168719" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168720
gdsn:cv168720 rdf:type owl:NamedIndividual ,
                       gdsn:c1478 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "(Register Verpakte Homeopatische Geneesmiddelen): An identification number provided by the Institute for Drug Evaluation (College ter Beoordeling van Geneesmiddelen – CBG) in the Netherlands. This number is used as the main identification for all homeopathic drugs that have been approved by the CBG for distribution within the Netherlands." ;
              rdfs:label "RVH" ;
              gdsn:codeListName "AdditionalTradeItemIdentificationTypeCode" ;
              gdsn:sourceId "168720" ;
              gdsn:sourceType "codeValue" .


