              rdfs:comment "The Society of Hospital Pharmacists of Australia (SHPA)" ;
              rdfs:label "44" ;
              gdsn:codeListName "AdditionalTradeItemClassificationCodeListCode" ;
              gdsn:sourceId "168515" ;
              gdsn:sourceType "codeValue" .


