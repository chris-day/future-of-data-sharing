           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:medical_device_trade_item:xsd:3' and local-name()='medicalDeviceTradeItemModule']/medicalDeviceInformation/tradeItemSterilityInformation/isTradeItemRequiredToRemainSterile" .


###  urn:gs1:std:gdsn:a6747
gdsn:a6747 rdf:type owl:ObjectProperty ;
           rdfs:domain gdsn:c1343 ;
           rdfs:range gdsn:c-510936499 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "Declaration of sterilisation, including not sterilised, which may have been performed by the manufacturer. Sterilisation refers to any process that effectively kills or eliminates transmissible agents (such as fungi, bacteria, viruses, prions and spore forms etc.) from a surface, equipment, foods, medications, or biological culture medium. Some methods of sterilization are through the application of heat, radiation, and ethylene." ;
           rdfs:label "initialManufacturerSterilisationCode" ;
           gdsn:bmsId 1593 ;
           gdsn:originalMultiplicity "0..*" ;
           gdsn:pathId "c-121536678/c1883158950/c1343/a6747" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:TradeItemSterilityInformation.initialManufacturerSterilisationCode" ;
           gdsn:sourceId "6747" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:medical_device_trade_item:xsd:3' and local-name()='medicalDeviceTradeItemModule']/medicalDeviceInformation/tradeItemSterilityInformation/initialManufacturerSterilisationCode" .


###  urn:gs1:std:gdsn:a6748
gdsn:a6748 rdf:type owl:ObjectProperty ;
           rdfs:domain gdsn:c1343 ;
           rdfs:range gdsn:c-510936499 ;
           dct:source "gdsn_classAttributes.json" ;
           rdfs:comment "This is an indication of the type(s) of sterilisation that is required to be completed by a healthcare provider prior to use of the healthcare trade item. Sterilisation refers to any process that effectively kills or eliminates transmissible agents (such as fungi, bacteria, viruses, prions and spore forms etc.) from a surface, equipment, foods, medications, or biological culture medium. Some methods of sterilisation are through the application of heat, radiation, and ethylene." ;
           rdfs:label "initialSterilisationPriorToUseCode" ;
           gdsn:bmsId 1594 ;
           gdsn:originalMultiplicity "0..*" ;
           gdsn:pathId "c-121536678/c1883158950/c1343/a6748" ;
           gdsn:semanticResourceUrn "urn:gs1:gdd:bie:TradeItemSterilityInformation.initialSterilisationPriorToUseCode" ;
           gdsn:sourceId "6748" ;
           gdsn:sourceType "attribute" ;
           gdsn:xPath "/catalogue_item_notification:catalogueItemNotificationMessage/transaction/documentCommand/catalogue_item_notification:catalogueItemNotification/catalogueItem/tradeItem/tradeItemInformation/extension/*[namespace-uri()='urn:gs1:gdsn:medical_device_trade_item:xsd:3' and local-name()='medicalDeviceTradeItemModule']/medicalDeviceInformation/tradeItemSterilityInformation/initialSterilisationPriorToUseCode" .


###  urn:gs1:std:gdsn:a6749
