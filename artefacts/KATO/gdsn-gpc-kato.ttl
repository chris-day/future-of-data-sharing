###  urn:gs1:std:gdsn:cv181630
gdsn:cv181630 rdf:type owl:NamedIndividual ,
                       gdsn:c-2013489156 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Competition act encompasses several pivotal environmental-related additions designed to hold companies accountable for their environmental claims. These provisions aim to mitigate the pervasive issue of greenwashing, ensuring businesses can't make superficial or misleading claims about their environmental efforts. For example the Canadian Competition Act." ;
              rdfs:label "COMPETITION_ACT" ;
              gdsn:codeListName "RegulationTypeCode" ;
              gdsn:sourceId "181630" ;
              gdsn:sourceType "codeValue" .


