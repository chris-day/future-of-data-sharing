###  urn:gs1:std:gdsn:cv177012
gdsn:cv177012 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Since 01/01/2015, if you are placing recyclable products on the French market (producers, importers and distributors) that are subject to an extended producer responsibility system and that fall under a sorting instruction, you are required to affix the Triman signage. https://www.ademe.fr/sites/default/files/assets/documents/user_s-handbook-triman.pdf" ;
              rdfs:label "TRIMAN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ademe.fr/sites/default/files/assets/documents/user_s-handbook-triman.pdf" ;
              gdsn:sourceId "177012" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177013
gdsn:cv177013 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "True Foods™ provides assurance to discerning consumers that food products bearing this trustmark are verified and continually monitored from farm to shelf to ensure that they consistently conform to the label claims on the package." ;
              rdfs:label "TRUE_FOODS_CANADA_TRUSTMARK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://truefoods.ca/" ;
              gdsn:sourceId "177013" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177014
gdsn:cv177014 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "True Source Certified attribute includes all products that present a True Source Certified logo." ;
              rdfs:label "TRUE_SOURCE_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.truesourcehoney.com/" ;
              gdsn:sourceId "177014" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177015
gdsn:cv177015 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "German label for food safety. The TÜV SÜD as a recognized, neutral testing agency, with its mark both for trading partners and consumers is an important decision-making aid." ;
              rdfs:label "TUEV_GEPRUEFT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.tuev-sued.de/management_systeme/lebensmittelsicherheit/gepruefte_qualitaet" ;
              gdsn:sourceId "177015" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177016
gdsn:cv177016 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Approved Estonian Taste - Quality/Tradition/Origin/Traceability for Estonian products. All raw materials must be 100% Estonian. Estonian Chamber of Agriculture and Commerce" ;
              rdfs:label "TUNNUSTATUD_EESTI_MAITSE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.epkk.ee/" ;
              gdsn:sourceId "177016" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177017
gdsn:cv177017 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Approved Taste label (designed as a barn swallow) denoting Estonian origin and high quality was introduced. This label has been given to products for Food quality and safety. Estonian Chamber of Agriculture and Commerce (ECAC) www.epkk.ee" ;
              rdfs:label "TUNNUSTATUD_MAITSE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.epkk.ee" ;
              gdsn:sourceId "177017" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177018
gdsn:cv177018 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The purpose of “UDEN GMO FODER” marque is to determine and guarantee that the products sold - using the “UDEN GMO FODER” marque - originates from a Danish milk farm which cows are fed without any GMO feed (Genetically Modified Organisms)." ;
              rdfs:label "UDEN_GMO_FODER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.arla.dk/produkter/arla-24/uden-brug-af-gmo-foder/" ;
              gdsn:sourceId "177018" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177019
gdsn:cv177019 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The UEBT (Union for Ethical Biotrade) Certified label is awarded to companies that meet the criteria of the Ethical Bio-trade Standard. UEBT offers two types of certification. One is for brands and is certification of ethical sourcing systems and another is for suppliers or producers of natural ingredients. The UEBT certification label is used for both types of certification. In the case of specific ingredient certification, the label is used on-product with the specific ingredient just above the label. (https://www.ethicalbiotrade.org/using-our-mark)" ;
              rdfs:label "UEBT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ethicalbiotrade.org/" ;
              gdsn:sourceId "177019" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177020
gdsn:cv177020 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The letters UKCA appear on many products traded in the United Kingdom. They signify that products sold in the United Kingdom have been assessed to meet high safety, health, and environmental protection requirements. The UK CA marking supports fair competition by holding all companies accountable to the same rules." ;
              rdfs:label "UK_CONFORMITY_ASSESSED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.gov.uk/guidance/using-the-ukca-marking" ;
              gdsn:sourceId "177020" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177021
gdsn:cv177021 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Conformity with Umweltbaum (The Environment Tree)'s standard is verified by an independent organization (third party). Applicable life cycle and supply chain phases Social and environmental attributes Mutual recognition with other ecolabels Standard details, including standard document, review frequency." ;
              rdfs:label "UMWELTBAUM" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ecolabelindex.com/ecolabel/umweltbaum-the-environment-tree" ;
              gdsn:sourceId "177021" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177022
gdsn:cv177022 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The source across the globe for product compliance." ;
              rdfs:label "UNDERWRITERS_LABORATORY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ul.com/" ;
              gdsn:sourceId "177022" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177023
gdsn:cv177023 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "There are multiple variations of marks for UL’s Listing service, some of which are for use in the United States, others for use in Canada and still others for use in both markets. Products carrying marks for Canada have been evaluated to Canadian safety requirements, which may be somewhat different from U.S. safety requirements. A combination mark indicates compliance with both Canadian and U.S. requirements." ;
              rdfs:label "UNDERWRITERS_LABORATORY_CERTIFIED_CANADA_US" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ul.com/marks/ul-listing-and-classification-marks/appearance-and-significance/marks-for-north-america/" ;
              gdsn:sourceId "177023" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177024
gdsn:cv177024 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Uniquely Finnish http://www.maakuntienparhaat.fi/en/ The Uniquely Finnish label is a national quality label for small entrepreneurs. ProAgria Association of Rural Advisory Centres grants the label to qualified foodstuff, handicraft and rural tourism companies based on applications." ;
              rdfs:label "UNIQUELY_FINNISH" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.maakuntienparhaat.fi/en/" ;
              gdsn:sourceId "177024" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177025
gdsn:cv177025 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "United Egg Producers or (UEP) Certified is an attribute that ensures hen welfare. Requirements for hen welfare are set by the nation's leading animal welfare researchers and veterinarians. UEP Certified is the only science-based animal welfare program for cage and cage-free egg production with standards endorsed by the Food Marketing Institute and the National Council of Chain Restaurants. Independent and third-party inspections are carried out by either USDA or Validus." ;
              rdfs:label "UNITED_EGG_PRODUCERS_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://uepcertified.com/" ;
              gdsn:sourceId "177025" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177026
gdsn:cv177026 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The regional seal \"\"Unser Land\"\" (Our Country) documented regional origin and quality of agricultural products and services based on criteria that go beyond legal requirements. They take into account the strengthening of regional economic cycles in cooperation with all relevant actors work towards a common good regional solidarity economy." ;
              rdfs:label "UNSER_LAND" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.unserland.info" ;
              gdsn:sourceId "177026" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177027
gdsn:cv177027 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Urdinkel - Quality seal for spelt (Triticum spelta) which has no cross in from wheat (triticum) and is of Swiss origin. The seal needs an independent certification according to the set standards." ;
              rdfs:label "URDINKEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.urdinkel.ch/de/produzent/richtlinien" ;
              gdsn:sourceId "177027" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177028
gdsn:cv177028 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "US Department of Agriculture" ;
              rdfs:label "USDA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.usda.gov/wps/portal/usda/usdahome" ;
              gdsn:sourceId "177028" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177029
gdsn:cv177029 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The United States Department of Agriculture (USDA) uses the term \"biobased product\" to mean a product is: (A) composed, in whole or in significant part, of biological products, including renewable domestic agricultural materials, renewable chemicals, and forestry materials; or (B) an intermediate ingredient or feedstock. Biobased Products are derived from raw materials such as plants and other renewable agricultural, marine, and forestry materials. Biobased products generally provide an alternative to conventional petroleum derived products and include a diverse range of offerings such as lubricants, detergents, inks, fertilizers, and bioplastics. Biobased products do not include food, feed, or fuel. https://www.biopreferred.gov/BioPreferred/faces/pages/BiobasedProducts.xhtml" ;
              rdfs:label "USDA_CERTIFIED_BIOBASED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.biopreferred.gov/BioPreferred/faces/pages/BiobasedProducts.xhtml" ;
              gdsn:sourceId "177029" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177030
gdsn:cv177030 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "USDA’s Agricultural Marketing Service, through the Livestock, Poultry, and Seed Program’s Quality Assessment Division, offers a voluntary program which provides for the official grading of eggs in accordance with the U.S. Grade Standards for the Voluntary Grading of Shell Eggs (pdf) (7 CFR Part 56) and the United States Standards, Grades, and Weight Classes for Shell Eggs (pdf) (AMS 56)." ;
              rdfs:label "USDA_GRADE_A" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ams.usda.gov/publications/qa-shell-eggs" ;
              gdsn:sourceId "177030" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177031
gdsn:cv177031 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "United States Department of Agriculture Egg Grading" ;
              rdfs:label "USDA_GRADE_AA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "177031" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177032
gdsn:cv177032 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The United States Department of Agriculture (USDA) provides a mark of inspection which can be found on labels and products. The mark serves as a seal of approval, bolstering consumers' confidence the meat, poultry and processed egg products they are about to enjoy are safe and wholesome. The inspections are conducted by the USDA's Food Safety and Inspection Service. https://www.fsis.usda.gov/wps/portal/informational/aboutfsis/faces-of-food-safety" ;
              rdfs:label "USDA_INSPECTION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.fsis.usda.gov/wps/portal/informational/aboutfsis/faces-of-food-safety" ;
              gdsn:sourceId "177032" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177033
gdsn:cv177033 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The U.S. Department of Agriculture has put in place a set of national standards that food labelled products must meet, whether it is grown in the United States or imported from other countries. Organic foods are produced without using most conventional pesticides; fertilizers made with synthetic ingredients or sewage sludge; bioengineering; or ionizing radiation. http://www.usda.gov/wps/portal/usda/usdahome ." ;
              rdfs:label "USDA_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.usda.gov/wps/portal/usda/usdahome" ;
              gdsn:sourceId "177033" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177034
gdsn:cv177034 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A certification which is intended to assure the social and environmental quality in coffee production. Coffee based products may be marked with this certification." ;
              rdfs:label "UTZ_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://utz.org/" ;
              gdsn:sourceId "177034" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177035
gdsn:cv177035 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "UTZ Certified is one of the largest programs for sustainable farming of coffee and cocoa in the world. This certification means that a product or brand practices sustainable farm management, good agricultural practices and above standard living and social conditions for the environment." ;
              rdfs:label "UTZ_CERTIFIED_COCOA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://utz.org/what-we-offer/certification/products-we-certify/cocoa/" ;
              gdsn:sourceId "177035" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177036
gdsn:cv177036 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vaad Hoeir Kosher Certification" ;
              rdfs:label "VAAD_HOEIR_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://ovkosher.org/" ;
              gdsn:sourceId "177036" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177037
gdsn:cv177037 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Grain based foods (bread, breakfast products, baking articles etc.) which have got a high content of whole grain will be puffed with a nutritional puff from the beginning of 2009: Please choose whole grain first! Denmark http://www.fuldkorn.dk/" ;
              rdfs:label "VAELG_FULDKORN_FORST" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.fuldkorn.dk/" ;
              gdsn:sourceId "177037" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177038
gdsn:cv177038 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "VDE stands for \"Verband der Elektrotechnik, Elektronik und Informationstechnik\". This German Institute tests and certifies electrical equipment, components and systems and is like Dutch KEMA-quality mark." ;
              rdfs:label "VDE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "0" ;
              gdsn:sourceId "177038" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177039
gdsn:cv177039 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "VdS (Vertrauen durch Sicherheit) is an independent and recognized German inspection and certification agency for fire and burglary. Whether it is a safe in a company, a sprinkler system in a production hall or a smoke detector in a house: VdS examines to the smallest detail." ;
              rdfs:label "VDS_CERTIFICATE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.vds.de" ;
              gdsn:sourceId "177039" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177040
gdsn:cv177040 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Vegan Awareness Foundation (Vegan Action) administers the “Certified Vegan” Logo, an easy-to-recognize trademarked symbol. The Logo is a registered trademark, similar in nature to the “kosher” mark, for products that do not contain animal products or byproducts and that have not been tested on animals. Companies must submit and have approved by the Vegan Awareness Foundation that acceptable steps are taken to thoroughly clean and sanitize all surfaces, vessels, utensils and machinery used between vegan and non-vegan production cycles to minimize cross-contamination if shared machinery is used." ;
              rdfs:label "VEGAN_AWARENESS_FOUNDATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://vegan.org/" ;
              gdsn:sourceId "177040" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177041
gdsn:cv177041 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "EarthKosher offers a Vegan Verification program. The standards for the Vegan Verification program are that a product contains no animal products or animal product derivatives whatsoever, i.e. “Zero Tolerance”." ;
              rdfs:label "VEGAN_BY_EARTHKOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://earthkosher.com/" ;
              gdsn:sourceId "177041" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177042
gdsn:cv177042 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vegan Natural Food Certifiers attribute includes all products that present a Vegan Natural Food Certifiers logo." ;
              rdfs:label "VEGAN_NATURAL_FOOD_CERTIFIERS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://nfccertification.com/" ;
              gdsn:sourceId "177042" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177043
gdsn:cv177043 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Vegan logo is a registered trademark and is a symbol of our Vegan 'Animal-free' Standards . It appears on thousands of animal free products, and is displayed by catering businesses, that have been registered with The Vegan Society." ;
              rdfs:label "VEGAN_SOCIETY_VEGAN_LOGO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.vegansociety.com" ;
              gdsn:sourceId "177043" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177044
gdsn:cv177044 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Vegaplan vzw was founded in 2003 by the members of the Platform for the Transformation and Trading of Raw Materials and Plant Products (PTMV) bringing together the different sectors and by the agricultural associations (Algemeen Boerensyndicaat, Boerenbond and Walloon Federation of 'Agriculture). Vegaplan vzw is intended primarily for farms and agricultural entrepreneurs who wish to obtain certification based on the 'Standard Vegaplan' specifications and / or the 'Sector Guide' recommended by the FASFC (Federal Agency for Safety of the food chain). The Vegaplan vzw also targets buyers of raw materials from the plant sector, namely companies in the \"trade and transformation of plant products\" link, with a view to optimizing quality within the plant sector." ;
              rdfs:label "VEGAPLAN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.vegaplan.be/fr" ;
              gdsn:sourceId "177044" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177045
gdsn:cv177045 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Vegetarian Society influences, inspires and supports people to embrace and maintain a vegetarian lifestyle. We work constructively with businesses, government agencies, policy makers and professionals, whilst always remaining independent. We rely on membership subscriptions and donations to carry out this vital work. Established in 1847, we are the oldest vegetarian organisation in the world. (Note: The code value contains a spelling error \"VEGA\", it is intentionally left this way to avoid unnecessary costs by the community to fix)." ;
              rdfs:label "VEGATARIAN_SOCIETY_V_LOGO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.vegsoc.org/" ;
              gdsn:sourceId "177045" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177046
gdsn:cv177046 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "VegeCert is a non-profit organization that certifies vegan and vegetarian food products. Vegans and Vegetarians represent approximately 5% of American and Canadian consumers, and VegeCert helps this key demographic make informed decisions about the food that they eat. VegeCert is unique in that we make physical inspections of our certified food manufacturing facilities to ensure that they conform to VegeCert's high standards." ;
              rdfs:label "VEGECERT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://vegecert.com/" ;
              gdsn:sourceId "177046" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177047
gdsn:cv177047 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Dutch \"Politie Keurmerk Veilig Wonen\" quality mark focuses on the prevention of intrusion in homes or buildings. The quality mark is given to locks by means of stars in which the burglar resistance is specified in minutes. Incidentally this label covers not only locks but also mirrors, smoke detectors and lighting fixtures." ;
              rdfs:label "VEILIG_WONEN_POLITIE_KEURMERK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.politiekeurmerk.nl" ;
              gdsn:sourceId "177047" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177048
gdsn:cv177048 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The label certifies that the guidelines of Verbund Ökohöfe e.V. are met. These guidelines are stronger than the legal requirements of the EU for organic farming (EC-Eco-Basis Ordinance (EC) No. 834/2007). For example, the following rules apply to the producers: - In cattle keeping: no dehorning, no tethering, pasture (at least 100 days) - CMS hybrids from protoplast fusion (horticultural cultures) and rye, wheat, triticale, barley, flower and herbal hybrids are not permitted. In addition, different restrictions apply to vegetable hybrids. - Conventional dung GMO (genetically modified organism) fed mammals is not permitted. - Copper preparations may only be used in fruit, wine and potato cultivation (maximum copper quantity 3kg / ha and year, calculated on the basis of the five-year average of rotation). - For horticultural crops, a 100 m distance to the motorway and 30 m to other busy roads must be observed. - settlecomposts - also from quality-tested systems - are not permissible, since the GMO is not guaranteed in the process." ;
              rdfs:label "VERBUND_OEKOHOEFE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.verbund-oekohoefe.de" ;
              gdsn:sourceId "177048" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177049
gdsn:cv177049 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The French agricultural organizations have created a common visual identity in order to highlight the French origin of agricultural products in this case lamb: the signatures \"Agricultural Products of France\". Remarkable to their elegant silhouette in a tricolor pentagon that is available for each family of products, these signatures reflect the commitment of the professionals of the sectors to value the know-how, the territories and the French jobs. Covering a variety of productions, these signatures all have a common basis, which consists of four criteria: Origin France of the products concerned, The existence of specifications or regulations governing the use of the logo, A formal commitment from the operators of the sectors concerned wishing to use these logos, Controls performed by a third party." ;
              rdfs:label "VIANDE_AGNEAU_FRANCAIS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.produitsagricolesdefrance.fr" ;
              gdsn:sourceId "177049" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177050
gdsn:cv177050 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The French agricultural organizations have created a common visual identity in order to highlight the French origin of agricultural products: the signatures \"Agricultural Products of France\". This identifies French cattle products. Remarkable to their elegant silhouette in a tricolor pentagon that is available for each family of products, these signatures reflect the commitment of the professionals of the sectors to value the know-how, the territories and the French jobs. Covering a variety of productions, these signatures all have a common basis, which consists of four criteria: Origin France of the products concerned, The existence of specifications or regulations governing the use of the logo, A formal commitment from the operators of the sectors concerned wishing to use these logos, Controls performed by a third party." ;
              rdfs:label "VIANDE_BOVINE_FRANCAISE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.produitsagricolesdefrance.fr" ;
              gdsn:sourceId "177050" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177051
gdsn:cv177051 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The French agricultural organizations have created a common visual identity in order to highlight the French origin of agricultural products in this case chevaline products: the signatures \"Agricultural Products of France\". Remarkable to their elegant silhouette in a tricolor pentagon that is available for each family of products, these signatures reflect the commitment of the professionals of the sectors to value the know-how, the territories and the French jobs. Covering a variety of productions, these signatures all have a common basis, which consists of four criteria: Origin France of the products concerned, The existence of specifications or regulations governing the use of the logo, A formal commitment from the operators of the sectors concerned wishing to use these logos, Controls performed by a third party." ;
              rdfs:label "VIANDE_CHEVALINE_FRANCAISE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.produitsagricolesdefrance.fr" ;
              gdsn:sourceId "177051" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177052
gdsn:cv177052 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The French agricultural organizations have created a common visual identity in order to highlight the French origin of agricultural products in this case meat from goats: the signatures \"Agricultural Products of France\". Remarkable to their elegant silhouette in a tricolor pentagon that is available for each family of products, these signatures reflect the commitment of the professionals of the sectors to value the know-how, the territories and the French jobs. Covering a variety of productions, these signatures all have a common basis, which consists of four criteria: Origin France of the products concerned, The existence of specifications or regulations governing the use of the logo, A formal commitment from the operators of the sectors concerned wishing to use these logos, Controls performed by a third party." ;
              rdfs:label "VIANDE_DE_CHEVRE_FRANCAISE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.produitsagricolesdefrance.fr" ;
              gdsn:sourceId "177052" ;
              gdsn:sourceType "codeValue" .


