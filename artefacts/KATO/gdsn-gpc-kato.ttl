              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174078" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174079
gdsn:cv174079 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Antioxidants are defined as substances which inhibit oxidation. Oxidation reactions or oxidative stress can damage or kill cells, and are thought to play an important part in many human diseases." ;
              rdfs:label "ANTIOXIDANTS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174079" ;
              gdsn:sourceType "codeValue" .


