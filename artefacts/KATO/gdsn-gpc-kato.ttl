gdsn:cv174081 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Artificial flavours are formed by chemical synthesis and not identical to substances found in nature. They are used to improve the taste or smell (aroma) of the product." ;
              rdfs:label "ARTIFICIAL_FLAVOUR" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174081" ;
