###  urn:gs1:std:gdsn:cv180960
gdsn:cv180960 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "White, semi-translucent, flavourless substance consisting of polysaccharides obtained from the red algae species (primarily from Gracilaria and Gelidiaceae genus). It is commonly used as vegan substitute of gelatine, gelling agent in food, pharmaceutical drugs, photography and cosmetic manufacturing, growth medium in microbiology and other medical materials." ;
              rdfs:label "AGAR" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "180960" ;
