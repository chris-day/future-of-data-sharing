###  urn:gs1:std:gdsn:cv172276
gdsn:cv172276 rdf:type owl:NamedIndividual ,
                       gdsn:c2034116970 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A commodity code for the import or export of goods under European Union regulation containing certain ingredients. E.g. types of milk and sugars." ;
              rdfs:label "MEURSING" ;
              gdsn:codeListName "ImportClassificationTypeCode" ;
              gdsn:sourceId "172276" ;
