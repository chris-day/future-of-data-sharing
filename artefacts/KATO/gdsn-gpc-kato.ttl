gdsn:cv181684 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Integrated Production of Wine (IPW) is the environmental sustainability scheme established by the South African wine industry. IPW complies with international wine industry environmental sustainability criteria. This seal is used when the wine is bottled abroad, i.e., not in South Africa." ;
