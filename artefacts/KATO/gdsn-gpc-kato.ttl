gdsn:cv174248 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Widely cultivated edible, starchy root vegetable of the nightshade family (solanum tuberosum)." ;
              rdfs:label "POTATO" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174248" ;
