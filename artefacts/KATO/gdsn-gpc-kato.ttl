###  urn:gs1:std:gdsn:cv177895
gdsn:cv177895 rdf:type owl:NamedIndividual ,
                       gdsn:c-574010573 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sending all current and known CURRENT pricing. This is used to start over by replacing previously synchronised information." ;
              rdfs:label "RELOAD" ;
              gdsn:codeListName "PriceDocumentTypeCode" ;
              gdsn:sourceId "177895" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177896
gdsn:cv177896 rdf:type owl:NamedIndividual ,
                       gdsn:c-574010573 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates that the message is used to recover a lost or missing message." ;
              rdfs:label "RESEND" ;
              gdsn:codeListName "PriceDocumentTypeCode" ;
              gdsn:sourceId "177896" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177897
gdsn:cv177897 rdf:type owl:NamedIndividual ,
                       gdsn:c-574010573 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The status used when a data recipient had rejected an item's pricing but wishes to resume price synchronisation." ;
              rdfs:label "RESTART" ;
              gdsn:codeListName "PriceDocumentTypeCode" ;
              gdsn:sourceId "177897" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177898
gdsn:cv177898 rdf:type owl:NamedIndividual ,
                       gdsn:c1206837096 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Resynchronisation of all Price Types for pricing done at the lowest level consumer unit. Uses NO_ACTION code to differentiate price types that have changed from those that have not." ;
              rdfs:label "1" ;
              gdsn:codeListName "PriceSynchronisationSpecialScenarioCode" ;
              gdsn:sourceId "177898" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177899
gdsn:cv177899 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Credit reflected on an invoice. This can occur either at the item or the invoice level. There are many types of allowances. Some are contractually based, e.g. backhaul, others are not formalized contracts. Some allowances are offered to the industry such as payment terms while others such as promotional allowances are trading partner specific." ;
              rdfs:label "ALLOWANCE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177899" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177900
gdsn:cv177900 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The price associated with an item for the purchase of a specific number of trade items, or some other logistical measure (weight, cube, truck). These are often offered in a series (e.g. 100 to 299 case lots, 300 to 599, full truckload, half truckload; each offering a different discount)." ;
              rdfs:label "BRACKET_TIER_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177900" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177901
gdsn:cv177901 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Debit reflected on an invoice. This can occur either at the item or at the invoice level. There are many types of charges. Some are contractually based, others are not formalized contracts." ;
              rdfs:label "CHARGE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177901" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177902
gdsn:cv177902 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The price associated with an item that has been negotiated or agreed to between trading partners exclusive of taxes but inclusive of allowances, charges and customs duty where applicable. This price would typically be associated with a formal contract between trading partners." ;
              rdfs:label "CONTRACT_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177902" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177903
gdsn:cv177903 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This is the value of the item as declared by the supplier. This value is used by customs to calculate the customs duty that is payable." ;
              rdfs:label "DECLARED_CUSTOMS_VALUE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177903" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177904
gdsn:cv177904 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Not Available" ;
              rdfs:label "INTRODUCTORY_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177904" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177905
gdsn:cv177905 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "External price associated with a product absent of all allowances or charges. This is normally the printed price contained on supplier’s price list or catalogue. (May or may not be customer specific)." ;
              rdfs:label "LIST_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177905" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177906
gdsn:cv177906 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An unspecified type." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177906" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177907
gdsn:cv177907 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A price that is available only as part of a promotion." ;
              rdfs:label "PROMOTIONAL_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177907" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177908
gdsn:cv177908 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The retail (to consumer) price as suggested by the manufacturer. May or may not appear on the package." ;
              rdfs:label "RETAIL_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177908" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177909
gdsn:cv177909 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The line item/GTIN price shown on the invoice document, including allowances and/or charges applying to the trading partner relationship (which can be zero), but excluding VAT and any other taxes, fees, and/or duties." ;
              rdfs:label "TRANSACTION_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177909" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177910
gdsn:cv177910 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The line item / GTIN price shown on the invoice document, including allowances and/ or charges applying to the trading partner relationship (which can be zero), excluding VAT, but including any other taxes, fees, and/or duties." ;
              rdfs:label "TRANSACTION_PRICE_WITH_SPECIAL_TAXES" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177910" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177911
gdsn:cv177911 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A specific financial allowance, comprising special taxes, whose goal is to identify a special price type and price value that the data recipient would pay to the data provider IF it pays the invoice in a certain delay (such delay is previously negotiated between the dataProvider and the dataRecipient and does not have to be communicated with the tariff)" ;
              rdfs:label "TRANSACTION_PRICE_WITH_SPECIAL_TAXES_AND_EARLY_PAYMENT_DISCOUNT" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177911" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177912
gdsn:cv177912 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The line item / GTIN price shown on the invoice document, including allowances and/ or charges applying to the trading partner relationship (which can be zero), including both VAT and any other taxes, fees, and/or duties." ;
              rdfs:label "TRANSACTION_PRICE_WITH_VAT_AND_SPECIAL_TAXES" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177912" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177913
gdsn:cv177913 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A specific financial allowance, comprising VAT and special taxes, whose goal is to identify a special price type and price value that the data recipient would pay to the data provider IF it pays the invoice in a certain delay (such delay is previously negotiated between the dataProvider and the dataRecipient and does not have to be communicated with the tariff)" ;
              rdfs:label "TRANSACTION_PRICE_WITH_VAT_AND_SPECIAL_TAXES_AND_EARLY_PAYMENT_DISCOUNT" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177913" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177914
gdsn:cv177914 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The price associated with an item exclusive of all allowances, charges, taxes and customs duty. (May or may not be customer specific). This applies to imported items that upon arrival into the country are stored in a Customs bonded warehouse. The goods are then sold without the customs duty paid. The purchaser must pay the customs duty." ;
              rdfs:label "UNDERBOND_LIST_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177914" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177915
gdsn:cv177915 rdf:type owl:NamedIndividual ,
                       gdsn:c1179957350 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The price associated with an item exclusive of all taxes and customs duty but inclusive of all allowances and charges. This applies to imported items that upon arrival into the country are stored in a Customs bonded warehouse. The goods are then sold without the customs duty paid. The purchaser must pay the customs duty." ;
              rdfs:label "UNDERBOND_TRANSACTION_PRICE" ;
              gdsn:codeListName "PriceTypeCode" ;
              gdsn:sourceId "177915" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177916
gdsn:cv177916 rdf:type owl:NamedIndividual ,
                       gdsn:c-1019936752 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An amount of or relating to money." ;
              rdfs:label "MONETARY_AMOUNT" ;
              gdsn:codeListName "PriceValueQualifierCode" ;
              gdsn:sourceId "177916" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177917
gdsn:cv177917 rdf:type owl:NamedIndividual ,
                       gdsn:c-1019936752 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "One part in a hundred." ;
              rdfs:label "PERCENT" ;
              gdsn:codeListName "PriceValueQualifierCode" ;
              gdsn:sourceId "177917" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178023
gdsn:cv178023 rdf:type owl:NamedIndividual ,
                       gdsn:c-951863509 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The process of continuous harmonisation of information between all trading partners ensures that the master data is the same in all trading partners systems." ;
              rdfs:label "DATA_SYNCHRONISATION" ;
              gdsn:codeListName "ProcessCapabilityCode" ;
              gdsn:sourceId "178023" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178024
gdsn:cv178024 rdf:type owl:NamedIndividual ,
                       gdsn:c-951863509 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The act of granting permission to sell (or deliver) an item at a specific location or groups of locations where the authorisation could be triggered by either trading partner depending on the buying and selling relationship through GDSN." ;
              rdfs:label "ITEM_AUTHORISATION" ;
              gdsn:codeListName "ProcessCapabilityCode" ;
              gdsn:sourceId "178024" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178025
gdsn:cv178025 rdf:type owl:NamedIndividual ,
                       gdsn:c-951863509 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The process framework for communicating information related to CURRENT trade item version information using the Global Data Synchronisation Network (GDSN)." ;
              rdfs:label "ITEM_FUTURISATION" ;
              gdsn:codeListName "ProcessCapabilityCode" ;
              gdsn:sourceId "178025" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178026
gdsn:cv178026 rdf:type owl:NamedIndividual ,
                       gdsn:c-951863509 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The process of synchronising party Master Data through GDSN." ;
              rdfs:label "PARTY_SYNCHRONISATION" ;
              gdsn:codeListName "ProcessCapabilityCode" ;
              gdsn:sourceId "178026" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178027
gdsn:cv178027 rdf:type owl:NamedIndividual ,
                       gdsn:c-951863509 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The process of synchronising price information through GDSN." ;
              rdfs:label "PRICE_SYNCHRONISATION" ;
              gdsn:codeListName "ProcessCapabilityCode" ;
              gdsn:sourceId "178027" ;
