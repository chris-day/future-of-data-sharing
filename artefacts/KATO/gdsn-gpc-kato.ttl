              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Coated with materials that make the packaging impervious to the effects of water." ;
              rdfs:label "WATER_RESISTANT" ;
              gdsn:codeListName "PackagingFunctionCode" ;
