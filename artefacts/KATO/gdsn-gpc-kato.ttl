###  urn:gs1:std:gdsn:cv180721
gdsn:cv180721 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Confit is the generic name given to various foods immersed in a substance for both taste and preservation. This logo is a simple way of identifying French confit." ;
