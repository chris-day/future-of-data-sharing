gdsn:cv180744 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A polymer blend or mixture of least two polymers that are blended to create a new material with different physical properties. These tend to be a proprietary mix of polymers and cannot be separated. The individual materials may not be known by the seller." ;
              rdfs:label "POLYMER_MIX" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
