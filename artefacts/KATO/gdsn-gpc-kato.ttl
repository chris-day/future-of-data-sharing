                       gdsn:c2147348267 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "High Intensity Discharge (HID) is an overarching term for a gas-discharge light. HID lamps produce light by sending an electrical charge or “arc” between two tungsten electrical conductors (electrodes) and through an ionized gas (also known as “plasma”) which is housed inside the bulb." ;
              rdfs:label "HIGH_INTENSITY_DISCHARGE" ;
              gdsn:codeListName "GrowingLightConditionTypeCode" ;
