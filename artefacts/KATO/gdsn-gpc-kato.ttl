###  urn:gs1:std:gdsn:cv179799
gdsn:cv179799 rdf:type owl:NamedIndividual ,
                       gdsn:c-569663405 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A feature of televisions used in addition to teletext with red, green, yellow buttons to go to sports, weather etc." ;
              rdfs:label "FASTEXT" ;
              gdsn:codeListName "TelevisionInformationServiceTypeCode" ;
              gdsn:sourceId "179799" ;
