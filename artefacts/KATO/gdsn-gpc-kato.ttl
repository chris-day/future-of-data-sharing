                       gdsn:c-696968629 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Aerobic Plate Count (APC) is used as an indicator of bacterial populations on a sample. The test is based on an assumption that each cell will form a visible colony when mixed with agar containing the appropriate nutrients." ;
              rdfs:label "AEROBIC_PLATE_COUNT" ;
              gdsn:codeListName "MicrobiologicalOrganismMethodOfAnalysisCode" ;
