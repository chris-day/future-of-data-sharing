###  urn:gs1:std:gdsn:cv179335
gdsn:cv179335 rdf:type owl:NamedIndividual ,
                       gdsn:c1989107388 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the height of storey. A storey (or story in American English) is any level part of a building that could be used by people (for living, work, storage, recreation, etc.). The terms \"floor\", \"level\", or \"deck\" can also be used in this sense." ;
              rdfs:label "STOREY_HEIGHT" ;
              gdsn:codeListName "SizeTypeCode" ;
