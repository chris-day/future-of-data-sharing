###  urn:gs1:std:gdsn:cv176118
gdsn:cv176118 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A Rigid Intermediate Bulk Container (RIBC) that is attached to a pallet or has the pallet integrated into the RIBC. The container is used for the transport and storage of fluids and other bulk materials. The construction of the IBC container and the materials used are chosen depending on the application. There are various types available in the market place. Foldable (collapsible) IBC Container, Plastic composite IBC Container, Wire Cage IBC Container, Steel IBC Container, and Stainless steel IBC Container." ;
              rdfs:label "AA" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176118" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176119
gdsn:cv176119 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A gas-tight, pressure-resistant container with a valve and propellant. When the valve is opened, propellant forces the product from the container in a fine or coarse spray pattern or stream. (e.g., a spray can dispensing paint, furniture polish, etc, under pressure). It does not include atomizers, because atomizers do not rely on a pressurised container to propel product from the container." ;
              rdfs:label "AE" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176119" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176120
gdsn:cv176120 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A relatively small container in tube shape, the end of which is drawn into a stem and closed by fusion after filling. The bottom may be flat, convex, or drawn out. An ampule is opened by breaking the stem." ;
              rdfs:label "AM" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176120" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176121
gdsn:cv176121 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cylindrical packaging whose bottom end is permanently fixed to the body and top end (head) is either removable or non-removable." ;
              rdfs:label "BA" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176121" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176122
gdsn:cv176122 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bag-In-Box or BIB is a type of container for the storage and transportation of liquids. It consists of a strong bladder, usually seated inside a corrugated fibreboard box. The box and internal bag can be fused together. In most cases there is nozzle or valve fixed to the bag. The nozzle can be connected easily to a dispensing installation or the valve allows for convenient dispensing." ;
              rdfs:label "BBG" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176122" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176123
gdsn:cv176123 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A preformed, flexible container, generally enclosed on all but one side, which forms an opening that may or may not be sealed after filling." ;
              rdfs:label "BG" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176123" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176124
gdsn:cv176124 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A container, usually cylindrical, can be equipped with a lid and a handle. (e.g., a pail made of metal, plastic, or other appropriate material)." ;
              rdfs:label "BJ" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176124" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176125
gdsn:cv176125 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A semi rigid container usually open at the top traditionally used for gathering, shipping and marketing agricultural products." ;
              rdfs:label "BK" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176125" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176126
gdsn:cv176126 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A container having a round neck of relatively smaller diameter than the body, as compared with a jar, and an opening capable of holding a closure for retention of the contents. The cross section of the bottle may be round, oval, square, oblong, or a combination of these." ;
              rdfs:label "BO" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176126" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176127
gdsn:cv176127 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A type of packaging in which the item is secured between a cavity or pocket made from a formable web, usually transparent, and a flat backing." ;
              rdfs:label "BPG" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176127" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176128
gdsn:cv176128 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A rectangular-shaped, stackable package designed primarily for liquids such as juice or milk" ;
              rdfs:label "BRI" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176128" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176129
gdsn:cv176129 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific term used to refer to a rigid container with closed faces that completely enclose its contents." ;
              rdfs:label "BX" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176129" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176130
gdsn:cv176130 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A container enclosed on at least one side by a grating of wires or bars that lets in air and light." ;
              rdfs:label "CG" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176130" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176131
gdsn:cv176131 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A chub or a chub pack is a type of container formed by a tube of flexible, non-edible packaging material. The cylindrical package has the appearance of a sausage with the ends sealed by metal crimps or clips, e.g. for sausages (artificial intestine)." ;
              rdfs:label "CHB" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176131" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176132
gdsn:cv176132 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A flat package to which the product is hung or attached for display." ;
              rdfs:label "CM" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176132" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176133
gdsn:cv176133 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A one-piece container consisting of two halves joined by a hinge area which allows the structure to come together to close. Clamshells get their name from their appearance to the shell of a clam, which it resembles both in form and function." ;
              rdfs:label "CMS" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176133" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176134
gdsn:cv176134 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A metallic and generally cylindrical container of unspecified size which can be used for items of consumer and institutional sizes." ;
              rdfs:label "CNG" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176134" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176135
gdsn:cv176135 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A container holding an item or substance, designed for insertion into a mechanism. Examples: Ink, beverage syrup, silicone sealant for construction." ;
              rdfs:label "CQ" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176135" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176136
gdsn:cv176136 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific term usually referring to a rigid three- dimensional container with semi-closed faces that enclose its contents for shipment or storage. Crates could have an open or closed top and may have internal divers. Even though some crates might be reused or become resealed they could also be disposable depending on the product hierarchy." ;
              rdfs:label "CR" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176136" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176137
gdsn:cv176137 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific term for a container designed to hold, house, and sheath or encase its content while protecting it during distribution, storage and/or exhibition. Cases are mostly intended to store and preserve its contents during the product's entire lifetime." ;
              rdfs:label "CS" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176137" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176138
gdsn:cv176138 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific term for an open or re-closable container used mostly for perishable foods (e.g. eggs, or fruit)." ;
              rdfs:label "CT" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176138" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176139
gdsn:cv176139 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A flat-bottomed container that has a base of any shape and which may or not be closed with a lid. These containers are typically used to contain mostly (but not exclusively) foods such as ice cream, margarine, yogurt, sour cream, confections, etc." ;
              rdfs:label "CU" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176139" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176140
gdsn:cv176140 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A rigid cylindrical container with straight sides and circular ends of equal size." ;
              rdfs:label "CY" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176140" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176141
gdsn:cv176141 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A predominantly flat container of flexible material having only two faces, and joined at three edges to form an enclosure. The non-joined edge provides a filling opening, which may later be closed by a gummed or adhesive flap, heat seal, tie string, metal clasp, or other methods." ;
              rdfs:label "EN" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176141" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176142
gdsn:cv176142 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A rectangular-shaped, non-stackable package designed primarily for liquids such as juice or milk" ;
              rdfs:label "GTG" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176142" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176143
gdsn:cv176143 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A container, normally cylindrical, with a handle and/or a lid or spout for holding and pouring liquids" ;
              rdfs:label "JG" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176143" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176144
gdsn:cv176144 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A rigid container with a large opening, which is used to store products, e.g., jams, cosmetics." ;
              rdfs:label "JR" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176144" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176145
gdsn:cv176145 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A bundle of products held together for ease of carriage by the consumer. A multipack is always a consumer unit." ;
              rdfs:label "MPG" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176145" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176146
gdsn:cv176146 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item is provided without packaging." ;
              rdfs:label "NE" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176146" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176147
gdsn:cv176147 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A container of meshwork material made from threads or strips twisted or woven to form a regular pattern with spaces between the threads that is used for holding, carrying, trapping, or confining something." ;
              rdfs:label "NT" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176147" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176148
gdsn:cv176148 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A three-dimensional container which either has a pallet platform permanently attached at its base or alternatively requires a platform for its handling and storage as due to its constitution it cannot be handled without it. The characteristics of the platform should be specified using the pallet type code list" ;
              rdfs:label "PB" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176148" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176149
gdsn:cv176149 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A package used for hygienic/sterile products which may be torn open without touching the product inside." ;
              rdfs:label "PLP" ;
              gdsn:codeListName "PackageTypeCode_GDSN" ;
              gdsn:sourceId "176149" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176150
gdsn:cv176150 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348127 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A preformed, flexible container, generally enclosed with a gusset seal at the bottom of the pack can be shaped/arranged to allow the pack to stand on shelf." ;
