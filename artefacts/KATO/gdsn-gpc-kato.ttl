gdsn:cv174800 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Demeter International Demeter-International e. V. is a non profit organisation and its member organisations work together in the spirit of an international confederation with democratic principles. Membership requires a functioning Demeter certification programme." ;
              rdfs:label "16" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174800" ;
              gdsn:sourceType "codeValue" .


