                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "A reference to the GTIN of the lowest level of product contained within this product?s family hierarchy. Supply at Level: All Applicable - Except Base Unit" ;
                rdfs:label "gTINOfBaseUnit" ;
                gdsn:example "09311279000990" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 5 ;
                gdsn:originalLimit "{14..14}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "275" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Syntax Valid GTIN, expressed as 14-digits" .


###  urn:gs1:std:gdsn:extAttr276
gdsn:extAttr276 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "Packaging type for the Hazardous / Dangerous item." ;
                rdfs:label "hazardousDangerousPackagingType" ;
                gdsn:example "BTL - Bottle" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{1..3}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "276" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr277
gdsn:extAttr277 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:integer ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "Hazardous / Dangerous volume of the item unit." ;
                rdfs:label "hazardousDangerousUnitVolume" ;
                gdsn:example "500 MLT (Millilitre) Note: Compound AVP" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{1..6}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "277" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr278
gdsn:extAttr278 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:decimal ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The Health Star Rating is a front-of-pack labelling system that rates the overall nutritional profile of packaged food and assigns it a rating from ½ a star to 5 stars. It provides a quick, easy, standard way to compare similar packaged foods. The more stars, the healthier the choice." ;
                rdfs:label "healthStarRatingValue" ;
                gdsn:example "3.5" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 7 ;
                gdsn:originalLimit "{1..2}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "278" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr279
gdsn:extAttr279 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The interpretive term associated with the Nutrient Content Declaration on the Health Star Rating Label." ;
                rdfs:label "interpretiveTermOptionalNutrient" ;
                gdsn:example "HIGH - The nutrient is present at levels consistent with the requirements of FSC Standard 1.2.7 – Nutrition, Health and Related Claims for making nutrition content claims for ‘good source’ or ‘excellent source’. LOW - The nutrient is present at levels co" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 7 ;
                gdsn:originalLimit "{1..10}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "279" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr28
gdsn:extAttr28 rdf:type owl:DatatypeProperty ;
               rdfs:domain gdsn:extGroup_Australasian_Supermarkets_PIF ;
               rdfs:range xsd:string ;
               dct:source "gdsn_extendedAttributes.json" ;
               rdfs:comment "This flag is used to indicate if there has been or it was possible that GM cross contamination occurred during the transport of Raw / bulk commodity with GM products. Valid values are Y (Yes), N (No) or blank (Not supplied)" ;
               rdfs:label "gMCrossContaminationTransport" ;
               gdsn:example "Y - Yes" ;
               gdsn:groupName "Australasian Supermarkets PIF" ;
               gdsn:hierarchyLevel 1 ;
               gdsn:originalLimit "{1..1}" ;
               gdsn:originalMultiplicity "0..1" ;
               gdsn:sourceId "28" ;
               gdsn:sourceType "attribute" ;
               gdsn:validationRules "Will be handled by Validator." .


###  urn:gs1:std:gdsn:extAttr280
gdsn:extAttr280 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The interpretive term associated with the Nutrient Content Declaration on the Health Star Rating Label." ;
                rdfs:label "interpretiveTermSaturatedFat" ;
                gdsn:example "LOW - The nutrient is present at levels consistent with the requirements of the FSC Standard 1.2.7 – Nutrition, Health and Related Claims for making a low saturated fat nutrition content claim." ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 7 ;
                gdsn:originalLimit "{1..10}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "280" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr281
gdsn:extAttr281 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The interpretive term associated with the Nutrient Content Declaration on the Health Star Rating Label." ;
                rdfs:label "interpretiveTermSodium" ;
                gdsn:example "LOW - The nutrient is present at levels consistent with the requirements of the FSC Standard 1.2.7 – Nutrition, Health and Related Claims for making a low sodium nutrition content claim." ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 7 ;
                gdsn:originalLimit "{1..10}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "281" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr282
gdsn:extAttr282 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The interpretive term associated with the Nutrient Content Declaration on the Health Star Rating Label." ;
                rdfs:label "interpretiveTermSugars" ;
                gdsn:example "LOW - The nutrient is present at levels consistent with the requirements of the FSC Standard 1.2.7 – Nutrition, Health and Related Claims for making a low sugars nutrition content claim." ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 7 ;
                gdsn:originalLimit "{1..10}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "282" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr283
gdsn:extAttr283 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "Dangerous goods are substances or articles that are potentially dangerous to people, property and the environment. They include materials that are explosive, flammable, spontaneously combustible (burst into flames without being lit), water reactive (produce flammable or toxic gases if mixed with water), oxidizing (help a fire to burn more fiercely), toxic (poisonous), Corrosive. [Note: this is a Woolworths attribute]" ;
                rdfs:label "isTradeItemADangerousGood" ;
                gdsn:example "Y-Yes" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{1..1}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "283" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator." .


###  urn:gs1:std:gdsn:extAttr284
gdsn:extAttr284 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "Hazardous goods are chemicals or chemical compounds that are hazardous to humans and environment. A hazardous substance can be a single chemical or a mixture of two or more chemicals formulated to make a chemical product. They include material that are; Shock sensitivity, Corrosiveness, Oxidising properties, Reactivity with common substances (for example, air or water), Autoignition temperature, Evaporation rate, Vapour density, Odour threshold, PH, at stated concentration, Solubility in organic solvents, Per cent volatiles, Volatile organic compounds, Bulk density. [Note: this is a Woolworths attribute]" ;
                rdfs:label "isTradeItemAHazardousGood" ;
                gdsn:example "N-No." ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{1..1}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "284" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator." .


###  urn:gs1:std:gdsn:extAttr285
gdsn:extAttr285 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The internal product number allocated to the product by the original manufacturer of the item. Where the vendor loading GS1net is the manufacturer this field is the same as the Vendor Internal Reference field. Supply at Level: All Applicable" ;
                rdfs:label "manufacturerInternalReference" ;
                gdsn:example "A1234" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 1 ;
                gdsn:originalLimit "{1..255}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "285" ;
                gdsn:sourceType "attribute" .


###  urn:gs1:std:gdsn:extAttr286
gdsn:extAttr286 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:decimal ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "This is the amount that a product will nest into another when stacked. Calculated as the difference between the height (in millimetre) of one product multiplied by 2 and the height of 2 products stacked. Apply at Level: All Applicable Consumer Units" ;
                rdfs:label "nesting" ;
                gdsn:example "40" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 4 ;
                gdsn:originalLimit "{4..7}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "286" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Value would be > 0 and Value would be < (Height of product x 2)" .


###  urn:gs1:std:gdsn:extAttr287
gdsn:extAttr287 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:integer ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The number of base unit (lowest level) products contained within this product. Only required where item is not a base unit. Supply at Level: All Applicable - Except Base Unitetw." ;
                rdfs:label "numberOfBaseUnits" ;
                gdsn:example "6" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 5 ;
                gdsn:originalLimit "{1..8}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "287" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "GTIN of Base unit and Number of Base Units are conditionally required" .


###  urn:gs1:std:gdsn:extAttr288
gdsn:extAttr288 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:string ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "A single positive nutrient that food companies may choose to display in addition to the prescribed nutrients on the Health Star Rating Label. Optional nutrients are defined as properties of food in Schedule 1 of Standard 1.2.7 – Nutrition, Health and Related Claims of the FSC." ;
                rdfs:label "optionalNutrientCode" ;
                gdsn:example "-" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 7 ;
                gdsn:originalLimit "{1..35}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "288" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr289
gdsn:extAttr289 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:decimal ;
                dct:source "gdsn_extendedAttributes.json" ;
                rdfs:comment "The depth (in millimetres) of the pallet load of goods. Identifies the Unit of Measure for the Pallet Depth field as millimetres. Supply at Level: CASE / Dispatch Units." ;
                rdfs:label "palletDepth" ;
                gdsn:example "1165" ;
                gdsn:groupName "Australasian Industry Generic" ;
                gdsn:hierarchyLevel 8 ;
                gdsn:originalLimit "{4..15}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "289" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "7 x Pallet Details Fields are conditionally required" .


###  urn:gs1:std:gdsn:extAttr29
gdsn:extAttr29 rdf:type owl:DatatypeProperty ;
               rdfs:domain gdsn:extGroup_Australasian_Supermarkets_PIF ;
               rdfs:range xsd:string ;
               dct:source "gdsn_extendedAttributes.json" ;
               rdfs:comment "A statement which provides details of any ingredients used in the manufacturing or processing of the Trade Item which have been obtained from an animal fed with GM feedstock." ;
               rdfs:label "gMFeedstockIngredientStatement" ;
               gdsn:example "-" ;
               gdsn:groupName "Australasian Supermarkets PIF" ;
               gdsn:hierarchyLevel 1 ;
