gdsn:cv177643 rdf:type owl:NamedIndividual ,
                       gdsn:c-623631210 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A portable, horizontal, perforated metal platform for storing, stacking and handling transporting goods as unit load, with dimensions 2025 x 1180 mm, suitable for lifting by a forklift, pallet jack, or other jacking device. Fits in the space of 2 EUR pallets." ;
              rdfs:label "52" ;
