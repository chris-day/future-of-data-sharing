                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Brew: to prepare by steeping, boiling, and fermentation or by infusion and fermentation, to prepare (a drink or other liquid) by infusion in hot water" ;
