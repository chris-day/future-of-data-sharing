###  urn:gs1:std:gdsn:cv174210
gdsn:cv174210 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The oat is a cereal plant cultivated chiefly in cool climates and widely used for animal feed as well as human consumption. The grain yielded by this, used as food." ;
              rdfs:label "OAT" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174210" ;
