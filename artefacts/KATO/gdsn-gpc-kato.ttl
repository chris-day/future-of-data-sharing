              rdfs:comment "Substances and articles belonging to packing group I and not classified in transport category 0 and substances and articles of the following classes: Class 1: 1.1B to 1.1J a /1.2B to 1.2J/1.3C/1.3G/1.3H/1.3J/1.5D a Class 2: groups T, TC a, TO, TF, TOC a and TFC, aerosols: groups C, CO, FC, T, TF, TC, TO, TFC and TOC Class 4.1: UN Nos. 3221 to 3224 and 3231 to 3240 Class 5.2: UN Nos. 3101 to 3104 and 3111 to 3120" ;
              rdfs:label "1" ;
              gdsn:codeListName "DangerousGoodsTransportCategoryCode" ;
              gdsn:sourceId "170717" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170718
gdsn:cv170718 rdf:type owl:NamedIndividual ,
                       gdsn:c-6079790 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Substances or articles belonging to packing group II and not classified in transport categories 0, 1 or 4 and substances of the following classes: Class 1: 1.4B to 1.4G and 1.6N Class 2: group F, aerosols: group F Class 4.1: UN Nos. 3225 to 3230 Class 5.2: UN Nos. 3105 to 3110 Class 6.1: substances and articles belonging to packing group III Class 9: UN No. 3245" ;
              rdfs:label "2" ;
              gdsn:codeListName "DangerousGoodsTransportCategoryCode" ;
              gdsn:sourceId "170718" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170719
gdsn:cv170719 rdf:type owl:NamedIndividual ,
                       gdsn:c-6079790 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Substances and articles belonging to packing group III and not classified in transport categories 0, 2 or 4 and substances and articles of the following classes: Class 2: groups A and O, aerosols: groups A and O Class 3: UN No. 3473 Class 4.3: UN No. 3476 Class 8: UN Nos. 2794, 2795, 2800, 3028 and 3477 Class 9: UN Nos. 2990 and 3072" ;
              rdfs:label "3" ;
              gdsn:codeListName "DangerousGoodsTransportCategoryCode" ;
              gdsn:sourceId "170719" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv170720
gdsn:cv170720 rdf:type owl:NamedIndividual ,
                       gdsn:c-6079790 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Class 1: 1.48 Class 4.1: UN Nos. 1331, 1345, 1944, 1945, 2554 and 2623 Class 4.2: UN Nos. 1361 and 1362 packing group III Class 7: Un Nos. 2908 to 2911 Class 9: UN No. 3268 and empty, uncleaned packagings having contained dangerous goods, except for those classified in transport category 0" ;
              rdfs:label "4" ;
              gdsn:codeListName "DangerousGoodsTransportCategoryCode" ;
              gdsn:sourceId "170720" ;
