                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Phosphorus" ;
              rdfs:label "PHOSPHORUS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174236" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174237
gdsn:cv174237 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Phthalates or phthalate esters, are esters of phthalic acid. They are mainly used as plasticizers, i.e., substances added to plastics to increase their flexibility, transparency, durability, and longevity." ;
              rdfs:label "PHTHALATE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174237" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174238
gdsn:cv174238 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The edible seed of various pine trees." ;
              rdfs:label "PINENUTS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174238" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174239
gdsn:cv174239 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The pistachio is the edible pale green seed of an Asian tree. The pistachio is the evergreen tree of the cashew family that produces this nut, with small brownish-green flowers and reddish wrinkled fruit borne in heavy clusters. It is widely cultivated, especially in the US and around the Mediterranean." ;
              rdfs:label "PISTACHIOS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174239" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174240
gdsn:cv174240 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A product whose structure and protein content mimic that of a type of meat. Also known as meat replacement in some markets. The determination of this is made by the supplier and is subject to target market regulations or trade organisation guidelines." ;
              rdfs:label "PLANT_BASED_ALTERNATIVE_TO_MEAT" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174240" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174241
gdsn:cv174241 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The protein is derived from plant-based sources. There may be one or more sources of protein. Examples of vegetable protein sources are soy, oats or broad bean." ;
              rdfs:label "PLANT_PROTEIN" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174241" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174242
gdsn:cv174242 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Plant sterols are defined as cholesterol‐like substances that occur naturally at low levels in many fruits, vegetables, nuts and cereals. Plant sterols can help to improve cholesterol levels." ;
              rdfs:label "PLANT_STEROLS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174242" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174243
gdsn:cv174243 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Microbeads are really tiny plastic particles usually smaller than two millimeters. The composition of microbeads can vary and often include polyethylene (PE)." ;
              rdfs:label "POLYETHYLENE_MICROBEADS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174243" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174244
gdsn:cv174244 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
