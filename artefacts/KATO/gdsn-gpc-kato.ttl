###  urn:gs1:std:gdsn:cv177118
gdsn:cv177118 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of various woody or arborescent grasses (as of the genera Bambusa, Arundinaria, and Dendrocalamus of the subfamily Bambusoideae) of tropical and temperate regions having hollow stems, thick rhizomes, and shoots. The packaging may be in the form of paper, wood or leaves." ;
              rdfs:label "BAMBOO" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177118" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177119
gdsn:cv177119 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A class of materials manufactured by the conversion of natural cellulose to a soluble cellulosic derivative and subsequent regeneration, typically forming a film (e.g., cellophane)." ;
              rdfs:label "CELLULOSE_HYDRATE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177119" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177120
gdsn:cv177120 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific material made from clay and hardened by firing at a high temperatures. Examples can include Terra-cotta, Earthenware, Stoneware, Porcelain, and High-Tech Ceramics." ;
              rdfs:label "CERAMIC" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177120" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177121
gdsn:cv177121 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non specific material made by weaving, felting, knitting, or crocheting natural and/or synthetic fibers." ;
              rdfs:label "CLOTH_OR_FABRIC" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177121" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177122
gdsn:cv177122 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A material that is made from multiple materials." ;
              rdfs:label "COMPOSITE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177122" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177123
gdsn:cv177123 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cork is an impermeable buoyant material, the phellem layer of bark tissue that is harvested for commercial use primarily from Quercus suber (the cork oak)." ;
              rdfs:label "CORK_NATURAL" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177123" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177124
gdsn:cv177124 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A structure formed by five layers of cardboard: two fluted sheets and three linerboards (two outer liners and one intermediate liner). Also known as 5-layer type." ;
              rdfs:label "CORRUGATED_BOARD_DOUBLE_WALL" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177124" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177125
gdsn:cv177125 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The value needed is not listed or is not defined within this list’s individual code value and definitions of corrugated boards. Please send a work request into GS1 or your solution provider requesting the code you are searching for." ;
              rdfs:label "CORRUGATED_BOARD_OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177125" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177126
gdsn:cv177126 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A structure formed by three layers of cardboard: one fluted sheet and two outer linerboards. Also known as 3-layer type or double faced." ;
              rdfs:label "CORRUGATED_BOARD_SINGLE_WALL" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177126" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177127
gdsn:cv177127 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A structure formed by seven layers of cardboard: three fluted sheets and four linerboards (two outer liners and two intermediate liners). Also known as 7-layer type." ;
              rdfs:label "CORRUGATED_BOARD_TRIPLE_WALL" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177127" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177128
gdsn:cv177128 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The American name for cloth woven from jute plant skins and other vegetable fibres. In other parts of the world it is known as Hessian, Hessian cloth, or gunny from the Indian gain." ;
              rdfs:label "FIBRE_BURLAP" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177128" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177129
gdsn:cv177129 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A natural cellulosic seed-hair fiber, obtained from the seed pod of the cotton plant. First known in India about 3000 B.C." ;
              rdfs:label "FIBRE_COTTON" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177129" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177130
gdsn:cv177130 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The plant from the stem of which bast fiber is extracted by retting to produce linen. An erroneous term for linen fiber, particularly in blends." ;
              rdfs:label "FIBRE_FLAX" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177130" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177131
gdsn:cv177131 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Hemp is a commonly used term for varieties of the Cannabis plant. Hemp can yield fibre which can be used in ropes, cloths, weaves, as a reinforcement of polymer composites as well as pulps for paper making." ;
              rdfs:label "FIBRE_HEMP" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177131" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177132
gdsn:cv177132 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A bast fiber obtained from the round pod jute or the long pod jute of the family Tiliaceae. Jute ribbon is purely made from the jute plant. Grown extensively in Pakistan and India, mainly in the Bengal district of Pakistan." ;
              rdfs:label "FIBRE_JUTE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177132" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177133
gdsn:cv177133 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non specific material made of a unit of matter, either natural or manufactured, that forms the basic element of fabrics and other textile structures." ;
              rdfs:label "FIBRE_OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177133" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177134
gdsn:cv177134 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non specific material in a lightweight cellular form resulting from introduction of gas bubbles during manufacture, used to reduce shock and vibration or abrasion." ;
              rdfs:label "FOAM" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177134" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177135
gdsn:cv177135 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A substance mainly consisting of sand, lime and soda, fused at high temperatures and cooled quickly so that it solidifies to a vitreous or noncrystalline condition. This term applies to transparent clear glass or as a generic term if distinction with coloured glass is not desired. Example: sodocalcite." ;
              rdfs:label "GLASS" ;
              gdsn:codeListName "packagingMaterialTypeCode" ;
              gdsn:sourceId "177135" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177136
gdsn:cv177136 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Glass containing external colouring or glass that has been coloured by the addition of colouring agents/particles in its creation" ;
              rdfs:label "GLASS_COLOURED" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177136" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177137
gdsn:cv177137 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A material made up of laminates of paperboard, foil and polyethylene which combined form a sheet suitable for asceptic processing." ;
              rdfs:label "LAMINATED_CARTON" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177137" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177138
gdsn:cv177138 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non specific material made from aluminum or aluminum alloy." ;
              rdfs:label "METAL_ALUMINUM" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177138" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177139
gdsn:cv177139 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Brass is an alloy of copper and zinc." ;
              rdfs:label "METAL_BRASS" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177139" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177140
gdsn:cv177140 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Refers to an object that is composed of two separate metals joined together. Instead of being a mixture of two or more metals, like alloys, metal composites consist of layers of different metals." ;
              rdfs:label "METAL_COMPOSITE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177140" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177141
gdsn:cv177141 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A heavy metallic element (Fe) capable of being fashioned into a variety of forms." ;
              rdfs:label "METAL_IRON" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177141" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177142
gdsn:cv177142 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A bluish-white soft malleable ductile plastic but inelastic heavy metallic element (Pb)" ;
              rdfs:label "METAL_LEAD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177142" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177143
gdsn:cv177143 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non specific material made from metal or metal alloy material." ;
              rdfs:label "METAL_OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177143" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177144
gdsn:cv177144 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An alloy of steel with chromium and sometimes another element (as nickel or molybdenum) that is practically immune to rusting and ordinary corrosion" ;
              rdfs:label "METAL_STAINLESS_STEEL" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177144" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177145
gdsn:cv177145 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Commercial iron that contains carbon in any amount up to about 1.7 percent as an essential alloying constituent, is malleable when under suitable conditions, and is distinguished from cast iron by its malleability and lower carbon content." ;
              rdfs:label "METAL_STEEL" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177145" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177146
gdsn:cv177146 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Tin is a chemical element that is obtained chiefly from the mineral cassiterite, where it occurs as an oxide, SnO2. This silvery, malleable poor metal is not easily oxidized in air, and is used to coat other metals to prevent corrosion. It is used in many alloys, most notably bronze" ;
              rdfs:label "METAL_TIN" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177146" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177147
gdsn:cv177147 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ground calcium carbonate and precipitated calcium carbonate products serve as functional fillers in plastic and rubber applications. Calcium carbonate is widely used as in polyvinyl chloride (PVC), polyolefin, polypropylene (PP), polyethylene (PE) and unsaturated polyester resins applications." ;
              rdfs:label "MINERAL_CALCIUM_CARBONATE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177147" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177148
gdsn:cv177148 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any other mineral-based material not available in this list. Should be used as a temporary measure while a proper code is established" ;
              rdfs:label "MINERAL_OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177148" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177149
gdsn:cv177149 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Talc is used to stiffen thermoplastics, mainly polypropylene but also polyethylene and polyamide (Nylon)." ;
              rdfs:label "MINERAL_TALC" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177149" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177150
gdsn:cv177150 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A strong elastic material made by drying the sap from various tropical trees, especially the American rubber tree." ;
              rdfs:label "NATURAL_RUBBER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177150" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177151
gdsn:cv177151 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The value needed is not listed or is not defined within this list’s individual code values and definitions. Please send a work request into GS1 or your solution provider requesting the code you are searching for." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177151" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177152
gdsn:cv177152 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Heavy paper with ridges and grooves, used in packing fragile articles." ;
              rdfs:label "PAPER_CORRUGATED" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177152" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177153
gdsn:cv177153 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Kraft paper is the paper grade with the highest strength. It is used for the production of e.g. paper bags, emery paper or shopping bags." ;
              rdfs:label "PAPER_KRAFT" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177153" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177154
gdsn:cv177154 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The wet-strength kraft paper has a certain tear strength when wet due to special additives. It is used for the production of e.g. paper bags, emery paper or shopping bags." ;
              rdfs:label "PAPER_KRAFT_WET_STRENGTH" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177154" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177155
gdsn:cv177155 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Used for producing pulp-based or fibrous products by pressing; example products: egg packages, trays and boxes for fruits and vegetables." ;
              rdfs:label "PAPER_MOLDED_PULP" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177155" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177156
gdsn:cv177156 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any other paper-based material not available in this list. Should be used as a temporary measure while a proper code is established." ;
              rdfs:label "PAPER_OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177156" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177157
gdsn:cv177157 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific sheet material produced by the matting of fibres from wood, rags, or other fibrous materials. Generally, paper is of a lesser thickness or weight than paperboard." ;
              rdfs:label "PAPER_PAPER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177157" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177158
gdsn:cv177158 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non specific material, generally made from cotton or wood, that describe a variety or of board materials used in the production of boxes, folding cartons, and solid fibre and corrugated shipping containers; also termed cardboard" ;
              rdfs:label "PAPER_PAPERBOARD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177158" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177159
gdsn:cv177159 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Generic term for a manmade fiber derived from regenerated cellulose." ;
              rdfs:label "PAPER_RAYON" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177159" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177160
gdsn:cv177160 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Plant leaves, such as banana leaves, including wet or dry leaves. In some cases, leaves are pre-softened by steaming." ;
              rdfs:label "PLANT_LEAVES" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177160" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177161
gdsn:cv177161 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Plastic materials made from biomass, but may have exactly the same properties as ordinary plastic. Sometimes these plastics are biodegradable." ;
              rdfs:label "PLASTIC_BIO_PLASTIC" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177161" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177162
gdsn:cv177162 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific material made of any of numerous organic synthetic or processed materials that are mostly thermoplastic or thermosetting polymers of high molecular weight and that can be made into objects, films, or filaments." ;
              rdfs:label "PLASTIC_OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177162" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177163
gdsn:cv177163 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific substance that becomes soft and pliable when heated, without a change in its intrinsic properties. Polystyrene and polyethylene are thermoplastics." ;
              rdfs:label "PLASTIC_THERMOPLASTICS" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177163" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177164
gdsn:cv177164 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyethylene Terephthalate, amorphous (APET) has a very high transparency, is flame retardant and suitable for direct food contact. It is used for packaging of all kinds." ;
              rdfs:label "POLYMER_APET" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177164" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177165
gdsn:cv177165 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Biaxially oriented PP (BOPP) films are characterized by their tear, impact and puncture resistance. The film is mainly used in food packaging, e.g. as candy wrap or wrapping for chocolate bars." ;
              rdfs:label "POLYMER_BOPP" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177165" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177166
gdsn:cv177166 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cellulose acetate is one of the most important esters of cellulose. Depending on the way it has been processed cellulose acetate can be used for a wide variety of applications, e.g. films, membranes or fibers." ;
              rdfs:label "POLYMER_CELLULOSE_ACETATE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177166" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177167
gdsn:cv177167 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Crystallized polyethylene terephthalate (CPET) is a variation of standard PET which has been crystallized for heat resistance, rigidity, and toughness" ;
              rdfs:label "POLYMER_CPET" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177167" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177168
gdsn:cv177168 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Epoxy resins are thermoset polymers which are frequently used as coatings for metal packaging such as soft-drink cans." ;
              rdfs:label "POLYMER_EPOXY" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177168" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177169
gdsn:cv177169 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Expanded polystyrene is a rigid, tough, closed cell and lightweight thermoplastic foam material. It is manufactured by expanding spherical beads in a mold, using heat and pressure to fuse the beads together. While each individual bead is a closed cell environment, there are significant open spaces between each bead." ;
              rdfs:label "POLYMER_EPS" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177169" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177170
gdsn:cv177170 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ethylene vinyl acetate, a copolymer of 60 to 90% ethylene and 40 to 10% vinyl acetate. Packaging applications include soft films, coatings, hot melt adhesives, wine cork substitutes, and closure seals for plastic and metal container caps." ;
              rdfs:label "POLYMER_EVA" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177170" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177171
gdsn:cv177171 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ethylene vinyl alcohol, a copolymer of ethylene and vinyl alcohol. A plastic resin commonly used in food applications to provide barrier to oxygen and other gases." ;
              rdfs:label "POLYMER_EVOH" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177171" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177172
gdsn:cv177172 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "High-Density PolyEthylene (HDPE) is a polyethylene thermoplastic made from petroleum. A strong, relatively opaque form of polyethylene having a dense structure with few side branches off the main carbon backbone. Can be applied to bottles, flasks and caps." ;
              rdfs:label "POLYMER_HDPE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177172" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177173
gdsn:cv177173 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Low-density polyethylene (LDPE) is a polyethylene thermoplastic made from petroleum. A strong form of polyethylene having a less dense structure with more side branches off the main carbon backbone (on about 2% of the carbon atoms) than HDPE; therefore its tensile strength is lower, and its resilience is higherMade in translucent or opaque variations, it is quite flexible, and tough to the degree of being almost unbreakable. It is widely used for manufacturing various containers, dispensing bottles, wash bottles, tubing, plastic bags for computer components, and various moulded laboratory equipment. Its most common use is in plastic bags." ;
              rdfs:label "POLYMER_LDPE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177173" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177174
gdsn:cv177174 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Linear low density polyethylene is a linear polyethylene with a significant number of short branches on the polymer backbone. It is commonly made by copolymerization of ethylene with longer-chain olefins. It is different from LDPE due to the absence of long chain branches which gives it higher tensile strength, impact and puncture resistance than LDPE. Common uses of LLDPE are plastic bags, wraps, stretch wraps, pouches, covers and lids." ;
              rdfs:label "POLYMER_LLDPE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177174" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177175
gdsn:cv177175 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Medium-density polyethylene is a type of polyethylene defined by a density range of 0.926-0.940 g/cm3. MDPE is typically used in shrink films, sacks, packaging film and carrier bags." ;
              rdfs:label "POLYMER_MDPE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177175" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177176
gdsn:cv177176 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Packaging applications include oven-baking bags (nylon 6 and nylon 66) and barrier layers (MXD6 and nylon 6) for PET and HDPE bottles. Very occasionally, bottles can be made of nylon." ;
              rdfs:label "POLYMER_NYLON" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177176" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177177
gdsn:cv177177 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Oriented polypropylene (OPP) is made of a soft polypropylene material which is stretched in a transverse or longitudinal direction (monoaxial) and becomes therefore brittle. Also known as: biaxially oriented polypropylene (BOPP), CAS Registry Number: 9003-07-0" ;
              rdfs:label "POLYMER_OPP" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177177" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177178
gdsn:cv177178 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific chemical compound or mixture of compounds formed by polymerization and consisting essentially of repeating structural units" ;
              rdfs:label "POLYMER_OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177178" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177179
gdsn:cv177179 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A polymer with repeating units linked by amide bonds. Polyamides (PA) occur both naturally and artificially, examples of naturally occurring polyamides are proteins, such as wool and silk. Artificially made polyamides can be nylons, aramids, and sodium poly(aspartate)." ;
              rdfs:label "POLYMER_PA" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177179" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177180
gdsn:cv177180 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyacrylonitril is a organic polymer which is frequently used in fibres for textiles. As fibres the material is frequently referred to as Acrylic." ;
              rdfs:label "POLYMER_PAN" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177180" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177181
gdsn:cv177181 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polycarbonate, a transparent thermoplastic which is used in a wide variety of applications including CDs and DVDs, eyeglasses, cell phone covers, laptops as well as packaging applications such as bottles." ;
              rdfs:label "POLYMER_PC" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177181" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177182
gdsn:cv177182 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polycaprolactone is a biodegradable polyester which is also used in in the manufacturing of polyurethanes. It is also used in blends with thermoplastic starch to improve properties and can also be used as a plasticizer to PVC." ;
              rdfs:label "POLYMER_PCL" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177182" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177183
gdsn:cv177183 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A thermoplastic composed of the polymers of ethylene." ;
              rdfs:label "POLYMER_PE" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177183" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177184
gdsn:cv177184 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyethylene naphthalate is a polymer with good barrier properties (unlike Polyethylene terephthalate). It is well-suited for production of the amber-colored bottles meant for packing beverages like beer." ;
              rdfs:label "POLYMER_PEN" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177184" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177185
gdsn:cv177185 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyethylene terephthalate is a thermoplastic polymer resin of the polyester family and is used in synthetic fibers. Can be applied to bottles, flasks and caps." ;
              rdfs:label "POLYMER_PET" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177185" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177186
gdsn:cv177186 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyethylene Terephthalate Glycol (PETG) is a PET modified with glycol, which is characterized by its aqueous properties (viscosity). Applications are found in injection molding." ;
              rdfs:label "POLYMER_PETG" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177186" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177187
gdsn:cv177187 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyhydroxyalkanoates are linear polyesters produced in nature by bacterial fermentation of sugar or lipids." ;
              rdfs:label "POLYMER_PHA" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177187" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177188
gdsn:cv177188 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polylactic acid or Polylactide is a biodegradable, thermoplastic, aliphatic polyester derived from lactic acid." ;
              rdfs:label "POLYMER_PLA" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177188" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177189
gdsn:cv177189 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polymethyl Methacrylate (PMMA) is often used as a lightweight and shatterproof alternative to glass, due to its transparency, brilliance and scratch resistance, PMMA is therefore often referred to as acrylic glass." ;
              rdfs:label "POLYMER_PMMA" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177189" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177190
gdsn:cv177190 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyoxymethylene (POM) is a thermoplastic with good mechanical properties and high dimensional stability. Fields of application are the automotive industry and electrical engineering, in packaging it is used for e.g. spray cans, gas lighter tanks, gas ampoules. Also known as acetal, polyacetal, and polyformaldehyde." ;
              rdfs:label "POLYMER_POM" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177190" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177191
gdsn:cv177191 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific material made of various thermoplastic plastics or fibers that are polymers of propylene." ;
              rdfs:label "POLYMER_PP" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177191" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177192
gdsn:cv177192 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A polymer prepared by the polymerization of styrene as the sole monomer" ;
              rdfs:label "POLYMER_PS" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177192" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177193
gdsn:cv177193 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyurethanes are primarily thermoset resins which are used in the manufacture of flexible and rigid foams, microcellular foam seals and gaskets, as well as high performance adhesives, surface coatings and sealants. Polyurethane can also be used to make synthetic fibers." ;
              rdfs:label "POLYMER_PU" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177193" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177194
gdsn:cv177194 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyvinyl alcohol (PVA or PVOH) is a biodegradable and highly water soluble polymer with high gas and grease barrier. Common uses for PVA are paper adhesives, paper coatings, as a self-standing water soluble films as well as blends to improve processability of thermoplastic starch." ;
              rdfs:label "POLYMER_PVA" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177194" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177195
gdsn:cv177195 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A polymer of vinyl chloride used especially for electrical insulation, films, and pipes" ;
              rdfs:label "POLYMER_PVC" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177195" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177196
gdsn:cv177196 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyvinylidene chloride is primarily used as a barrier coating to provide barrier against fat, vapour and gases." ;
              rdfs:label "POLYMER_PVDC" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177196" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177197
gdsn:cv177197 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Styrene acrylonitrile (SAN) is a copolymer transparent and rigid plastic. Examples of applications are kitchenware and cosmetic packaging." ;
              rdfs:label "POLYMER_SAN" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177197" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177198
gdsn:cv177198 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Thermoplastic starch is obtained through destructurization of natural starch through exposure to shear and heat. TPS is most frequently used in blends with biodegradable synthetic polymers such as PCL and PVA." ;
              rdfs:label "POLYMER_TPS" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177198" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177199
gdsn:cv177199 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Extruded polystyrene is a rigid, tough, closed cell and lightweight thermoplastic foam material. It is manufactured using a process of extrusion that produces a homogeneous \"closed cell\" matrix with each cell fully enclosed by polystyrene walls." ;
              rdfs:label "POLYMER_XPS" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177199" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177200
gdsn:cv177200 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A strong elastic synthetic substance made either by improving the qualities of natural rubber or by an industrial process using petroleum and coal products" ;
              rdfs:label "RUBBER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177200" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177201
gdsn:cv177201 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non-specific polymer of a vinyl compound or a product (as a resin or a textile fiber) made from such a polymer" ;
              rdfs:label "VINYL" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177201" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177202
gdsn:cv177202 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Hardboard (not to be confused with hardwood), also called High-Density Fiberboard (HDF), is a type of fiberboard, which is similar to particle board and medium-density fiberboard, but is denser, much stronger and harder because it is made out of exploded wood fibers which have been highly compressed. Consequently, the density of hardboard is 31 lbs or more per cubic foot (500 kg/m³)[2] and is usually about 50-65 lbs per cubic foot (800–1040 kg/m³). It differs from particle board in that the bonding of the wood fibers requires no additional materials, although resin is often added. Unlike particle board, it will not split or crack." ;
              rdfs:label "WOOD_HARDBOARD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177202" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177203
gdsn:cv177203 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A general term referring to any variety of broad-leaved, deciduous trees, and the wood from those trees. The term has nothing to do with the actual hardness of the wood; some hardwoods are softer than certain softwood (evergreen) species." ;
              rdfs:label "WOOD_HARDWOOD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177203" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177204
gdsn:cv177204 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Medium-Density Fibreboard (MDF) is an engineered wood product made by breaking down hardwood or softwood residuals into wood fibres, combining them with wax and a resin binder, and forming panels by applying high temperature and pressure. MDF is generally denser than plywood. It is made up of separated fibres, but can be used as a building material similar in application to plywood. It is stronger and much more dense than particle board." ;
              rdfs:label "WOOD_MEDIUM_DENSITY_FIBREBOARD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177204" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177205
gdsn:cv177205 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Oriented Strand Board (OSB), also known as sterling board, sterling OSB, aspenite, and smartply, is an engineered wood particle board formed by adding adhesives and then compressing layers of wood strands (flakes) in specific orientations. OSB may have a rough and variegated surface with the individual strips of around 2.5 × 15 cm (1\" × 6\"), lying unevenly across each other and comes in a variety of types." ;
              rdfs:label "WOOD_ORIENTED_STRANDBOARD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177205" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177206
gdsn:cv177206 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A non specific material made from the hard fibrous lignified substance under the bark of trees." ;
              rdfs:label "WOOD_OTHER" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177206" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177207
gdsn:cv177207 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Particle Board, also known as particleboard, chipboard, and Low-Density Fiberboard (LDF), is an engineered wood product manufactured from wood chips, sawmill shavings, or sawdust, and a synthetic resin or other suitable binder, which is pressed and extruded. Particle board is a composite material." ;
              rdfs:label "WOOD_PARTICLE_BOARD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177207" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177208
gdsn:cv177208 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Plywood, a manufactured wood panel similar to LDF, MDF, and HDF, is made from layering thin sheets of wood. Plywood layers (called veneers or plies) are glued together, with adjacent plies having their wood grain rotated relative to adjacent layers up to 90 degrees. All plywoods bind resin and wood fibre sheets (cellulose cells are long, strong and thin) to form a composite material." ;
              rdfs:label "WOOD_PLYWOOD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177208" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177209
gdsn:cv177209 rdf:type owl:NamedIndividual ,
                       gdsn:c318819073 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "General term used to describe lumber produced from needle and/or cone bearing trees (Conifers)." ;
              rdfs:label "WOOD_SOFTWOOD" ;
              gdsn:codeListName "PackagingMaterialTypeCode" ;
              gdsn:sourceId "177209" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177210
gdsn:cv177210 rdf:type owl:NamedIndividual ,
                       gdsn:c-638314018 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The packaging material is made from bio-based polymers whole or partially from renewable biological resources, like sugar cane, starch." ;
              rdfs:label "BIOLOGICAL_PLASTIC" ;
              gdsn:codeListName "PackagingRawMaterialCode" ;
              gdsn:sourceId "177210" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177211
gdsn:cv177211 rdf:type owl:NamedIndividual ,
                       gdsn:c-638314018 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The packaging material is made from crude oil." ;
              rdfs:label "CRUDE_OIL" ;
              gdsn:codeListName "PackagingRawMaterialCode" ;
              gdsn:sourceId "177211" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177212
gdsn:cv177212 rdf:type owl:NamedIndividual ,
                       gdsn:c-638314018 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The packaging material is made from virgin, non-recycled raw materials, such as aluminium or wood." ;
              rdfs:label "NEW_RAW_MATERIAL_OTHER" ;
              gdsn:codeListName "PackagingRawMaterialCode" ;
              gdsn:sourceId "177212" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177213
gdsn:cv177213 rdf:type owl:NamedIndividual ,
                       gdsn:c-638314018 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The packaging material is made from post consumer recycled content." ;
              rdfs:label "RECYCLED" ;
              gdsn:codeListName "PackagingRawMaterialCode" ;
              gdsn:sourceId "177213" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177214
gdsn:cv177214 rdf:type owl:NamedIndividual ,
                       gdsn:c-972462914 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Packaging and the environment — Organic recycling For each of the packaging components the following four aspects are addressed: a) biodegradation b) disintegration during biological waste treatment process (i.e. composting); c) negative effects on the biological process; d) negative effects on the quality of the resulting compost, including the persistence of high levels of regulated metals and other substances, hazardous to the environment." ;
              rdfs:label "COMPOSTING_ORGANIC_RECOVERY" ;
              gdsn:codeListName "PackagingRecoveryRateTypeCode" ;
              gdsn:sourceId "177214" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177215
gdsn:cv177215 rdf:type owl:NamedIndividual ,
                       gdsn:c-972462914 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "To allow optimization of energy recovery in a real industry system, the theoretical calorific gain shall be well above zero. To claim energy recovery qnet shall be equal to greater than qnet,min,real as defined for various incineration conditions. Reference ISO18605:2013(E) Annex A." ;
              rdfs:label "ENERGY_RECOVERY" ;
              gdsn:codeListName "PackagingRecoveryRateTypeCode" ;
              gdsn:sourceId "177215" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177216
gdsn:cv177216 rdf:type owl:NamedIndividual ,
                       gdsn:c-972462914 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The supplier shall be able to demonstrate that the procedures defined in normative ISO 18604:2013(E) Annexes A and ISO 18604:2013(E) B have been followed in arriving at the final design of the finish" ;
              rdfs:label "MATERIAL_RECYCLING" ;
              gdsn:codeListName "PackagingRecoveryRateTypeCode" ;
              gdsn:sourceId "177216" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177217
gdsn:cv177217 rdf:type owl:NamedIndividual ,
                       gdsn:c-972462914 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Code value not available in code list." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "PackagingRecoveryRateTypeCode" ;
              gdsn:sourceId "177217" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177218
gdsn:cv177218 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348043 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The German minimum standard for determining the recyclability of packaging, subject to system packaging pursuant to section 21 (3) VerpackG (Verpackungsgesetz–Packaging Act)." ;
              rdfs:label "DEUTSCHER_MINDESTSTANDARD" ;
              gdsn:codeListName "PackagingRecyclabilityAssessmentSpecificationCode" ;
              gdsn:sourceId "177218" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177219
gdsn:cv177219 rdf:type owl:NamedIndividual ,
                       gdsn:c-355883579 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Code value not available in code list." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "PackagingRecycledContentTypeCode" ;
              gdsn:sourceId "177219" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177220
gdsn:cv177220 rdf:type owl:NamedIndividual ,
                       gdsn:c-355883579 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ratio of post-consumer recycled material (post-consumer and pre consumer as defined by ISO 14021) to total material used in packaging constituents, packaging components, or packaging systems." ;
              rdfs:label "POST_CONSUMER_RECYCLED_CONTENT" ;
              gdsn:codeListName "PackagingRecycledContentTypeCode" ;
              gdsn:sourceId "177220" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177221
gdsn:cv177221 rdf:type owl:NamedIndividual ,
                       gdsn:c-355883579 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ratio of pre-consumer recycled material (post-consumer and pre consumer as defined by ISO 14021) to total material used in packaging constituents, packaging components, or packaging systems" ;
              rdfs:label "PRE_CONSUMER_RECYCLED_CONTENT" ;
              gdsn:codeListName "PackagingRecycledContentTypeCode" ;
              gdsn:sourceId "177221" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177222
gdsn:cv177222 rdf:type owl:NamedIndividual ,
                       gdsn:c-760519534 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Packaging that can biodegrade generating a relatively homogeneous and stable humus-like substance." ;
              rdfs:label "COMPOSTABLE" ;
              gdsn:codeListName "PackagingRecyclingProcessTypeCode" ;
              gdsn:sourceId "177222" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177223
gdsn:cv177223 rdf:type owl:NamedIndividual ,
                       gdsn:c-760519534 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Packaging which allows for a net calorific gain in energy recovery operations." ;
              rdfs:label "ENERGY_RECOVERABLE" ;
              gdsn:codeListName "PackagingRecyclingProcessTypeCode" ;
              gdsn:sourceId "177223" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177224
gdsn:cv177224 rdf:type owl:NamedIndividual ,
                       gdsn:c-760519534 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Packaging material and format which can be diverted from the waste stream through available processes and programmes and can be collected, processed and returned to use in the form of raw materials or products." ;
              rdfs:label "RECYCLABLE" ;
              gdsn:codeListName "PackagingRecyclingProcessTypeCode" ;
              gdsn:sourceId "177224" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177225
gdsn:cv177225 rdf:type owl:NamedIndividual ,
                       gdsn:c-760519534 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Packaging that has been conceived and designed to accomplished within its life cycle a certain number of trips, rotations or uses for the same purpose for which it was conceived." ;
              rdfs:label "REUSABLE" ;
              gdsn:codeListName "PackagingRecyclingProcessTypeCode" ;
              gdsn:sourceId "177225" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177226
gdsn:cv177226 rdf:type owl:NamedIndividual ,
                       gdsn:c-1205694018 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Recycling scheme code 1 relates to Polyethylene terephthalates. These recyclables represent polyester fibres' (Polar Fleece), thermoformed sheet, strapping, soft drink bottles, tote bags, furniture, carpet, panelling and (occasionally) new containers which can be picked up through most curb side recycling programs." ;
              rdfs:label "1" ;
              gdsn:codeListName "PackagingRecyclingSchemeCode" ;
              gdsn:sourceId "177226" ;
              gdsn:sourceType "codeValue" .


