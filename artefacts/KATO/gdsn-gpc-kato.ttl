                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A count of attenuation steps or dilution levels representing the homeopathic potency of a substance where each attenuation step represents one part source material combined with 49,999 parts dilution medium; commonly denoted as LM1, LM2, LM3, etc." ;
