###  urn:gs1:std:gdsn:cv174795
gdsn:cv174795 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "GÄA - Gäa is a diverse farming association for farmers, processors and traders inside.Focal point is Germany. Gäa is a special design for the structure of the organic farming. Biokreis- The Biokreis is an association for organic farming. Currently more than 800 farms, 80 and 200 processors, consumers are members of Biokreis, committed to working together on more than 33,000 for organic and sustainable farming." ;
              rdfs:label "11" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174795" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174796
gdsn:cv174796 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Naturland - Naturland is active the world over in promoting organic agriculture. Its members are farmers who produce a wide range of valuable products: coffee from Mexico and Peru, olive oil from Greece, tea from the slopes of India’s mountains, pineapple and other tropical fruit from Uganda, spices from Sri Lanka. Organic agriculture safeguards the existence of smallholders and helps with the sustainable management of what are often fragile ecosystems. On a global scale, over 50,000 Naturland farmers are cultivating an area of over 142,000 hectares." ;
              rdfs:label "12" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174796" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174797
gdsn:cv174797 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Biopark - Biopark is an organic farmers’ association based in the North of Germany, in Mecklenburg-Vorpommerania." ;
              rdfs:label "13" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174797" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174798
gdsn:cv174798 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ecovin - ECOVIN Federation Organic Viticulture Association: ECOVIN largest merger in 1985 as ecologically-working wine estates in Germany was founded. Approximately 220 member companies currently manage 1,600 hectares of vineyards in 11 German wine-growing areas." ;
              rdfs:label "14" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174798" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174799
gdsn:cv174799 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "IFOAM - The International Federation of Organic Agriculture Movements (IFOAM) is a grassroots and democratic organisation that currently unites 750 member organisations in 116 countries. Note: this value will be deleted in the future and should not be used." ;
              rdfs:label "15" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174799" ;
              gdsn:sourceType "codeValue" .


