###  urn:gs1:std:gdsn:cv177057
gdsn:cv177057 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: Based on ISO26000 (social responsibility). Private, France - Started with a charter created by 10 producers in 2007, and is still producer run. The charter has 37 commitments. The cellars create their own specific performance goals which must be met. The individual performance goals are to be used as a framework for decision making. v-dd.com" ;
              rdfs:label "VIGNERONS_EN_DEVELOPPEMENT_DURABLE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://v-dd.com/" ;
              gdsn:sourceId "177057" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177058
gdsn:cv177058 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The logo marks quality foodstuffs that are nutritionally balanced. Food and beverages products marked with logo “Vím, co jím” contain less salt, added sugars, trans-fatty acids and saturated fatty acids. For some product categories, it informs the consumer that the product is rich of fiber and/or contain appropriate amount of energy (calories). The same logo is used in both the Czech Republic (under the name “Vím, co jím”) and Slovakia (under the name “Viem, čo jem”). This program is part of the global program “The Choices Programme”. https://www.vimcojim.cz" ;
              rdfs:label "VIM_CO_JIM" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.vimcojim.cz" ;
              gdsn:sourceId "177058" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177059
gdsn:cv177059 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Swiss wine out of sustainable production." ;
              rdfs:label "VINATURA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://vinatura.ch/de/" ;
              gdsn:sourceId "177059" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177060
gdsn:cv177060 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Seal of Guarantee certifies the authenticity and genuineness of Vinho Verde, assuring its origin and strict controls carried out at all stages of the production process, from the vineyard to the glass. Each stamp is unique, with coding both unique and traceable." ;
              rdfs:label "VINHO_VERDE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.vinhoverde.pt/en/bottle-history" ;
              gdsn:sourceId "177060" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177061
gdsn:cv177061 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: Viticulture Durable en Champagne. Regional, Champagne, France. French wine region with own certification. Similar to national HVE. Champagne as a region has recognised the need to go from being the least sustainable wine region in France to the most - especially as it is vulnerable to global warming, image effects and quality questions of bulk grape purchases. https://www.champagne.fr/en/viticulture-durable/" ;
              rdfs:label "VITICULTURE_DURABLE_EN_CHAMPAGNE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.champagne.fr/en/viticulture-durable/" ;
              gdsn:sourceId "177061" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177062
gdsn:cv177062 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certification: Equalitas does not consider VIVA to be a certification but a “declaration” of data results. National, governmental, Italy. First sustainability certification of wine to be directly promoted by a national government. http://www.viticolturasostenibile.org/EN" ;
              rdfs:label "VIVA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.viticolturasostenibile.org/EN/" ;
              gdsn:sourceId "177062" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177063
gdsn:cv177063 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The French agricultural organizations have created a common visual identity in order to highlight the French origin of agricultural products in this case poultry products: the signatures \"Agricultural Products of France\". Remarkable to their elegant silhouette in a tricolor pentagon that is available for each family of products, these signatures reflect the commitment of the professionals of the sectors to value the know-how, the territories and the French jobs. Covering a variety of productions, these signatures all have a common basis, which consists of four criteria: Origin France of the products concerned, The existence of specifications or regulations governing the use of the logo, A formal commitment from the operators of the sectors concerned wishing to use these logos, Controls performed by a third party." ;
              rdfs:label "VOLAILLE_FRANCAISE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.produitsagricolesdefrance.fr" ;
              gdsn:sourceId "177063" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177064
gdsn:cv177064 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Becoming an official supplier to the Belgian Court is a source of particular pride for a craftsman or company to seeing their talent and professionalism rightly recognized by His Majesty the King." ;
              rdfs:label "WARRANT_HOLDER_OF_THE_COURT_OF_BELGIUM" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.dghb.be/en/" ;
              gdsn:sourceId "177064" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177065
gdsn:cv177065 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A certification given in the Netherlands to dairy products made from milk produced by cattle (bovine) that is allowed to roam free in the pasture for at least a minimum of 120 days in a year." ;
              rdfs:label "WEIDEMELK" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.weidemelk.nl/en/" ;
              gdsn:sourceId "177065" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177066
gdsn:cv177066 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Foods and meals in the Weight Watchers program are assigned points, and you're allotted a certain number of points daily depending on your initial body weight and weight loss goals. Some packaged food brands and even certain restaurants have teamed up with Weight Watchers to promote this healthy point-based weight-loss program." ;
              rdfs:label "WEIGHT_WATCHERS_ENDORSED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.weightwatchers.com/us/" ;
              gdsn:sourceId "177066" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177067
gdsn:cv177067 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Welfare Quality states that the welfare of the animals both on the farm and during slaughter is followed in accordance with the welfare quality procedure. Consumers know that the welfare of the animals is protected." ;
              rdfs:label "WELFARE_QUALITY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.welfarequality.net/media/1067/wq___overall_scoring_english.pdf" ;
              gdsn:sourceId "177067" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177068
gdsn:cv177068 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Western Kosher provides assistance with Kashruth supervision by certifying bakeries, butcher shops, caterers, restaurants, hotels, manufacturers or processors involved in producing Kosher food products for year-round use for Canada and the United States. Western Kosher, formerly the Vaad Ha'ir of Winnipeg, provides its 120 licensees with the North American standard of kashruth – a standard adhered to throughout all of Canada and the U.S." ;
              rdfs:label "WESTERN_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://westernkosher.com/" ;
              gdsn:sourceId "177068" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177069
gdsn:cv177069 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Whole Grain 100 Percent Stamp is a program of The Whole Grain Council. The Whole Grains Council helps consumers find whole grain foods and understand their health benefits; helps manufacturers and restaurants create delicious whole grain foods; and helps the media write accurate, compelling stories about whole grains. If a product bears the 100% Stamp, then all its grain ingredients are whole grains. There is a minimum requirement of 16g (16 grams) – a full serving – of whole grain per labelled serving, for products using the 100% Stamp." ;
              rdfs:label "WHOLE_GRAIN_100_PERCENT_STAMP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://wholegrainscouncil.org/whole-grain-stamp/canadian-stamp" ;
              gdsn:sourceId "177069" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177070
gdsn:cv177070 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Whole Grain Basic Stamp is a program of The Whole Grain Council. The Whole Grains Council helps consumers find whole grain foods and understand their health benefits; helps manufacturers and restaurants create delicious whole grain foods; and helps the media write accurate, compelling stories about whole grains. If a product bears the Basic Stamp, it contains at least 8g (8 grams) – a half serving – of whole grain, but may also contain some refined grain. Even if a product contains large amounts of whole grain (23g, 37g, 41g, etc.), it will use the Basic Stamp if it also contains extra bran, germ, or refined flour." ;
              rdfs:label "WHOLE_GRAIN_BASIC_STAMP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://wholegrainscouncil.org/whole-grain-stamp/canadian-stamp" ;
              gdsn:sourceId "177070" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177071
gdsn:cv177071 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Whole Grain Stamp is a certification symbol from the Oldways Whole Grains Council that communicates the gram amount of whole grain in a product. There are three different versions of the Whole Grain Stamp that can appear on packages (the 100% Stamp, the 50%+ Stamp, and the Basic Stamp), depending on what percentage of the grain ingredients are whole grain (or in Canada, what percentage of the product weight is whole grain)." ;
              rdfs:label "WHOLE_GRAIN_COUNCIL_STAMP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://wholegrainscouncil.org/whole-grain-stamp/canadian-stamp" ;
              gdsn:sourceId "177071" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177072
gdsn:cv177072 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "If a product bears the 50%+ Stamp, then at least half of its grain ingredients are whole grain. There is a minimum requirement of 8 grams– a half serving – of whole grain per labelled serving, for products using the 50%+ Stamp." ;
              rdfs:label "WHOLE_GRAINS_50_PERCENT_STAMP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://wholegrainscouncil.org/whole-grain-stamp" ;
              gdsn:sourceId "177072" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177073
gdsn:cv177073 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Wine and Agricultural Ethical Trading Association (WIETA). WIETA’s vision is to promote fair treatment, respectful relationships and dignified lives toward achieving a transformed agricultural sector." ;
              rdfs:label "WIETA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://wieta.org.za/" ;
              gdsn:sourceId "177073" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177074
gdsn:cv177074 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Sustainable Wineries for Climate Protection (SWfCP) certification, developed by the Spanish Wine Federation (FEV), is aimed at the continuous improvement and sustainability of wineries, acting on four fundamental pillars: Environmental, Social, Economic and Governance to align with the Sustainable Development Goals (SDGs). Note: it’s the evolution of the sustainability seal, \"Wineries for Climate Protection ’, which was created in 2015." ;
              rdfs:label "WINERIES_FOR_CLIMATE_PROTECTION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.wineriesforclimateprotection.com/" ;
              gdsn:sourceId "177074" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177075
gdsn:cv177075 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Kosher Supervisors of Wisconsin Certification" ;
              rdfs:label "WISCONSIN_K" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.kosherwisconsin.com/" ;
              gdsn:sourceId "177075" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177076
gdsn:cv177076 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "WQA's Certified Product Listings are available to help connect consumers with water treatment products that have been tested and certified to industry standards. WQA's Gold Seal Product Certification Program ensures that the product is constructed or formulated from safe materials, the claims listed on the packaging are backed by test data, and the product will hold up under normal usage conditions." ;
              rdfs:label "WQA_TESTED_CERTIFIED_WATER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.wqa.org/product-cert" ;
              gdsn:sourceId "177076" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177077
gdsn:cv177077 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Washington State Department of Agriculture Organic Food Program, Washington State Department of Agriculture Organic Food Program (WSDA) Organic Food Program The WSDA Organic Food Program, a USDA-accredited certifier, upholds the integrity of the organic label through certification and inspection of organic crop and livestock producers, processors, handlers and retailers. Whether you are looking to market your organic product at home or abroad, WSDA offers certification services to meet your needs. Please browse below to find out how WSDA can put your business on the path to certification." ;
              rdfs:label "WSDA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://agr.wa.gov/FoodAnimal/Organic/" ;
              gdsn:sourceId "177077" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177078
gdsn:cv177078 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products that support the WWF http://www.worldwildlife.org/" ;
              rdfs:label "WWF_PANDA_LABEL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.worldwildlife.org/" ;
              gdsn:sourceId "177078" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177079
gdsn:cv177079 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This label is awarded to companies that support (through their products or services) the preservation of rare or uncommon cattle and animal sorts." ;
              rdfs:label "ZELDZAAM_LEKKER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.zeldzaamlekker.nl/page/over_zeldzaamlekker/" ;
              gdsn:sourceId "177079" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177080
gdsn:cv177080 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "U.S. Zero Waste Business Council Certification Program is created by U.S. Zero Waste Business Council. It is the first third-party Zero Waste Facility Certification program for facilities that meet the requests of Zero Waste Business for a valid, comprehensive verification of their Zero Waste achievements." ;
              rdfs:label "ZERO_WASTE_BUSINESS_COUNCIL_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://uszwbc.org/certification/" ;
              gdsn:sourceId "177080" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177081
gdsn:cv177081 rdf:type owl:NamedIndividual ,
                       gdsn:c-1306027989 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The front of package nutrient label displays important nutrition information from the nutrition facts panel (found on the back and sides of packages) in a clear, simple and easy-to-use format on the front of food and beverage packages. This subset of the nutrition information will assist the consumer in their purchasing decisions by highlighting specific nutrients." ;
              rdfs:label "FRONT_OF_PACKAGE" ;
              gdsn:codeListName "PackagingMarkedNutritionLabelCode" ;
              gdsn:sourceId "177081" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177082
gdsn:cv177082 rdf:type owl:NamedIndividual ,
                       gdsn:c25785491 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The material has been treated to have additional resistance to deformation or change." ;
              rdfs:label "CHEMICALLY_HARDENED" ;
              gdsn:codeListName "PackagingMaterialAppliedProcessCode" ;
              gdsn:sourceId "177082" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177083
gdsn:cv177083 rdf:type owl:NamedIndividual ,
                       gdsn:c25785491 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The material has been subjected to compressive stress which results in reduction of volume as compared to an uncompressed but otherwise identical state." ;
              rdfs:label "COMPRESSED" ;
              gdsn:codeListName "PackagingMaterialAppliedProcessCode" ;
              gdsn:sourceId "177083" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177084
gdsn:cv177084 rdf:type owl:NamedIndividual ,
                       gdsn:c25785491 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The material was manufactured by injection moulding, which consists of feeding the material into a heated barrel, mixed, and forced into a mold cavity where it cools and hardens to the configuration of the cavity." ;
              rdfs:label "INJECTION_MOULDED" ;
              gdsn:codeListName "PackagingMaterialAppliedProcessCode" ;
              gdsn:sourceId "177084" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177085
gdsn:cv177085 rdf:type owl:NamedIndividual ,
                       gdsn:c25785491 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The material has been designed or processed to reduce heat transfer." ;
              rdfs:label "INSULATED" ;
              gdsn:codeListName "PackagingMaterialAppliedProcessCode" ;
              gdsn:sourceId "177085" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177086
gdsn:cv177086 rdf:type owl:NamedIndividual ,
                       gdsn:c25785491 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The material property that resists uptake or passage of water. The resistance of a packaging material to deterioration or change when in contact with water. To be water resistant is not to be waterproof." ;
              rdfs:label "MOISTURE_RESISTANT" ;
              gdsn:codeListName "PackagingMaterialAppliedProcessCode" ;
              gdsn:sourceId "177086" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177087
gdsn:cv177087 rdf:type owl:NamedIndividual ,
                       gdsn:c25785491 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The material was manufactured by moulding, which consists of filling a mold with the material on liquid form and allowing it to harden so it takes the shape of the mold." ;
              rdfs:label "MOULDED" ;
              gdsn:codeListName "PackagingMaterialAppliedProcessCode" ;
              gdsn:sourceId "177087" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177088
gdsn:cv177088 rdf:type owl:NamedIndividual ,
                       gdsn:c25785491 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A process through which a material is heated to a forming temperature, stretched onto or into a single-surface mould, and held against the mould by applying a vacuum between the mould surface and the sheet." ;
              rdfs:label "VACUUM_FORMED" ;
              gdsn:codeListName "PackagingMaterialAppliedProcessCode" ;
              gdsn:sourceId "177088" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177089
gdsn:cv177089 rdf:type owl:NamedIndividual ,
                       gdsn:c25785491 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The material has been treated or processed so it can resist the ingress of water under specified conditions" ;
              rdfs:label "WATER_REPELLENT" ;
              gdsn:codeListName "PackagingMaterialAppliedProcessCode" ;
              gdsn:sourceId "177089" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177090
gdsn:cv177090 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A general term applied to the support or pedestal of an object." ;
              rdfs:label "BASE" ;
              gdsn:codeListName "PackagingMaterialElementCode" ;
              gdsn:sourceId "177090" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177091
gdsn:cv177091 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A bung is an apparatus used to seal a container, such as a bottle, barrel or tube. A bung is partially inserted inside the container to act as a seal." ;
              rdfs:label "BUNG_SEAL" ;
              gdsn:codeListName "PackagingMaterialElementCode" ;
              gdsn:sourceId "177091" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177092
gdsn:cv177092 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cage that fits over the cork of a bottle of champagne, sparkling wine or beer to prevent the cork from emerging under the pressure of the carbonated contents." ;
              rdfs:label "CAGE" ;
              gdsn:codeListName "PackagingMaterialElementCode" ;
              gdsn:sourceId "177092" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177093
gdsn:cv177093 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A cap that seals a bottle or other form of packaging." ;
              rdfs:label "CAP" ;
              gdsn:codeListName "PackagingMaterialElementCode" ;
              gdsn:sourceId "177093" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv177094
gdsn:cv177094 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348045 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A device of various types attached to or hang from trolleys to support the load." ;
              rdfs:label "CARRIER" ;
