gdsn:cv176765 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Canada Beef Inc. is an independent national organization representing the research, marketing and promotion of the Canadian cattle and beef industry worldwide. Its efforts to maximize demand for Canadian beef and optimize the value of Canadian beef products is funded by cattle producers and the National Beef Check-Off, which in turn makes it possible to access beef industry market development funds provided by the Government of Canada and the Government of Alberta." ;
              rdfs:label "MADE_WITH_CANADIAN_BEEF" ;
