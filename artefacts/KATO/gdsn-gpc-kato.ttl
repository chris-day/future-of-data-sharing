                 rdfs:domain gdsn:c1325 ;
                 rdfs:range gdsn:c-1284986072 ;
                 dct:source "gdsn_classAttributes.json" ;
                 rdfs:comment "A text description describing the range of servings/portions contained within a trade item. Some items may contain a variance in the number of units or a range, therefore the servings could also vary for the trade item. This attribute should only be used when there is a range of servings. If servings is an exact amount, this should not be used. An example of its use would be a bag of meatballs may contain 18-20 meatballs. If the serving size is 2 meatballs then the numberOfServingsRange would be 9-10 servings or portions." ;
                 rdfs:label "numberOfServingsRangeDescription" ;
                 gdsn:bmsId 1367 ;
                 gdsn:originalMultiplicity "0..*" ;
                 gdsn:pathId "c-742831728/c1325/a1437973620" ;
