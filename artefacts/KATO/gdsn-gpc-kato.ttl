                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "BPA (bisphenol A) is a chemical that is added to many commercial products, including food containers and hygiene products. BPA-containing plastics are commonly used in food containers, baby bottles, and other items." ;
