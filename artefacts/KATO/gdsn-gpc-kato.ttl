###  urn:gs1:std:gdsn:extAttr1127
gdsn:extAttr1127 rdf:type owl:ObjectProperty ;
                 rdfs:domain gdsn:extGroup_GS1_Canada ;
                 rdfs:range gdsn:extCode_BiomedicalHazardType ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "Biohazard substances pose a threat to the health of living organisms, primarily that of humans. Biomedical hazards normally come from biological sources or substances used in the diagnosis, prevention, or treatment of diseases. Having the knowledge of whether a trade item contains biomedical hazards will allow for the item to be handled and administered safely." ;
                 rdfs:label "BiomedicalHazardType" ;
                 gdsn:example "ANTINEOPLASTIC BIOLOGIC CYTOTOXIC RADIOACTIVE" ;
                 gdsn:groupName "GS1 Canada" ;
                 gdsn:hierarchyLevel 2 ;
                 gdsn:originalLimit "{1..35}" ;
                 gdsn:originalMultiplicity "0..*" ;
                 gdsn:sourceId "1127" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:validationRules "The Biomedical Hazard Code must allow multiple selections from the code list." .


