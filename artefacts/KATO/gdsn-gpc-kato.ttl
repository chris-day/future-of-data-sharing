                       gdsn:c-1204590580 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "These are plastic screw caps that also have a plastic base that is attached to the packaging. This system is attached to laminated cartons, brick packaging, etc. Some of the caps perforate the carton or base to allow liquids to flow." ;
              rdfs:label "PLASTIC_SCREW_CAP_WITH_BASE" ;
