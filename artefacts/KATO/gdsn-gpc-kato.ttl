                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Nanolitre- Nanolitre is the metric unit of volume equal to one billionth of a litre, which can be represented numerically as 0.000000001/liter." ;
              rdfs:label "Q34" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172825" ;
              gdsn:sourceType "codeValue" .


