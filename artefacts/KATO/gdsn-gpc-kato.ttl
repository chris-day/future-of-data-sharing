###  urn:gs1:std:gdsn:cv181598
gdsn:cv181598 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sahti is a traditional Finnish unfiltered beer brewed with fresh yeast. The raw materials used are mainly barley malt and, in small quantities, rye malt, and sometimes wheat and oats." ;
              rdfs:label "SAHTI" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "181598" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181599
gdsn:cv181599 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348182 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A product that is not produced strictly for a trading partner or a purchasing group. It can be sold through any retailers. The formula/design is owned by the manufacturer, not the ultimate recipient trading partner or purchasing group. Also known as national brand." ;
              rdfs:label "BRAND_LABEL" ;
              gdsn:codeListName "BrandDistributionTradeItemTypeCode" ;
              gdsn:sourceId "181599" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181600
gdsn:cv181600 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A soft, silver-white or blue, lustrous metal typically found in mineral deposits with lead, zinc, and copper." ;
