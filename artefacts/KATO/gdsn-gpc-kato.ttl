###  urn:gs1:std:gdsn:extAttr1165
gdsn:extAttr1165 rdf:type owl:ObjectProperty ;
                 rdfs:domain gdsn:extGroup_GS1_US_Healthcare ;
                 rdfs:range gdsn:extCode_extendedInitialSterilisationPriorToUse ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "Prior to use, the user should sterilize the item using a method which is not currently available in the GDSN Sterilization Method Code List. These values are: Chlorine_Dioxide, Dry_Heat, High_Intensity_Or_Pulse_Light, Microwave_Radiation, Sound_Waves, High_Level_Disinfectant, Liquid_Chemical, Nitrogen_Dioxide, and Supercritical_Carbon_Dioxide" ;
                 rdfs:label "extendedInitialSterilisationPriorToUse" ;
                 gdsn:example "Chlorine_Dioxide, Dry_Heat, High_Intensity_Or_Pulse_Light, Microwave_Radiation, Sound_Waves, High_Level_Disinfectant, Liquid_Chemical, Nitrogen_Dioxide, and/or Supercritical_Carbon_Dioxide" ;
                 gdsn:groupName "GS1 US Healthcare" ;
                 gdsn:hierarchyLevel 3 ;
                 gdsn:originalLimit "{1..100}" ;
                 gdsn:originalMultiplicity "0..*" ;
                 gdsn:sourceId "1165" ;
                 gdsn:sourceType "attribute" .


###  urn:gs1:std:gdsn:extAttr1170
gdsn:extAttr1170 rdf:type owl:ObjectProperty ;
                 rdfs:domain gdsn:extGroup_GS1_US_Healthcare ;
                 rdfs:range gdsn:extCode_groupedProduct ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "Code representing if the trade item is considered by the manufacturer to be more than a single item, such as a kit, combination item." ;
                 rdfs:label "groupedProduct" ;
                 gdsn:example "KIT, COMBINATION, KIT_AND_COMBINATION" ;
                 gdsn:groupName "GS1 US Healthcare" ;
                 gdsn:hierarchyLevel 1 ;
                 gdsn:originalLimit "{1..35}" ;
                 gdsn:originalMultiplicity "0..1" ;
                 gdsn:sourceId "1170" ;
                 gdsn:sourceType "attribute" ;
                 gdsn:validationRules "Constrained by the values of KIT, COMBINATION, KIT_AND_COMBINATION" .


