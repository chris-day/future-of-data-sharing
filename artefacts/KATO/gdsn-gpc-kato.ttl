###  urn:gs1:std:gdsn:cv168513
gdsn:cv168513 rdf:type owl:NamedIndividual ,
                       gdsn:c-778930468 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "National Health Service (NHS) eClass: NHS-eClass is a bespoke classification system for products and services, owned by the English National Health Service (NHS). The purpose of NHS-eClass is to facilitate the accurate analysis of expenditure." ;
              rdfs:label "42" ;
