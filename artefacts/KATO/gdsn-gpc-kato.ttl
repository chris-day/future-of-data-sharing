###  urn:gs1:std:gdsn:cv174808
gdsn:cv174808 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ACO - Australian Certified Organic is Australia’s largest certifier for organic and biodynamic produce and has over 1500 operators within its certification system. ACO is a not for profit fully-owned subsidiary of Australia Organic Ltd." ;
              rdfs:label "24" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174808" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174809
gdsn:cv174809 rdf:type owl:NamedIndividual ,
                       gdsn:c366491729 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "NASAA Certified Organic (NCO) is a fully-owned subsidiary of The National Association for Sustainable Agriculture, Australia who provides the certification services." ;
              rdfs:label "25" ;
              gdsn:codeListName "OrganicClaimAgencyCode" ;
              gdsn:sourceId "174809" ;
