              rdfs:comment "Games intended for an adult audience." ;
              rdfs:label "ADULT" ;
              gdsn:codeListName "ProductGenreTypeCode (Electronic Game)" ;
              gdsn:sourceId "178263" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178264
gdsn:cv178264 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348160 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Games which cast the player as the protagonist of a story, normally requiring the player to solve various puzzles by interacting with people or the environment, most often in a non-confrontational way." ;
              rdfs:label "ADVENTURE" ;
              gdsn:codeListName "ProductGenreTypeCode (Electronic Game)" ;
              gdsn:sourceId "178264" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178265
gdsn:cv178265 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348160 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Games that attempt to teach the user using the game as a vehicle." ;
              rdfs:label "EDUCATIONAL" ;
              gdsn:codeListName "ProductGenreTypeCode (Electronic Game)" ;
              gdsn:sourceId "178265" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178266
gdsn:cv178266 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348160 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Games where players face off against each other or against computer-controlled characters in close combat." ;
              rdfs:label "FIGHTING" ;
