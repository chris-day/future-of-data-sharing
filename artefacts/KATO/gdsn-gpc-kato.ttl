###  urn:gs1:std:gdsn:cv178033
gdsn:cv178033 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The place the animal was born/hatched. The place may be a country, region (land or sea), city, etc. The actual birth place of a particular animal would be transactional. Note: the term animal includes but is not limited to mammals, birds, fish and crustaceans." ;
              rdfs:label "BIRTH" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178033" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178034
gdsn:cv178034 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The place in which the beverage is bottled." ;
              rdfs:label "BOTTLING" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178034" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178035
gdsn:cv178035 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The sea zone in which the seafood in the trade item was caught." ;
              rdfs:label "CATCH_ZONE" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178035" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178036
gdsn:cv178036 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The place where the cutting operation on the carcass or group of carcasses is performed. e.g. approval number of the cutting hall acc. to Regulation EC No 1760/2000 of the European Parliament. Note: The animal is not killed at this location." ;
              rdfs:label "CUTTER" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178036" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178037
gdsn:cv178037 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The cultivation of animals, plants, fungi, and other life forms" ;
              rdfs:label "FARMING" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178037" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178038
gdsn:cv178038 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The country from where the trade item has been purchased by the importer. This is different than the “Last Processing” the product is somehow altered, prepared or assembled before it is imported. Example: a case of 12 bottles of wine is made in France (Country of Origin = France), and a Canadian company purchased/ imported the same case from Italy (Country of Import = Italy)" ;
              rdfs:label "IMPORTATION" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178038" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178039
gdsn:cv178039 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ISO 3166-1 code that identifies the country in which the trade item was last processed and tested before importation." ;
              rdfs:label "LAST_PROCESSING" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178039" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178040
gdsn:cv178040 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Milking is the act of removing milk from mammary glands of various animal types." ;
              rdfs:label "MILKING" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178040" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178041
gdsn:cv178041 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The place the animal was raised after birth to the end of the animals’ life. The place may be a country, region (land or sea), city, etc. The actual rearing place(s) of a particular animal would be transactional. Guidance: If the animal was raised in multiple locations, one instance of the attribute should be populated (e.g. reared in Spain and Portugal). If the animal may have been raised in a single location but for a particular animal it is transactional, it is suggested to populate the attribute for each possibility of location an animal may have come from (e.g. Instance 1 - reared in Spain, instance 2 - Reared in Portugal). Note: the term animal includes but is not limited to mammals, birds, fish and crustaceans." ;
              rdfs:label "REARING" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178041" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178042
gdsn:cv178042 rdf:type owl:NamedIndividual ,
                       gdsn:c1340828336 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The place the animal was killed to be processed for food or other purposes. The place may be a country, region (land or sea), city, etc. The actual slaughter place of a particular animal would be transactional. Note: the term animal includes but is not limited to mammals, birds, fish and crustaceans." ;
              rdfs:label "SLAUGHTER" ;
              gdsn:codeListName "ProductActivityTypeCode" ;
              gdsn:sourceId "178042" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178043
gdsn:cv178043 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum air speed, e.g. leaf blower or fan. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "airSpeedMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178043" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178045
gdsn:cv178045 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximal amperage. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "amperageMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178045" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178046
gdsn:cv178046 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicators of different types of lightweight, flexible container that may be closed for holding, storing, carrying an item or articles. Use productCharacteristicValueCode to populate. Values are available in GS1 code list: ApparelBagTypeCode." ;
              rdfs:label "apparelBagTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178046" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178047
gdsn:cv178047 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum area performance measured in squaremeter per hour (m²/h). Populate using productCharacteristicValueInteger." ;
              rdfs:label "areaPerformanceM2PerHourMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178047" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178049
gdsn:cv178049 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Is the measured ability of a particular ballast to produce light from the lamp(s) it powers. The ballast factor itself is derived by dividing the lumen output of a particular lamp-ballast combination by the lumen output of the same lamp(s) on a reference ballast. This factor, which usually results in a number less than one, accounts for the fact that some lumen loss results when operating lamps on commercially available ballasts. Populate using productCharacteristicValueNumeric." ;
              rdfs:label "ballastFactor" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178049" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178050
gdsn:cv178050 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indication whether or not the trade item or trade item packaging bears an image of a national symbol of the target market (e.g. flag or coat of arms). The importation of such goods may be restricted by local target market regulations. Populate using productCharacteristicValueCode \"true\" or \"false\"." ;
              rdfs:label "bearsNationalSymbol" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178050" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178051
gdsn:cv178051 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicators for different bedclothes; blankets, sheets, etc., used on a bed. Use productCharacteristicValueCode to populate. Values are available in GS1 code list: BeddingTypeCode." ;
              rdfs:label "beddingTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178051" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178052
gdsn:cv178052 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicator of the different applications to a hat bill. Use productCharacteristicValueCode to populate. Values are available in GS1 code list: BillLogoApplicationTypeCode." ;
              rdfs:label "billLogoApplicationTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178052" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178053
gdsn:cv178053 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The month that the gem is representative of and gem type for example: April-Diamond; August- Peridot; December-Tanzanite, Zircon, Turquoise; February- methyst; January- Garnet; July- Ruby; June - Pearl, Alexandrite; March- Aquamarine; May- Emerald; November- Topaz, Citrine; October- Tourmaline, Opal; September- Sapphire. Use productCharacteristicValueDescription to populate." ;
              rdfs:label "birthstoneMonth" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178053" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178054
gdsn:cv178054 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the characteristics of the blade like Serrated, single edge. Populate using productCharacteristicValueDescription." ;
              rdfs:label "bladeType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178054" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178055
gdsn:cv178055 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicator that is used to identify the style height of a boot. Use productCharacteristicValueCode to populate. Values are available in GS1 code list: BootShaftTypeCode." ;
              rdfs:label "bootShaftTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178055" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178056
gdsn:cv178056 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicator of the construction or style of a bracelet. Use productCharacteristicValueCode to populate. Values are available in GS1 code list: BraceletTypeCode." ;
              rdfs:label "braceletTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178056" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178057
gdsn:cv178057 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The total length of the cable (including connectors). Use productCharacteristicValueMeasurement to populate value." ;
              rdfs:label "cableLength" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178057" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178058
gdsn:cv178058 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the format the calendar is using for example HOURLY, DAILY, MONTHLY, YEARLY. Uses productCharacteristicValueCode to populate with values from CalendarDateFormatTypeCode." ;
              rdfs:label "calendarDateFormatCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178058" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178059
gdsn:cv178059 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The length of the calendar for the item examples 12 months, 14 months, 16 months, 2 years. Use productCharacteristicValueMeasurement to populate." ;
              rdfs:label "calendarTerm" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178059" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178060
gdsn:cv178060 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A camera on the rear of the trade item, facing away from the user. FRONT_FACING or REAR_FACING. Use productCharacteristicValueCode to populate value." ;
              rdfs:label "cameraFacingCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178060" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178061
gdsn:cv178061 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Designates whether or not the trade item has a car seat LATCH system. The LATCH (Lower Anchors and Tethers for Children) system was developed to make it easier to correctly install child safety seats without using seat belts. TRUE, FALSE, UNSPECIFIED, NOT_APPLICABLE. Use productCharacteristicValueCode to populate value." ;
              rdfs:label "carSeatLATCHSystem" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178061" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178062
gdsn:cv178062 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of car seat convertible, booster, travel, rear facing, front facing. Use productCharacteristicValueDescription to populate value." ;
              rdfs:label "carSeatType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178062" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178063
gdsn:cv178063 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum catch volume, e.g. catch tray of a lawn mower. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "catchVolumeMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178063" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178064
gdsn:cv178064 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum chain speed, e.g. chainsaw. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "chainSpeedMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178064" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178065
gdsn:cv178065 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of drill chuck — the part that holds the bit. Examples SDS; Keyed. Populate using productCharacteristicValueDescription." ;
              rdfs:label "chuckType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178065" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178066
gdsn:cv178066 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicator that is used to identify the cut or style pertaining to the Coat/Jacket. Use productCharacteristicValueCode to populate. Values are available in GS1 code list: CoatJacketTypeCode." ;
              rdfs:label "coatJacketTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178066" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178067
gdsn:cv178067 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the minimum colour rendering index, e.g. lamps. A colour rendering index (CRI) is a quantitative measure of the ability of a light source to reveal the colours of various objects faithfully in comparison with an ideal or natural light source. Light sources with a high CRI are desirable in colour-critical applications such as neonatal care, photography and cinematography. It is defined by the International Commission on Illumination (CIE) as follows: Colour rendering: Effect of an illuminant on the colour appearance of objects by conscious or subconscious comparison with their colour appearance under a reference illuminant. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "colourRenderingIndexMin" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178067" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178068
gdsn:cv178068 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "When the piston has moved up to the top of its stroke inside the cylinder, and the remaining volume inside the head or combustion chamber has been reduced to 100 cc, then the compression ratio would be proportionally described as 1000:100, or with fractional reduction, a 10:1 compression ratio. Examples 8.2:1; 9.0:1 productCharacteristicValueString" ;
              rdfs:label "compressionRatio" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178068" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178069
gdsn:cv178069 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Commonly used term for the physical size to which the computer conforms. Example: Tower; Micro Tower; Nettop. Use productCharacteristicValueString to populate value." ;
              rdfs:label "computerFormFactor" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178069" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178070
gdsn:cv178070 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Basic graphics processor or graphics card information. Example AMD Radeon HD 6410D; Nividia GTX 8600. Use productCharacteristicValueString to populate value." ;
              rdfs:label "computerGraphicsDescription" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178070" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178071
gdsn:cv178071 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indication whether or not the trade item contains plant material. The importation of such goods may be restricted by local target market regulations. Populate using productCharacteristicValueCode \"true\" or \"false\"." ;
              rdfs:label "containsPlantMaterial" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178071" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178072
gdsn:cv178072 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indication whether or not the trade item contains timber/wood/MDF. The importation of such goods may be restricted by local target market regulations. Populate using productCharacteristicValueCode \"true\" or \"false\"." ;
              rdfs:label "containsTimber" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178072" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178073
gdsn:cv178073 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of cooling system the trade item has. Examples Air, Liquid, Inducted Water. Use productCharacteristicValueDescription to populate," ;
              rdfs:label "coolingSystemType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178073" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178074
gdsn:cv178074 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Type of mechanical slot that the CPU is compatible with. Examples: AM3; LGA 1150. Use productCharacteristicValueString to populate value." ;
              rdfs:label "cPUSocketType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178074" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178075
gdsn:cv178075 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The amount of time the pixels in the display take to change from one state to another. Measured in milliseconds. Use productCharacteristicValueIMeasurement to populate value." ;
              rdfs:label "displayScreenResponseTime" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178075" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178076
gdsn:cv178076 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum distributed load, e.g. tent or small summer house in the garden. Many loads do not act as point loads, but instead act over an extended length or area as distributed loads. For example, a tractor with continuous tracks will apply a load distributed over the length of each track. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "distributedLoadMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178076" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178077
gdsn:cv178077 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Does the imaging device incorporate an automatic document feeder or manual MANUAL; AUTOMATIC. Use productCharacteristicValueCode to populate value." ;
              rdfs:label "documentFeederTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178077" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178078
gdsn:cv178078 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Does the trade item have an empty Fuel container that may be filled with fuels such as gas, CO2, Propane, ETC. as these types of containers must meet regulatory guidelines. Example: TRUE, FALSE. Use productCharacteristicValueCode to populate value." ;
              rdfs:label "doesTradeItemHaveEmptyFuelContainer" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178078" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178079
gdsn:cv178079 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The system in a motor vehicle that connects the transmission to the drive axles. Examples: T-V-Drive Cummins QSB 425 Diesels; 160mm jet pump, axial-flow, single stage. Use productCharacteristicValueString to populate." ;
              rdfs:label "drivetrainType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178079" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178080
gdsn:cv178080 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The amount of time the trade item takes to be cured, dried properly before ready for use or touch. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "dryingTime" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178080" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178081
gdsn:cv178081 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Engine displacement is the volume swept by all the pistons inside the cylinders of a reciprocating engine in a single movement from top dead centre (TDC) to bottom dead centre (BDC). Populate using productCharacteristicsValuemeasurement." ;
              rdfs:label "engineDisplacement" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178081" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178082
gdsn:cv178082 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Inboard, Outboard, Front, rear, Inboard & Outboard. Populate using productCharacteristicValueDescription." ;
              rdfs:label "engineLocation" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178082" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178083
gdsn:cv178083 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of engine that comes with the trade item. Examples: 2.0L EcoBoost; 12-cylinder 6-litre Continental. Populate using productCharacteristicValueString." ;
              rdfs:label "engineModel" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178083" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178084
gdsn:cv178084 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The method of how the engine starts. Example Pull Cord, Electric Button, Key, etc. Populate using productCharacteristicValueDescription." ;
              rdfs:label "engineStartMethodType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178084" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178085
gdsn:cv178085 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum expenditure of force e.g. drill press stand. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "expenditureOfForceMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178085" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178086
gdsn:cv178086 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The location of how the faucet setting are aligned for installation. Examples Centre-set; Widespread. Use productCharacteristicValueDescription." ;
              rdfs:label "faucetDrillingSetting" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178086" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178087
gdsn:cv178087 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Calibre or calibre is the approximate internal diameter of the barrel, or the diameter of the projectile it fires, usually shown in millimetres, or in hundredths or thousandths of an inch. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "firearmCalibre" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178087" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178088
gdsn:cv178088 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The gauge refers indirectly to the bore diameter of a shotgun. It is not a direct measure, but is calculated as the number of lead balls of a bore diameter required to make up one pound. This is an old British measurement system. Thus, a 16-gauge shotgun has a bore diameter such that 16 lead balls of the bore diameter would weigh a pound. Populate using productCharacteristicValueNumeric." ;
              rdfs:label "firearmGauge" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178088" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178089
gdsn:cv178089 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The product's level of firmness as it is described from a marketing perspective. Example: Plush, soft, firm. Use productCharacteristicValueDescription." ;
              rdfs:label "firmness" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178089" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178090
gdsn:cv178090 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the Flour Type number. (e.g. The German flour type numbers (Mehltypen) indicate the amount of ash - unburned mineral content, measured in milligrams - obtained from 100g of the dry mass of this flour; the French flour type numbers indicate the ash content (in milligrams) per 10g flour)" ;
              rdfs:label "flourType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178090" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178091
gdsn:cv178091 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum flow rate, e.g. pumps. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "flowRateMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178091" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178092
gdsn:cv178092 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The basic description of a photographic lens. It is not a measurement of the actual length of a lens, but a calculation of an optical distance from the point where light rays converge to form a sharp image of an object to the digital sensor or 35mm film at the focal plane in the camera. The focal length of a lens is determined when the lens is focused at infinity. Both the minimum and maximum focal lengths are stated for example 15-80 millimetres. Use productCharacteristicValueString to populate." ;
              rdfs:label "focalLength" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178092" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178093
gdsn:cv178093 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "In optics, the f-number (sometimes called focal ratio, f-ratio, f-stop, or relative aperture) of an optical system is the ratio of the lens's focal length to the diameter of the entrance pupil. Examples include f/2.5, f/3.8. Use productCharacteristicValueString to populate." ;
              rdfs:label "focalRatio" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178093" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178094
gdsn:cv178094 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of brakes that recommended. For the front of vehicle. example: Ventilated 13\" discs with dual piston callipers; Twin Brembo 320mm fully-floating high carbon stainless steel discs & Brembo 4 piston radially mounted callipers. Brembo front brake master cylinder with integral reservoir. Use productCharacteristicValueDescription to populate." ;
              rdfs:label "frontBrakesType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178094" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178095
gdsn:cv178095 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of suspension that recommended. For the front of vehicle. example: independent MacPherson strut-type with rear stabilizer bar; Inverted strut-type with aluminium-alloy lower L-arm and pillow-ball joint mount, stabilizer bar; Ohlin's 43mm upside down forks with adjustable preload, compression & rebound damping. Use productCharacteristicValueDescription to populate." ;
              rdfs:label "frontSuspensionType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178095" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178096
gdsn:cv178096 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the quality of the fuel used to give the best performance and upkeep of the product. Use productCharacteristicValueString to populate." ;
              rdfs:label "FuelQualityRecommended" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178096" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178097
gdsn:cv178097 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of fuel system the motor has. Examples: Digital Fuel Injection (DFI®) with 60mm throttle body; Fuel Stratified Injection (FSI). Use productCharacteristicValueDescription to populate." ;
              rdfs:label "FuelSystem" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178097" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178098
gdsn:cv178098 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicate the maximum number of fuses. Populate using productCharacteristicValueInteger." ;
              rdfs:label "fuseQuantityMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178098" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178101
gdsn:cv178101 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Determines whether the trade item contains a flash. TRUE, FALSE, UNSPECIFIED, NOT_APPLICABLE. Use productCharacteristicValueCode to populate value. Use productCharacteristicValueCode to populate value." ;
              rdfs:label "hasRemovableFlash" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178101" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178102
gdsn:cv178102 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Denotes if item has a signal booster, is a bidirectional amplifier created to boost weak cell phone signals in remote or hard to reach areas. TRUE, FALSE, UNSPECIFIED, NOT_APPLICABLE. Use productCharacteristicValueCode to populate value." ;
              rdfs:label "hasSignalBooster" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178102" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178103
gdsn:cv178103 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicator of the shape or form of the front part of a cap that shades the wearer's face from sunlight. Use productCharacteristicValueCode to populate. Values are available in GS1 code list: BillTypeCode." ;
              rdfs:label "hatBillTypeCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178103" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178104
gdsn:cv178104 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A heating element converts electricity into heat through the process of resistive or Joule heating. Electric current passing through the element .encounters resistance, resulting in heating of the element. Use productCharacteristicsValueDescription." ;
              rdfs:label "heatingElement" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178104" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178105
gdsn:cv178105 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Trailer hitches are given a class rating based on their maximum weight capacity and receiver opening size. The classes range from class I, which has the lowest capacity, to class V, which has the highest capacity. Use productCharacteristicValueString to populate." ;
              rdfs:label "hitchClass" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178105" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178106
gdsn:cv178106 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum idling speed. Idle speed (idling, or idle) is the rotational speed the engine runs on when the engine is uncoupled to the drivetrain and the throttle pedal isn't depressed (generally measured in revolutions per minute, or rpm, of the crankshaft) of a combustion engine. At idle speed, the engine generates enough power to run reasonably smoothly and operate its ancillaries (water pump, alternator, and, if equipped, other accessories such as power steering), but usually not enough to perform useful work, such as moving an automobile. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "idlingSpeedMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178106" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178107
gdsn:cv178107 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the minimum idling speed. Idle speed (idling, or idle) is the rotational speed the engine runs on when the engine is uncoupled to the drivetrain and the throttle pedal isn't depressed (generally measured in revolutions per minute, or rpm, of the crankshaft) of a combustion engine. At idle speed, the engine generates enough power to run reasonably smoothly and operate its ancillaries (water pump, alternator, and, if equipped, other accessories such as power steering), but usually not enough to perform useful work, such as moving an automobile. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "idlingSpeedMin" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178107" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178108
gdsn:cv178108 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum impact energy, e.g. rotary hammer. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "impactEnergyMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178108" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178109
gdsn:cv178109 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Describes the type of propeller. Examples: Three-blade, oval-edge stainless steel; Aluminium 3 blade, 8\" Diameter, 7\" Pitch, Standard Rotation. Use productCharacteristicValueDescription to populate." ;
              rdfs:label "impellerOrPropellerType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178109" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178110
gdsn:cv178110 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The system that brings the fuel-air mixture to the cylinders . It includes the carburettor or fuel injection system, intake manifold , intake ports , and intake valves . Example: Eaton Twin Vortices Series Roots-type supercharger with air-to-water intercooler. Use productCharacteristicValueString to populate." ;
              rdfs:label "inductionSystemType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178110" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178111
gdsn:cv178111 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The colour of the inner flesh usually edible part of a fruit or vegetable. Examples are pink or yellow grapefruit, orange or green for a melon. Use values PINK, YELLOW, GREEN, GREEN_WHITE, RED, WHITE, ORANGE, BROWN, BLACK, VIOLET, PURPLE and then use GPC colour code list to broaden colour code. Use ProductCharacteristicValueCode to populate based on values in InnerFleshColourCode." ;
              rdfs:label "innerFleshColourCode" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178111" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178112
gdsn:cv178112 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Is bare tool means you can buy the tool minus the battery and swap the battery out between the tools. Batteries and chargers are sold separately. TRUE, FALSE Populate using productCharacteristicValueCode." ;
              rdfs:label "isBareTool" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178112" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178113
gdsn:cv178113 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates, with reference to the product branding, labelling or packaging, the descriptive term that is used by the product manufacturer to identify if the product is intended as maternity wear." ;
              rdfs:label "isMaternity" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178113" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178114
gdsn:cv178114 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Specifies the wash and or treatment the jeans have undertaken as part of the production process ex. Stone Wash, worn look, torn, Acid, Dirty, Vintage, etc. Use productCharacteristicValueDescription to populate value." ;
              rdfs:label "jeanCharacteristic" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178114" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178115
gdsn:cv178115 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum Limit load. Limit load is the maximum load that a structure can safely carry. It's the load at which the structure is in a state of incipient plastic collapse. As the load on the structure increases, the displacements increases linearly in the elastic range till the load attains the yield value. Beyond this, the load-displacement response becomes non-linear and the plastic or irreversible part of the displacement increases steadily with the applied load. Plasticity spreads throughout the solid and at the limit load, the plastic zone becomes very large and the displacements become unbounded and the component is said to have collapsed. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "limitLoad" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178115" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178116
gdsn:cv178116 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum load weight capacity, e.g. plastic step ladder. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "loadWeightCapacityMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178116" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178117
gdsn:cv178117 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum load weight (duty rating), e.g. ladder, shelf. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "loadWeightMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178117" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178118
gdsn:cv178118 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Indicates the maximum load weight per wood beam (balk, wood truss). Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "loadWeightPerWoodBeamMax" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178118" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178119
gdsn:cv178119 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The type of locking mechanism the item has. Examples Padlock & Key, Combination Lock, Trunk Lock, Case Locking Catch, etc. Use productCharacteristicValueDescription to populate." ;
              rdfs:label "lockMechanismType" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178119" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178120
gdsn:cv178120 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The maximum size a hole or an opening through which light travels in the trade item for example f22 (f/22),16 (f/16), f/11, f/8.0, f/5.6, f/4.0, f/2.8, f/2.0, f/1.8. Use productCharacteristicValueString to populate." ;
              rdfs:label "maximumAperatureValue" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178120" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178121
gdsn:cv178121 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The maximum document size that the imaging device is capable of handling. Examples A0, A4, Letter. Use productCharacteristicValueString to populate value." ;
              rdfs:label "maximumDocumentSizeCapability" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178121" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178122
gdsn:cv178122 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The amount of power an engine can produce. Examples like cars, boats, etc. Usually some units measures are horsepower or kilowatts per hour etc." ;
              rdfs:label "maximumEnginePower" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178122" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178123
gdsn:cv178123 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The angle of incline the item can be raised at maximum. Populate using productCharacteristicValueNumeric." ;
              rdfs:label "maximumIncline" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178123" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178124
gdsn:cv178124 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The maximum pressure the trade item should be inflated. Use productCharacteristicValueMeasurement to populate." ;
