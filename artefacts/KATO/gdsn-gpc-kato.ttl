                rdfs:comment "The numeric value of the volume or mass of a single unit of medication" ;
                rdfs:label "volumeWeightAmountC5D5" ;
                gdsn:example "1.15 MLT (Millilitre) Note: Compound AVP" ;
                gdsn:groupName "Australasian Healthcare" ;
                gdsn:hierarchyLevel 7 ;
                gdsn:originalLimit "{3..8}" ;
                gdsn:originalMultiplicity "0..1" ;
                gdsn:sourceId "263" ;
                gdsn:sourceType "attribute" ;
                gdsn:validationRules "Decimal validation to 2 decimal places" .


###  urn:gs1:std:gdsn:extAttr264
gdsn:extAttr264 rdf:type owl:DatatypeProperty ;
                rdfs:domain gdsn:extGroup_Australasian_Industry_Generic ;
                rdfs:range xsd:integer ;
