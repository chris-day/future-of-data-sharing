                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A material made from the skin of an animal by tanning or a similar process." ;
              rdfs:label "LEATHER" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179767" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179768
gdsn:cv179768 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Surface consisting of linoleum, a strong, shiny material made from materials such as solidified linseed oil (linoxyn), pine resin, ground cork dust, sawdust, and mineral fillers such as calcium carbonate, most commonly on a burlap or canvas backing." ;
              rdfs:label "LINOLEUM" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179768" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179769
gdsn:cv179769 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Marble is a natural stone, formed under the earth. Over time, layers upon layers of limestone and calcium carbonate were subjected to heat and pressure. It is a type of hard rock that becomes smooth when it is polished, and is used for making e.g. countertops and floors." ;
              rdfs:label "MARBLE" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179769" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179770
gdsn:cv179770 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Surfaces made of metal from materials that occur primarily as minerals. For example: iron, zinc, copper and tin." ;
              rdfs:label "METAL_GENERIC" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179770" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179771
gdsn:cv179771 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A variety of mountain-born mineral substances that stand in contrast to any synthetic or manufactured stone products. Common natural stone flooring includes slate, limestone, travertine, granite, and sandstone." ;
              rdfs:label "NATURAL_STONE" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179771" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179772
gdsn:cv179772 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The value needed is not listed or is not defined within this list’s individual code values and definitions. Please send a work request into GS1 or your solution provider requesting the code you are searching for." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179772" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179773
gdsn:cv179773 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Surfaces made from paper, cardboard and other paper type materials. It can be made from natural raw materials such as reed, bamboo or wood, and may be refined (bleaching), or from recycled materials such as old clothes, paper/carboard, etc." ;
              rdfs:label "PAPER_GENERIC" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179773" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179774
gdsn:cv179774 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Plastic is a light, strong, synthetic or semi-synthetic material that is based on natural products such as cellulose, coal, natural gas, salt and crude oil." ;
              rdfs:label "PLASTIC" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179774" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179775
gdsn:cv179775 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Surface consisting of PVC laminate, a material made by joining several thin layers of PVC on top of each other." ;
              rdfs:label "PVC_LAMINATE" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179775" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179776
gdsn:cv179776 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Stainless steel is a corrosion-resistant alloy of iron, chromium and, in some cases, nickel and other metals. It is practically immune to rusting and ordinary corrosion, and is completely recyclable." ;
              rdfs:label "STAINLESS_STEEL" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179776" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179777
gdsn:cv179777 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vinyl is composed of two simple building blocks: chlorine, based on common salt, and ethylene, from crude oil. The resulting compound, ethylene dichloride, is then converted by polymerisation." ;
              rdfs:label "VINYL" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179777" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179778
gdsn:cv179778 rdf:type owl:NamedIndividual ,
                       gdsn:c-971223122 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Wood is the hard fibrous material that forms the main substance of the trunk or branches of a tree or shrub, generally used as a building material." ;
              rdfs:label "WOOD" ;
              gdsn:codeListName "TargetSurfaceTypeCode" ;
              gdsn:sourceId "179778" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179779
gdsn:cv179779 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Tax applies to the item or service within the target market at the tax rate or tax amount." ;
              rdfs:label "APPLICABLE" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179779" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179780
gdsn:cv179780 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Code specifying that the rate is based upon the domestic reverse charge VAT treatment. This code value is particularly pertinent to the UK context." ;
              rdfs:label "DOMESTIC_REVERSE_CHARGE" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179780" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179781
gdsn:cv179781 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item or service has no taxation requirements nor any requirements related to invoicing or reporting." ;
              rdfs:label "EXEMPT" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179781" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179782
gdsn:cv179782 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Code specifying that the item is free export and taxes are not charged." ;
              rdfs:label "FREE_EXPORT_ITEM" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179782" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179783
gdsn:cv179783 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Trade Item is taxed at a tax rate that is higher than any other rate of taxation for trade items. The classification of High is subject to Target Market rules and can change based on regulation." ;
              rdfs:label "HIGH" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179783" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179784
gdsn:cv179784 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item or service is taxed at a tax rate that is lower than any other rate of taxation for trade items (except zero). The classification of low is subject to Target Market rules and can change based on regulation." ;
              rdfs:label "LOW" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179784" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179785
gdsn:cv179785 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item or service is taxed at a tax rate that is considered to be intermediate between the lower and higher rates of taxation for trade items. The classification of medium is subject to Target Market rules and can change based on regulation." ;
              rdfs:label "MEDIUM" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179785" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179786
gdsn:cv179786 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Code specifying that the rate is based on mixed tax. Transaction includes item taxed at different rates." ;
              rdfs:label "MIXED" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179786" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179787
gdsn:cv179787 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Tax does not apply to the item or service within the target market." ;
              rdfs:label "NOT_APPLICABLE" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179787" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179788
gdsn:cv179788 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The tax, fee or duty has been paid by the supplier of the trade item." ;
              rdfs:label "PREPAID" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179788" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179789
gdsn:cv179789 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A benefit provided under the law that allows one to apply a reduction in the tax basis for calculating. In general, exceptions to the basis for tax calculation are the value of an operation. However, to reduce the tax, the benefit is granted to a reduction in the value of this base. This code value is particularly pertinent to the Brazilian (BR) tax structure." ;
              rdfs:label "REDUCTION_IN_BASE" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179789" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179790
gdsn:cv179790 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A reduction in the tax rate. Generally, reduced tax rates are arranged in a more objective way according to the law. This code value is particularly pertinent to the BR tax structure." ;
              rdfs:label "REDUCTION_IN_TAX_RATE" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179790" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179791
gdsn:cv179791 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Code specifying that taxes are not applicable to the services." ;
              rdfs:label "SERVICES_OUTSIDE_SCOPE_OF_TAX" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179791" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179792
gdsn:cv179792 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Tax rate used or accepted as normal or average. The classification of standard is subject to Target Market rules and can change based on regulation." ;
              rdfs:label "STANDARD" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179792" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179793
gdsn:cv179793 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A fixed amount of tax for each product, based on criteria established by legislation rather than the conventional method which is the application of a percentage over the value of the product or operation. This code value is particularly pertinent to the Brazilian (BR) tax structure." ;
              rdfs:label "VALUE_ADDED" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179793" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179794
gdsn:cv179794 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A percentage defined by the Tax Authorities that is applied on (the value of the goods+ Federal VAT+ freight+ other expenses) aiming at obtaining a basis for calculating the substitution for the State VAT. The goal of the Value Added Margin is to calculate the State VAT according to the basis that would be applied in the last step of the production chain; in this case, it could be the final resale. Example: Final Price to Retailer = Suggested Price + Expenses + % MVA. This code value is particularly pertinent to the Brazilian (BR) tax structure." ;
              rdfs:label "VALUE_ADDED_MARGIN" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179794" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179795
gdsn:cv179795 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A code to indicate that the Value Added Tax (VAT) amount which is due on the current invoice is to be paid on receipt of a separate VAT payment request. The value added tax is not due for payment now." ;
              rdfs:label "VALUE_ADDED_TAX_NOT_NOW_DUE_FOR_PAYMENT" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179795" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179796
gdsn:cv179796 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Code specifying that the rate is based upon the domestic reverse charge VAT treatment." ;
              rdfs:label "VAT_REVERSE_CHARGE" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179796" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179797
gdsn:cv179797 rdf:type owl:NamedIndividual ,
                       gdsn:c-703157608 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The item or service has a tax rate or amount equal to zero but still has requirements for invoicing and may have a rate that can be modified by the government at any given time." ;
              rdfs:label "ZERO" ;
              gdsn:codeListName "TaxCategoryCode" ;
              gdsn:sourceId "179797" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179798
gdsn:cv179798 rdf:type owl:NamedIndividual ,
                       gdsn:c-569663405 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Television information retrieval services used in France." ;
