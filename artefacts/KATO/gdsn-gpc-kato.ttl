###  urn:gs1:std:gdsn:extAttr43
gdsn:extAttr43 rdf:type owl:DatatypeProperty ;
               rdfs:domain gdsn:extGroup_Australasian_Healthcare ;
               rdfs:range xsd:integer ;
               dct:source "gdsn_extendedAttributes.json" ;
               rdfs:comment "The AMT Containered Trade Product Pack (CTPP) Code uniquely identifies a CTPP within the Australian Medicines Terminology (AMT) ontology. The CTPP represents the marketable medicinal entity available for patient use, with details of the container type. Its attributes include the brand, active ingredient(s), strength(s), form, unit of use quantity and container type." ;
               rdfs:label "aMTContaineredTradeProductPackCode" ;
               gdsn:example "12345678000012300 – GS1 Paracetamol 500 mg capsule, 20, blister pack" ;
               gdsn:groupName "Australasian Healthcare" ;
               gdsn:hierarchyLevel 7 ;
               gdsn:originalLimit "{1..18}" ;
               gdsn:originalMultiplicity "0..1" ;
               gdsn:sourceId "43" ;
               gdsn:sourceType "attribute" ;
               gdsn:validationRules "Will be handled by Validator" .


###  urn:gs1:std:gdsn:extAttr435
