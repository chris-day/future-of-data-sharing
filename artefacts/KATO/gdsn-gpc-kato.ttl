###  urn:gs1:std:gdsn:cv178859
gdsn:cv178859 rdf:type owl:NamedIndividual ,
                       gdsn:c1671067820 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Cosmetic Product Data Information Sheet provides good knowledge of useful precautions to be taken when using and handling the product under reasonably foreseeable conditions. The risks relating to the safety during transport and storage are included. It does not contain information relating to the end use of the product. Cosmetic products are governed by the EC Regulation n°1223/2009; in accordance with the regulation. Example: https://medias.kaliptis.com/Documents/53f4f74b-a90d-4e49-a64a-40225398225d.pdf" ;
              rdfs:label "FITPC" ;
              gdsn:codeListName "SDSStandardCode" ;
              gdsn:sourceId "178859" ;
              gdsn:sourceType "codeValue" .


