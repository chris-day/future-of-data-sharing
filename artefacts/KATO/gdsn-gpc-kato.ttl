###  urn:gs1:std:gdsn:cv176253
gdsn:cv176253 rdf:type owl:NamedIndividual ,
                       gdsn:c715725203 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Packaging in containers, either rigid or flexible, from which substantially all gases have been removed prior to final sealing of the container." ;
