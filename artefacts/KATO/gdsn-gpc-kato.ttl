###  urn:gs1:std:gdsn:cv174320
gdsn:cv174320 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348061 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a food is fortified with the substance in the ClaimElementCode. Fortified means adding vitamins or minerals to a food that weren't originally present in the food. This is often do for \"Nutrition Policy\", to ensure a population has a sufficient intake of an essential nutrient. Some foods \"may\" be voluntarily fortified; for others, fortification is mandatory. e.g., Adding vitamin D to milk. Note the amount that determines fortified is based on target market regulations." ;
              rdfs:label "FORTIFIED" ;
              gdsn:codeListName "ClaimTypeCode" ;
              gdsn:sourceId "174320" ;
              gdsn:sourceType "codeValue" .


