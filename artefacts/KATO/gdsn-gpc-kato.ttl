###  urn:gs1:std:gdsn:cv176410
gdsn:cv176410 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certified Carbon Free by Carbonfund is the 1st carbon neutral label in the US. It indicates the product is environmentally-friendly and carbon neutral." ;
              rdfs:label "CERTIFIED_CARBON_FREE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://carbonfund.org/product-certification/" ;
              gdsn:sourceId "176410" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176411
gdsn:cv176411 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Humane Farm Animal Care (HFAC) is the leading non-profit certification organisation dedicated to improving the lives of farm animals in food production from birth through slaughter. The goal of the program is to improve the lives of farm animals by driving consumer demand for kinder and more responsible farm animal practices. When you see the Certified Humane Raised and Handled label on a product you can be assured that the food products have come from facilities that meet precise, objective standards for farm animal treatment." ;
              rdfs:label "CERTIFIED_HUMANE_ORGANISATION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://certifiedhumane.org/" ;
              gdsn:sourceId "176411" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176412
gdsn:cv176412 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Certified Naturally Grown attribute includes all products that present a Certified Naturally Grown logo." ;
              rdfs:label "CERTIFIED_NATURALLY_GROWN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.cngfarming.org/" ;
              gdsn:sourceId "176412" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176413
gdsn:cv176413 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The OE 100 standard is a chain-of-custody standard that gives third party verification to a final product containing a given amount of organically grown cotton." ;
