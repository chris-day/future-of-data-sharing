###  urn:gs1:std:gdsn:cv178232
gdsn:cv178232 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Number of stones in the item as related to the descriptiveSizeDimension. Use productCharacteristicValueNumeric to populate value." ;
