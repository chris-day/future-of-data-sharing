###  urn:gs1:std:gdsn:cv180995
gdsn:cv180995 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "North American Kosher Supervision LLC is a West Coast based kosher certification agency dedicated to serving kosher consumers and kosher food manufacturers. A network of Rabbis and kosher supervisors worldwide, with special expertise in the North American West, provide certification expertise." ;
              rdfs:label "NORTH_AMERICAN_KOSHER" ;
