###  urn:gs1:std:gdsn:cv169818
gdsn:cv169818 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "American Style Lager is a type of beer, originally crafted in America, conditioned at low temperatures. Lagers can be pale, amber, or dark. Pale lager is the most widely consumed and commercially available style of beer." ;
              rdfs:label "AMERICAN_STYLE_LAGER" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
