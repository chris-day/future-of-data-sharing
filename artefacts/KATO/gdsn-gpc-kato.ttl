###  urn:gs1:std:gdsn:cv177738
gdsn:cv177738 rdf:type owl:NamedIndividual ,
                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cooking food with high heat with the heat applied directly to the food, most commonly from above. Heat transfer to the food is primarily via radiant heat" ;
              rdfs:label "BROIL" ;
