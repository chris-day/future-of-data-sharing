###  urn:gs1:std:gdsn:cv174205
gdsn:cv174205 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Niacin, also known as nicotinic acid, is an organic compound and a form of vitamin B3, an essential human nutrient. It has the formula C6H5NO2 and belongs to the group of the pyridinecarboxylic acid." ;
              rdfs:label "NIACIN" ;
              gdsn:codeListName "ClaimElementCode" ;
