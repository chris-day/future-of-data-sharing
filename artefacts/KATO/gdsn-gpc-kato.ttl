###  urn:gs1:std:gdsn:cv179749
gdsn:cv179749 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cracked skin is a classic symptom of dry skin, but it can also occur in response to scratches or other trauma, or infection. When the skin dries, it can become rough and flaky, with small tears that can lead to deeper cracks called fissures, which can extend into the deeper layers of the skin." ;
              rdfs:label "CRACKED" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179749" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179750
gdsn:cv179750 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Dry skin is an uncomfortable condition marked by scaling, itching, and cracking." ;
              rdfs:label "DRY_OR_DEHYDRATED" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179750" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179751
gdsn:cv179751 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Impure skin is often oily, shiny and has large pores. It shows black heads, pimples and tends to develop inflammations. Ideal products are tailored to the skin type in order to reach the natural balance of the moisture level and sebum production." ;
              rdfs:label "IMPURE" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179751" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179752
gdsn:cv179752 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Normal is a term widely used to refer to well-balanced skin. The scientific term for well-balanced skin is eudermic." ;
              rdfs:label "NORMAL" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179752" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179753
gdsn:cv179753 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Oily skin is the result of the overproduction of sebum from sebaceous glands." ;
              rdfs:label "OILY" ;
              gdsn:codeListName "TargetSkinTypeCode" ;
              gdsn:sourceId "179753" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179754
gdsn:cv179754 rdf:type owl:NamedIndividual ,
                       gdsn:c840062915 ;
