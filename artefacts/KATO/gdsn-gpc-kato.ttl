###  urn:gs1:std:gdsn:cv172555
gdsn:cv172555 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Technical Atmosphere" ;
              rdfs:label "ATT" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172555" ;
