              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv179612
gdsn:cv179612 rdf:type owl:NamedIndividual ,
                       gdsn:c-839280846 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A conventional plastic mixed with an additive to imitate biodegredation. Oxo-degradable plastics quickly fragment into smaller and smaller pieces, called microplastics, but don’t break down at the molecular or polymer level. The resulting microplastics are left in the environment indefinitely until they eventually fully break down." ;
              rdfs:label "OXO_DEGRADABLE" ;
              gdsn:codeListName "SustainabilityFeatureCode" ;
              gdsn:sourceId "179612" ;
              gdsn:sourceType "codeValue" .


