gdsn:cv176779 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "MPS-A is an environmental registration certificates. The qualification is awarded to participants who record their usage of crop protection agents, fertilisers, energy and waste. The qualification MPS-A stands for most environmentally-friendly cultivation. The qualifications MPS-B, MPS-C and MPS-D also exist depending on the earned points." ;
              rdfs:label "MPS_A" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.my-mps.com/en/" ;
              gdsn:sourceId "176779" ;
              gdsn:sourceType "codeValue" .


