###  urn:gs1:std:gdsn:cv173023
gdsn:cv173023 rdf:type owl:NamedIndividual ,
                       gdsn:c431397809 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Auburn hair is a variety of red hair, most commonly described as reddish-brown in colour or dark ginger. Auburn hair ranges in shades from medium to dark." ;
              rdfs:label "AUBURN" ;
              gdsn:codeListName "NaturalHairColourCode" ;
              gdsn:sourceId "173023" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv173024
gdsn:cv173024 rdf:type owl:NamedIndividual ,
                       gdsn:c431397809 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Black hair is the darkest and most common of all human hair colours globally, due to larger populations with this dominant trait. It is a dominant genetic trait, and it is found in people of all backgrounds and ethnicities. It has large amounts of eumelanin and is less dense than other hair colours." ;
              rdfs:label "BLACK" ;
              gdsn:codeListName "NaturalHairColourCode" ;
              gdsn:sourceId "173024" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv173025
gdsn:cv173025 rdf:type owl:NamedIndividual ,
                       gdsn:c431397809 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Blonde or fair hair is a hair colour characterized by low levels of the dark pigment eumelanin." ;
              rdfs:label "BLONDE" ;
              gdsn:codeListName "NaturalHairColourCode" ;
              gdsn:sourceId "173025" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv173026
gdsn:cv173026 rdf:type owl:NamedIndividual ,
                       gdsn:c431397809 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Brown hair varies from light brown to almost black hair. It is characterized by higher levels of the dark pigment eumelanin and lower levels of the pale pigment pheomelanin." ;
              rdfs:label "BROWN" ;
              gdsn:codeListName "NaturalHairColourCode" ;
              gdsn:sourceId "173026" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv173027
gdsn:cv173027 rdf:type owl:NamedIndividual ,
                       gdsn:c431397809 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Grey hair is a combination of normally pigmented hairs interspersed with white ones. Hair turns white when the pigmentation cells responsible for colour (melanin) stop being produced." ;
              rdfs:label "GREY" ;
              gdsn:codeListName "NaturalHairColourCode" ;
              gdsn:sourceId "173027" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv173028
gdsn:cv173028 rdf:type owl:NamedIndividual ,
                       gdsn:c431397809 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Red hair varies in hue from a deep burgundy or bright copper to burnt orange or red-orange to strawberry blond. Characterized by high levels of the reddish pigment pheomelanin and relatively low levels of the dark pigment eumelanin." ;
              rdfs:label "RED" ;
              gdsn:codeListName "NaturalHairColourCode" ;
              gdsn:sourceId "173028" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv173029
gdsn:cv173029 rdf:type owl:NamedIndividual ,
                       gdsn:c431397809 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "White hair is not caused by a true gray or white pigment, but is due to a lack of pigmentation and melanin. The clear hairs appear white because of the way light is reflected from the hairs." ;
              rdfs:label "WHITE" ;
              gdsn:codeListName "NaturalHairColourCode" ;
              gdsn:sourceId "173029" ;
              gdsn:sourceType "codeValue" .


