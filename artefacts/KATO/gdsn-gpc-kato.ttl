###  urn:gs1:std:gdsn:cv180024
gdsn:cv180024 rdf:type owl:NamedIndividual ,
                       gdsn:c1329411021 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Establishment that offers personal care goods, toiletries and non-controlled drugs which can be obtained without a prescription. Within the Netherlands this establishment is a different than a retail pharmacy (referred to in the code list as DRUG)." ;
