###  urn:gs1:std:gdsn:cv181592
gdsn:cv181592 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348333 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lasts about 6 to 8 weeks. Penetrates deeper into the hair and contains weak developers (hydrogen peroxide) that store the colour pigments in the hair, but cannot completely lighten the hair. E.g., semi-permanent colourations or glossings." ;
              rdfs:label "INTENSIVE" ;
              gdsn:codeListName "HairColourPermanenceLevelCode" ;
              gdsn:sourceId "181592" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181593
gdsn:cv181593 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348333 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The value needed is not listed or is not defined within this list’s individual code values and definitions. Please send a work request into GS1 or your solution provider requesting the code you are searching for." ;
              rdfs:label "OTHER" ;
              gdsn:codeListName "HairColourPermanenceLevelCode" ;
              gdsn:sourceId "181593" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181595
gdsn:cv181595 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348333 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lasts until the next hair wash. This type of colour only lays on the outer layer of the hair (cuticle) and does not penetrate the inside of the hair. E.g., colour sprays, chalk or foam colourations." ;
              rdfs:label "TEMPORARY" ;
              gdsn:codeListName "HairColourPermanenceLevelCode" ;
              gdsn:sourceId "181595" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181596
gdsn:cv181596 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348333 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "About 6 to 10 washes. Penetrates easily into the cuticle, but not deep into the hair. Gradually fades without leaving visible roots. E.g., easily washable tints or foam tints." ;
              rdfs:label "WASHABLE" ;
              gdsn:codeListName "HairColourPermanenceLevelCode" ;
              gdsn:sourceId "181596" ;
              gdsn:sourceType "codeValue" .


