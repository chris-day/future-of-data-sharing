###  urn:gs1:std:gdsn:cv178628
gdsn:cv178628 rdf:type owl:NamedIndividual ,
                       gdsn:c1826432850 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Catalogue Item is in the process of being processed at the Global Registry." ;
