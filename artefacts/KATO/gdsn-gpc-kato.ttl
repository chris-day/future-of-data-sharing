###  urn:gs1:std:gdsn:cv168850
gdsn:cv168850 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ice wine is a type of dessert wine produced from grapes that have been frozen while still on the vine which has a significant amount of Carbon Dioxide. The CO2 is either a part of the fermentaion process or as part of the production process." ;
              rdfs:label "SPARKLING_WINE_ICE_WINE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168850" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168851
gdsn:cv168851 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sparkling wine is a wine with significant levels of carbon dioxide in it, making it fizzy." ;
              rdfs:label "SPARKLING_WINE_OTHER" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168851" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168852
gdsn:cv168852 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Prosecco is an Italian wine, controlled by DOC or DOCG. Under these wine laws, Prosecco can be spumante (\"sparkling wine\"), frizzante (\"semi-sparkling wine\"), or tranquillo (\"still wine\"). It is made from Prosecco grapes (renamed within the EU to Glera grapes)" ;
              rdfs:label "SPARKLING_WINE_PROSECCO" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168852" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168853
gdsn:cv168853 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sekt is a German term for some sparkling wine. The majority of Sekt produced (around 95%) is made by the Charmat method with the remaining premium Sekt being made according to the méthode traditionnelle." ;
              rdfs:label "SPARKLING_WINE_SEKT" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168853" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168854
gdsn:cv168854 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A sparkling wine which is not fully sweet." ;
              rdfs:label "SPARKLING_WINE_SEMI_SPARKLING_WINE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168854" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168855
gdsn:cv168855 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Absinthe is distilled, highly alcoholic beverage (45–74% ABV / 90–148 U.S. proof). It is an anise-flavoured spirit derived from botanicals, including the flowers and leaves of Artemisia absinthium (\"grand wormwood\"), together with green anise, sweet fennel, and other medicinal and culinary herbs." ;
              rdfs:label "SPIRIT_ABSINTHE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168855" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168856
gdsn:cv168856 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Applejack or Apple Brandy is a strong apple-flavoured alcoholic drink produced from apples." ;
              rdfs:label "SPIRIT_APPLEJACK_APPLE_BRANDY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168856" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168857
gdsn:cv168857 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Arak is a Levantine unsweetened distilled spirit (≈40–63% alc/vol or ≈80–126 proof) in the anise drinks family. It is a translucent white anise-flavoured drink." ;
              rdfs:label "SPIRIT_ARAK" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168857" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168858
gdsn:cv168858 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Armagnac is a distinctive kind of brandy produced in the Armagnac region in Gascony, southwest France. It is distilled from wine usually made from a blend of grapes including Baco 22A, Colombard, Folle blanche and Ugni blanc, traditionally using column stills rather than the pot stills used in the production of cognac, which is made only from ugni blanc grapes. The resulting spirit is then aged in oak barrels before release. Production is overseen by the Institut national de l'origine et de la qualité (INAO) and the Bureau National Interprofessionel de l'Armagnac (BNIA)." ;
              rdfs:label "SPIRIT_ARMAGNAC" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168858" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168859
gdsn:cv168859 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Baijiu, also known as shaojiu, is a category of at least a dozen Chinese liquors made from grain" ;
              rdfs:label "SPIRIT_BAIJIU" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168859" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168860
gdsn:cv168860 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Bourbon whiskey is a type of whisky/whiskey which is Produced in the United States; made from a grain mixture that is at least 51% corn; aged in new, charred oak containers; distilled to no more than 160 (U.S.) proof (80% alcohol by volume); entered into the container for aging at no more than 125 proof (62.5% alcohol by volume); and bottled (like other whiskeys) at 80 proof or more (40% alcohol by volume)." ;
              rdfs:label "SPIRIT_BOURBON" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168860" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168861
gdsn:cv168861 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Flavoured Bourbon is a type of whisky/whiskey, with flavouring elements added, which is produced in the United States; made from a grain mixture that is at least 51% corn; aged in new, charred oak containers; distilled to no more than 160 (U.S.) proof (80% alcohol by volume); entered into the container for aging at no more than 125 proof (62.5% alcohol by volume); and bottled (like other whiskeys) at 80 proof or more (40% alcohol by volume)." ;
              rdfs:label "SPIRIT_BOURBON_FLAVOURED" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168861" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168862
gdsn:cv168862 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Brandy is a spirit produced by distilling wine. Brandy generally contains 35–60% alcohol by volume (70–120 US proof) and is typically drunk as an after-dinner digestif." ;
              rdfs:label "SPIRIT_BRANDY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168862" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168863
gdsn:cv168863 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Flavoured brandy is a spirit, with added flavouring elements, produced by distilling wine. Brandy generally contains 35–60% alcohol by volume (70–120 US proof) and is typically drunk as an after-dinner digestif." ;
              rdfs:label "SPIRIT_BRANDY_FLAVOURED" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168863" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168864
gdsn:cv168864 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cachaça is a distilled spirit made from fermented sugarcane juice. Also known as aguardente, pinga, caninha." ;
              rdfs:label "SPIRIT_CACHACA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168864" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168865
gdsn:cv168865 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Calvados is an apple or pear brandy from Normandy in France." ;
              rdfs:label "SPIRIT_CALVADOS" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168865" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168866
gdsn:cv168866 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Canadian whiskies are blended multi-grain liquors containing a large percentage of corn spirits, and are typically lighter and smoother than other whisky/whiskey styles." ;
              rdfs:label "SPIRIT_CANADIAN_WHISKY_WHISKEY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168866" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168867
gdsn:cv168867 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cane spirit, also known as 'gavine' or 'mystery liquor', is distilled from fermented molasses, by the continuous column still method." ;
              rdfs:label "SPIRIT_CANE_SPIRIT" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168867" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168868
gdsn:cv168868 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cider is an alcoholic beverage made from the fermented juice of apples." ;
              rdfs:label "SPIRIT_CIDER" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168868" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168869
gdsn:cv168869 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cognac is a variety of brandy named after the town of Cognac, France. It is produced in the surrounding wine-growing region in the departments of Charente and Charente-Maritime." ;
              rdfs:label "SPIRIT_COGNAC" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168869" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168870
gdsn:cv168870 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Fruit brandy or fruit spirit is a distilled beverage produced from mash, juice, wine or residues of edible fruits. The term covers a broad class of spirits produced across the world, and typically excludes beverages made from grapes, which are referred to as plain brandy (when made from distillation from wine) or pomace brandy (when made directly from grape pomace). Apples, pears, apricots, plums and cherries are the most commonly used fruits." ;
              rdfs:label "SPIRIT_FRUIT_SPIRIT" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168870" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168871
gdsn:cv168871 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Genever, also known as jenever, genièvre, or peket, is the juniper-flavoured traditional liquor in the Netherlands, Belgium and adjoining areas in northern France and northwestern Germany." ;
              rdfs:label "SPIRIT_GENEVER" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168871" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168872
gdsn:cv168872 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Gin is a distilled alcoholic drink that derives its predominant flavour from juniper berries (Juniperus communis). Gin is one of the broadest categories of spirits, all of various origins, styles, and flavour profiles, that revolve around juniper as a common ingredient." ;
              rdfs:label "SPIRIT_GIN" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168872" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168873
gdsn:cv168873 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Grappa is a fragrant, grape-based pomace brandy of Italian origin that contains 35 to 60 percent alcohol by volume (70 to 120 US proof)." ;
              rdfs:label "SPIRIT_GRAPPA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168873" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168874
gdsn:cv168874 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Huangjiu is a type of Chinese alcoholic beverage made from water, cereal grains such as rice, sorghum, millet, or wheat, and a qū starter culture. Unlike baijiu, it is not distilled and contains less than 20% alcohol." ;
              rdfs:label "SPIRIT_HUANGIJU" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168874" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168875
gdsn:cv168875 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Irish whisky/whiskey must be distilled on the island of Ireland (comprising the Republic of Ireland and Northern Ireland) from a mash of malted cereals with or without whole grains of other cereals and which has been: saccharified by the diastase of malt contained therein, with or without other natural enzymes; fermented by the action of yeast; distilled at an alcoholic strength of less than 94.8% alcohol by volume in such a way that the distillate has an aroma and taste derived from the materials used; subject to the maturation of the final distillate for at least three years in wooden casks, such as oak, not exceeding 700 litres (185 US gal; 154 imp gal) capacity; The distillate, to which only water and plain caramel colouring may be added (E150a), retains its colour, aroma and taste derived from the production process referred to above. Irish whiskey is to have a minimum alcoholic by volume content of 40%." ;
              rdfs:label "SPIRIT_IRISH_WHISKY_WHISKEY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168875" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168876
gdsn:cv168876 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Japanese whisky/whisky is a style of whiskey developed and produced in Japan. Broadly speaking the style of Japanese whisky/whiskey is more similar to that of Scotch whisky than other major styles of whisky/whiskey." ;
              rdfs:label "SPIRIT_JAPANESE_WHISKY_WHISKEY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168876" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168877
gdsn:cv168877 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Korn also known as Kornbrand or Kornbranntwein, is a German colourless distilled beverage produced from fermented cereal grain seed. In the production of Korn only the cereal grain types rye, wheat, barley, oat and buckwheat are permissible. Most of the production is based on rye or wheat; barley and buckwheat are rarely used. Barley is mainly used to obtain the required malt for the brewing process. The addition of food colour, flavourings, or sweeteners is not permitted. Korn differs from vodka in that it is distilled to lower alcoholic proofs and less rigorously filtered, which leaves more of the cereal grain flavour in the finished spirit." ;
              rdfs:label "SPIRIT_KORN_KORNBRAND" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168877" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168878
gdsn:cv168878 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Mezcal or Mescal is a Mexican distilled alcoholic beverage made from any type of agave." ;
              rdfs:label "SPIRIT_MEZCAL_MESCAL" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168878" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168879
gdsn:cv168879 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Moonshine is a spirit which can be made from various grains. It is typically clear and unaged." ;
              rdfs:label "SPIRIT_MOONSHINE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168879" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168880
gdsn:cv168880 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Orujo is a pomace brandy (a liquor obtained from the distillation of marc, the solid remains left after pressing of the grape) from northern Spain. It is a transparent spirit with an alcohol content over 50% (100° proof)." ;
              rdfs:label "SPIRIT_ORUJO" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168880" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168881
gdsn:cv168881 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The alcohol product is a Spirit which is not otherwise enumerated in this codeset" ;
              rdfs:label "SPIRIT_OTHER" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168881" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168882
gdsn:cv168882 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ouzo is a dry anise-flavoured aperitif that is widely consumed in Greece and Cyprus. It is made from rectified spirits that have undergone a process of distillation and flavouring. Its taste is similar to other anise liquors like rakı, arak, pastis and sambuca." ;
              rdfs:label "SPIRIT_OUZO" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168882" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168883
gdsn:cv168883 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pastis is an anise-flavoured spirit and apéritif from France, typically containing less than 100 g/l sugar and 40–45% ABV (alcohol by volume)." ;
              rdfs:label "SPIRIT_PASTIS_ANISE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168883" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168884
gdsn:cv168884 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pisco is a colourless or yellowish-to-amber coloured brandy produced made by distilling fermented grape juice into a high-proof spirit." ;
              rdfs:label "SPIRIT_PISCO" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168884" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168885
gdsn:cv168885 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Raki or rakı is a sweetened, often anise-flavoured, alcoholic drink often served with seafood or meze. It is comparable to several other alcoholic beverages available around the Mediterranean and the Middle East, e.g. pastis, ouzo, sambuca, arak and aguardiente" ;
              rdfs:label "SPIRIT_RAKI" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168885" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168886
gdsn:cv168886 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Rakia or rakija is the collective term for fruit brandy popular in the Balkans. The alcohol content of rakia is normally 40% ABV." ;
              rdfs:label "SPIRIT_RAKIA_RAKIJA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168886" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168887
gdsn:cv168887 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Rum is a distilled alcoholic drink made by fermenting then distilling sugarcane molasses or sugarcane juice. The distillate, a clear liquid, is usually aged in oak barrels." ;
              rdfs:label "SPIRIT_RUM" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168887" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168888
gdsn:cv168888 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Flavoured rum is a distilled alcoholic drink made by fermenting then distilling sugarcane molasses or sugarcane juice with added flavouring elements. The distillate, a clear liquid, is usually aged in oak barrels." ;
              rdfs:label "SPIRIT_RUM._FLAVOURED" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168888" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168889
gdsn:cv168889 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Rhum agricole is the French term for cane juice rum, a style of rum originally distilled in the French Caribbean islands from freshly squeezed sugar cane juice rather than molasses." ;
              rdfs:label "SPIRIT_RUM_AGRICOLE_RHUM_AGRICOLE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168889" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168890
gdsn:cv168890 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Rye whisky/whiskey is a type of whisky/whiskey which is Produced in the United States; made from a grain mixture that is at least 51% rye; aged in new, charred oak containers; distilled to no more than 160 (U.S.) proof (80% alcohol by volume); entered into the container for aging at no more than 125 proof (62.5% alcohol by volume); and bottled (like other whisky/whiskeys) at 80 proof or more (40% alcohol by volume)." ;
              rdfs:label "SPIRIT_RYE_WHISKY_WHISKEY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168890" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168891
gdsn:cv168891 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sake, also referred to as Japanese rice beer, is an alcoholic beverage made by fermenting rice that has been polished to remove the bran. Despite the name, unlike wine, in which alcohol is produced by fermenting sugar that is naturally present in fruit (typically grapes), sake is produced by a brewing process more akin to that of beer, where starch is converted into sugars, which ferment into alcohol." ;
              rdfs:label "SPIRIT_SAKE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168891" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168892
gdsn:cv168892 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Sambuca is an Italian anise-flavoured, usually colourless, liqueur. Its most common variety is often referred to as white sambuca to differentiate it from other varieties that are deep blue in colour (black sambuca) or bright red (red sambuca). Like other anise-flavoured liqueurs, the ouzo effect is sometimes observed when combined with water." ;
              rdfs:label "SPIRIT_SAMBUCA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168892" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168893
gdsn:cv168893 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Schnapps or Aquavit are a type of alcoholic beverage that may take several forms, including distilled fruit brandies, herbal liqueurs, infusions, and \"flavoured liqueurs\" made by adding fruit syrups, spices, or artificial flavourings to neutral grain spirits." ;
              rdfs:label "SPIRIT_SCHNAPPS_AQUAVIT" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168893" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168894
gdsn:cv168894 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Scotch must be produced at a distillery in Scotland from water and malted barley (to which only whole grains of other cereals may be added) all of which have been: Processed at that distillery into a mash; Converted at that distillery to a fermentable substrate only by endogenous enzyme systems; Fermented at that distillery only by adding yeast; Distilled at an alcoholic strength by volume of less than 94.8% (190 US proof); Wholly matured in an excise warehouse in Scotland in oak casks of a capacity not exceeding 700 litres (185 US gal; 154 imp gal) for at least three years; Retaining the colour, aroma, and taste of the raw materials used in, and the method of, its production and maturation; Containing no added substances, other than water and plain (E150A) caramel colouring; Comprising a minimum alcoholic strength by volume of 40% (80 US proof)." ;
              rdfs:label "SPIRIT_SCOTCH_WHISKY_WHISKEY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168894" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168895
gdsn:cv168895 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Shōchū is a Japanese distilled beverage less than 45% alcohol by volume. It is typically distilled from rice (kome), barley (mugi), sweet potatoes (satsuma-imo), buckwheat (soba), or brown sugar (kokutō), though it is sometimes produced from other ingredients such as chestnut, sesame seeds, potatoes or even carrots." ;
              rdfs:label "SPIRIT_SHOCHU" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168895" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168896
gdsn:cv168896 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Soju is a clear, colourless distilled beverage of Korean origin. It is usually consumed neat, and its alcohol content varies from about 16.8% to 53% alcohol by volume (ABV). Most brands of soju are made in South Korea. While soju is traditionally made from rice, wheat, or barley, modern producers often replace rice with other starches such as potatoes, sweet potatoes, or tapioca." ;
              rdfs:label "SPIRIT_SOJU" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168896" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168897
gdsn:cv168897 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Spiked seltzer, hard seltzer or hard sparkling water is an alcoholic beverage containing carbonated water, alcohol, and often fruit flavouring. The alcohol is usually made by fermenting cane sugar; sometimes malted barley is used. The alcohol by volume is around 5% and the calorie-content is relatively low" ;
              rdfs:label "SPIRIT_SPIKED_SELTZERS" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168897" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168898
gdsn:cv168898 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Tennessee whiskey is straight whisky/whiskey produced in the United States, specifically the state of Tennessee. All current Tennessee whisky/whiskey producers are required by Tennessee law to produce their whisky/whiskeys in Tennessee and, with few exceptions, use a filtering step known as the Lincoln County Process prior to aging the whisky/whiskey. Beyond the perceived marketing value of the distinction, Tennessee whisky/whiskey and bourbon have almost identical requirements, and most Tennessee whisky/whiskeys meet the criteria for bourbon." ;
              rdfs:label "SPIRIT_TENNESSEE_WHISKY_WHISKEY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168898" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168899
gdsn:cv168899 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Tequila is a distilled beverage made from the blue agave plant. Tequila is a type of mezcal. The distinction is that tequila must use only blue agave plants rather than any type of agave." ;
              rdfs:label "SPIRIT_TEQUILA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168899" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168900
gdsn:cv168900 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vodka is a clear distilled alcoholic beverage. It is composed primarily of water and ethanol, but sometimes with traces of impurities and flavourings. Traditionally it is made by distilling the liquid from cereal grains or potatoes that have been fermented, though some modern brands use fruits or sugar as the base." ;
              rdfs:label "SPIRIT_VODKA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168900" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168901
gdsn:cv168901 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Flavoured vodka is a clear distilled alcoholic beverage with flavouring elements added. It is composed primarily of water and ethanol, but sometimes with traces of impurities and flavourings. Traditionally it is made by distilling the liquid from cereal grains or potatoes that have been fermented, though some modern brands use fruits or sugar as the base." ;
              rdfs:label "SPIRIT_VODKA_FLAVOURED" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168901" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168902
gdsn:cv168902 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Whisky or whiskey is a type of distilled alcoholic beverage made from fermented grain mash. Various grains (which may be malted) are used for different varieties, including barley, corn, rye, and wheat. Whisky is typically aged in wooden casks, generally made of charred white oak. While Bourbon, Scotch, Rye, Irish, Canadian, Japanese, Tennessee, etc. are all Whiskeys, they have very specific distillation processes. Any whiskey that does not meet any of those specific processes are common Whiskeys." ;
              rdfs:label "SPIRIT_WHISKY_WHISKEY" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168902" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168903
gdsn:cv168903 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Flavoured whisky or whiskey is a type of distilled alcoholic beverage, with flavouring elements added, made from fermented grain mash. Various grains (which may be malted) are used for different varieties, including barley, corn, rye, and wheat. Whisky is typically aged in wooden casks, generally made of charred white oak." ;
              rdfs:label "SPIRIT_WHISKY_WHISKEY_FLAVOURED" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168903" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168904
gdsn:cv168904 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Unsweetened, distilled, alcoholic drinks that have an alcohol content of at least 20% ABV are called spirits. ... Fortified wine is distinguished from spirits made from wine in that spirits are produced by means of distillation, while fortified wine is simply wine that has had a spirit added to it." ;
              rdfs:label "SPIRIT_WINE_SPIRIT" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168904" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168905
gdsn:cv168905 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "DO – denominacion de origin, the mainstay of Spain's wine quality control system. Each region is governed by a consejo regulardor, which decides on the boundaries of the region, permitted varietals, maximum yields, limits of alcoholic strength and other quality standards or production limitations pertaining to the zone." ;
              rdfs:label "STILL_WINE_DENOMINACION_DE_ORIGEN_" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168905" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168906
gdsn:cv168906 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "DOCa – denominación de origen calificada ('denomination of qualified origin'), is the highest category in Spanish wine regulations, reserved for regions with above-average grape prices and particularly stringent quality controls. Rioja was the first Spanish region to be awarded DOCa status in 1991, followed by Priorat in 2003. Priorat uses the alternative designation DOQ, for denominació d'origen qualificada in the Catalan language. These are the only two regions considered \"above\" DO status." ;
              rdfs:label "STILL_WINE_DENOMINACION_DE_ORIGEN_CALIFICADA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168906" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168907
gdsn:cv168907 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "DOC- Denominazione di origine controllata are roughly equivalent to the French Appellation d'origine contrôlée (AOC). It requires that a wine satisfy a defined quality standard, and be produced within the specified region." ;
              rdfs:label "STILL_WINE_DENOMINAZIONE_DI_ORIGINE_CONTROLLATA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168907" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168908
gdsn:cv168908 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "DOCG- Denominazione di origine controllata e garantita is intended to be a superior classification to DOC, and is the highest classification in Italy. All DOCG wines from each producer are analysed and tasted by government–licensed judgement panel before being bottled. Once approved, the wines are “guaranteed” with a numbered governmental seal across the cap or cork, to prevent later manipulation." ;
              rdfs:label "STILL_WINE_DENOMINAZIONE_DI_ORIGINE_CONTROLLATA_E_GUARANTITA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168908" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168909
gdsn:cv168909 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "DOP- Protected Designation of Origin is an origin protection of the EU for certain products." ;
              rdfs:label "STILL_WINE_DENOMINAZIONE_DI_ORIGINE_PROETTA_DOP" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168909" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168910
gdsn:cv168910 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Ice wine is a type of dessert wine produced from grapes that have been frozen while still on the vine." ;
              rdfs:label "STILL_WINE_ICE_WINE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168910" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168911
gdsn:cv168911 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "IGP- Indication Geographique Protegee is an origin protection of the EU for certain products." ;
              rdfs:label "STILL_WINE_INDICATION_GEOGRAPHIQUE_PROTEGEE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168911" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168912
gdsn:cv168912 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "IGT- Indicazione geografica tipica is the third of four classifications of wine recognized by the government of Italy. Created to recognize the unusually high quality of the class of wines known as Super Tuscans, IGT wines are labeled with the locality of their creation. However, they do not meet the requirements of the stricter DOC or DOCG designations, which are generally intended to protect traditional wine formulations such as Chianti or Barolo." ;
              rdfs:label "STILL_WINE_INDICAZIONE_GEOGRAPHIE_TIPICA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168912" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168913
gdsn:cv168913 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Landwein is a German table wine." ;
              rdfs:label "STILL_WINE_LANDWEIN" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168913" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168914
gdsn:cv168914 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "QbA- Qualitätswein, or quality wine from a specific region. This is wine from one of the 13 German wine-growing regions (Anbaugebiete), and the region must be shown on the label." ;
              rdfs:label "STILL_WINE_QBA" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168914" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168915
gdsn:cv168915 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "QmP- Prädikatswein, or superior quality wine. Known as Qualitätswein mit Prädikat (QmP) (quality wine with specific attributes), this is the top level of German wines." ;
              rdfs:label "STILL_WINE_QMP" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168915" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168916
gdsn:cv168916 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Tafelwein is a German table wine." ;
              rdfs:label "STILL_WINE_TAFELWEIN" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168916" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168917
gdsn:cv168917 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Verband Deutscher Prädikats- und Qualitätsweingüter e.V. or the Association of German Prädikat Wine Estates, is an organisation where most (but not all) of Germany's top wine producers are members. It is commonly known under its acronym VDP. Its membership includes about 200 wine estates and it was founded in 1910 as Verband Deutscher Naturweinversteigerer e.V., Association of German Natural (i.e. not chaptalized) Wine Auctioneers. It consists of 13 regional associations, one for each region in the German wine classification system." ;
              rdfs:label "STILL_WINE_VERBAND_DEUTSCHER_PRAEDIKATSWEINGUETER_VDP" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168917" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168918
gdsn:cv168918 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vin de paysor \"country wine\") is a French wine classification that is above the vin de table classification, but below the appellation d'origine contrôlée classification, as well as the former vin délimité de qualité supérieure classification." ;
              rdfs:label "STILL_WINE_VIN_DE_PAYS" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168918" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168919
gdsn:cv168919 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Vin de Table is a basic French wine classification." ;
              rdfs:label "STILL_WINE_VIN_DE_TABLE" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
