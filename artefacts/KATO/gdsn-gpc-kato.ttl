              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178228
gdsn:cv178228 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Snow load is the downward force on a building’s roof by the weight of accumulated snow and ice. The roof or the entire structure can fail if the snow load exceeds the weight the building was designed to shoulder. Populate using productCharacteristicValueMeasurement." ;
              rdfs:label "snowLoadRating" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178228" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178229
gdsn:cv178229 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The version number assigned to this specific release of the software. Use productCharacteristicValueIString to populate value." ;
              rdfs:label "softwareVersionNumber" ;
              gdsn:codeListName "ProductCharacteristicCode" ;
              gdsn:sourceId "178229" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178230
gdsn:cv178230 rdf:type owl:NamedIndividual ,
                       gdsn:c504224086 ;
              dct:source "gdsn_codeValues.json" ;
