###  urn:gs1:std:gdsn:cv178602
gdsn:cv178602 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Document is a sample shipping order. A sample shipping order isn´t needed for every item (GTIN), but a shipping order can differ from GTIN to GTIN. E.g. in case an item is an organic product the sample shipping order needs to contain the organic product origin number according article 31 of the implementing regulations EG Nr. 889/2008. For non-organic items this information isn´t needed." ;
              rdfs:label "SAMPLE_SHIPPING_ORDER" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178602" ;
              gdsn:sourceType "codeValue" .


