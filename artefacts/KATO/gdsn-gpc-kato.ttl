###  urn:gs1:std:gdsn:extAttr1061
gdsn:extAttr1061 rdf:type owl:DatatypeProperty ;
                 rdfs:domain gdsn:extGroup_Carrefour ;
                 rdfs:range xsd:string ;
                 dct:source "gdsn_extendedAttributes.json" ;
                 rdfs:comment "The definition of the kind of Price this document reflects.One of the following attribute values must be selected from the enumerated list.· List Or Catalogue - The gross price before application of any discounts, allowances, charges, taxes, etcetera. The value represented is the price that the manufacturer expects to receive for the trade item or service from any buyer prior to any relationship specific negotiations (eg, a public catalogue population).· Net Price Calculated by Supplier - The net price after application of any discounts, allowances, charges, taxes, etcetera. It represents the price that the seller expects to receive and the buyer expects to pay considering the relationship that exists between the two parties (eg, data alignment agreement). For example, allowances, charges or price brackets negotiated by either party should be reflected within the value represented in the communication." ;
                 rdfs:label "attributePriceType" ;
                 gdsn:example "Not Available" ;
                 gdsn:groupName "Carrefour" ;
                 gdsn:hierarchyLevel 13 ;
                 gdsn:originalLimit "{1..255}" ;
                 gdsn:originalMultiplicity "0..*" ;
                 gdsn:sourceId "1061" ;
                 gdsn:sourceType "attribute" .


