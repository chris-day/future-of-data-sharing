                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Lacon Institute stands for the assurance of quality and the certification of organically produced food." ;
              rdfs:label "LACON" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.lacon-institut.com" ;
