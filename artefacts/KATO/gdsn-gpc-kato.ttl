###  urn:gs1:std:gdsn:cv176996
gdsn:cv176996 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A standard for the natural and sustainable production of Swiss milk. With \"swissmilk green\", one thing is certain: this milk and dairy products have been produced to the highest standards." ;
