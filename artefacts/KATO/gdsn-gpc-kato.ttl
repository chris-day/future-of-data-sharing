gdsn:cv174162 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "High fructose corn syrup (HFCS) (also called glucose-fructose, isoglucose and glucose-fructose syrup) is a sweetener made from corn starch that has been processed by glucose isomerase to convert some of its glucose into fructose." ;
              rdfs:label "HIGH_FRUCTOSE_CORN_SYRUP" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174162" ;
              gdsn:sourceType "codeValue" .


