###  urn:gs1:std:gdsn:cv178564
gdsn:cv178564 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Link to the energy label for a trade item. On 19 May 2010, the EU adopted the Directive 2010/30/EU on energy labels. Energy labels help consumers choosing products which save energy and thus money. They also provide incentives for the industry to develop and invest in energy efficient product design. They are found on a selection of white goods and other products and are designed to help customers see how energy efficient a model is before they buy." ;
              rdfs:label "ENERGY_LABEL" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178564" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv178565
gdsn:cv178565 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The certificate of conformity for suitability for food contact is a document issued by the manufacturer or the person placing the product on the European market. It certifies that the product sold complies with the EC Regulation 1935/2004. Thus, it is proven to be safe to get in contact with food." ;
              rdfs:label "FOOD_CONTACT_CONFORMITY_CERTIFICATE" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178565" ;
              gdsn:sourceType "codeValue" .


