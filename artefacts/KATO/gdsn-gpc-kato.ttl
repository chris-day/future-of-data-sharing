              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "High pressure sodium light is a specific type of gas- discharge light (also known as a high intensity discharge, HID or arc light). The arc tube is made of aluminum oxide and the sodium metal is combined with several other elements like mercury which counter-balances the yellow glow with some white to light emissions." ;
              rdfs:label "HIGH_PRESSURE_SODIUM" ;
              gdsn:codeListName "GrowingLightConditionTypeCode" ;
              gdsn:sourceId "180825" ;
              gdsn:sourceType "codeValue" .


