                       gdsn:c119186588 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Organic in accordance with the regulation in force for the target market and for the product. E.g., in EU for processed food, when at least 95% of the agricultural ingredients of the product by weight are organic; 100% organic for fresh products like fruit and vegetables, meat, fish, eggs, etc. Outside Europe, this code indicates \"Organic (at least 95% by weight)\"." ;
              rdfs:label "2" ;
              gdsn:codeListName "OrganicTradeItemCode" ;
              gdsn:sourceId "174956" ;
              gdsn:sourceType "codeValue" .


