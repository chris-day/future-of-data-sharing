###  urn:gs1:std:gdsn:cv168839
gdsn:cv168839 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Limoux wine is produced around the city of Limoux in Languedoc in southwestern France. Limoux wine is produced under four Appellation d'origine contrôlée (AOC) designations: Blanquette de Limoux, Blanquette méthode ancestrale, Crémant de Limoux and Limoux, the first three of which are sparkling wines and dominate the production around Limoux." ;
              rdfs:label "SPARKLING_WINE_BLANQUETTE_DE_LIMOUX" ;
              gdsn:codeListName "AlcoholBeverageTypeCode" ;
              gdsn:sourceId "168839" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv168840
gdsn:cv168840 rdf:type owl:NamedIndividual ,
                       gdsn:c1001786865 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cava is a sparkling wine of Denominación de Origen (DO) status from Spain. It may be white (blanco) or rosé (rosado)." ;
