###  urn:gs1:std:gdsn:cv174218
gdsn:cv174218 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Oxybenzone is a benzophenone derivative used as a sunscreen agent. Oxybenzone absorbs UVB and UVA II rays, resulting in a photochemical excitation and absorption of energy." ;
              rdfs:label "OXYBENZONE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174218" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174219
gdsn:cv174219 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Palm oil is a yellow oil which comes from the fruit of certain palm trees and is used in making soap and sometimes as a fat in cooking." ;
              rdfs:label "PALM_OIL" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174219" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174220
gdsn:cv174220 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pantothenic acid, also called vitamin B5 (a B vitamin), is a water-soluble vitamin. Pantothenic acid is an essential nutrient. Animals require pantothenic acid in order to synthesize coenzyme-A (CoA), as well as to synthesize and metabolize proteins, carbohydrates, and fats. The anion is called pantothenate. Not to be confused with pantethine." ;
              rdfs:label "PANTOTHENIC_ACID" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174220" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174221
gdsn:cv174221 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Any of a group of compounds used as preservatives in pharmaceutical and cosmetic products and in the food industry." ;
              rdfs:label "PARABEN" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174221" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174222
gdsn:cv174222 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Paraffin refers to a mixture of acyclic alkanes (saturated hydrocarbons) with the general total formula CnH2n+2." ;
              rdfs:label "PARAFFIN" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174222" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174223
gdsn:cv174223 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Partially Hydrogenated Vegetable Oils (PHOs are the most common source of artificial trans fats within processed foods. The US FDA has revoked PHOs GRAS status and food manufacturers must remove PHOs from products." ;
              rdfs:label "PARTIALLY_HYDROGENATED_VEGETABLE_OIL" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174223" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174224
gdsn:cv174224 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "It is a source of protein derived and extracted in powder form from the yellow and green split peas (Pisum sativum)." ;
              rdfs:label "PEA_PROTEIN" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174224" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174225
gdsn:cv174225 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A claim that a food is free from peanuts. Note the amount that determines containment or lack of containment is based on target market regulations." ;
              rdfs:label "PEANUTS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174225" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174226
gdsn:cv174226 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A species of hickory, native to south-central North America, in Mexico from Coahuila south to Jalisco and Veracruz,[1][2] in the United States in Alabama, Arkansas, Florida, Georgia, Illinois, Indiana, Iowa, Kansas, Kentucky, Louisiana, Mississippi, Missouri, Oklahoma, South Carolina, Tennessee, and Texas." ;
              rdfs:label "PECANS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174226" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174227
gdsn:cv174227 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The peel is the outer covering, mostly solid, of a fruit, nut or shellfish." ;
              rdfs:label "PEEL" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174227" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174228
gdsn:cv174228 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Polyethylene glycols (PEG) are a humectant (which help retain or preserve moisture) or emulsifiers that can be found in many cosmetic products." ;
              rdfs:label "PEG_EMULSIFIERS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174228" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174229
gdsn:cv174229 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Peroxides are a group of compounds with the structure R−O−O−R. The O−O group in a peroxide is called the peroxide group or peroxo group. In contrast to oxide ions, the oxygen atoms in the peroxide ion have an oxidation state of −1. The most common peroxide is hydrogen peroxide, colloquially known simply as \"peroxide\"." ;
              rdfs:label "PEROXIDE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174229" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174230
gdsn:cv174230 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pesticides are substances that are meant to control pests, including weeds. The term pesticide includes all of the following: herbicide, insecticides (which may include insect growth regulators, termiticides, etc.) nematicide, molluscicide, piscicide, avicide, rodenticide, bactericide, insect repellent, animal repellent, antimicrobial, and fungicide." ;
              rdfs:label "PESTICIDE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174230" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174231
gdsn:cv174231 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Pesticide residue refers to the pesticides that may remain on or in food after they are applied to food crops. The maximum allowable levels of these residues in foods are often stipulated by regulatory bodies in many countries. Regulations such as pre-harvest intervals also often prevent harvest of crop or livestock products if recently treated in order to allow residue concentrations to decrease over time to safe levels before harvest. Exposure of the general population to these residues most commonly occurs through consumption of treated food sources, or being in close contact to areas treated with pesticides such as farms or lawns." ;
              rdfs:label "PESTICIDE_RESIDUES" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174231" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174232
gdsn:cv174232 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Per- and polyfluoroalkyl substances (PFAS) are a group of man-made chemicals that includes PFOA, PFOS, GenX, and many other chemicals." ;
              rdfs:label "PFAS" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174232" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174233
gdsn:cv174233 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Germicidal and germistatic glycol ether, phenol ether, and aromatic alcohol often used together with quaternary ammonium compounds." ;
              rdfs:label "PHENOXYETHANOL" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174233" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174234
gdsn:cv174234 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A essential amino acid." ;
              rdfs:label "PHENYLALANINE" ;
              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174234" ;
              gdsn:sourceType "codeValue" .


