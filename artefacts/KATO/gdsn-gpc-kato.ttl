                       gdsn:c-1245497546 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The use of smoke derived from burning select (hard) woods, then filtered to remove large particles. The bioactive compounds found in smoke are used to impart colour and flavour." ;
              rdfs:label "FILTER_WOOD_SMOKE" ;
