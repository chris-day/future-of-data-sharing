              gdsn:codeListName "MultiComponentDeviceTypeCode" ;
              gdsn:sourceId "181617" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181618
gdsn:cv181618 rdf:type owl:NamedIndividual ,
                       gdsn:c-519231 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "A gluconate salt form of chlorhexidine, a biguanide compound used as an antiseptic agent." ;
              rdfs:label "CHLORHEXIDINE_GLUCONATE" ;
              gdsn:codeListName "NonfoodIngredientOfConcernCode" ;
              gdsn:sourceId "181618" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181619
gdsn:cv181619 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "EcoStep-Wein is an integrated management system for small and medium-sized wineries and sparkling wine producers. It combines requirements from international standards like ISO 9001, ISO 14001, ISO 22000, and ISO 45001. Developed with Geisenheim University and the Environmental Alliance of Hesse, it aims to optimize operations and enhance sustainability in economic, ecological, and social aspects." ;
              rdfs:label "ECO_STEP_WEIN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://ecostep-wein.de/" ;
              gdsn:sourceId "181619" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181620
gdsn:cv181620 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Responsible Fisheries Management (RFM) Certification is a voluntary and internationally accredited third-party certification program for wild-capture fisheries. It allows companies to demonstrate responsible sourcing to their customers. Certified Sustainable RFM fisheries are independently assessed and scored against strict and comprehensive criteria to ensure biological sustainability, conservation, biodiversity, and ecosystem integrity." ;
              rdfs:label "RESPONSIBLE_FISHERIES_MANAGEMENT" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://rfmcertification.org/" ;
              gdsn:sourceId "181620" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv181621
gdsn:cv181621 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Vignerons Indépendants de France (Independent Winemakers of France) is an association of winemakers who grow their own vines, produce their own wine, and sell it directly to consumers. Their logo, a winemaker carrying a barrel, helps consumers identify authentic independent producers." ;
              rdfs:label "VIGNERONS_INDEPENDANTS_DE_FRANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:sourceId "181621" ;
              gdsn:sourceType "codeValue" .


