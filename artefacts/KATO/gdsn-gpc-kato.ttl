###  urn:gs1:std:gdsn:cv172823
gdsn:cv172823 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Femtolitre- Femtolitre is the metric unit of volume equal to one thousand trillionth (European) or one quadrillionth (American) litre. One femtolitre is the same as one cubic micrometre (μm3), which can be represented numerically as 0.00000000000001/liter." ;
              rdfs:label "Q32" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172823" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv172824
gdsn:cv172824 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348125 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Picolitre- Picoliter is the metric unit of volume equal to a trillionth (one millionth of a millionth) of a liter, which can be represented numerically as 0.000000000001/liter. just as the prefix nano denotes a billionth part." ;
              rdfs:label "Q33" ;
              gdsn:codeListName "MeasurementUnitCode_GDSN" ;
              gdsn:sourceId "172824" ;
              gdsn:sourceType "codeValue" .


