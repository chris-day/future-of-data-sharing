###  urn:gs1:std:gdsn:cv176286
gdsn:cv176286 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The packaging is recyclable aluminium by Gesamtverband der Aluminiumindustrie." ;
