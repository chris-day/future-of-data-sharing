###  urn:gs1:std:gdsn:cv176901
gdsn:cv176901 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Marks, signs or characters that are marked on the packaging of cosmetics, pet food and other products in China to declare that the item conforms to quality requirements, as specified by relevant regulations." ;
              rdfs:label "QUALITY_CONFORMANCE_MARKING_CN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "Varies too many to list" ;
              gdsn:sourceId "176901" ;
