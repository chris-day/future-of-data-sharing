###  urn:gs1:std:gdsn:cv176666
gdsn:cv176666 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "How2Recycle is a standardized labeling system that clearly communicates recycling instructions to the public. It involves a coalition of forward thinking brands who want their packaging to be recycled and are empowering consumers through smart packaging labels. The How2Recycle label was created to provide consistent and transparent on-package recycling information to consumers in North America." ;
              rdfs:label "HOW_2_RECYCLE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://how2recycle.info/" ;
              gdsn:sourceId "176666" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176667
gdsn:cv176667 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Humane Heartland attribute includes all products that present a Humane Heartland logo." ;
              rdfs:label "HUMANE_HEARTLAND" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.humaneheartland.org/" ;
              gdsn:sourceId "176667" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176668
gdsn:cv176668 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Hypertension Canada is the only national non-profit organization dedicated solely to the prevention and control of hypertension and its complications. We work with leading minds across medical and health disciplines to advance research and professional and public education, and with policy makers to ensure Canadians can avoid the potentially deadly complications of hypertension." ;
              rdfs:label "HYPERTENSION_CANADA_MEDICAL_DEVICE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.hypertension.ca/en/devices-endorsed-by-hypertension-canada" ;
              gdsn:sourceId "176668" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176669
gdsn:cv176669 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ICADA (International Cosmetic and Detergents Association) mark makes it for the consumer visible that only raw materials were used for the production of organic and natural cosmetics, which conform to the strict requirements. http://www.icada.eu/." ;
              rdfs:label "ICADA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.icada.eu/" ;
              gdsn:sourceId "176669" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176670
gdsn:cv176670 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ICEA (Instituto Certicazione Etica e Ambientale, Environmental and Ethical Certification Institute) is a Consortium that control and certifies companies that carry out their activities in respect of people and nature, defending workers dignity and rights of consumers. ICEA is among most important bodies of the sector in Italy and in Europe, where it operates to favour a fair and socially sustainable development that ranges from organic farming to other bio related sectors. http://www.icea.info/en/." ;
              rdfs:label "ICEA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.icea.info/en/" ;
              gdsn:sourceId "176670" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176671
gdsn:cv176671 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Iceland Responsible Fisheries logo indicates Icelandic origin of fish catches in Icelandic waters and responsible fisheries management." ;
              rdfs:label "ICELAND_RESPONSIBLE_FISHERIES" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.responsiblefisheries.is/certification/" ;
              gdsn:sourceId "176671" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176672
gdsn:cv176672 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Organic Certification assures consumers that organically produced foods and textiles meet a consistent set of standards that were developed and are regulated by the USDA National Organic Program (USDA NOP), or similar internationally recognized standard. In order to label products as Organic, certification is required by law in the U.S. and many other countries. As a USDA NOP Accredited Certifier, ICS verifies that all its clients are compliant with these standards. ICS certifies all categories of operations: Family Farms, Commercial Farms, On-farm processing, Contract Services, Processor/Manufacturers, and Handlers." ;
              rdfs:label "ICS_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.newchapter.com/newsletter/aug2013" ;
              gdsn:sourceId "176672" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176673
gdsn:cv176673 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "IFANCA, one of the world's leading resources for halal information. Halal, when applied to food, is a dietary set of guidelines for Muslims living an Islamic lifestyle. Since 1982, IFANCA is committed to helping halal consumers through research, education and advocacy. One of the services IFANCA provides to halal consumers is third-party halal certification. Our certification symbol, the Crescent helps halal consumers select goods, assuring them that what they buy is halal without a doubt." ;
              rdfs:label "IFANCA_HALAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ifanca.org/Pages/index.aspx" ;
              gdsn:sourceId "176673" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176674
gdsn:cv176674 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "International Federation of Organic Agriculture Movements (IFOAM) Accreditation is primarily a means of ensuring fair and orderly trade of organic products. It is in this sense a service for the trade and producers as well as for certifiers. IFOAM Accreditation facilitates equivalency of organic certification bodies worldwide by confirming whether they meet IFOAM's international norms." ;
              rdfs:label "IFOAM" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ifoam.bio/en/about-us" ;
              gdsn:sourceId "176674" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176675
gdsn:cv176675 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "IFS Standards help to comply with all legal food and non-food safety and quality requirements and give common and transparent standards to all concerned suppliers and service providers as well as a concrete and strong answer to the high safety and quality expectations of customers." ;
              rdfs:label "IFS_HPC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.ifs-certification.com/index.php/en/standards/260-ifs-hpc-en" ;
              gdsn:sourceId "176675" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176676
gdsn:cv176676 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The IGP label (indication géographique protégée) is for products with a protected geographical indication. This means that the speciality has either been produced, processed, or refined in the place of origin. The raw materials used are 100 % Swiss in origin." ;
              rdfs:label "IGP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.aop-igp.ch" ;
              gdsn:sourceId "176676" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176677
gdsn:cv176677 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Cosmetics according to the guidelines of the German Society for the Prevention of Cruelty to Animals ( Deutscher Tierschutzbund e. V. ) The German Society for the Prevention of Cruelty to Animals and the International Manufactory Association against Animal Testing in Cosmetics ( IHTK e. V.) carry on their consequent work against animal testing in 2001 http://www.ihtk.de/ihtk-en.htm." ;
              rdfs:label "IHTK_SEAL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ihtk.de/ihtk-en.htm" ;
              gdsn:sourceId "176677" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176678
gdsn:cv176678 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "IKB egg is a Dutch quality system for the production of eggs." ;
              rdfs:label "IKB_EIEREN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://ikbei.nl/" ;
              gdsn:sourceId "176678" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176679
gdsn:cv176679 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Product Board for Poultry and Eggs has registered the IKB Chicken quality mark with the Benelux Trademarks Office, for the purpose of recognisability of rigorously inspected, quality poultry meat, produced and handled in conformity with the regulations of the IKB Chicken certification scheme stipulated by the management of the Product Board for Poultry and Eggs." ;
              rdfs:label "IKB_KIP" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://pluimned.avined.nl/thema/ikb-kip" ;
              gdsn:sourceId "176679" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176680
gdsn:cv176680 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products produced within the Dutch quality system IKB pig come from companies that are checked with regard to their use of animal feed, use of animal medication, hygiene and transportation." ;
              rdfs:label "IKB_VARKEN" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ikbvarken.nl/" ;
              gdsn:sourceId "176680" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176681
gdsn:cv176681 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Dansk Indeklima Mærkning (DIM) is a voluntary labeling scheme. DIM requires documented limited emission of gas, fibres, particles and smell to secure high indoor climate." ;
              rdfs:label "INDEKLIMA_MAERKET" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.teknologisk.dk/ydelser/dansk-indeklima-maerkning/om-indeklimamaerket/253" ;
              gdsn:sourceId "176681" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176682
gdsn:cv176682 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This INSTITUT FRESENIUS Quality Seal on a package, certify, that this item is a quality product that consumer can trust in. That’s because Fresenius thoroughly examine products, that indicates it is high-class quality. The main focus on food products and related cooking products." ;
              rdfs:label "INSTITUT_FRESENIUS" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.qualitaetssiegel.net/" ;
              gdsn:sourceId "176682" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176683
gdsn:cv176683 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The IP Code (International Protection Rating, sometimes called Ingress Protection) on electrical appliances is an indication of the degree of protection of the design of electrical and electronic equipment against internal damage in \"hostile environments\" and against any danger to the user. The IP designation is internationally standardized in IEC 60529. The IP designation has two numbers: the first indicates the degree of protection against contact and ingress of objects, the second indicates the degree of protection against moisture. Companies can use their own logo." ;
              rdfs:label "INT_PROTECTION" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.nema.org" ;
              gdsn:sourceId "176683" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176684
gdsn:cv176684 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The integrity & sustainability seal combines two systems. The integrity is guaranteed by the Wine of Origin (WO) system, which is administered by the Wine and Spirit Board (WSB). The sustainability is covered by the Integrated Production of Wine (IPW) scheme, an industry-wide, technical system of sustainable wine production. This seal covers both WO and IPW. It is used when the wine is bottled within South Africa." ;
              rdfs:label "INTEGRITY_AND_SUSTAINABILITY_CERTIFIED" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.wosa.co.za/home/" ;
              gdsn:sourceId "176684" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176685
gdsn:cv176685 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The International Aloe Science Council Cert certification includes all products that have published the International Aloe Science Council Certification stamp on their package." ;
              rdfs:label "INTERNATIONAL_ALOE_SCIENCE_COUNCIL_CERTIFICATE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.iasc.org/" ;
              gdsn:sourceId "176685" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176686
gdsn:cv176686 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The International Kosher Council was established to assist food manufacturers in the many facets that encompass getting a product kosher certified." ;
              rdfs:label "INTERNATIONAL_KOSHER_COUNCIL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ikckosher.com/index.html" ;
              gdsn:sourceId "176686" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176687
gdsn:cv176687 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Superior Taste Award label is a powerful marketing tool that is used to communicate about the products and the company's success, in both domestically and internationally. Its visibility of the label brings an immediate differentiation amongst the vast product choices on the marketplace and reassures consumers in their buying decision." ;
              rdfs:label "INTERNATIONAL_TASTE_QUALITY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.itqi.com/en/superior-taste-award/" ;
              gdsn:sourceId "176687" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176688
gdsn:cv176688 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The ETL Mark is proof of product compliance to North American safety standards. Authorities Having Jurisdiction(AHJs) and code officials across the US and Canada accept the ETL Listed Mark as proof of product compliance to published industry standards. The ETL Listed Mark is proof that a product has been independently tested and meets the applicable published standard." ;
              rdfs:label "INTERTEK_CERTIFICATE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.intertek.com/certification/" ;
              gdsn:sourceId "176688" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176689
gdsn:cv176689 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Intertek’s ETL Mark is a safety mark which is recognised all over North America. It indicates that your product has been tested by an accredited third party testing laboratory, and meets the applicable safety standards and minimal requirements for sale or distribution within North America." ;
              rdfs:label "INTERTEK_ETL" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.intertek-twn.com/FrontEnd/ResourceMark.aspx?lang=E" ;
              gdsn:sourceId "176689" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176690
gdsn:cv176690 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "High quality products which are produced environmentally friendly and in line with the animal needs." ;
              rdfs:label "IP_SUISSE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.ipsuisse.ch/" ;
              gdsn:sourceId "176690" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176691
gdsn:cv176691 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ISCC (International Sustainability and Carbon Certification) is a voluntary certification standard to support the shift towards the circular economy and bio-economy. This label can be used by ISCC system users with a valid ISCC certificate or that are certified under an ISCC group certification. (https://www.iscc-system.org/)" ;
              rdfs:label "ISCC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.iscc-system.org/" ;
              gdsn:sourceId "176691" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176692
gdsn:cv176692 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ISCC (International Sustainability and Carbon Certification) is an independent multi-stakeholder organisation providing a globally applicable certification system for the sustainability of raw materials and products. This label can be used for products linked to bio-circular materials. Bio-circular materials are materials made from biological waste and residues. This logo can also be used for mixed products linked to bio-circular and bio materials. (https://www.iscc-system.org/process/marketing-with-iscc/)" ;
              rdfs:label "ISCC_SUPPORTING_THE_BIOECONOMY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.iscc-system.org/process/marketing-with-iscc/" ;
              gdsn:sourceId "176692" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176693
gdsn:cv176693 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "ISEAL is the global association for sustainability standards. They develop guidance and facilitate coordinated efforts to improve their members’ effectiveness and scale up their social and environmental impacts." ;
              rdfs:label "ISEAL_ALLIANCE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.isealalliance.org/" ;
              gdsn:sourceId "176693" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176694
gdsn:cv176694 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Products bearing this certification are certified by a 3rd party ensuring they follow the ISO standards. ISO standards give world-class specifications for products, services and systems, to ensure quality, safety and efficiency. They are instrumental in facilitating international trade." ;
              rdfs:label "ISO_QUALITY" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.iso.org/certification.html" ;
              gdsn:sourceId "176694" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176695
gdsn:cv176695 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "\"Naturleder\" is an IVN ( Internationaler Verband der Naturtextilwirtschaft e. V.) standard. This is the only standard for eco-friendly leather products in Europe. All products certified with this standard offer a high level of ecology and quality." ;
              rdfs:label "IVN_NATURAL_LEATHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.naturtextil.de" ;
              gdsn:sourceId "176695" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176696
gdsn:cv176696 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "This IVN ( Internationaler Verband der Naturtextilwirtschaft e. V.) quality seal, well known within Europe, currently sets the strictest ecological standard for textile production at the highest technical level currently feasible. BEST reflects the standards for eco-friendly textiles developed by the International Association of Natural Textile Industry (IVN) since 1990 and reviews the entire textile production chain both in terms of ecological standards and in terms of social accountability." ;
              rdfs:label "IVN_NATURAL_TEXTILES_BEST" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.naturtextil.de" ;
              gdsn:sourceId "176696" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176697
gdsn:cv176697 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "International Verified Omega-3 is an independent not-for-profit organization whose goal is to: 1) increase consumer confidence in the quality of marine oils (including fish oils) rich in omega-3s, 2) help consumers identify and select the best omega-3 products for their health, 3) to advocate for and support responsible marine stewardship and the long term sustainability of fish populations and habitat around the world." ;
              rdfs:label "IVO_OMEGA3" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://ivopure.org/" ;
              gdsn:sourceId "176697" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176698
gdsn:cv176698 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Japanese Agricultural Standards are standards for the agriculture industry maintained by the Japanese Government. They are comparable to Japanese Industrial Standards but for food and agricultural products. Once a product has passed tests conducted by government-backed rating bureaus the JAS seal (right) is appended to the product" ;
              rdfs:label "JAS_ORGANIC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.maff.go.jp/e/policies/standard/jas/" ;
              gdsn:sourceId "176698" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176699
gdsn:cv176699 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Jay Kosher Pareve Certification" ;
              rdfs:label "JAY_KOSHER_PAREVE" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.jaykosher.com/" ;
              gdsn:sourceId "176699" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176700
gdsn:cv176700 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The \"Jodsiegel\" were built up by the Federal Centre for Health and Education (BZgA) on behalf of the Federal Ministry of Health. The seal is provided on packages of products by the food manufacturer, when the products made with iodized salt. With the help of the label, consumers can see the use of iodized salt directly. The logo is part of a series of awareness campaigns BZgA together with the Arbeitskreis Jodmangel (working group of iodine deficiency), which aim to make the use of iodized salt to a rule." ;
              rdfs:label "JODSALZ_BZGA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.bzga.de" ;
              gdsn:sourceId "176700" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176701
gdsn:cv176701 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Kabelkeur is the quality mark for television and television cables, splitters and amplifiers and is an initiative of the industry association of the Dutch NLkabel cable companies. The purpose of this label is to increase the quality of television and television accessories." ;
              rdfs:label "KABELKEUR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.kabelkeur.nl/" ;
              gdsn:sourceId "176701" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176702
gdsn:cv176702 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Quality products in line with animal needs." ;
              rdfs:label "KAGFREILAND" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.kagfreiland.ch/" ;
              gdsn:sourceId "176702" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176703
gdsn:cv176703 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Kehilla Kosher California-K Certification" ;
              rdfs:label "KEHILLA_KOSHER_CALIFORNIA_K" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://kehilla-kosher.org/" ;
              gdsn:sourceId "176703" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176704
gdsn:cv176704 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Kehilla Kosher Heart-K Certification" ;
              rdfs:label "KEHILLA_KOSHER_HEART_K" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://kehilla-kosher.org/" ;
              gdsn:sourceId "176704" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176705
gdsn:cv176705 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "KEMA quality mark is a household name in the Netherlands and is based on international standards for electrical safety. It is recognized throughout Europe." ;
              rdfs:label "KEMA_KEUR" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.dekra-certification.nl/nl/kema-keur" ;
              gdsn:sourceId "176705" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176706
gdsn:cv176706 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The KIWA quality mark applies mainly to the (construction) technical qualities of a product and, depending on the product, environmental aspects. The KIWA label is mainly reflected on products from the construction sector, specially from the drinking water supply such as pipes, fittings and faucets." ;
              rdfs:label "KIWA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.kiwa.nl" ;
              gdsn:sourceId "176706" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176707
gdsn:cv176707 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Czech national mark of quality. The KLASA Mark has been awarded by the Ministry of Agriculture since 2003. Only the best quality food and agricultural products earn it." ;
              rdfs:label "KLASA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "http://www.eklasa.eu/" ;
              gdsn:sourceId "176707" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176708
gdsn:cv176708 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "KOF-K Kosher Supervision is one of the world’s most widely known kosher certification and supervision agencies, serving food producers, manufacturers, and processors around the world. KOF-K’s roster of clients includes Fortune 500 companies and the world’s largest brand names. The KOF-K trademark on a product is recognized and respected world wide as a designation of quality and purity that has been earned through full compliance with the highest of kosher standards to meet the expectations of the kosher market. The KOF-K symbol is protected under U.S. Federal law and is vigilantly guarded against unauthorized use, so that the customer can choose a KOF-K labelled product with complete confidence." ;
              rdfs:label "KOF_K_KOSHER" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.kof-k.org/" ;
              gdsn:sourceId "176708" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176709
gdsn:cv176709 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The KOMO-quality mark is a collective mark of quality with a focus on products in the construction and installation sector and requires quality, environmental and safety aspects for the Dutch market. The trademark KOMO covers several quality marks for specific sectors (KOMO- reduction, KOMO install and KOMO climb-label). The Foundation KOMO manages the labels and the KOMO-quality certificates are submitted by certification settings." ;
              rdfs:label "KOMO" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "www.komo.nl" ;
              gdsn:sourceId "176709" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176710
gdsn:cv176710 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Kosher Australia Certification" ;
              rdfs:label "KOSHER_AUSTRALIA" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
              gdsn:externalLink "https://www.kosher.org.au/" ;
              gdsn:sourceId "176710" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv176711
gdsn:cv176711 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "The Badatz Tartikov hechsher has been the seal of one of the most respected kashrus supervision organizations in the world for close to 20 years,. To this day, our specialty remains to satisfy the standards of the most stringent consumers in the Jewish world." ;
              rdfs:label "KOSHER_BDMC" ;
              gdsn:codeListName "PackagingMarkedLabelAccreditationCode" ;
