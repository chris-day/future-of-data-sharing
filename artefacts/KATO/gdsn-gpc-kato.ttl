###  urn:gs1:std:gdsn:cv178581
gdsn:cv178581 rdf:type owl:NamedIndividual ,
                       gdsn:c58572829 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "An Optimised Hero Image type is to support retail, consumers, distributors and foodservice operators in completing their online sites. These images will assist consumers to identify specific information about the products they are purchasing. The image is a representation of a real world product, built specifically for use on larger screens that may differ from a standard pack shot, but that maintains the majority of the physical pack’s key elements of design, shape and colour, and is therefore recognisable on a digital shelf." ;
              rdfs:label "OPTIMISED_HERO_IMAGE" ;
              gdsn:codeListName "ReferencedFileTypeCode" ;
              gdsn:sourceId "178581" ;
              gdsn:sourceType "codeValue" .


