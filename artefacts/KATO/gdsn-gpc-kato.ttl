gdsn:cv176997 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Swiss gourmet beef, veal and pork. In addition to stringent quality requirements regarding the meat, the label programme is characterized by animal-friendly husbandry, natural feed and 100% traceability." ;
