                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "American Style India Pale Ale (IPA) is a style of pale ale, originally crafted in America. The colour of an IPA can vary from a light gold to a reddish amber." ;
