###  urn:gs1:std:gdsn:cv179680
gdsn:cv179680 rdf:type owl:NamedIndividual ,
                       gdsn:c-604632254 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Includes animals that may be described/observed as cold-blooded vertebrate typically living on land but breeding in water. Includes animals such as frogs, toads and salamanders." ;
              rdfs:label "AMPHIBIAN" ;
              gdsn:codeListName "TargetedConsumptionByCode" ;
              gdsn:sourceId "179680" ;
