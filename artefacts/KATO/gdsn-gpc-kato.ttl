              gdsn:codeListName "ClaimElementCode" ;
              gdsn:sourceId "174215" ;
              gdsn:sourceType "codeValue" .


###  urn:gs1:std:gdsn:cv174216
gdsn:cv174216 rdf:type owl:NamedIndividual ,
                       gdsn:c2147348062 ;
              dct:source "gdsn_codeValues.json" ;
