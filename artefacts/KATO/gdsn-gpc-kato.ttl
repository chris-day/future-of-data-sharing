gdsn:cv176909 rdf:type owl:NamedIndividual ,
                       gdsn:c-1409540287 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Rainforest Alliance people & nature label indicates that partner supports a healthier planet and an improve quality of life for people in farming communities." ;
