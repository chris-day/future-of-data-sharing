###  urn:gs1:std:gdsn:cv169851
gdsn:cv169851 rdf:type owl:NamedIndividual ,
                       gdsn:c1041249980 ;
              dct:source "gdsn_codeValues.json" ;
              rdfs:comment "Doppelbock or double bock is a stronger version of traditional bock. Historically, Doppelbock was high in alcohol and sweet, thus serving as \"liquid bread\" for the Friars during times of fasting, when solid food was not permitted. Today, Doppelbock is still strong—ranging from 7%–12% or more by volume." ;
              rdfs:label "DOPPELBOCK" ;
              gdsn:codeListName "BeerStyleTypeCode" ;
              gdsn:sourceId "169851" ;
              gdsn:sourceType "codeValue" .


