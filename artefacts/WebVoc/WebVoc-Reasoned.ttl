                rdfs:range xsd:string ;
                rdfs:comment "A short text string code (see values defined in ISO 3166) specifying the country in which a processing or other activity is performed, for example processing, bottling, manufacturing."@en ,
                             "Code specifying the country for the address using ISO 3166-1."@en ;
                rdfs:isDefinedBy voc: ;
                rdfs:label "Country Code"@en ;
                ns:term_status "stable" ;
                skos:closeMatch schema:addressCountry ;
                skos:related schema:PostalAddress .


