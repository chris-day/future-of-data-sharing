                                                             <https://gs1.org/voc/OrganizationRoleType> ,
                                                             <https://gs1.org/voc/TypeCode> ,
                                                             voc:OrganizationRoleType ,
                                                             voc:TypeCode ,
                                                             <https://www.gs1.org/voc/OrganizationRoleType> ,
