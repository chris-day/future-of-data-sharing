###  https://www.gs1.org/voc/OrganizationRoleType-CONSUMER

###  https://ref.gs1.org/voc/OrganizationRoleType-CORPORATE_IDENTITY
voc:OrganizationRoleType-CORPORATE_IDENTITY rdf:type owl:NamedIndividual ,
                                                     <https://gs1.org/voc/OrganizationRoleType> ,
                                                     <https://gs1.org/voc/TypeCode> ,
                                                     voc:OrganizationRoleType ,
                                                     voc:TypeCode ,
                                                     <https://www.gs1.org/voc/OrganizationRoleType> ,
                                                     <https://www.gs1.org/voc/TypeCode> ;
                                            owl:sameAs <https://www.gs1.org/voc/OrganizationRoleType-CORPORATE_IDENTITY> ;
                                            rdfs:comment "An organization that represents the identity of a commercial organization, commonly known as a holding or parent company, and links a number of other organizations or affiliated sub-organizations. "@en ;
                                            rdfs:label "Corporate Identity"@en ;
                                            ns:term_status "stable" ;
                                            skos:prefLabel "CORPORATE_IDENTITY" .


