#################################################################
#    Data properties
#################################################################

###  http://schema.org/availableLanguage
schema:availableLanguage rdf:type owl:DatatypeProperty .


###  http://schema.org/description
schema:description rdf:type owl:DatatypeProperty .


###  http://schema.org/expires
schema:expires rdf:type owl:DatatypeProperty .


###  http://schema.org/height
schema:height rdf:type owl:DatatypeProperty .


###  http://schema.org/inLanguage
schema:inLanguage rdf:type owl:DatatypeProperty .


###  http://schema.org/name
schema:name rdf:type owl:DatatypeProperty .


###  http://schema.org/url
schema:url rdf:type owl:DatatypeProperty .


###  http://schema.org/width
schema:width rdf:type owl:DatatypeProperty .


###  https://ref.gs1.org/_TOP_OBJECT_PROPERTY_
<https://ref.gs1.org/_TOP_OBJECT_PROPERTY_> rdf:type owl:DatatypeProperty .


###  https://ref.gs1.org/voc/activityIdeas
voc:activityIdeas rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:anyURI .


###  https://ref.gs1.org/voc/additionalOrganizationIdentificationTypeValue
voc:additionalOrganizationIdentificationTypeValue rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain voc:Organization ;
                                                  rdfs:range xsd:string ;
                                                  rdfs:comment "The value associated with the Additional Organization Identification Type Value."@en ;
                                                  rdfs:isDefinedBy voc: ;
                                                  rdfs:label "Additional Organization Identification Type Value"@en ;
                                                  ns:term_status "stable" .


###  https://ref.gs1.org/voc/additionalProductClassificationCode
voc:additionalProductClassificationCode rdf:type owl:DatatypeProperty ,
                                                 owl:FunctionalProperty ;
                                        rdfs:domain voc:AdditionalProductClassificationDetails ;
                                        rdfs:range xsd:string ;
                                        rdfs:comment "Code specifying the applied additional product classification scheme."@en ;
                                        rdfs:isDefinedBy voc: ;
                                        rdfs:label "Additional Product Classification Code"@en ;
                                        ns:term_status "stable" .


###  https://ref.gs1.org/voc/additionalProductClassificationCodeDescription
voc:additionalProductClassificationCodeDescription rdf:type owl:DatatypeProperty ,
                                                            owl:FunctionalProperty ;
                                                   rdfs:domain voc:AdditionalProductClassificationDetails ;
                                                   rdfs:range rdf:langString ;
                                                   rdfs:comment "A description related to  the additional product classification code value."@en ;
                                                   rdfs:isDefinedBy voc: ;
                                                   rdfs:label "Additional Product Classification Code Description"@en ;
                                                   ns:term_status "stable" .


###  https://ref.gs1.org/voc/additionalProductClassificationValue
voc:additionalProductClassificationValue rdf:type owl:DatatypeProperty ,
                                                  owl:FunctionalProperty ;
                                         rdfs:domain voc:AdditionalProductClassificationDetails ;
                                         rdfs:range xsd:string ;
                                         rdfs:comment "Code specifying an additional product classification other than the GS1 Global Product Classification. The applied classification scheme is specified as additional information together with the classification value."@en ;
                                         rdfs:isDefinedBy voc: ;
                                         rdfs:label "Additional Product Classification Value"@en ;
                                         ns:term_status "stable" .


###  https://ref.gs1.org/voc/additionalProductDescription
voc:additionalProductDescription rdf:type owl:DatatypeProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:domain voc:Product ;
                                 rdfs:range rdf:langString ;
                                 rdfs:comment "Additional variants necessary to communicate to the industry to help define the product. Multiple variants can be established for each GTIN for e.g. Style, Colour, and Fragrance ."@en ;
                                 rdfs:isDefinedBy voc: ;
                                 rdfs:label "Additional Product Description"@en ;
                                 ns:term_status "stable" .


###  https://ref.gs1.org/voc/additiveName
voc:additiveName rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain voc:AdditiveDetails ;
                 rdfs:range rdf:langString ;
                 rdfs:comment "The name of any additive or genetic modification contained or not contained in the product ."@en ;
                 rdfs:isDefinedBy voc: ;
                 rdfs:label "Additive Name"@en ;
