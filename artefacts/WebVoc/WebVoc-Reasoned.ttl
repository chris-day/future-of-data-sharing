###  https://ref.gs1.org/voc/Organization
voc:Organization rdf:type owl:Class ;
                 owl:equivalentClass <https://www.gs1.org/voc/Organization> ;
                 rdfs:subClassOf owl:Thing ;
                 rdfs:comment "An Organization is any legal or physical entity involved at any point in any supply chain and upon which there is a need to retrieve predefined information. An Organization is uniquely identified by a Global Location Number (GLN)."@en ;
                 rdfs:isDefinedBy voc: ;
                 rdfs:label "Organization"@en ;
                 ns:term_status "stable" ;
                 skos:exactMatch schema:Organization .


###  https://ref.gs1.org/voc/OrganizationClassificationDetails
voc:OrganizationClassificationDetails rdf:type owl:Class ;
                                      owl:equivalentClass <https://www.gs1.org/voc/OrganizationClassificationDetails> ;
                                      rdfs:subClassOf owl:Thing ;
                                      rdfs:comment "Government bodies, trade organisations, and other parties have developed taxonomies that classify business sectors, activities, and other organisational classifications.  This class provides a A repeatable grouping of classification details for an organisation."@en ;
                                      rdfs:isDefinedBy voc: ;
                                      rdfs:label "Organization Classification Details"@en ;
                                      ns:term_status "stable" .


###  https://ref.gs1.org/voc/OrganizationClassificationType
voc:OrganizationClassificationType rdf:type owl:Class ;
                                   owl:equivalentClass <https://www.gs1.org/voc/OrganizationClassificationType> ;
                                   rdfs:subClassOf <https://gs1.org/voc/TypeCode> ,
                                                   voc:TypeCode ,
                                                   <https://www.gs1.org/voc/TypeCode> ;
                                   rdfs:comment "A code value indicating a specific taxonomy that classifies business sectors, activities, and other organisational classifications. National Classification systems are often based on global or regional Classification systems (e.g., ISIC, SIC, NACE). If so, the national system extends the international system adding new or longer code values. In case the code value from the local system is in fact the same as in the international system, it is highly recommended to use the Organization Classification Type for the international system rather than that for the national system. By using the international code, many more organisation will be able to interpret the code value used easily and correctly."@en ;
                                   rdfs:isDefinedBy voc: ;
                                   rdfs:label "Organization Classification Type"@en ;
                                   ns:term_status "stable" .


###  https://ref.gs1.org/voc/OrganizationID_Details
voc:OrganizationID_Details rdf:type owl:Class ;
                           owl:equivalentClass <https://www.gs1.org/voc/OrganizationID_Details> ;
                           rdfs:subClassOf owl:Thing ;
                           rdfs:comment "Government bodies, trade organisations, and other parties issue identifiers that are associated to legal entities and/or functions. Linking these identifiers to GLN and one another supports consolidating records, mapping related, collaborative identifiers, enhances search ability and enables more efficient transitions between identifiers.  This class provides a mechanism for connecting and sharing party identifiers."@en ;
                           rdfs:isDefinedBy voc: ;
                           rdfs:label "Organisation ID Details"@en ;
                           ns:term_status "stable" .


