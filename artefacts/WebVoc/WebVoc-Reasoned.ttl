voc:OrganizationRoleType-DELIVERY_RECIPIENT_PARTY rdf:type owl:NamedIndividual ,
                                                           <https://gs1.org/voc/OrganizationRoleType> ,
                                                           <https://gs1.org/voc/TypeCode> ,
