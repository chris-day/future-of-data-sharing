voc:locationInfo rdf:type owl:DatatypeProperty ;
                 rdfs:range xsd:anyURI .


###  https://ref.gs1.org/voc/locationOpeningDate
voc:locationOpeningDate rdf:type owl:DatatypeProperty ;
                        rdfs:domain voc:Place ;
                        rdfs:range xsd:date ;
                        rdfs:comment "Date in which a location was opened or otherwise established. Note that this is NOT the date when a GLN was allocated to identify the location. To designate when location was finally closed, see gs1: gs1:locationFinalClosureDate"@en ;
                        rdfs:isDefinedBy voc: ;
                        rdfs:label "Location Opening Date"@en ;
                        ns:term_status "stable" .


###  https://ref.gs1.org/voc/logisticsInfo
voc:logisticsInfo rdf:type owl:DatatypeProperty ;
                  rdfs:range xsd:anyURI .


###  https://ref.gs1.org/voc/longitude
voc:longitude rdf:type owl:DatatypeProperty ;
              rdfs:domain voc:GeoCoordinates ;
              rdfs:range xsd:string ;
              rdfs:comment "The arc or portion of the earth's equator intersected between the meridian of a given place and the prime meridian and expressed in degrees"@en ;
              rdfs:isDefinedBy voc: ;
              rdfs:label "Longitude"@en ;
              ns:term_status "stable" ;
              skos:exactMatch schema:longitude ;
              skos:relatedMatch <http://www.w3.org/2003/01/geo/wgs84_pos#long> .


