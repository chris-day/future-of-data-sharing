#################################################################
#    Annotations
#################################################################

voc:activityIdeas rdfs:comment "A link to ideas for using a product or engaging in other forms of entertainment, particularly with children."@en ;
                  rdfs:label "Activity Ideas"@en ;
                  ns:term_status "stable" .


voc:allergenInfo rdfs:comment "A link to a description of the allergen information."@en ;
                 rdfs:label "Allergen information"@en ;
                 ns:term_status "stable" .


voc:appDownload rdfs:comment "A link to a related mobile app"@en ;
                rdfs:label "App download"@en ;
                ns:term_status "stable" .


voc:authenticitySecurityFeatureInstructionsURL rdfs:comment "Links to online instructions about how to locate a physical security marking and read a value from it."@en ;
                                               rdfs:isDefinedBy voc: ;
                                               rdfs:label "Authenticity Security Feature Instructions Link"@en ;
                                               ns:term_status "stable" .


voc:backgroundInfo rdfs:comment "A link to information typically from the owner of the identified entity about the creative background, thought leadership or influence of the identified entity. This may include the inspiration, innovation for a development process, literary approach or, the science or technology used."@en ;
                   rdfs:label "Background Information"@en ;
                   ns:term_status "stable" .


voc:bestBeforeDate rdfs:comment "Best before date on the label or package signifies the end of the period under which the product will retain specific quality attributes or claims even though the product may continue to retain positive quality attributes after this date. Best before date is primarily used for consumer information and may be a regulatory requirement."@en ;
                   rdfs:isDefinedBy voc: ;
                   rdfs:label "Best Before Date"@en ;
                   ns:term_status "stable" ;
                   skos:altLabel "Best Before Date"@en ;
                   skos:notation "15"^^voc:AI ;
                   skos:prefLabel "15" .


voc:brandHomepageClinical rdfs:comment "A link to a brand presence aimed at clinical professionals."@en ;
                          rdfs:label "Information for professionals about this brand"@en ;
                          ns:term_status "stable" .


voc:brandHomepagePatient rdfs:comment "A link to a brand presence aimed at patients."@en ;
                         rdfs:label "Information for patients about this brand"@en ;
                         ns:term_status "stable" .


voc:careersInfo rdfs:comment "A link to information about jobs, careers, or other employment opportunities associated to an organisation or location."@en ;
                rdfs:label "Careers information"@en ;
                ns:term_status "stable" .


voc:certificationInfo rdfs:comment "A link to certification information."@en ;
                      rdfs:label "Certification Information"@en ;
                      ns:term_status "stable" .


voc:compulsoryAdditionalLabelInformation rdfs:comment "The legally required/compulsory additional label information as stated on the product packaging or label."@en ;
                                         rdfs:isDefinedBy voc: ;
                                         rdfs:label "Compulsory Additional Label Information"@en ;
                                         ns:term_status "stable" .


voc:consumerHandlingStorageInfo rdfs:comment "A link to information about safe handling and storage for consumer use."@en ;
                                rdfs:label "Consumer handling and storage information"@en ;
                                ns:term_status "stable" .


voc:consumerProductVariant rdfs:comment "The consumer product variant may be used to distinguish one variant of a retail consumer trade item from another if the change does not require the allocation of a different Global Trade Item Number (per the GTIN Management Standard), but communication between trading partners is required to support consumers. The brand owner is responsible for assigning the consumer product variant."@en ;
                           rdfs:isDefinedBy voc: ;
                           rdfs:label "Consumer Product Variant"@en ;
                           ns:term_status "stable" ;
                           skos:altLabel "Consumer Product Variant"@en ;
                           skos:notation "22"^^voc:AI ;
                           skos:prefLabel "22" .


voc:defaultLink rdfs:comment "The default link for a given identified item to which a resolver will redirect unless there is information in the request that is a better match."@en ;
                rdfs:label "Default link"@en ;
                ns:term_status "stable" ;
                voc:restricted "resolver" .


voc:defaultLinkMulti rdfs:comment "A set of 'default links' that may be differentiated by information in the HTTP request headers sent to a resolver to enable a better match than the single default link."@en ;
                     rdfs:label "Default linkMulti"@en ;
                     ns:term_status "stable" ;
                     voc:restricted "resolver" .


voc:dietCode rdfs:comment "Links to multiple pairs of gs1:DietTypeCode and diet type sub code (free-form text string)."@en ;
             rdfs:isDefinedBy voc: ;
             rdfs:label "Diet Code"@en ;
             ns:term_status "stable" .


voc:discountType rdfs:comment "A code that specifies the type of payment discount applicable to an offer, for example BOGO."@en ;
                 rdfs:isDefinedBy voc: ;
                 rdfs:label "Discount Type"@en ;
                 ns:term_status "stable" .


voc:dpp rdfs:comment "A link to a digital product passport."@en ;
        rdfs:label "Digital Product Passport"@en ;
        ns:term_status "stable" .


voc:dueDate rdfs:comment "The date by which an invoice should be paid. This data element represents an attribute of a payment slip reference number, AI (8020), and a Global Location Number (GLN) of the invoicing party."@en ;
            rdfs:isDefinedBy voc: ;
            rdfs:label "Due Date"@en ;
            ns:term_status "stable" ;
            skos:altLabel "Due Date"@en ;
            skos:notation "12"^^voc:AI ;
            skos:prefLabel "12" .


voc:eifu rdfs:comment "A link to electronic Instruction For Use instructions for Medical Devices."@en ;
         rdfs:label "Electronic Instructions For Use"@en ;
         ns:term_status "stable" ;
         voc:restricted "validatedHealthcare" .


voc:eligibleTradeChannel rdfs:comment "A code determining the location where a user can redeem the offer, for example ONLINE_ONLY. "@en ;
                         rdfs:isDefinedBy voc: ;
                         rdfs:label "Eligible Trade Channel"@en ;
                         ns:term_status "stable" .


voc:epcis terms:isReplacedBy voc:epcisRepository ;
          rdfs:comment "A link to an EPCIS repository of visibility event data."@en ;
          rdfs:label "EPC Information Services (EPCIS) repository"@en ;
          owl:deprecated "true"^^xsd:boolean ;
          ns:term_status "archaic" .


voc:epcisRepository rdfs:comment "A link to an EPCIS repository of visibility event data."@en ;
                    rdfs:label "EPC Information Services (EPCIS) repository"@en ;
                    ns:term_status "stable" .


voc:epil rdfs:comment "A link to an electronic patient information leaflet."@en ;
         rdfs:label "Electronic Patient Information Leaflet"@en ;
         ns:term_status "stable" ;
         voc:restricted "validatedHealthcare" .


voc:eventsInfo rdfs:comment "A link to event details.  For a page specifically for scheduling a reservation or booking an appointment, see gs1:scheduleTime."@en ;
               rdfs:label "Events information"@en ;
               ns:term_status "stable" .


voc:exactDiscountAmount rdfs:comment "Links to a gs1:PriceSpecification that indicates in terms of an amount and specified currency, the exact discount on the sales price associated with a particular gs1:Discount. This property can be used to express '$10 off'."@en ;
                        rdfs:isDefinedBy voc: ;
                        rdfs:label "Exact Discount Amount"@en ;
                        ns:term_status "stable" .


voc:exclusionDescription rdfs:comment " A text description of any products, brands, or categories that cannot be used with the offer"@en ;
                         rdfs:isDefinedBy voc: ;
                         rdfs:label "Exclusion Description"@en ;
                         ns:term_status "stable" .


voc:expirationDate rdfs:comment "The expiration date is the date that determines the limit of consumption or use of a product/coupon. Its meaning is determined based on the trade item context (e.g., for food, the date will indicate the possibility of a direct health risk resulting from use of the product after the date, for pharmaceutical products, it will indicate the possibility of an indirect health risk resulting from the ineffectiveness of the product after the date). It is often referred to as 'use by date' or 'maximum durability date'."@en ;
                   rdfs:isDefinedBy voc: ;
                   rdfs:label "Expiration Date"@en ;
                   ns:term_status "stable" ;
                   skos:altLabel "Expiration Date"@en ;
                   skos:notation "17"^^voc:AI ;
                   skos:prefLabel "17" .


voc:expirationDateTime rdfs:comment "The manufacturer determines the expiration date and time, which is relevant only for short duration and for items that will not be sent on long distances and not outside of the time zone. A typical application of AI (7003) is in hospitals or public pharmacies for special, customised, products which may have a 'life duration' shorter than one single day. The life duration varies according the pharmaceutical substances used in the treatment. The precise expiration date and time is defined at the end of the manufacturing process, and can be barcoded on the product label as an attribute to the item's GTIN. Where there is no business requirement to express the expiration date to the nearest hour (or less), AI (17) Expiration date should be used."@en ;
                       rdfs:isDefinedBy voc: ;
                       rdfs:label "Expiration Date and Time"@en ;
                       ns:term_status "stable" ;
                       skos:altLabel "Expiration Date and Time"@en ;
                       skos:notation "7003"^^voc:AI ;
                       skos:prefLabel "7003" .


voc:faqs rdfs:comment "A link to a set of frequently asked questions."@en ;
         rdfs:label "Frequently Asked Questions"@en ;
         ns:term_status "stable" .


voc:firstFreezeDate rdfs:comment "The first freeze date is applicable to products that are frozen directly after slaughtering, harvesting, catching or after initial processing of the product. Examples include fresh meat, meat products or fishery products. The first freeze date is determined by the organisation conducting the freezing."@en ;
                    rdfs:isDefinedBy voc: ;
                    rdfs:label "First Freeze Date"@en ;
                    ns:term_status "stable" ;
                    skos:altLabel "First Freeze Date"@en ;
                    skos:notation "7006"^^voc:AI ;
                    skos:prefLabel "7006" .


voc:handledBy rdfs:comment "Used when one resolver redirects all request URIs that match a given pattern without further processing, such as from GS1 to a brand-operated service. See section 7.7.1 of the Digital Link standard, version 1.1. "@en ;
              rdfs:label "Handled by"@en ;
              ns:term_status "stable" ;
              voc:restricted "resolver" .


voc:harvestDate rdfs:comment "The harvest date. For example, the harvest date can be the date when an animal was slaughtered or killed, a fish has been harvested, or a crop was harvested. This date  is determined by the organisation conducting the harvesting. Different organisations may use more specific terminology when referring to their specific needs and use terms such as: Date of catch or slaughter date. "@en ;
                rdfs:isDefinedBy voc: ;
                rdfs:label "Harvest Date."@en ;
                ns:term_status "stable" ;
                skos:altLabel "Harvest Date."@en ;
                skos:notation "7007"^^voc:AI ;
                skos:prefLabel "7007" .


voc:harvestDateEnd rdfs:comment "The harvest end date. For example, the harvest end date can be the date when an animal was slaughtered or killed, a fish has been harvested, or a crop was harvested. This end date is determined by the organisation conducting the harvesting. Different organisations may use more specific terminology when referring to their specific needs and use terms such as: Date of catch or slaughter date. When referring to animals the date range refers to the whole animal and all meat or fish cuts derived from this animal."@en ;
                   rdfs:isDefinedBy voc: ;
                   rdfs:label "Harvest Date End"@en ;
                   ns:term_status "stable" ;
                   skos:altLabel "Harvest Date End"@en ;
                   skos:notation "7007"^^voc:AI ;
                   skos:prefLabel "7007" .


voc:harvestDateStart rdfs:comment "The harvest start date. For example, the harvest start date can be the date when an animal was slaughtered or killed, a fish has been harvested, or a crop was harvested. This start date is determined by the organisation conducting the harvesting. Different organisations may use more specific terminology when referring to their specific needs and use terms such as: Date of catch or slaughter date. When referring to animals the date range refers to the whole animal and all meat or fish cuts derived from this animal."@en ;
                     rdfs:isDefinedBy voc: ;
                     rdfs:label "Harvest Date Start"@en ;
                     ns:term_status "stable" ;
                     skos:altLabel "Harvest Date Start"@en ;
                     skos:notation "7007"^^voc:AI ;
                     skos:prefLabel "7007" .


voc:hasBatchLotNumber rdfs:comment "The batch or lot number associates an item with information the manufacturer considers relevant for traceability of the trade item to which the element string is applied. The data may refer to the trade item itself or to items contained. The number may be, for example, a production lot number, a shift number, a machine number, a time, or an internal production code. In cases where the same product is manufactured in different locations the brand owner and the manufacturer are responsible for ensuring the non-duplication of batch/lot numbers for a GTIN. For the re-use of batch/lot numbers with a GTIN, sector-specific constraints need to be considered."@en ;
                      rdfs:isDefinedBy voc: ;
                      rdfs:label "Batch/Lot Identifier"@en ;
                      ns:term_status "stable" ;
                      skos:altLabel "Batch/Lot Identifier"@en ;
                      skos:notation "10"^^voc:AI ;
                      skos:prefLabel "10" .


voc:hasRetailers rdfs:comment "A link to a list of retailers."@en ;
                 rdfs:label "Has Retailers"@en ;
                 ns:term_status "stable" .


voc:hasSerialNumber rdfs:comment "A serial number is assigned to an entity for its lifetime. When combined with a GTIN, a serial number uniquely identifies an individual item. The serial number field is alphanumeric and may include all characters contained in figure 7.11-1. The brand owner and the manufacturer are responsible for ensuring the non-duplication of serial numbers for a GTIN. For the re-use of serial numbers with a GTIN, sector-specific constraints need to be considered."@en ;
                    rdfs:isDefinedBy voc: ;
                    rdfs:label "Serial Number"@en ;
                    ns:term_status "stable" ;
                    skos:altLabel "Serial Number"@en ;
                    skos:notation "21"^^voc:AI ;
                    skos:prefLabel "21" .


voc:hasThirdPartyControlledSerialNumber rdfs:comment "This identifier is assigned to an entity for its lifetime. When combined with a GTIN, a TPX uniquely identifies an individual item and forms a unit pack Unique Identifier (upUI) for tobacco traceability per EU 2018/574. The serial number field is alphanumeric and may include all characters contained in figure 7.11-1. The Third Party determines the TPX, but the TPX shall begin with the ID Issuer Unique Identification Code (UIC), followed by GS1 UIC Extension 1, and GS1 UIC Extension 2."@en ;
                                        rdfs:isDefinedBy voc: ;
                                        rdfs:label "Third-Party Controlled Serial Number"@en ;
                                        ns:term_status "stable" ;
                                        skos:altLabel "Third-Party Controlled Serial Number"@en ;
                                        skos:notation "235"^^voc:AI ;
                                        skos:prefLabel "235" .


